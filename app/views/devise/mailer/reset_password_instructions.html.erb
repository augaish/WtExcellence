<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
      <h2 style="color: #5C3984;">Reset Your Password</h2>
      
      <p>Hello <%= @resource.email %>,</p>
      
      <p>Someone has requested a link to change your password. You can do this through the link below:</p>
      
      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= edit_user_password_url(reset_password_token: @token) %>" 
           style="background-color: #5C3984; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;">
          Change my password
        </a>
      </div>
      
      <p style="color: #797C81; font-size: 12px;">
        If you didn't request this, please ignore this email. Your password won't change until you access the link above and create a new one.
      </p>
      
      <p style="color: #797C81; font-size: 12px;">
        If the button above doesn't work, copy and paste this link into your browser:<br>
        <%= edit_user_password_url(reset_password_token: @token) %>
      </p>
    </div>
  </body>
</html>
