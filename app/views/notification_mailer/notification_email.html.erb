<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f7f7fd; padding: 32px 16px;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width: 560px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
        <!-- Header with brand -->
        <tr>
          <td style="padding: 28px 32px 24px 32px; border-bottom: 1px solid #e5e7eb;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td>
                  <span style="font-size: 20px; font-weight: 700; color: #5C3984; letter-spacing: -0.02em;">Way to Excellence</span>
                </td>
              </tr>
              <tr>
                <td style="padding-top: 4px;">
                  <span style="font-size: 13px; color: #6b7280;">Notification</span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Greeting -->
        <tr>
          <td style="padding: 24px 32px 8px 32px;">
            <p style="margin: 0; font-size: 16px; color: #0d1120; line-height: 1.5;">Hello <%= @recipient.name %>,</p>
          </td>
        </tr>

        <!-- Message card with language sections -->
        <tr>
          <td style="padding: 8px 32px 24px 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px;">
              <!-- English section -->
              <tr>
                <td style="padding: 16px 20px 12px 20px; border-bottom: 1px solid #e5e7eb;">
                  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 600; color: #5C3984; text-transform: uppercase; letter-spacing: 0.04em;">English</p>
                  <p style="margin: 0; font-size: 15px; color: #1f2937; line-height: 1.5;"><%= @title_en %></p>
                </td>
              </tr>
              <!-- Arabic section -->
              <tr>
                <td style="padding: 16px 20px 16px 20px;" dir="rtl">
                  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 600; color: #5C3984; text-transform: uppercase; letter-spacing: 0.04em;">العربية</p>
                  <p style="margin: 0; font-size: 15px; color: #1f2937; line-height: 1.5; text-align: right;"><%= @title_ar %></p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CTA button -->
        <tr>
          <td style="padding: 8px 32px 32px 32px; text-align: center;">
            <a href="<%= @link_url %>"
               style="display: inline-block; background-color: #5C3984; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 28px; border-radius: 8px; box-shadow: 0 2px 6px rgba(92, 57, 132, 0.25);">
              <%= @view_in_app_en %>
            </a>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding: 20px 32px 28px 32px; background-color: #f9fafb; border-top: 1px solid #e5e7eb;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td style="padding-bottom: 10px;">
                  <p style="margin: 0; font-size: 13px; color: #4b5563; line-height: 1.5;"><%= @footer_en %></p>
                </td>
              </tr>
              <tr>
                <td dir="rtl">
                  <p style="margin: 0; font-size: 13px; color: #4b5563; line-height: 1.5; text-align: right;"><%= @footer_ar %></p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
