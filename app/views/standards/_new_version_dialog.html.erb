<dialog id="newVersionDialog" class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4" data-controller="modal dialog-no-backdrop-close">
    <div class="p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 sm:mb-6">
            <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('create_new_version') %></h2>
            <button data-action="click->modal#close" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors duration-200" aria-label="<%= t('close') %>">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <%= form_with url: new_version_standard_path(@standard), method: :post, multipart: true, class: "space-y-6", local: true do |form| %>
            <div>
                <%= form.label :version_label, t('version_label'), class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_field :version_label, placeholder: t('version_label_placeholder'), class: "w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm", required: true %>
            </div>

            <div>
                <%= form.label :pdf_file, t('upload_pdf'), class: "block text-sm font-medium text-gray-700 mb-2" %>
                <div class="relative">
                    <%= form.file_field :pdf_file, accept: ".pdf,.xlsx", class: "w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm #{rtl? ? 'file:ml-4' : 'file:mr-4'} file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[#F7F7FD] file:text-[#5C3984] hover:file:bg-[#E8E8F5]", required: true %>
                </div>
                <p class="text-xs text-gray-500 mt-1"><%= t('only_pdf_allowed') %></p>
            </div>

            <div>
                <%= form.label :notes, t('notes'), class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_area :notes, placeholder: t('notes_placeholder'), rows: 3, class: "w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm" %>
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center <%= rtl? ? 'sm:justify-start sm:flex-row-reverse' : 'sm:justify-end' %> gap-2 <%= rtl? ? 'sm:space-x-reverse sm:space-x-3' : 'sm:space-x-3' %> pt-4">
                <button type="button" data-action="click->modal#closeById" data-modal-dialog-param="newVersionDialog" class="w-full sm:w-auto px-4 py-3 sm:py-2 min-h-[44px] text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200 text-[16px] sm:text-sm">
                    <%= t('cancel') %>
                </button>
                <button type="submit" class="w-full sm:w-auto px-6 py-3 sm:py-2 min-h-[44px] bg-[#5C3984] hover:bg-[#4A2F6B] text-white rounded-lg font-medium transition-colors duration-200 text-[16px] sm:text-sm">
                    <%= t('create_version') %>
                </button>
            </div>
        <% end %>
    </div>
</dialog>
