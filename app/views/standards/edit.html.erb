<div class="bg-gray-50 min-h-screen"
     data-controller="clause-editor modal"
     data-clause-editor-pencil-icon-path-value="<%= asset_path('pencil-icon.svg') %>"
     data-clause-editor-delete-icon-path-value="<%= asset_path('delete-clause-icon.svg') %>"
     data-clause-editor-discard-modal-title-value="<%= t('discard_changes_modal_title') %>"
     data-clause-editor-discard-modal-message-value="<%= t('discard_changes_modal_message') %>"
     data-clause-editor-discard-modal-confirm-value="<%= t('discard_changes') %>"
     data-clause-editor-new-clause-default-value="<%= t('new_clause_default') %>"
     data-clause-editor-new-checkpoint-default-value="<%= t('new_checkpoint_default') %>"
     data-clause-editor-drop-here-value="<%= t('drop_here') %>"
     data-clause-editor-drop-here-root-level-value="<%= t('drop_here_root_level') %>"
     data-clause-editor-drop-here-inside-value="<%= t('drop_here_inside') %>"
     data-clause-editor-drop-here-to-cancel-value="<%= t('drop_here_to_cancel') %>"
     data-clause-editor-hold-to-nest-value="<%= t('hold_to_nest') %>"
     data-clause-editor-drop-to-nest-value="<%= t('drop_to_nest') %>"
     data-clause-editor-add-sub-clause-label-value="<%= t('add_sub_clause') %>"
     data-clause-editor-add-checkpoint-label-value="<%= t('add_checkpoint') %>"
     data-clause-editor-edit-clause-label-value="<%= t('edit_clause_action') %>"
     data-clause-editor-delete-clause-label-value="<%= t('delete_clause_action') %>"
     data-clause-editor-delete-checkpoint-label-value="<%= t('delete_checkpoint_action') %>"
     data-clause-editor-edit-label-value="<%= t('edit') %>"
     data-clause-editor-delete-label-value="<%= t('delete') %>"
     data-clause-editor-confirm-delete-title-value="<%= t('confirm_delete_title') %>"
     data-clause-editor-confirm-delete-clause-message-value="<%= t('confirm_delete_clause_message') %>"
     data-clause-editor-confirm-delete-checkpoint-message-value="<%= t('confirm_delete_checkpoint_message') %>"
     data-clause-editor-drop-checkpoints-here-label-value="<%= t('drop_checkpoints_here') %>"
     data-clause-editor-translating-label-value="<%= t('translating') %>"
     data-clause-editor-mark-as-reviewed-label-value="<%= t('mark_as_reviewed') %>"
     data-clause-editor-save-label-value="<%= t('save') %>"
     data-clause-editor-cancel-label-value="<%= t('cancel') %>"
     data-clause-editor-save-changes-label-value="<%= t('save_changes') %>">
    <div class="bg-white border-b border-gray-200 px-4 sm:px-6 py-3 sm:py-4">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:space-x-4">
                <%= link_to standard_path(@standard), class: "flex items-center space-x-2 text-gray-600 hover:text-gray-900 min-h-[44px]" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span class="text-sm sm:text-base"><%= t('go_back') %></span>
                <% end %>
                <div class="h-6 w-px bg-gray-300 hidden sm:block"></div>
                <h1 class="text-lg sm:text-xl font-bold text-gray-900 break-words"><%= @standard.code %></h1>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:space-x-4">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs sm:text-sm text-gray-600"><%= t('version') %>:</span>
                    <span class="px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium rounded-full bg-blue-100 text-blue-800">
                        <%= @version&.version_label || 'v1.0' %>
                    </span>
                    <span class="text-xs sm:text-sm text-gray-600"><%= t('status_label') %>:</span>
                    <span class="px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium rounded-full <%= @version&.status == 'draft' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %>">
                        <%= @version&.status ? t("version_statuses.#{@version.status}") : t("version_statuses.draft") %>
                    </span>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <% if @version %>
                      <% previous_version = @standard.standard_versions.where("created_at < ?", @version.created_at).order(created_at: :desc).first %>
                      <% if previous_version %>
                        <%= link_to compare_standard_path(@standard, compare_with: previous_version.id, version_id: @version.id), 
                            class: "px-4 py-3 sm:py-2 text-[#5C3984] border border-[#5C3984] rounded-lg hover:bg-[#5C3984] hover:text-white transition-colors min-h-[44px] text-[16px] sm:text-sm whitespace-nowrap" do %>
                          <%= t('compare_with_previous_version') %>
                        <% end %>
                      <% end %>
                    <% end %>

                    <button data-action="click->modal#open" data-modal-dialog-param="publishVersionDialog" class="px-4 py-3 sm:py-2 bg-[#5C3984] text-white rounded-lg hover:bg-[#4A2F6B] transition-colors min-h-[44px] text-[16px] sm:text-sm whitespace-nowrap">
                        <%= t('publish_new_version') %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 py-4 sm:py-6">
        <div class="mb-4 sm:mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-base sm:text-lg font-medium text-gray-900"><%= t('edit_clause_tree') %></h2>
                <p class="text-xs sm:text-sm text-gray-600"><%= t('edit_clause_tree_description') %></p>
            </div>
            <div id="clause-editor-toolbar" class="flex flex-wrap items-center gap-2">
                <span id="clause-editor-unsaved-indicator" class="hidden text-xs sm:text-sm font-medium text-amber-700 bg-amber-100 px-3 py-2 rounded-lg">
                    <%= t('unsaved_changes') %>
                </span>
                <button type="button"
                        id="clause-editor-discard-btn"
                        disabled
                        data-action="click->clause-editor#discardChanges"
                        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed min-h-[44px]">
                    <%= t('discard_changes') %>
                </button>
                <button type="button"
                        id="clause-editor-save-all-btn"
                        disabled
                        data-action="click->clause-editor#saveAllChanges"
                        class="px-4 py-2 text-sm font-medium text-white bg-[#5C3984] rounded-lg hover:bg-[#4A2F6B] disabled:opacity-50 disabled:cursor-not-allowed min-h-[44px]">
                    <%= t('save_all_changes') %>
                </button>
            </div>
        </div>

        <% if @version && @clauses&.any? %>
            <div id="root-clauses-container" class="space-y-4" data-children-container data-standard-version-id="<%= @version.id %>">
                <% @clauses.each do |clause| %>
                    <%= render 'clause_hierarchy_edit', clause: clause, level: 0 %>
                <% end %>
            </div>
        <% elsif @version && current_user&.platform_admin? %>
            <div id="root-clauses-container" class="space-y-4" data-children-container data-standard-version-id="<%= @version.id %>">
                <div class="text-center py-12">
                    <p class="text-sm sm:text-base text-gray-600 mb-4"><%= t('no_clauses_found_version') %></p>
                    <button class="px-4 py-3 sm:py-2 text-xs sm:text-sm font-medium flex items-center justify-center gap-2 bg-[#D6C4ED] text-[#0D1120] rounded-xl hover:opacity-90 mx-auto min-h-[44px]" 
                            data-action="click->clause-editor#addRootClause"
                            data-standard-version-id="<%= @version.id %>">
                        <%= image_tag asset_path('add-subclause-icon.svg'), class: "w-3 h-3 max-w-full h-auto" %>
                        <span><%= t('add_clause') %></span>
                    </button>
                </div>
            </div>
        <% else %>
            <div class="text-center py-12">
                <p class="text-sm sm:text-base text-gray-600"><%= t('no_clauses_found_version') %></p>
            </div>
        <% end %>
    </div>
</div>

<style>
    /* SortableJS drag & drop styles */
    /* The placeholder left in the source list while dragging — shows the
       user exactly where the item will land if they drop right now.
       Made visually loud so reorder targets are obvious. */
    .clause-hierarchy.sortable-ghost {
        opacity: 1 !important;
        background-color: #F6EEFF !important;
        border: 2px dashed #5C3984 !important;
        box-shadow: inset 0 0 0 2px #F6EEFF;
    }
    .clause-hierarchy.sortable-ghost > * {
        visibility: hidden;
    }

    .sortable-chosen {
        border: 2px solid #D9CAEF !important;
        background-color: #D9CAEF !important;
    }

    .sortable-chosen-checkpoint {
        border: 2px solid #D9CAEF !important;
        background-color: #D9CAEF !important;
    }

    /* The floating element that follows the cursor while dragging
       (used in forceFallback mode). */
    .sortable-drag {
        opacity: 0.85 !important;
        box-shadow: 0 8px 24px rgba(92, 57, 132, 0.25);
        transform: rotate(0.5deg);
    }

    /* Visual feedback for clause drop zones */
    [id^="clause_"]:not([id$="_checkpoints"]) {
        transition: background-color 0.2s, border-color 0.2s;
    }

    /* Highlight empty clause drop zones when dragging */
    .sortable-fallback ~ [id^="clause_"]:empty,
    [id^="clause_"]:empty:hover {
        min-height: 40px;
        border: 2px dashed #cbd5e1;
        border-radius: 0.5rem;
        background-color: #f8fafc;
    }

    /* Checkpoint drop zone styles */
    .checkpoint-drop-zone {
        transition: all 0.2s;
    }

    /* Hide empty checkpoint hint by default */
    .empty-checkpoint-hint {
        display: none;
    }

    /* Show hint when checkpoint is being dragged */
    body.dragging-checkpoint .empty-checkpoint-hint {
        display: block;
        border-color:#D9CAEF;
        background-color:#D9CAEF;
    }

    /* Highlight checkpoint drop zones when dragging */
    body.dragging-checkpoint .checkpoint-drop-zone:hover .empty-checkpoint-hint {
        border-color:#D9CAEF;
        background-color:#D9CAEF;
    }

    /* Hold-to-nest visual feedback */
    [data-children-container].nesting-hold-pending,
    #root-clauses-container.nesting-hold-pending {
        position: relative;
        outline: 2px dashed #D9CAEF;
        outline-offset: 4px;
        border-radius: 0.5rem;
        min-height: 32px;
        transition: outline-color 0.2s, background-color 0.2s;
    }

    [data-children-container].nesting-hold-pending::after,
    #root-clauses-container.nesting-hold-pending::after {
        content: attr(data-hold-label);
        position: absolute;
        top: -0.85rem;
        left: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: #5C3984;
        background: #F6EEFF;
        padding: 0 0.4rem;
        border-radius: 0.25rem;
        pointer-events: none;
        animation: nesting-pulse 1s ease-in-out infinite;
    }

    @keyframes nesting-pulse {
        0%, 100% { opacity: 0.7; }
        50% { opacity: 1; }
    }

    [data-children-container].nesting-hold-ready,
    #root-clauses-container.nesting-hold-ready {
        position: relative;
        outline: 2px solid #5C3984;
        outline-offset: 4px;
        border-radius: 0.5rem;
        background-color: #F6EEFF;
        min-height: 32px;
    }

    [data-children-container].nesting-hold-ready::after,
    #root-clauses-container.nesting-hold-ready::after {
        content: attr(data-ready-label);
        position: absolute;
        top: -0.85rem;
        left: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: #FFFFFF;
        background: #5C3984;
        padding: 0 0.4rem;
        border-radius: 0.25rem;
        pointer-events: none;
    }

    /* Make children containers easier to hit while a clause is being dragged.
       Without this, empty / short containers (especially when their only
       child has been lifted) are nearly invisible to SortableJS hit-testing
       when moving downward through the tree. */
    body.dragging-clause [data-children-container] {
        min-height: 48px;
        padding-top: 16px;
        padding-bottom: 24px;
    }

    body.dragging-clause #root-clauses-container {
        min-height: 80px;
        padding-top: 32px;
        padding-bottom: 48px;
    }

    /* The source container itself should NOT grow during drag — otherwise
       you have to mouse-travel past its padding/min-height before SortableJS
       lets you escape into the parent. Keep it tight so the cursor exits
       quickly when moving down past the dragged item. */
    body.dragging-clause [data-children-container].drag-source-container,
    body.dragging-clause #root-clauses-container.drag-source-container {
        min-height: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    /* The "Σ children" stats row sits at the bottom of every children
       container and adds ~50px of dead space that the cursor must traverse
       to escape the container while dragging. Hide it during a drag so the
       container's bottom edge sits right under the last clause — makes it
       trivial to drop "below" into the parent. */
    body.dragging-clause [data-children-stats] {
        display: none;
    }

    /* Free drop target — shown for any cross-container move that does NOT
       require a hold (un-nesting / same-depth re-parenting). Tells the user
       which container will receive the drop. */
    [data-children-container].drop-target-free,
    #root-clauses-container.drop-target-free {
        position: relative;
        outline: 2px solid #5C3984;
        outline-offset: 4px;
        border-radius: 0.5rem;
        background-color: #F6EEFF;
        min-height: 32px;
    }

    [data-children-container].drop-target-free::after,
    #root-clauses-container.drop-target-free::after {
        content: attr(data-drop-label);
        position: absolute;
        top: -0.85rem;
        left: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: #FFFFFF;
        background: #5C3984;
        padding: 0.05rem 0.45rem;
        border-radius: 0.25rem;
        pointer-events: none;
        z-index: 5;
        white-space: nowrap;
    }
</style>

<%= render 'publish_version_dialog' %>
<%= render 'shared/general_confirmation_modal' %>
