<% 
  # Determine the level based on the clause code
  level = clause['code'].count('.')
%>

<div
    class="clause-item level-<%= level %>">
    <!-- Drag Handle -->
    <div class="drag-handle">⋮</div>

    <!-- Clause Content -->
    <div class="clause-content">
        <div class="clause-code"><%= clause['code'] %></div>
        <div class="clause-title">
            <%= clause['title_en'] %>
        </div>
    </div>

    <!-- Action Buttons -->
    <div
        class="clause-actions">
        <!-- Edit Icon -->
        <div class="action-icon" title="Edit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
        </div>

        <!-- Delete Icon -->
        <div class="action-icon" title="Delete">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
            </svg>
        </div>

        <!-- Add Subclause Button -->
        <button class="action-button add-subclause" title="Add Subclause">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            Add Subclause
        </button>

        <!-- Add Checkpoint Button -->
        <button class="action-button add-checkpoint" title="Add Checkpoint">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            Add Checkpoint
        </button>

        <!-- Expanded/Collapsed Button -->
        <button class="action-button expanded" title="Expanded">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
            </svg>
            Expanded
        </button>
    </div>
</div>

<% if clause['checkpoints'] && clause['checkpoints'].any? %>
    <div class="checkpoints-section">
        <div class="checkpoints-label">Checkpoints:</div>
        <% clause['checkpoints'].each do |checkpoint| %>
            <div class="checkpoint-item">
                <div class="drag-handle">⋮</div>
                <div class="checkpoint-text">
                    <%= checkpoint['text_en'] %>
                </div>
            </div>
        <% end %>
    </div>
<% end %>
