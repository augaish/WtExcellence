<dialog id="new_standard_dialog" class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4" data-controller="modal dialog-no-backdrop-close">
    <div class="p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 sm:mb-6">
            <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('add_new_standard') %></h2>
            <button data-action="click->modal#close" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors duration-200" aria-label="<%= t('close') %>">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form class="space-y-6" data-action="submit->modal#submitForm">
            <div>
                <label for="standard_name" class="block text-sm font-medium text-gray-700 mb-2"><%= t('standard_name') %></label>
                <input type="text" id="standard_name" name="standard_name" placeholder="<%= t('enter_standard_name') %>" class="w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm" required>
            </div>

            <div>
                <span class="block text-sm font-medium text-gray-700 mb-2"><%= t('standard_type') %></span>
                <div class="space-y-2 mt-2">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="pipeline_type" value="efqm" class="w-4 h-4 text-[#5C3984] border-gray-300 focus:ring-[#5C3984]">
                        <span class="text-[16px] sm:text-sm text-gray-800"><%= t('standard_type_efqm') %></span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="pipeline_type" value="iso9001" class="w-4 h-4 text-[#5C3984] border-gray-300 focus:ring-[#5C3984]">
                        <span class="text-[16px] sm:text-sm text-gray-800"><%= t('standard_type_iso9001') %></span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="pipeline_type" value="qiyas" class="w-4 h-4 text-[#5C3984] border-gray-300 focus:ring-[#5C3984]">
                        <span class="text-[16px] sm:text-sm text-gray-800"><%= t('standard_type_qiyas') %></span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="pipeline_type" value="generic" class="w-4 h-4 text-[#5C3984] border-gray-300 focus:ring-[#5C3984]" checked>
                        <span class="text-[16px] sm:text-sm text-gray-800"><%= t('standard_type_generic') %></span>
                    </label>
                </div>
                <p class="text-xs text-gray-500 mt-1"><%= t('standard_type_hint') %></p>
            </div>

            <div>
                <label for="pdf_upload" class="block text-sm font-medium text-gray-700 mb-2"><%= t('upload_pdf') %></label>
                <div class="relative">
                    <input type="file" id="pdf_upload" name="pdf_upload" accept=".pdf,.xlsx" class="w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm <%= rtl? ? 'file:ml-4' : 'file:mr-4' %> file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[#F7F7FD] file:text-[#5C3984] hover:file:bg-[#E8E8F5]" required>
                </div>
                <p class="text-xs text-gray-500 mt-1"><%= t('only_pdf_allowed') %></p>
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center <%= rtl? ? 'sm:justify-start sm:flex-row-reverse' : 'sm:justify-end' %> gap-2 <%= rtl? ? 'sm:space-x-reverse sm:space-x-3' : 'sm:space-x-3' %> pt-4">
                <button type="button" data-action="click->modal#closeById" data-modal-dialog-param="new_standard_dialog" class="w-full sm:w-auto px-4 py-3 sm:py-2 min-h-[44px] text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200 text-[16px] sm:text-sm">
                    <%= t('cancel') %>
                </button>
                <button type="submit" class="w-full sm:w-auto px-6 py-3 sm:py-2 min-h-[44px] bg-[#5C3984] hover:bg-[#4A2F6B] text-white rounded-lg font-medium transition-colors duration-200 text-[16px] sm:text-sm flex items-center justify-center gap-2">
                    <svg data-submit-spinner class="hidden w-4 h-4 animate-spin flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span data-submit-button-text><%= t('add_standard') %></span>
                </button>
            </div>
        </form>
    </div>
</dialog>
