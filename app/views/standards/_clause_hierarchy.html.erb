<%
  # Initialize level if not provided
  level ||= clause.code.count('.')
  # Calculate padding based on level (24px per level, minimum 12px)
  base_padding = level > 0 ? level * 24 : 12
  # Generate unique ID for this clause
  clause_id = "clause_#{clause.id}_#{level}"
  # RTL-aware padding - use inline style for dynamic padding
  padding_style = rtl? ? "padding-right: #{base_padding}px;" : "padding-left: #{base_padding}px;"
%>
<div class="clause-hierarchy mt-8 sm:mt-12 transition-shadow rounded-lg" style="<%= padding_style %>" id="clause-<%= clause.id %>" data-clause-id="<%= clause_id %>" data-clause-button-id="<%= clause.id %>">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3">
        <!-- Left side: Clause info and badges -->
        <div class="flex-1 min-w-0">
            <!-- Clause Title -->
            <div class="mb-2 flex flex-wrap items-center gap-2">
                <% if level == 0 %>
                    <span class="font-bold text-[#0D1120] text-sm sm:text-base break-words leading-snug"><%= clause.code %>
                        <%= clause.title(I18n.locale.to_s) %></span>
                <% else %>
                    <span class="font-semibold text-[#0D1120] text-sm sm:text-base break-words leading-snug"><%= clause.code %>
                        <%= clause.title(I18n.locale.to_s) %></span>
                <% end %>
                <% if clause.leaf? && defined?(current_company) && current_company.present? && !current_user&.super_admin? && !current_user&.delegated_admin? %>
                    <% title_tool = clause.tool %>
                    <% if title_tool %>
                        <% title_tool_clause = ToolClause.find_by(clause_id: clause.id, tool_id: title_tool.id) %>
                        <% if title_tool_clause %>
                            <% title_assessment = Assessment.find_by(tool_clause_id: title_tool_clause.id, company_id: current_company.id) %>
                            <%= render "assessments/status_badge", status: title_assessment&.status || "not_started" %>
                        <% end %>
                    <% end %>
                <% end %>
            </div>
            
            <!-- Show Evaluation Progress and Compliance (if tool is linked and user is not super admin or delegated admin) -->
            <%
              linked_tool = clause.primary_tool
              score_data = nil
              if defined?(current_company) && current_company.present? && !current_user&.super_admin? && !current_user&.delegated_admin? && linked_tool.present?
                score_data = clause.calculate_score(linked_tool, current_company)
              end
            %>
            
            <!-- Tool Switcher Section (only for root clauses and users with manage_tools permission) -->
            <% if level == 0 && current_user&.can_manage_tools? %>
              <div class="flex flex-wrap items-center gap-2 mt-3 mb-3">
                <!-- Current Tool Badge -->
                <% if linked_tool.present? %>
                  <div class="flex items-center gap-1 px-2 py-1 bg-blue-50 border border-blue-300 rounded">
                    <svg class="w-3 h-3 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z"/>
                    </svg>
                    <span class="text-xs font-medium text-blue-600">Tool: <%= linked_tool.name %></span>
                  </div>
                <% end %>
                
                <!-- Link/Switch Tool Button -->
                <button type="button" 
                        data-controller="basic-modal"
                        data-basic-modal-dialog-value="tool-switcher-modal-<%= clause.id %>"
                        data-action="click->basic-modal#open"
                        class="flex items-center gap-1 px-3 py-2 min-h-[44px] text-xs sm:text-[11px] font-medium text-[#5C3984] bg-white border border-[#5C3984] rounded hover:bg-[#F6EEFF] transition-colors">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                  </svg>
                  <%= linked_tool.present? ? 'Switch Tool' : 'Link Tool' %>
                </button>
                
                <!-- Unlink Button (if linked) -->
                <% if linked_tool.present? %>
                  <button type="button"
                          data-controller="basic-modal"
                          data-basic-modal-dialog-value="unlink-tool-modal-<%= clause.id %>"
                          data-action="click->basic-modal#open"
                          class="flex items-center gap-1 px-3 py-2 min-h-[44px] text-xs sm:text-[11px] font-medium text-red-600 bg-white border border-red-300 rounded hover:bg-red-50 transition-colors">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Unlink
                  </button>
                <% end %>
              </div>
            <% end %>
            <% if score_data.present? %>
                <% 
                  evaluated_count = score_data[:evaluated_count].to_i
                  total_count = score_data[:total_count].to_i
                  percentage = score_data[:percentage].to_f
                  allocated_points = score_data[:allocated_points].to_f
                  scored_points = score_data[:score].to_f
                  all_evaluated = evaluated_count == total_count && total_count > 0
                  
                  # Check if business rules are violated
                  # Check cache for violation message
                  business_rule_violated = false
                  business_rule_violation_message = nil
                  if clause.leaf? && all_evaluated && linked_tool.present? && current_company.present?
                    cache = ClauseScoreCache.find_by(clause_id: clause.id, company_id: current_company.id)
                    if cache&.cached? && cache.business_rule_violation.present?
                      # Cache exists with violation message
                      business_rule_violated = true
                      business_rule_violation_message = cache.business_rule_violation
                    elsif !cache&.cached?
                      # All evaluated but no cache - check if business rules are violated
                      tool_clause = ToolClause.find_by(clause_id: clause.id, tool_id: linked_tool.id)
                      if tool_clause
                        calculator = ClauseScoreCalculator.new(tool_clause)
                        result = calculator.calculate_score(current_company)
                        validator = BusinessRuleValidator.new(linked_tool, clause, result, current_company)
                        violation_message = validator.violation_message
                        if violation_message.present?
                          business_rule_violated = true
                          business_rule_violation_message = violation_message
                        end
                      end
                    end
                  end
                %>
                
            <!-- Badges Section - Wraps on smaller screens -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3 mt-3">
                <!-- Show Scored Points (hidden from super admins and delegated admins) -->
                <% if allocated_points > 0 && !current_user&.super_admin? && !current_user&.delegated_admin? %>
                    <div class="flex items-center gap-1 px-2 py-1 bg-[#F6EEFF] border border-[#5C3984] rounded">
                        <span class="text-xs text-[#5C3984] font-medium">Scored:</span>
                        <span class="text-xs font-bold text-[#5C3984]"><%= scored_points.round(2) %></span>
                        <span class="text-xs text-[#5C3984]">/</span>
                        <span class="text-xs font-bold text-[#5C3984]"><%= allocated_points.round(2) %> pts</span>
                    </div>
                <% end %>
                
                <% if total_count > 0 %>
                        <!-- Business Rule Violation Warning -->
                        <% if business_rule_violated %>
                            <div class="relative group">
                                <span class="px-2 py-1 text-xs font-medium text-red-700 bg-red-50 border border-red-300 rounded flex items-center gap-1 cursor-help">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                    </svg>
                                    Business Rule Violated
                                </span>
                                <% if business_rule_violation_message.present? %>
                                    <div class="hidden group-hover:block absolute z-20 bottom-full left-0 mb-2 w-80 bg-white border-2 border-red-300 rounded-lg shadow-lg p-3">
                                        <div class="text-xs font-semibold text-red-700 mb-1">Rule Violation:</div>
                                        <div class="text-xs text-gray-700"><%= business_rule_violation_message %></div>
                                    </div>
                                <% end %>
                            </div>
                        <% end %>
                        
                        <!-- Evaluation Progress -->
                        <% if all_evaluated %>
                            <div class="flex items-center gap-1 px-2 py-1 bg-[#F6EEFF] border border-[#5C3984] rounded">
                                <svg class="w-4 h-4 text-[#5C3984]" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-xs font-medium text-[#5C3984]">✓ <%= evaluated_count %>/<%= total_count %> evaluated</span>
                            </div>
                        <% else %>
                            <div class="flex items-center gap-1 px-2 py-1 bg-[#F6EEFF] border border-[#5C3984] rounded">
                                <svg class="w-4 h-4 text-[#5C3984]" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-xs font-medium text-[#5C3984]"><%= evaluated_count %>/<%= total_count %> evaluated</span>
                            </div>
                        <% end %>
                        
                        <!-- Total Score (hidden from super admins and delegated admins) -->
                        <% if all_evaluated && !current_user&.super_admin? && !current_user&.delegated_admin? %>
                            <div class="relative">
                                <div class="flex items-center gap-1 px-2 py-1 bg-[#F6EEFF] border border-[#5C3984] rounded">
                                    <svg class="w-4 h-4 text-[#5C3984]" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                    <span class="text-xs font-bold text-[#5C3984]">Total Score: <%= percentage.round(2) %>%</span>
                                    <button type="button" 
                                            class="text-[#5C3984] hover:text-[#4A2F6B] focus:outline-none"
                                            onclick="toggleScoreDetails(event, 'score-details-<%= clause.id %>')">
                                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </div>
                                
                                <!-- Score Details Dropdown -->
                                <div id="score-details-<%= clause.id %>" 
                                     class="hidden absolute z-10 mt-2 w-80 bg-white border-2 border-[#5C3984] rounded-lg shadow-lg p-4"
                                     style="left: 0;">
                                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-[#5C3984]">
                                        <h4 class="text-sm font-bold text-[#5C3984]">Attribute Scores</h4>
                                        <button type="button" 
                                                onclick="toggleScoreDetails(event, 'score-details-<%= clause.id %>')"
                                                class="text-[#5C3984] hover:text-[#4A2F6B]">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="space-y-2 max-h-64 overflow-y-auto">
                                        <% 
                                          # Get detailed scores for each subcheckpoint
                                          tool_clause = if clause.leaf?
                                            ToolClause.where(clause_id: clause.id, tool_id: linked_tool.id).first
                                          else
                                            # For parent clauses, get all terminal descendants
                                            terminal_clauses = clause.self_and_descendants.where("NOT EXISTS (SELECT 1 FROM clauses AS children WHERE children.parent_id = clauses.id)")
                                            ToolClause.where(clause_id: terminal_clauses.pluck(:id), tool_id: linked_tool.id)
                                          end
                                          
                                          if tool_clause.is_a?(ActiveRecord::Relation)
                                            # Parent clause - show aggregated view
                                            tool_clause.each do |tc|
                                              assessment = current_company ? Assessment.find_by(tool_clause_id: tc.id, company_id: current_company.id, status: "approved") : nil
                                              next unless assessment
                                              assessment.assessment_scores.includes(:tool_subcheckpoint).where.not(percentage_score: nil).each do |score_rec|
                                        %>
                                                <div class="flex items-center justify-between py-2 px-2 bg-[#F6EEFF] rounded">
                                                    <span class="text-xs text-[#5C3984] font-medium"><%= tc.clause.code %> - <%= score_rec.tool_subcheckpoint.name %></span>
                                                    <span class="text-xs font-bold text-[#5C3984]"><%= score_rec.percentage_score.round(1) %>%</span>
                                                </div>
                                        <%
                                              end
                                            end
                                          elsif tool_clause
                                            # Terminal clause - show its scores
                                            assessment = current_company ? Assessment.find_by(tool_clause_id: tool_clause.id, company_id: current_company.id, status: "approved") : nil
                                            if assessment
                                              assessment.assessment_scores.includes(:tool_subcheckpoint).where.not(percentage_score: nil).each do |score_rec|
                                        %>
                                              <div class="flex items-center justify-between py-2 px-2 bg-[#F6EEFF] rounded">
                                                  <span class="text-xs text-[#5C3984] font-medium"><%= score_rec.tool_subcheckpoint.name %></span>
                                                  <span class="text-xs font-bold text-[#5C3984]"><%= score_rec.percentage_score.round(1) %>%</span>
                                              </div>
                                        <%
                                              end
                                            end
                                          end
                                        %>
                                    </div>
                                    <div class="mt-3 pt-2 border-t border-[#5C3984]">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs font-bold text-[#5C3984]">Average:</span>
                                            <span class="text-xs font-bold text-[#5C3984]"><%= percentage.round(2) %>%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                <% end %>
            </div>
            <% end %>
        </div>
        
        <!-- Right side: Assessment button + Expand/Collapse -->
        <div class="flex items-center gap-2 flex-shrink-0 mt-3 sm:mt-0 sm:ms-4">
          <% if clause.leaf? && clause.tool && !(current_user&.super_admin? || current_user&.delegated_admin?) %>
            <%= link_to clause_assessment_path(clause),
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white bg-[#5C3984] hover:bg-[#4A2F6B] rounded-md transition-colors",
                  data: { turbo: false } do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
              <%= t('open_assessment') %>
            <% end %>
          <% end %>
          <% has_children = clause.children.exists? %>
          <% has_checkpoints = clause.checklist_items.any? %>
          <% if has_children || has_checkpoints %>
              <% initial_state = has_children ? "collapsed" : "expanded" %>
              <% initial_label = has_children ? t('collapsed') : t('expanded') %>
              <% initial_rotation = has_children ? "rotate(180deg)" : "rotate(0deg)" %>
              <button class="inline-flex items-center justify-center px-3 py-1.5 rounded-md border border-[#5C3984] text-[#5C3984] text-xs transition-all duration-200 hover:bg-[#F6EEFF] hover:border-[#4A2F6B] whitespace-nowrap" data-action="click->clause-tree#toggle" data-clause-tree-clause-id-param="<%= clause_id %>" data-state="<%= initial_state %>" id="toggle-button-<%= clause.id %>">
                  <svg class="w-3.5 h-3.5 <%= rtl? ? 'ml-1.5' : 'mr-1.5' %> expand-icon transition-transform duration-200" fill="none" stroke="currentColor" viewbox="0 0 24 24" style="transform: <%= initial_rotation %>;">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                  </svg>
                  <span class="text-xs font-medium button-text"><%= initial_label %></span>
              </button>
          <% end %>
        </div>
    </div>

    <!-- Checkpoints displayed directly below the clause -->
    <% if clause.checklist_items.any? %>
        <% checkpoint_id = "#{clause_id}_checkpoints" %>
        <% checkpoint_padding = rtl? ? "padding-right: #{base_padding + 24}px;" : "padding-left: #{base_padding + 24}px;" %>
        <div class="children-container mt-3" style="<%= checkpoint_padding %>" id="<%= checkpoint_id %>">
            <div class="flex flex-col sm:flex-row gap-2 sm:gap-4">
                <div class="text-sm text-[#5C3984] font-medium"><%= t('checkpoints') %>:</div>
                <div class="space-y-1 flex-1">
                    <% clause.checklist_items.ordered.each do |checkpoint| %>
                        <div class="text-sm text-[#0D1120]">
                            <%= checkpoint.text(I18n.locale.to_s) %>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
    <% end %>

    <!-- Children (sub-clauses) — loaded lazily on first expand -->
    <% if clause.children.exists? %>
        <div class="children-container collapsed"
             id="<%= clause_id %>"
             data-lazy-src="<%= clause_children_path(clause) %>">
            <!-- Children fetched by clause-tree controller on first expand -->
        </div>
    <% end %>
</div>

<% if level == 0 && current_user&.can_manage_tools? %>
  <!-- Tool Switcher Modal -->
  <dialog id="tool-switcher-modal-<%= clause.id %>" 
          class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4"
          data-controller="basic-modal dialog-no-backdrop-close"
          data-basic-modal-dialog-value="tool-switcher-modal-<%= clause.id %>">
    <div class="p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-[#0D1120]">
          <%= linked_tool.present? ? 'Switch' : 'Link' %> Tool for <%= clause.code %>
        </h3>
        <button type="button"
                data-controller="basic-modal"
                data-basic-modal-dialog-value="tool-switcher-modal-<%= clause.id %>"
                data-action="click->basic-modal#close"
                class="text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      
      <form id="tool-switcher-form-<%= clause.id %>" onsubmit="handleToolSwitch(event, '<%= clause.id %>')">
        <!-- Tool Selection -->
        <div class="mb-4" data-controller="choices-select" data-choices-select-search-value="true">
          <label class="block text-sm font-medium text-gray-700 mb-2">Select Tool</label>
          <select name="tool_id" required
                  data-choices-select-target="select"
                  class="w-full">
            <option value="">-- Select a tool --</option>
            <% Tool.all.order(:name).each do |tool| %>
              <option value="<%= tool.id %>" <%= 'selected' if tool.id == linked_tool&.id %>>
                <%= tool.name_in(I18n.locale.to_s) %>
              </option>
            <% end %>
          </select>
        </div>
        
        <!-- Warning if switching -->
        <% if linked_tool.present? %>
          <div class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded">
            <p class="text-sm text-yellow-800">
              <strong>Warning:</strong> Switching tools will unlink this clause from 
              "<%= linked_tool.name %>" and link it to the new tool.
            </p>
          </div>
        <% end %>
        
        <!-- Actions -->
        <div class="flex justify-end gap-2 mt-4">
          <button type="button"
                  data-controller="basic-modal"
                  data-basic-modal-dialog-value="tool-switcher-modal-<%= clause.id %>"
                  data-action="click->basic-modal#close"
                  class="px-4 py-2 min-h-[44px] text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">
            Cancel
          </button>
          <button type="submit"
                  class="px-4 py-2 min-h-[44px] text-sm font-medium text-white bg-[#5C3984] rounded hover:bg-[#4A2F6B]">
            <%= linked_tool.present? ? 'Switch' : 'Link' %> Tool
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Unlink Tool Confirmation Modal -->
  <% if linked_tool.present? %>
    <dialog id="unlink-tool-modal-<%= clause.id %>" 
            class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4"
            data-controller="basic-modal dialog-no-backdrop-close"
            data-basic-modal-dialog-value="unlink-tool-modal-<%= clause.id %>">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-[#0D1120]">
            Unlink Tool
          </h3>
          <button type="button"
                  data-controller="basic-modal"
                  data-basic-modal-dialog-value="unlink-tool-modal-<%= clause.id %>"
                  data-action="click->basic-modal#close"
                  class="text-gray-400 hover:text-gray-600 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        
        <div class="mb-6">
          <p class="text-sm text-[#797C81] mb-3">
            Are you sure you want to unlink the tool "<%= linked_tool.name %>" from clause <%= clause.code %>?
          </p>
          <div class="p-3 bg-yellow-50 border border-yellow-200 rounded">
            <p class="text-sm text-yellow-800">
              <strong>Warning:</strong> This will remove the link for all child clauses under this root clause.
            </p>
          </div>
        </div>
        
        <div class="flex justify-end gap-2 mt-4">
          <button type="button"
                  data-controller="basic-modal"
                  data-basic-modal-dialog-value="unlink-tool-modal-<%= clause.id %>"
                  data-action="click->basic-modal#close"
                  class="px-4 py-2 min-h-[44px] text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">
            Cancel
          </button>
          <button type="button"
                  onclick="unlinkClauseTool('<%= clause.id %>', '<%= linked_tool.id %>', 'unlink-tool-modal-<%= clause.id %>')"
                  class="px-4 py-2 min-h-[44px] text-sm font-medium text-white bg-red-600 rounded hover:bg-red-700">
            Unlink Tool
          </button>
        </div>
      </div>
    </dialog>
  <% end %>
<% end %>

<% if level == 0 %>
  <script>
    function toggleScoreDetails(event, detailsId) {
      event.stopPropagation();
      const detailsDiv = document.getElementById(detailsId);
      
      if (!detailsDiv) return;
      
      // Close all other open details
      document.querySelectorAll('[id^="score-details-"]').forEach(div => {
        if (div.id !== detailsId) {
          div.classList.add('hidden');
        }
      });
      
      // Toggle this one
      detailsDiv.classList.toggle('hidden');
      
      // Close when clicking outside
      if (!detailsDiv.classList.contains('hidden')) {
        setTimeout(() => {
          const closeOnClickOutside = (e) => {
            if (!detailsDiv.contains(e.target) && !e.target.closest(`[onclick*="${detailsId}"]`)) {
              detailsDiv.classList.add('hidden');
              document.removeEventListener('click', closeOnClickOutside);
            }
          };
          document.addEventListener('click', closeOnClickOutside);
        }, 100);
      }
    }
    
    <% if current_user&.can_manage_tools? %>
    // Helper function to dispatch toast notifications
    if (typeof window.dispatchToolSwitcherToast === 'undefined') {
      window.dispatchToolSwitcherToast = function(message, type = 'success') {
        const bgColor = type === 'success' 
          ? 'bg-[#FFFFFF] border-[#E3E3E3] border-l-4 border-l-[#5C3984]'
          : 'bg-[#FFFFFF] border-[#E3E3E3] border-l-4 border-l-red-500';
        
        const icon = type === 'success'
          ? '<svg class="w-5 h-5 text-[#5C3984]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>'
          : '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';

        const notificationHtml = `
          <div 
            data-toast-target="notification"
            class="${bgColor} rounded-lg shadow-lg p-4 flex items-start gap-3 transform opacity-0 translate-x-full transition ease-out duration-300"
          >
            ${icon}
            <div class="flex-1 text-sm text-[#0D1120] font-medium">
              ${message}
            </div>
            <button 
              data-action="click->toast#close"
              class="text-gray-400 hover:text-gray-600 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        `;

        const event = new CustomEvent('toast:show', {
          detail: { notificationHtml },
          bubbles: true
        });
        document.dispatchEvent(event);
      };
    }

    // Define tool switcher functions only once (idempotent)
    if (typeof window.handleToolSwitch === 'undefined') {
      window.handleToolSwitch = async function(event, clauseId) {
        event.preventDefault();

        const form = event.target;
        const formData = new FormData(form);
        const toolId = formData.get('tool_id');

        if (!toolId) {
          window.dispatchToolSwitcherToast('Please select a tool', 'error');
          return;
        }

        // Show loading state
        const submitButton = form.querySelector('button[type="submit"]');
        const originalText = submitButton.textContent;
        submitButton.disabled = true;
        submitButton.textContent = 'Processing...';

        try {
          const response = await fetch('/tools/switch_clause_tool', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({
              clause_id: clauseId,
              tool_id: toolId
            })
          });
          
          const result = await response.json();
          
          if (result.success) {
            // Show success message
            window.dispatchToolSwitcherToast(result.message || 'Tool switched successfully', 'success');
            // Reload page to show updated state
            setTimeout(() => {
              window.location.reload();
            }, 500);
          } else {
            window.dispatchToolSwitcherToast(result.error || 'Failed to switch tool', 'error');
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        } catch (error) {
          console.error('Error switching tool:', error);
          window.dispatchToolSwitcherToast('An error occurred while switching the tool', 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalText;
        }
      };

      window.unlinkClauseTool = async function(clauseId, toolId, modalId) {
        // Close the modal if provided
        if (modalId) {
          const modal = document.getElementById(modalId);
          if (modal) {
            modal.close();
          }
        }
        
        try {
          const response = await fetch('/tools/unlink_clause_tool', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({
              clause_id: clauseId,
              tool_id: toolId
            })
          });
          
          const result = await response.json();
          
          if (result.success) {
            window.dispatchToolSwitcherToast(result.message || 'Tool unlinked successfully', 'success');
            setTimeout(() => {
              window.location.reload();
            }, 500);
          } else {
            window.dispatchToolSwitcherToast(result.error || 'Failed to unlink tool', 'error');
          }
        } catch (error) {
          console.error('Error unlinking tool:', error);
          window.dispatchToolSwitcherToast('An error occurred while unlinking the tool', 'error');
        }
      };
    }
    <% end %>
  </script>
<% end %>
