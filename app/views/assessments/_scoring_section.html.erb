<%# Scoring section: grouped by ToolCheckpoint, with sliders/inputs per ToolSubcheckpoint %>
<%
  weights = @tool.effective_weights
  cap_ids = @tool.cap_subcheckpoint_ids
  weights_json = weights.transform_keys(&:to_s).to_json
  caps_json = cap_ids.map(&:to_s).to_json
%>

<div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden mb-6"
     data-controller="scoring-calculator"
     data-scoring-calculator-weights-value="<%= weights_json %>"
     data-scoring-calculator-caps-value="<%= caps_json %>">
  <div class="p-4 sm:p-5 border-b border-[#E3E3E3] bg-[#F7F7FD]">
    <h2 class="text-base sm:text-lg font-semibold text-[#0D1120]"><%= t("assessments.scoring") %></h2>
    <p class="text-xs text-[#797C81] mt-1"><%= t("assessments.scoring_help") %></p>
  </div>

  <div class="p-4 sm:p-6">
    <% checkpoints.each do |cp| %>
      <% subs = cp.subcheckpoints.sort_by { |s| s.display_order || 0 } %>
      <% next if subs.empty? %>

      <div class="mb-6">
        <%# Group header %>
        <h3 class="text-xs font-bold text-[#5C3984] uppercase tracking-widest mb-4 flex items-center gap-2">
          <div class="w-1 h-4 bg-[#5C3984] rounded-full"></div>
          <%= cp.name_in %>
        </h3>

        <%# Scoring rows %>
        <% subs.each do |sub| %>
          <% score_record = assessment_scores[sub.id] %>
          <% current_value = if sub.scoring_type == "Number"
               score_record&.score&.to_f&.round(0) || 0
             else
               score_record&.percentage_score&.to_f&.round(0) || 0
             end %>
          <% is_cap = cap_ids.include?(sub.id) %>

          <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-4 p-3 bg-gray-50 rounded-lg">
            <%# Attribute name + tooltip + cap badge %>
            <div class="flex items-center gap-2 sm:w-48 shrink-0">
              <span class="text-sm font-medium text-[#0D1120]"><%= sub.name_in %></span>
              <% if sub.description_in.present? %>
                <span class="relative group" tabindex="0">
                  <svg class="w-4 h-4 text-gray-400 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                  </svg>
                  <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg whitespace-normal w-48 text-center opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity pointer-events-none z-10">
                    <%= sub.description_in %>
                  </span>
                </span>
              <% end %>
              <% if is_cap %>
                <span class="text-xs text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded font-medium">CAP</span>
              <% end %>
            </div>

            <%# Scoring input %>
            <div class="flex-1">
              <% if sub.scoring_type == "Percentage" || sub.scoring_type.blank? %>
                <div class="flex items-center gap-3">
                  <input type="range"
                         name="assessment[scores][<%= sub.id %>]"
                         min="<%= sub.min_score || 0 %>"
                         max="<%= sub.max_score || 100 %>"
                         step="10"
                         value="<%= current_value %>"
                         class="flex-1 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[#5C3984]"
                         data-scoring-calculator-target="attributeInput"
                         data-subcheckpoint-id="<%= sub.id %>"
                         data-attribute-name="<%= sub.name_in %>"
                         data-action="input->scoring-calculator#recalculate"
                         aria-label="<%= sub.name_in %>"
                         aria-valuemin="<%= sub.min_score || 0 %>"
                         aria-valuemax="<%= sub.max_score || 100 %>"
                         aria-valuenow="<%= current_value %>"
                         <% if readonly %>disabled<% end %>>
                  <div class="w-14 px-2 py-1 bg-white border border-gray-300 rounded text-sm text-center font-semibold text-[#5C3984]"
                       data-scoring-calculator-target="valueDisplay"
                       data-subcheckpoint-id="<%= sub.id %>">
                    <%= current_value %>%
                  </div>
                </div>
              <% elsif sub.scoring_type == "Number" %>
                <%
                  num_min = sub.min_score || 0
                  num_max = sub.max_score || 100
                  num_raw = score_record&.score&.to_f || num_min.to_f
                %>
                <div class="flex items-center gap-3">
                  <input type="number"
                         name="assessment[scores][<%= sub.id %>]"
                         min="<%= num_min %>"
                         max="<%= num_max %>"
                         value="<%= num_raw.round(0) %>"
                         step="1"
                         class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent"
                         data-scoring-calculator-target="attributeInput"
                         data-subcheckpoint-id="<%= sub.id %>"
                         data-attribute-name="<%= sub.name_in %>"
                         data-scoring-type="Number"
                         data-action="input->scoring-calculator#recalculate"
                         <% if readonly %>disabled<% end %>>
                  <span class="text-xs text-[#797C81] shrink-0">/ <%= num_max.to_i %></span>
                </div>
              <% elsif sub.scoring_type == "Multiple Choice" %>
                <% options = sub.multiple_choice_options_in %>
                <% if options.present? %>
                  <div class="flex flex-wrap gap-3">
                    <% options.each do |opt| %>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="radio"
                               name="assessment[scores][<%= sub.id %>]"
                               value="<%= opt['weight'] || 0 %>"
                               class="text-[#5C3984] focus:ring-[#5C3984]"
                               data-scoring-calculator-target="attributeInput"
                               data-subcheckpoint-id="<%= sub.id %>"
                               data-attribute-name="<%= sub.name_in %>"
                               data-action="change->scoring-calculator#recalculate"
                               <%= "checked" if score_record&.percentage_score&.to_f&.round(0) == (opt['weight'] || 0).to_i %>
                               <% if readonly %>disabled<% end %>>
                        <span class="text-sm text-[#0D1120]"><%= opt['text'] %></span>
                      </label>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ===== Overall Score Bar ===== %>
    <div class="border-t-2 border-[#E3E3E3] pt-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 p-4 px-6 bg-[#F7F7FD] rounded-xl border border-[#E3E3E3]">
        <div class="flex items-center gap-2 sm:w-48 shrink-0">
          <span class="text-sm font-bold text-[#0D1120]"><%= t("assessments.overall") %></span>
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-3">
            <div class="flex-1 bg-gray-200 rounded-full h-3 overflow-hidden">
              <div class="bg-[#5C3984] h-3 rounded-full transition-all duration-500"
                   data-scoring-calculator-target="overallBar"
                   style="width: <%= overall_score ? overall_score[:percentage] : 0 %>%"></div>
            </div>
            <div class="w-18 min-w-[4.5rem] px-2 py-1 bg-[#5C3984] rounded text-sm text-center font-bold text-white shrink-0"
                 data-scoring-calculator-target="overallValue">
              <%= overall_score ? overall_score[:percentage] : 0 %>%
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <p class="text-xs text-[#797C81]" data-scoring-calculator-target="formulaText">
          <% if overall_score && overall_score[:cap_applied] %>
            <%= t("assessments.formula_capped",
                  weighted_sum: overall_score[:weighted_sum],
                  cap_attr: overall_score[:cap_attribute],
                  cap_val: overall_score[:cap_value],
                  overall: overall_score[:percentage]) %>
          <% elsif overall_score %>
            <%= t("assessments.formula_simple", weighted_sum: overall_score[:weighted_sum], overall: overall_score[:percentage]) %>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</div>
