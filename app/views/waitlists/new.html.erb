<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <div class="w-full max-w-lg">
    <nav class="flex items-center justify-between mb-6 text-sm" aria-label="<%= rtl? ? 'التنقل' : 'Navigation' %>">
      <a href="<%= root_path %>" class="text-[#5C3984] hover:underline"><%= rtl? ? '← العودة إلى الصفحة الرئيسية' : '← Back to homepage' %></a>
      <% if rtl? %>
        <a href="<%= switch_language_path(:en) %>" lang="en" class="text-[#797C81] hover:text-[#0D1120]">English</a>
      <% else %>
        <a href="<%= switch_language_path(:ar) %>" lang="ar" class="text-[#797C81] hover:text-[#0D1120]">العربية</a>
      <% end %>
    </nav>
    <!-- Logo and Heading -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-6">
        <%= image_tag asset_path('logo.png'), alt: (rtl? ? 'Way To Excellence' : 'Way To Excellence'), class: "h-16 w-auto rounded-full" %>
      </div>
      <h2 class="text-2xl font-semibold text-[#0D1120] mb-2"><%= rtl? ? 'اطلب عرضًا توضيحيًا' : 'Request a demo' %></h2>
      <p class="text-sm text-gray-600"><%= rtl? ? 'أخبرنا عن مؤسستك وسنتواصل معك خلال يومي عمل لتحديد موعد عرض توضيحي يناسبك.' : 'Tell us about your organisation and we will get back to you within two working days to set up a demo.' %></p>
    </div>

    <!-- Card Container -->
    <div class="bg-[#FFFFFF] border border-[#E3E3E3] rounded-lg shadow-lg p-8">
      <%= form_with url: waitlist_path, method: :post, html: { class: "space-y-6" }, local: true do |f| %>
        
        <!-- Error Messages -->
        <% if flash[:alert] %>
          <div class="bg-red-50 <%= rtl? ? 'border-r-4 border-r-red-500' : 'border-l-4 border-l-red-500' %> border border-red-200 rounded-lg p-4 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
              <p class="text-sm text-red-800 font-medium text-<%= rtl? ? 'right' : 'left' %>"><%= flash[:alert] %></p>
            </div>
          </div>
        <% end %>

        <!-- Full Name Field -->
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2 text-<%= rtl? ? 'right' : 'left' %>">
            <%= rtl? ? 'الاسم الكامل' : 'Full name' %> <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 <%= rtl? ? 'right-0 pr-3' : 'left-0 pl-3' %> flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              value="<%= params[:name] %>"
              class="w-full <%= rtl? ? 'pr-10 pl-4' : 'pl-10 pr-4' %> py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2 transition-colors duration-200"
              placeholder="<%= rtl? ? 'محمد أحمد' : 'John Doe' %>" />
          </div>
        </div>

        <!-- Work Email Field -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-2 text-<%= rtl? ? 'right' : 'left' %>">
            <%= rtl? ? 'البريد الإلكتروني للعمل' : 'Work email' %> <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 <%= rtl? ? 'right-0 pr-3' : 'left-0 pl-3' %> flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              value="<%= params[:email] %>"
              class="w-full <%= rtl? ? 'pr-10 pl-4' : 'pl-10 pr-4' %> py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2 transition-colors duration-200"
              placeholder="<%= rtl? ? 'you@company.com' : 'you@company.com' %>" />
          </div>
        </div>

        <!-- Company Name Field -->
        <div>
          <label for="company_name" class="block text-sm font-medium text-gray-700 mb-2 text-<%= rtl? ? 'right' : 'left' %>">
            <%= rtl? ? 'اسم الشركة' : 'Company name' %> <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 <%= rtl? ? 'right-0 pr-3' : 'left-0 pl-3' %> flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <input 
              type="text" 
              id="company_name" 
              name="company_name" 
              required
              value="<%= params[:company_name] %>"
              class="w-full <%= rtl? ? 'pr-10 pl-4' : 'pl-10 pr-4' %> py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2 transition-colors duration-200"
              placeholder="<%= rtl? ? 'شركة التقنية' : 'Acme Inc.' %>" />
          </div>
        </div>

        <!-- Company Size Field -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3 text-<%= rtl? ? 'right' : 'left' %>">
            <%= rtl? ? 'حجم الشركة' : 'Company Size' %> <span class="text-red-500">*</span>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center justify-center px-4 py-3 border border-gray-300 rounded-lg cursor-pointer hover:border-[#5C3984] transition-colors duration-200 has-[:checked]:border-[#5C3984] has-[:checked]:bg-purple-50">
              <input 
                type="radio" 
                name="company_size" 
                value="1-10" 
                required
                <%= 'checked' if params[:company_size] == '1-10' %>
                class="w-4 h-4 text-[#5C3984] focus:ring-[#5C3984] border-gray-300" />
              <span class="<%= rtl? ? 'mr-2' : 'ml-2' %> text-sm font-medium text-gray-700" dir="ltr">1–10</span>
            </label>
            
            <label class="flex items-center justify-center px-4 py-3 border border-gray-300 rounded-lg cursor-pointer hover:border-[#5C3984] transition-colors duration-200 has-[:checked]:border-[#5C3984] has-[:checked]:bg-purple-50">
              <input 
                type="radio" 
                name="company_size" 
                value="11-50" 
                required
                <%= 'checked' if params[:company_size] == '11-50' %>
                class="w-4 h-4 text-[#5C3984] focus:ring-[#5C3984] border-gray-300" />
              <span class="<%= rtl? ? 'mr-2' : 'ml-2' %> text-sm font-medium text-gray-700" dir="ltr">11–50</span>
            </label>
            
            <label class="flex items-center justify-center px-4 py-3 border border-gray-300 rounded-lg cursor-pointer hover:border-[#5C3984] transition-colors duration-200 has-[:checked]:border-[#5C3984] has-[:checked]:bg-purple-50">
              <input 
                type="radio" 
                name="company_size" 
                value="51-200" 
                required
                <%= 'checked' if params[:company_size] == '51-200' %>
                class="w-4 h-4 text-[#5C3984] focus:ring-[#5C3984] border-gray-300" />
              <span class="<%= rtl? ? 'mr-2' : 'ml-2' %> text-sm font-medium text-gray-700" dir="ltr">51–200</span>
            </label>
            
            <label class="flex items-center justify-center px-4 py-3 border border-gray-300 rounded-lg cursor-pointer hover:border-[#5C3984] transition-colors duration-200 has-[:checked]:border-[#5C3984] has-[:checked]:bg-purple-50">
              <input 
                type="radio" 
                name="company_size" 
                value="200+" 
                required
                <%= 'checked' if params[:company_size] == '200+' %>
                class="w-4 h-4 text-[#5C3984] focus:ring-[#5C3984] border-gray-300" />
              <span class="<%= rtl? ? 'mr-2' : 'ml-2' %> text-sm font-medium text-gray-700" dir="ltr">200+</span>
            </label>
          </div>
        </div>

        <!-- Role Field -->
        <div>
          <label for="role" class="block text-sm font-medium text-gray-700 mb-2 text-<%= rtl? ? 'right' : 'left' %>">
            <%= rtl? ? 'دورك' : 'Your role' %> <span class="text-red-500">*</span>
          </label>
          <div class="relative" data-controller="choices-select">
            <select 
              id="role" 
              name="role" 
              required
              data-choices-select-target="select"
              class="w-full">
              <option value=""><%= rtl? ? 'اختر دورك' : 'Select your role' %></option>
              <% @available_roles&.each do |display_name, value| %>
                <option value="<%= value %>" <%= 'selected' if params[:role] == value %>><%= display_name %></option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <div>
          <button 
            type="submit" 
            class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-[#5C3984] hover:bg-[#4A2F6B] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#5C3984] transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
            <%= rtl? ? 'اطلب العرض التوضيحي' : 'Request the demo' %>
          </button>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-600">
            <%= rtl? ? 'نستخدم بياناتك فقط للتواصل معك بشأن العرض التوضيحي. اقرأ ' : 'We use your details only to arrange the demo. Read our ' %><a href="<%= page_path(:privacy) %>" class="text-[#5C3984] hover:underline"><%= rtl? ? 'سياسة الخصوصية' : 'privacy notice' %></a>.
        </p>
      </div>
    </div>


  </div>
</div>

