<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("home.meta.title") %></title>
  <meta name="description" content="<%= t("home.meta.description") %>">
  <%= csrf_meta_tags %>
  <%= favicon_link_tag asset_path('logo.png') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink: oklch(0.24 0.02 300);
      --ink-soft: oklch(0.44 0.02 300);
      --ink-faint: oklch(0.60 0.015 300);
      --surface: oklch(0.985 0.004 305);
      --surface-2: oklch(0.965 0.008 305);
      --line: oklch(0.90 0.01 305);
      --purple: oklch(0.42 0.12 305);
      --purple-deep: oklch(0.30 0.10 307);
      --purple-ink: oklch(0.20 0.07 307);
      --purple-tint: oklch(0.95 0.025 305);
      --gold: oklch(0.82 0.12 78);
      --on-dark: oklch(0.97 0.01 305);
      --on-dark-soft: oklch(0.82 0.02 305);
      --radius: 14px;
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --maxw: 1180px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{
      font-family:'Geist',system-ui,-apple-system,sans-serif;
      background:var(--surface);color:var(--ink);
      line-height:1.6;font-size:clamp(1rem,0.97rem + 0.2vw,1.12rem);
      -webkit-font-smoothing:antialiased;overflow-x:hidden;
    }
    a{color:inherit;text-decoration:none}
    .wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:clamp(1.25rem,4vw,2.5rem)}
    .eyebrow{
      font-size:0.8rem;font-weight:600;letter-spacing:0.02em;
      color:var(--purple);text-transform:none;
    }
    h1,h2,h3{line-height:1.08;letter-spacing:-0.02em;font-weight:700;color:var(--ink)}
    h2{font-size:clamp(1.8rem,1.2rem + 2.6vw,2.9rem);font-weight:700}
    h3{font-size:clamp(1.15rem,1.05rem + 0.5vw,1.4rem);letter-spacing:-0.01em}
    p{max-width:64ch}
    .lead{font-size:clamp(1.1rem,1rem + 0.5vw,1.35rem);color:var(--ink-soft);line-height:1.55}

    /* Header */
    header{
      position:sticky;top:0;z-index:50;backdrop-filter:saturate(1.4) blur(10px);
      background:color-mix(in oklch, var(--surface) 82%, transparent);
      border-bottom:1px solid var(--line);
    }
    .nav{display:flex;align-items:center;gap:1.5rem;height:68px}
    .brand{display:flex;align-items:center;gap:0.6rem;font-weight:700;letter-spacing:-0.02em}
    .brand img{height:30px;width:auto}
    .nav-links{display:flex;gap:1.6rem;margin-inline-start:1.5rem}
    .nav-links a{font-size:0.95rem;color:var(--ink-soft);font-weight:500;transition:color .2s var(--ease)}
    .nav-links a:hover{color:var(--purple)}
    .nav-right{margin-inline-start:auto;display:flex;align-items:center;gap:0.9rem}
    .lang-switch{font-size:0.9rem;color:var(--ink-soft);font-weight:600}
    .btn{
      display:inline-flex;align-items:center;gap:0.5rem;font-weight:600;
      padding:0.68rem 1.15rem;border-radius:10px;font-size:0.95rem;
      transition:transform .25s var(--ease), background .25s var(--ease), box-shadow .25s var(--ease);
    }
    .btn-primary{background:var(--purple);color:var(--on-dark);box-shadow:0 1px 2px oklch(0.42 0.12 305 / .3)}
    .btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px oklch(0.42 0.12 305 / .28)}
    .btn-ghost{color:var(--ink);border:1px solid var(--line)}
    .btn-ghost:hover{border-color:var(--purple);color:var(--purple)}
    .btn-lg{padding:0.85rem 1.5rem;font-size:1.02rem}
    .nav-toggle{display:none}

    /* Hero */
    .hero{padding-block:clamp(3.5rem,2rem + 8vw,7rem) clamp(2rem,1rem + 4vw,4rem)}
    .hero-grid{display:grid;grid-template-columns:1.05fr 0.95fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}
    .hero h1{font-size:clamp(2.6rem,1.6rem + 4.6vw,5rem);font-weight:800;letter-spacing:-0.035em;margin-block:1rem 1.4rem}
    .hero .accent{color:var(--purple)}
    .hero-cta{display:flex;gap:0.8rem;flex-wrap:wrap;margin-top:2rem}
    .hero-note{margin-top:1.4rem;font-size:0.92rem;color:var(--ink-faint)}

    /* Product visual: assessment scorecard */
    .panel{
      background:#fff;border:1px solid var(--line);border-radius:var(--radius);
      box-shadow:0 30px 60px -30px oklch(0.30 0.10 307 / .35), 0 2px 8px oklch(0.30 0.1 307 / .06);
      overflow:hidden;
    }
    .panel-bar{display:flex;align-items:center;gap:0.4rem;padding:0.7rem 0.9rem;border-bottom:1px solid var(--line);background:var(--surface-2)}
    .dot{width:9px;height:9px;border-radius:50%;background:var(--line)}
    .panel-title{margin-inline-start:0.6rem;font-size:0.82rem;color:var(--ink-faint);font-weight:600}
    .panel-body{padding:1.15rem 1.25rem}
    .score-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:0.6rem 0;border-bottom:1px solid var(--surface-2)}
    .score-row:last-child{border-bottom:0}
    .score-label{font-size:0.9rem;color:var(--ink-soft);font-weight:500}
    .meter{height:8px;border-radius:99px;background:var(--surface-2);flex:1;overflow:hidden;max-width:170px}
    .meter > i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--purple),oklch(0.55 0.13 300))}
    .score-val{font-variant-numeric:tabular-nums;font-weight:700;font-size:0.9rem;color:var(--purple);min-width:44px;text-align:end}
    .overall{display:flex;align-items:baseline;gap:0.5rem;margin-top:0.9rem;padding-top:0.9rem;border-top:1px solid var(--line)}
    .overall b{font-size:2rem;font-weight:800;color:var(--purple);font-variant-numeric:tabular-nums;letter-spacing:-0.03em}

    /* Positioning strip */
    .strip{border-block:1px solid var(--line);background:var(--surface-2)}
    .strip .wrap{display:flex;align-items:center;gap:1.5rem 2.5rem;flex-wrap:wrap;padding-block:1.1rem;font-size:0.95rem;color:var(--ink-soft);font-weight:500}
    .strip b{color:var(--ink)}
    .strip .sep{width:5px;height:5px;border-radius:50%;background:var(--purple);opacity:.5}

    /* Movements */
    .movement{padding-block:clamp(3.5rem,2rem + 6vw,6rem)}
    .m-head{max-width:46rem;margin-bottom:clamp(2rem,3vw,3rem)}
    .m-head .eyebrow{display:block;margin-bottom:0.6rem}
    .m-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center}
    .m-grid.flip .m-visual{order:-1}
    .feat{display:flex;gap:0.85rem;padding-block:0.85rem;border-top:1px solid var(--line)}
    .feat:first-child{border-top:0}
    .feat svg{width:22px;height:22px;flex:none;color:var(--purple);margin-top:2px}
    .feat h3{margin-bottom:0.2rem}
    .feat p{font-size:0.98rem;color:var(--ink-soft);max-width:46ch}

    /* Dark movement (Govern) */
    .dark{background:var(--purple-ink);color:var(--on-dark)}
    .dark h2,.dark h3{color:var(--on-dark)}
    .dark .eyebrow{color:var(--gold)}
    .dark .lead,.dark .feat p{color:var(--on-dark-soft)}
    .dark .feat{border-color:oklch(0.4 0.06 307)}
    .dark .feat svg{color:var(--gold)}
    .dark .panel{background:oklch(0.26 0.08 307);border-color:oklch(0.4 0.06 307);box-shadow:0 30px 60px -30px #000}
    .dark .panel-bar{background:oklch(0.23 0.08 307);border-color:oklch(0.4 0.06 307)}
    .dark .panel-title{color:var(--on-dark-soft)}

    /* Risk matrix */
    .matrix{display:grid;grid-template-columns:1.3rem repeat(5,1fr);gap:4px;font-size:0.68rem;width:100%}
    .matrix .cell{aspect-ratio:1.75;min-width:0;border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:700;color:oklch(0.25 0.05 300)}
    .matrix .axis{background:transparent;color:var(--on-dark-soft);font-weight:600}
    .register-row{display:flex;align-items:center;justify-content:space-between;gap:0.75rem;padding:0.55rem 0;border-top:1px solid oklch(0.4 0.06 307);font-size:0.85rem}
    .register-row:first-of-type{border-top:0}
    .tag{font-size:0.72rem;font-weight:700;padding:0.15rem 0.55rem;border-radius:99px}

    /* AI band */
    .ai{background:linear-gradient(180deg,var(--purple-tint),var(--surface))}
    .ai-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center}
    .chat{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:1.1rem;box-shadow:0 24px 50px -28px oklch(0.30 0.10 307 / .3)}
    .bubble{padding:0.7rem 0.95rem;border-radius:12px;font-size:0.92rem;margin-bottom:0.7rem;max-width:85%}
    .bubble.you{background:var(--purple);color:var(--on-dark);margin-inline-start:auto;border-end-end-radius:4px}
    .bubble.ai{background:var(--surface-2);color:var(--ink);border-end-start-radius:4px}
    .bubble .src{display:block;margin-top:0.4rem;font-size:0.75rem;color:var(--ink-faint)}

    /* Final CTA */
    .cta-final{background:var(--purple);color:var(--on-dark);border-radius:0}
    .cta-final .wrap{padding-block:clamp(3.5rem,2rem + 6vw,6rem);text-align:center}
    .cta-final h2{color:var(--on-dark);max-width:20ch;margin-inline:auto}
    .cta-final .lead{color:var(--on-dark-soft);margin:1.1rem auto 2rem;max-width:52ch}
    .cta-final .btn-primary{background:#fff;color:var(--purple)}
    .cta-final .btn-ghost{color:var(--on-dark);border-color:oklch(0.85 0.05 305 / .4)}
    .cta-final .btn-ghost:hover{border-color:#fff;color:#fff}

    footer{background:var(--purple-ink);color:var(--on-dark-soft);padding-block:2.5rem;font-size:0.9rem}
    footer .wrap{display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;align-items:center}
    footer a:hover{color:#fff}

    /* Reveal motion */
    .reveal{opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
    .reveal.in{opacity:1;transform:none}
    .reveal[data-d="1"]{transition-delay:.08s}
    .reveal[data-d="2"]{transition-delay:.16s}
    .reveal[data-d="3"]{transition-delay:.24s}

    @media (max-width:860px){
      .nav-links{display:none}
      .hero-grid,.m-grid,.m-grid.flip,.ai-grid{grid-template-columns:1fr}
      .m-grid.flip .m-visual{order:0}
      .hero-visual{margin-top:1rem}
      .nav-right .btn-ghost{display:none}
    }
    @media (prefers-reduced-motion:reduce){
      .reveal{opacity:1;transform:none;transition:none}
      html{scroll-behavior:auto}
    }
  </style>
</head>
<% app_sign_in = "#{ENV['ROOT_URL']}/users/sign_in" %>
<body>
  <header>
    <div class="wrap nav">
      <a href="<%= root_path %>" class="brand">
        <%= image_tag asset_path('logo.png'), alt: "Way to Excellence" %>
      </a>
      <nav class="nav-links">
        <a href="#assess"><%= rtl? ? "التقييم" : "Assess" %></a>
        <a href="#act"><%= rtl? ? "المعالجة" : "Act" %></a>
        <a href="#govern"><%= rtl? ? "الحوكمة" : "Govern" %></a>
        <a href="#ai"><%= rtl? ? "الذكاء الاصطناعي" : "AI" %></a>
      </nav>
      <div class="nav-right">
        <% if rtl? %>
          <a class="lang-switch" href="<%= switch_language_path(:en) %>"><%= t("home.header.switch_to_en") %></a>
        <% else %>
          <a class="lang-switch" href="<%= switch_language_path(:ar) %>"><%= t("home.header.switch_to_ar") %></a>
        <% end %>
        <a class="btn btn-ghost" href="<%= app_sign_in %>"><%= rtl? ? "تسجيل الدخول" : "Sign in" %></a>
        <a class="btn btn-primary" href="<%= new_waitlist_path %>"><%= rtl? ? "انضم للقائمة" : "Join the waitlist" %></a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow reveal in"><%= rtl? ? "إدارة الجودة والامتثال" : "Quality & compliance management" %></span>
        <h1 class="reveal in" data-d="1">
          <% if rtl? %>
            برنامج الجودة والامتثال بالكامل<br><span class="accent">في مكان واحد.</span>
          <% else %>
            Your whole compliance program,<br><span class="accent">in one place.</span>
          <% end %>
        </h1>
        <p class="lead reveal in" data-d="2">
          <% if rtl? %>
            قيّم معايير EFQM وISO 9001 وKAQA، وأدر الإجراءات التصحيحية والمخاطر والموردين، وأثبت امتثالك، بالعربية والإنجليزية، ومدعوماً بالذكاء الاصطناعي.
          <% else %>
            Assess EFQM, ISO 9001 and KAQA, manage corrective actions, risk and vendors, and prove your compliance, in Arabic and English, with AI along the way.
          <% end %>
        </p>
        <div class="hero-cta reveal in" data-d="3">
          <a class="btn btn-primary btn-lg" href="<%= new_waitlist_path %>"><%= rtl? ? "انضم للقائمة" : "Join the waitlist" %></a>
          <a class="btn btn-ghost btn-lg" href="<%= app_sign_in %>"><%= rtl? ? "لديك حساب؟ سجّل الدخول" : "Sign in to your workspace" %></a>
        </div>
        <p class="hero-note reveal in" data-d="3">
          <%= rtl? ? "مصمّم للمؤسسات في المملكة العربية السعودية ومنطقة الخليج." : "Built for enterprises across Saudi Arabia and the Gulf." %>
        </p>
      </div>
      <div class="hero-visual reveal in" data-d="2">
        <div class="panel">
          <div class="panel-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="panel-title"><%= rtl? ? "التقييم: البند 1.1 تحديد الغرض والرؤية" : "Assessment: Clause 1.1 Purpose & Vision" %></span>
          </div>
          <div class="panel-body">
            <% approach = rtl? ? "النهج" : "Approach" %>
            <% deployment = rtl? ? "التطبيق" : "Deployment" %>
            <% assessment = rtl? ? "التقييم والتحسين" : "Assessment & Refinement" %>
            <div class="score-row"><span class="score-label"><%= approach %></span><span class="meter"><i style="width:82%"></i></span><span class="score-val">82%</span></div>
            <div class="score-row"><span class="score-label"><%= deployment %></span><span class="meter"><i style="width:74%"></i></span><span class="score-val">74%</span></div>
            <div class="score-row"><span class="score-label"><%= assessment %></span><span class="meter"><i style="width:68%"></i></span><span class="score-val">68%</span></div>
            <div class="overall"><b>75%</b><span class="score-label"><%= rtl? ? "الدرجة الإجمالية للبند" : "overall clause score" %></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONING STRIP -->
  <div class="strip">
    <div class="wrap">
      <span><b>EFQM</b></span><span class="sep"></span>
      <span><b>ISO 9001</b></span><span class="sep"></span>
      <span><b>KAQA</b> <%= rtl? ? "وقياس" : "& Qiyas" %></span><span class="sep"></span>
      <span><%= rtl? ? "عربي / إنجليزي بدعم كامل لليمين إلى اليسار" : "Arabic / English with full RTL" %></span>
    </div>
  </div>

  <!-- ASSESS -->
  <section class="movement" id="assess">
    <div class="wrap">
      <div class="m-head reveal">
        <span class="eyebrow"><%= rtl? ? "التقييم" : "Assess" %></span>
        <h2><%= rtl? ? "قيّم المعايير على مستوى البند، بدقة." : "Score standards at the clause level, precisely." %></h2>
        <p class="lead"><%= rtl? ? "كل بند نهائي يحصل على صفحة تقييم مخصّصة: تعريف واضح، ونقاط تقييم، وأدلة، ودرجات محسوبة تلقائياً من أداة التقييم المهيأة للمعيار." : "Every terminal clause gets a dedicated page: a clear definition, checkpoints, evidence, and scores computed automatically from the tool configured for that standard." %></p>
      </div>
      <div class="m-grid">
        <div class="reveal">
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg><div><h3><%= rtl? ? "مكتبة المعايير" : "Standards library" %></h3><p><%= rtl? ? "استورد المعايير وأدر إصداراتها وشجرة بنودها في مكان واحد." : "Import standards and manage their versions and clause trees in one place." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18M19 9l-5 5-4-4-3 3"/></svg><div><h3><%= rtl? ? "تقييم متعدد المعايير" : "Multi-standard scoring" %></h3><p><%= rtl? ? "مؤشرات انزلاقية لـ EFQM، ونعم/لا لـ ISO، وأدوات مخصّصة، مع أوزان وحدود قصوى قابلة للتهيئة." : "Sliders for EFQM, Yes/No for ISO, custom tools, with configurable weights and caps." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.4a2 2 0 00-.6-1.4l-4.4-4.4a2 2 0 00-1.4-.6H7a2 2 0 00-2 2v14a2 2 0 002 2zM9 13h6M9 17h6"/></svg><div><h3><%= rtl? ? "الأدلة والملاحظات" : "Evidence & notes" %></h3><p><%= rtl? ? "أرفق المستندات واكتب الملاحظات على مستوى كل نقطة تقييم." : "Attach documents and capture notes at each checkpoint." %></p></div></div>
        </div>
        <div class="m-visual reveal" data-d="1">
          <div class="panel">
            <div class="panel-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="panel-title"><%= rtl? ? "شجرة البنود" : "Clause tree" %></span></div>
            <div class="panel-body">
              <% ["1. القيادة والغرض / Leadership & Purpose","1.1 تحديد الغرض / Define Purpose","1.2 قيادة التميز / Lead with Excellence","2. الاستراتيجية / Strategy"].each_with_index do |c, idx| %>
                <div class="score-row" style="<%= 'padding-inline-start:1.1rem' if idx==1||idx==2 %>">
                  <span class="score-label"><%= rtl? ? c.split(' / ').first : c.split(' / ').last %></span>
                  <% if idx==1||idx==2 %><span class="meter" style="max-width:110px"><i style="width:<%= idx==1 ? 75 : 61 %>%"></i></span><span class="score-val"><%= idx==1 ? 75 : 61 %>%</span><% else %><span class="score-val" style="color:var(--ink-faint)">—</span><% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACT -->
  <section class="movement" id="act" style="background:var(--surface-2)">
    <div class="wrap">
      <div class="m-head reveal">
        <span class="eyebrow"><%= rtl? ? "المعالجة" : "Act" %></span>
        <h2><%= rtl? ? "أغلق الفجوات بإجراءات تصحيحية يساعدك الذكاء الاصطناعي على صياغتها." : "Close gaps with corrective actions the AI helps you write." %></h2>
        <p class="lead"><%= rtl? ? "من فتح حالة عدم المطابقة حتى إغلاقها: يقترح الذكاء الاصطناعي أسئلة تحليل السبب الجذري، والإجراءات التصحيحية، وبنود المعايير ذات الصلة." : "From opening a nonconformity to closing it, the AI drafts root-cause questions, corrective actions, and the relevant standard clauses to link." %></p>
      </div>
      <div class="m-grid flip">
        <div class="reveal">
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><div><h3><%= rtl? ? "دورة حياة CAPA" : "CAPA lifecycle" %></h3><p><%= rtl? ? "تتبّع كل إجراء من مفتوح إلى مُسند إلى قيد التنفيذ إلى مغلق." : "Track every action from open to assigned to in-progress to closed." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><div><h3><%= rtl? ? "توليد بمساعدة الذكاء الاصطناعي" : "AI-assisted generation" %></h3><p><%= rtl? ? "استبيانات السبب الجذري، والإجراءات المقترحة، واقتراح البنود، قابلة للمراجعة قبل الحفظ." : "Root-cause questionnaires, suggested actions, and clause suggestions, all reviewable before you save." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7h3a2 2 0 012 2v9a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3m6 0V5a2 2 0 00-2-2h-2a2 2 0 00-2 2v2m6 0H9"/></svg><div><h3><%= rtl? ? "دليل قابل لإعادة الاستخدام" : "Reusable evidence" %></h3><p><%= rtl? ? "اربط مستنداً واحداً بعدة بنود ومعايير وإجراءات دون إعادة رفعه." : "Link one document to many clauses, standards and actions without re-uploading." %></p></div></div>
        </div>
        <div class="m-visual reveal" data-d="1">
          <div class="panel">
            <div class="panel-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="panel-title"><%= rtl? ? "مساعد الاستبيان" : "Questionnaire assistant" %></span></div>
            <div class="panel-body">
              <div class="bubble ai" style="max-width:100%"><%= rtl? ? "ما العملية التي فشلت، ومتى لوحظ ذلك أول مرة؟" : "Which process failed, and when was it first observed?" %></div>
              <div class="bubble you" style="max-width:100%;background:var(--surface-2);color:var(--ink)"><%= rtl? ? "مراجعة المورد تأخرت عن الجدول بأسبوعين." : "Supplier review slipped two weeks past schedule." %></div>
              <div class="bubble ai" style="max-width:100%"><%= rtl? ? "الإجراء المقترح: أتمتة تذكيرات مراجعة الموردين قبل 30 يوماً من الاستحقاق." : "Suggested action: automate supplier-review reminders 30 days before due." %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GOVERN (dark) -->
  <section class="movement dark" id="govern">
    <div class="wrap">
      <div class="m-head reveal">
        <span class="eyebrow"><%= rtl? ? "الحوكمة" : "Govern" %></span>
        <h2><%= rtl? ? "احكم المخاطر والأطراف الثالثة والالتزامات في سجل واحد." : "Govern risk, third parties and commitments in one register." %></h2>
        <p class="lead"><%= rtl? ? "سجّل المخاطر وقيّمها على مصفوفة 5×5، وجمّعها في مساحات عمل حسب الإطار أو القسم، وتابع مخاطر الموردين والتزامات العملاء جنباً إلى جنب." : "Log and score risks on a 5×5 matrix, group them into workspaces by framework or department, and keep vendor risk and customer commitments alongside." %></p>
      </div>
      <div class="m-grid">
        <div class="reveal">
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 3h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h16.9a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg><div><h3><%= rtl? ? "سجل المخاطر ومساحات العمل" : "Risk register & workspaces" %></h3><p><%= rtl? ? "درجات أصلية ومتبقية، مجمّعة حسب ISO 27001 أو القسم." : "Inherent and residual scores, grouped by ISO 27001 or by department." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 7a4 4 0 108 0 4 4 0 00-8 0zM22 21l-3-3m0 0a2 2 0 10-3-3"/></svg><div><h3><%= rtl? ? "مخاطر الأطراف الثالثة" : "Third-party risk" %></h3><p><%= rtl? ? "سجّل الموردين ومستوى مخاطرهم وفئتهم والمسؤول عنهم." : "Track vendors with their risk level, category and owner." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 12l2 2 4-4"/></svg><div><h3><%= rtl? ? "التزامات العملاء" : "Customer commitments" %></h3><p><%= rtl? ? "تتبّع الالتزامات التعاقدية وتواريخ استحقاقها مع تنبيهات التأخر." : "Track contractual obligations and due dates, with past-due alerts." %></p></div></div>
        </div>
        <div class="m-visual reveal" data-d="1">
          <div class="panel">
            <div class="panel-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="panel-title"><%= rtl? ? "مصفوفة المخاطر" : "Risk matrix" %></span></div>
            <div class="panel-body">
              <div class="matrix">
                <% cols = [["#e9f7ef","#e9f7ef","#fef6e0","#fdeede","#fdeede"],
                           ["#e9f7ef","#fef6e0","#fef6e0","#fdeede","#fbe0e0"],
                           ["#fef6e0","#fef6e0","#fdeede","#fbe0e0","#fbe0e0"],
                           ["#fef6e0","#fdeede","#fbe0e0","#fbe0e0","#f7c9c9"],
                           ["#fdeede","#fbe0e0","#fbe0e0","#f7c9c9","#f4b4b4"]] %>
                <% (0..4).each do |r| %>
                  <div class="cell axis"><%= 5-r %></div>
                  <% (0..4).each do |c| %>
                    <div class="cell" style="background:<%= cols[4-r][c] %>"><%= (5-r)*(c+1) %></div>
                  <% end %>
                <% end %>
                <div class="cell axis"></div>
                <% (1..5).each do |c| %><div class="cell axis"><%= c %></div><% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROVE -->
  <section class="movement" id="prove">
    <div class="wrap">
      <div class="m-head reveal">
        <span class="eyebrow"><%= rtl? ? "الإثبات" : "Prove" %></span>
        <h2><%= rtl? ? "أثبت امتثالك، للقيادة وللعملاء." : "Prove it, to leadership and to customers." %></h2>
        <p class="lead"><%= rtl? ? "لوحات تنفيذية توضح حالة الامتثال، وسجل تدقيق كامل، وصفحة ثقة عامة تشارك بها موقفك دون منح العملاء حساباً." : "Executive dashboards for compliance status, a complete audit trail, and a public Trust Center that shares your posture without giving customers an account." %></p>
      </div>
      <div class="m-grid">
        <div class="reveal">
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg><div><h3><%= rtl? ? "لوحات تنفيذية" : "Executive dashboards" %></h3><p><%= rtl? ? "نسبة امتثال دقيقة عبر كل المعايير في لمحة." : "Accurate compliance percentages across every standard at a glance." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><div><h3><%= rtl? ? "مركز الثقة" : "Trust Center" %></h3><p><%= rtl? ? "صفحة عامة تعرض المعايير التي تلتزم بها ونسبة الامتثال الحية." : "A public page showing the standards you meet and live compliance." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6a1 1 0 01.7.3l5.4 5.4a1 1 0 01.3.7V19a2 2 0 01-2 2z"/></svg><div><h3><%= rtl? ? "سجل تدقيق كامل" : "Full audit trail" %></h3><p><%= rtl? ? "كل تغيير مسجّل ومنسوب، جاهز للمدقق." : "Every change recorded and attributed, ready for the auditor." %></p></div></div>
        </div>
        <div class="m-visual reveal" data-d="1">
          <div class="panel">
            <div class="panel-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="panel-title">trust.wtexcel.com</span></div>
            <div class="panel-body">
              <div class="score-row"><span class="score-label">EFQM 2025</span><span class="meter"><i style="width:78%"></i></span><span class="score-val">78%</span></div>
              <div class="score-row"><span class="score-label">ISO 9001:2015</span><span class="meter"><i style="width:91%"></i></span><span class="score-val">91%</span></div>
              <div class="score-row"><span class="score-label">KAQA</span><span class="meter"><i style="width:84%"></i></span><span class="score-val">84%</span></div>
              <div class="overall"><span class="tag" style="background:var(--purple-tint);color:var(--purple)"><%= rtl? ? "موثّق للعملاء" : "Customer-facing" %></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI BAND -->
  <section class="movement ai" id="ai">
    <div class="wrap ai-grid">
      <div class="reveal">
        <span class="eyebrow"><%= rtl? ? "الذكاء الاصطناعي" : "Artificial intelligence" %></span>
        <h2 style="margin-block:0.6rem 1rem"><%= rtl? ? "ذكاء اصطناعي يعرف معاييرك ومصطلحاتك." : "AI that knows your standards and your terminology." %></h2>
        <p class="lead"><%= rtl? ? "اسأل المساعد عن معاييرك وإجراءاتك ومخاطرك ومورديك، وزوّده بتعليمات مخصّصة بالعربية والإنجليزية ليتبع مصطلحات مؤسستك في كل توليد." : "Ask the assistant about your standards, actions, risks and vendors, and feed it custom instructions in Arabic and English so it follows your organization's terminology in every generation." %></p>
        <div style="margin-top:1.6rem">
          <div class="feat" style="border-top:0;padding-top:0"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-6l-4 4v-4z"/></svg><div><h3><%= rtl? ? "مساعد على مستوى المنصة" : "Platform-wide assistant" %></h3><p><%= rtl? ? "إجابات مستندة إلى بيانات شركتك فقط." : "Answers grounded only in your company's data." %></p></div></div>
          <div class="feat"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.3a4 4 0 010 11.4M5 12h.01M12 3v2m0 14v2"/></svg><div><h3><%= rtl? ? "تعليمات ذكاء اصطناعي مخصّصة" : "Custom AI instructions" %></h3><p><%= rtl? ? "علّم الذكاء الاصطناعي معرفة مجالك، ثنائية اللغة." : "Teach the AI your domain knowledge, bilingually." %></p></div></div>
        </div>
      </div>
      <div class="reveal" data-d="1">
        <div class="chat">
          <div class="bubble you"><%= rtl? ? "ما حالة امتثالنا لـ ISO 9001؟" : "What's our ISO 9001 compliance status?" %></div>
          <div class="bubble ai">
            <%= rtl? ? "امتثالك الحالي لـ ISO 9001:2015 هو 91%. أدنى بند هو 8.5 (الإنتاج) عند 72%." : "Your ISO 9001:2015 compliance is 91%. The lowest clause is 8.5 (Production) at 72%." %>
            <span class="src"><%= rtl? ? "المصادر: معيار ISO 9001، البند 8.5، لوحة الامتثال" : "Sources: ISO 9001 standard, Clause 8.5, compliance dashboard" %></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="cta-final">
    <div class="wrap reveal">
      <h2><%= rtl? ? "ابدأ رحلة التميّز مع مؤسستك." : "Start your organization's journey to excellence." %></h2>
      <p class="lead"><%= rtl? ? "انضم إلى قائمة الانتظار، أو سجّل الدخول إذا كان لديك حساب بالفعل." : "Join the waitlist, or sign in if you already have a workspace." %></p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn btn-primary btn-lg" href="<%= new_waitlist_path %>"><%= rtl? ? "انضم للقائمة" : "Join the waitlist" %></a>
        <a class="btn btn-ghost btn-lg" href="<%= app_sign_in %>"><%= rtl? ? "تسجيل الدخول" : "Sign in" %></a>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="brand" style="color:var(--on-dark)">
        <%= image_tag asset_path('logo-tr.png'), alt: "Way to Excellence", style: "height:26px" %>
      </div>
      <div style="display:flex;gap:1.5rem;flex-wrap:wrap;align-items:center">
        <a href="mailto:info@wtexcellence.com">info@wtexcellence.com</a>
        <a href="<%= app_sign_in %>"><%= rtl? ? "تسجيل الدخول" : "Sign in" %></a>
        <% if rtl? %><a href="<%= switch_language_path(:en) %>">English</a><% else %><a href="<%= switch_language_path(:ar) %>">العربية</a><% end %>
        <span>© <%= Time.current.year %> Way to Excellence</span>
      </div>
    </div>
  </footer>

  <script>
    (function(){
      var els = document.querySelectorAll('.reveal:not(.in)');
      if (!('IntersectionObserver' in window)) { els.forEach(function(e){e.classList.add('in')}); return; }
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      els.forEach(function(e){ io.observe(e); });
    })();
  </script>
</body>
</html>
