<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t("home.meta.title") %></title>
  <meta name="description" content="<%= t("home.meta.description") %>">
  
  <style>
    /* Import Geist font exactly like Lovable */
    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap');

    /* CSS Variables from index.css */
    :root {
      --background: 220 20% 98%;
      --foreground: 222 62% 9%;
      --card: 0 0% 100%;
      --card-foreground: 222 62% 9%;
      --popover: 0 0% 100%;
      --popover-foreground: 222 62% 9%;
      --primary: 272 38% 37%;
      --primary-foreground: 0 0% 100%;
      --secondary: 240 33% 97%;
      --secondary-foreground: 222 62% 9%;
      --muted: 240 33% 97%;
      --muted-foreground: 220 3% 49%;
      --accent: 228 80% 51%;
      --accent-foreground: 0 0% 100%;
      --destructive: 0 84% 60%;
      --destructive-foreground: 0 0% 100%;
      --border: 0 0% 89%;
      --input: 0 0% 89%;
      --ring: 228 80% 51%;
      --radius: 0.75rem;
      --purple: 272 38% 37%;
      --purple-light: 240 76% 97%;
      --blue: 228 80% 51%;
      --blue-light: 240 60% 97%;
      --navy: 222 62% 9%;
      --gray-50: 220 20% 98%;
      --gray-100: 240 33% 97%;
      --gray-200: 0 0% 89%;
      --gray-500: 220 3% 49%;
      --gray-600: 213 11% 49%;
      --gray-900: 222 62% 9%;
      --green: 102 77% 31%;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      border-color: hsl(var(--border));
    }

    html, body {
      font-family: 'Geist', system-ui, sans-serif;
      background: hsl(var(--background));
      color: hsl(var(--foreground));
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    button,
    input,
    select,
    textarea {
      font-family: inherit;
      font-size: inherit;
      line-height: inherit;
    }

    h1, h2, h3, h4, h5, h6 {
      font-weight: 600; /* font-semibold */
      letter-spacing: -0.025em; /* tracking-tight */
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* Utility Classes */
    .container-custom {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    @media (min-width: 640px) {
      .container-custom {
        padding: 0 1.5rem;
      }
    }

    @media (min-width: 1024px) {
      .container-custom {
        padding: 0 2rem;
      }
    }

    .section-padding {
      padding: 4rem 0;
    }

    @media (min-width: 768px) {
      .section-padding {
        padding: 6rem 0;
      }
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary {
      background: hsl(var(--primary));
      color: hsl(var(--primary-foreground));
    }

    .btn-primary:hover {
      background: hsl(var(--primary) / 0.9);
    }

    .btn-lg {
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
    }

    /* Badge */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
      background: hsl(var(--purple-light));
      color: hsl(var(--accent));
    }

    /* ============ HEADER ============ */
    .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: hsl(var(--background) / 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid hsl(var(--border) / 0.5);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4rem;
    }

    @media (min-width: 768px) {
      .header-inner {
        height: 5rem;
      }
    }

    .header-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .header-logo img {
      width: 2rem;
      height: 2rem;
      object-fit: contain;
    }

    .header-logo span {
      font-weight: 600;
      font-size: 1.125rem;
      color: hsl(var(--foreground));
    }

    .header-nav {
      display: none;
      align-items: center;
      gap: 0.25rem;
    }

    @media (min-width: 768px) {
      .header-nav {
        display: flex;
      }
    }

    .header-nav a {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
      border: 1px solid hsl(var(--border));
      border-radius: 9999px;
      transition: all 0.2s;
    }

    .header-nav a:hover {
      color: hsl(var(--foreground));
      background: hsl(var(--secondary));
    }

    .header-cta {
      display: none;
      align-items: center;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .header-cta {
        display: flex;
      }
    }

    .header-cta .lang-switch {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
      transition: color 0.2s;
    }

    .header-cta .lang-switch:hover {
      color: hsl(var(--foreground));
    }

    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      background: none;
      border: none;
      cursor: pointer;
      color: hsl(var(--foreground));
    }

    @media (min-width: 768px) {
      .mobile-menu-btn {
        display: none;
      }
    }

    .mobile-menu {
      display: none;
      padding: 1rem 0;
      border-top: 1px solid hsl(var(--border) / 0.5);
      animation: fadeIn 0.3s ease-out;
      text-align: center; /* match EN/AR: centered mobile menu */
    }

    .mobile-menu.open {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .mobile-menu a {
      font-size: 0.875rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
      padding: 0.5rem 0;
      transition: color 0.2s;
    }

    .mobile-menu a:hover {
      color: hsl(var(--foreground));
    }

    .mobile-menu-divider {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-top: 1rem;
      border-top: 1px solid hsl(var(--border) / 0.5);
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* ============ HERO ============ */
    .hero {
      padding-top: 6rem;
      padding-bottom: 4rem;
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .hero {
        padding-top: 8rem;
        padding-bottom: 6rem;
      }
    }

    .hero-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, hsl(var(--primary) / 0.05), transparent, transparent);
      pointer-events: none;
    }

    .hero-grid {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
      }
    }

    .hero-content {
      text-align: center;
    }

    @media (min-width: 1024px) {
      .hero-content {
        text-align: left;
      }
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    @media (min-width: 1024px) {
      .hero-badges {
        justify-content: flex-start;
      }
    }

    .hero h1 {
      font-size: 2.25rem;
      font-weight: 600;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      color: hsl(var(--foreground));
      text-wrap: balance;
    }

    @media (min-width: 768px) {
      .hero h1 {
        font-size: 3rem;
      }
    }

    @media (min-width: 1024px) {
      .hero h1 {
        font-size: 3.75rem;
      }
    }

    .hero h1 .accent {
      color: hsl(var(--accent));
    }

    .hero-subtitle {
      font-size: 1.125rem;
      color: hsl(var(--muted-foreground));
      margin-bottom: 2rem;
      max-width: 36rem;
      margin-left: auto;
      margin-right: auto;
    }

    @media (min-width: 1024px) {
      .hero-subtitle {
        margin-left: 0;
      }
    }

    @media (min-width: 1024px) {
      .hero-subtitle {
        margin-left: 0;
      }
    }

    .hero-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }

    .hero-features li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      justify-content: center;
    }

    @media (min-width: 1024px) {
      .hero-features li {
        justify-content: flex-start;
      }
    }

    .hero-features svg {
      width: 1.25rem;
      height: 1.25rem;
      color: hsl(var(--muted-foreground));
      flex-shrink: 0;
    }

    .hero-features span {
      font-size: 0.875rem;
      color: hsl(var(--foreground));
    }

    .hero-cta {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    @media (min-width: 1024px) {
      .hero-cta {
        align-items: flex-start;
      }
    }

    .hero-cta p {
      font-size: 0.75rem;
      color: hsl(var(--foreground));
    }

    .hero-image {
      position: relative;
    }

    .hero-image-bg {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, hsl(var(--purple-light)), hsl(var(--blue-light)));
      border-radius: 1.5rem;
    }

    .hero-image-inner {
      position: relative;
      z-index: 10;
      padding: 1.5rem;
    }

    .hero-image img {
      border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      width: 100%;
    }

    /* ============ STATS ============ */
    .stats {
      background: hsl(var(--blue-light));
      padding: 2rem 0;
    }

    .stats-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .stats-grid {
        flex-direction: row;
      }
    }

    .stats-item {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      gap: 0.75rem;
      border-radius: 0.75rem;
    }

    .stats-item .value {
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.4;
      color: hsl(var(--accent));
    }

    .stats-item .label {
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.4;
      color: hsl(var(--foreground));
    }

    /* ============ FEATURES ============ */
    .features {
      padding: 4rem 0;
    }

    @media (min-width: 768px) {
      .features {
        padding: 5rem 0;
      }
    }

    .features-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    @media (min-width: 768px) {
      .features-inner {
        padding: 0 5rem;
      }
    }

    .features-header {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    @media (min-width: 768px) {
      .features-header {
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
      }
    }

    .features-title-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 42rem;
    }

    .features-title-wrap h2 {
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.4;
      color: hsl(var(--foreground));
    }

    .features-title-wrap p {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.4;
      color: hsl(var(--muted-foreground));
    }

    .features-nav {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .features-nav button {
      width: 2.5rem;
      height: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: hsl(var(--secondary));
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .features-nav button:hover {
      background: hsl(var(--secondary) / 0.8);
    }

    .features-nav svg {
      width: 1.125rem;
      height: 1.125rem;
      color: hsl(var(--foreground));
    }

    .features-carousel-wrap {
      position: relative;
    }

    .features-carousel {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      padding-bottom: 1rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .features-carousel::-webkit-scrollbar {
      display: none;
    }

    .feature-card {
      flex-shrink: 0;
      width: 320px;
      height: 288px;
      background: hsl(var(--card));
      border: 1px solid hsl(var(--border));
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .feature-card-icon {
      width: 50px;
      height: 50px;
      border-radius: 0.75rem;
      background: hsl(var(--blue-light));
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feature-card-icon svg {
      width: 1.125rem;
      height: 1.125rem;
      color: hsl(var(--primary));
    }

    .feature-card-content {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .feature-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.4;
      color: hsl(var(--foreground));
    }

    .feature-card p {
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1.4;
      color: hsl(var(--muted-foreground));
    }

    .features-fade {
      position: absolute;
      top: 0;
      right: 0;
      width: 120px;
      height: 100%;
      background: linear-gradient(270deg, hsl(var(--background)) 0%, transparent 100%);
      pointer-events: none;
    }

    @media (min-width: 768px) {
      .features-fade {
        width: 272px;
      }
    }

    /* ============ AI INSIGHTS ============ */
    .ai-insights {
      padding: 5rem 0;
      background: #F0EEFF;
    }

    @media (min-width: 1024px) {
      .ai-insights {
        padding: 6rem 0;
      }
    }

    .ai-insights-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.25rem; /* px-5 = 1.25rem */
    }

    @media (min-width: 768px) {
      .ai-insights-inner {
        padding: 0 5rem; /* px-20 = 5rem */
      }
    }

    .ai-insights-grid {
      display: flex;
      flex-direction: column;
      gap: 3rem; /* gap-12 = 3rem */
    }

    @media (min-width: 1024px) {
      .ai-insights-grid {
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        gap: 4rem; /* lg:gap-16 = 4rem */
      }
    }

    .ai-insights-content {
      max-width: 672px; /* max-w-[672px] */
      display: flex;
      flex-direction: column;
      gap: 0.5rem; /* gap-2 = 0.5rem */
    }

    .ai-insights-content h2 {
      font-size: 32px; /* text-[32px] */
      font-weight: 600; /* font-semibold */
      color: hsl(var(--foreground));
      line-height: 1.4; /* leading-[140%] */
    }

    .ai-insights-content > p {
      font-size: 16px; /* text-base */
      font-weight: 500; /* font-medium */
      line-height: 1.4; /* leading-[140%] */
    }

    .ai-insights-features {
      display: flex;
      flex-direction: column;
      gap: 1.25rem; /* gap-5 = 1.25rem */
      margin-top: 2rem; /* mt-8 = 2rem */
      max-width: 510px; /* max-w-[510px] */
    }

    .ai-feature-item {
      display: flex;
      align-items: center;
      gap: 0.75rem; /* gap-3 = 0.75rem */
    }

    .ai-feature-icon {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #F7F7FD;
      border-radius: 12px;
    }

    .ai-feature-icon svg {
      width: 18px;
      height: 18px;
      color: #5C3984;
    }

    .ai-feature-item span {
      font-size: 16px; /* fontSize: "16px" */
      font-weight: 500; /* font-medium */
      line-height: 1.4; /* leading-[140%] */
      color: #0D1120; /* color: "#0D1120" */
    }

    .ai-dashboard {
      position: relative;
      width: 100%;
      height: 372px;
      flex-shrink: 0;
    }

    @media (min-width: 1024px) {
      .ai-dashboard {
        width: 580px;
      }
    }

    .ai-dashboard-bg {
      position: absolute;
      inset: 0;
      border-radius: 24px;
      border: 1px solid #E3E3E3;
      background: linear-gradient(270deg, #F4EAFF 0%, #E1E7FF 100%);
    }

    .ai-dashboard-card {
      position: absolute;
      left: 12px; /* left-3 = 12px */
      top: 16px; /* top-4 = 16px */
      width: calc(100% - 24px);
      border-radius: 18px; /* rounded-[18px] */
      border: 3px solid #5C3984; /* border-[3px] */
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      background: #F9FAFC;
    }

    @media (min-width: 1024px) {
      .ai-dashboard-card {
        left: 19px; /* lg:left-[19px] */
        top: -40px; /* lg:-top-[40px] */
        width: 540px; /* lg:w-[540px] */
        border-width: 3.6px; /* lg:border-[3.6px] */
      }
    }

    .ai-dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px; /* px-3 py-2 */
      background: #FFFFFF;
      border-bottom: 0.55px solid #E3E3E3;
    }

    .ai-dashboard-header span {
      font-size: 10px; /* fontSize: "10px" */
      font-weight: 600; /* font-semibold */
      color: hsl(var(--foreground));
      line-height: 1.4; /* lineHeight: "140%" */
    }

    .ai-dashboard-header-actions {
      display: flex;
      align-items: center;
      gap: 8px; /* gap-2 = 8px */
    }

    .ai-auditor-badge {
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 500; /* font-medium */
      color: hsl(var(--foreground));
      padding: 4px 8px; /* px-2 py-1 */
      background: #F0EEFF;
      border: 0.55px solid #E3E3E3; /* border: "0.55px solid #E3E3E3" */
      border-radius: 16.5px; /* borderRadius: "16.5px" */
    }

    .ai-analyze-btn {
      display: flex;
      align-items: center;
      gap: 4px; /* gap-1 = 4px */
      padding: 4px 8px; /* px-2 py-1 */
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 500; /* font-medium */
      color: white;
      background: #5C3984;
      border-radius: 6.6px; /* borderRadius: "6.6px" */
    }

    .ai-analyze-btn svg {
      width: 8px; /* w-2 = 8px */
      height: 8px; /* h-2 = 8px */
    }

    .ai-table {
      background: #FFFFFF;
    }

    .ai-table-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #F7F7FD;
      border-bottom: 0.55px solid #E3E3E3;
    }

    .ai-table-header div {
      padding: 8px 12px; /* px-3 py-2 */
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 600; /* font-semibold */
      color: hsl(var(--muted-foreground));
      line-height: 1.4; /* lineHeight: "140%" */
    }

    .ai-table-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-bottom: 0.55px solid #E3E3E3;
    }

    .ai-table-row > div:first-child {
      padding: 8px 12px; /* px-3 py-2 */
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 500; /* font-medium */
      color: hsl(var(--foreground));
      line-height: 1.4; /* lineHeight: "140%" */
    }

    .ai-table-answer {
      display: flex;
      align-items: flex-start; /* items-start */
      gap: 4px; /* gap-1 = 4px */
      padding: 8px 12px; /* px-3 py-2 */
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 500; /* font-medium */
      color: hsl(var(--foreground));
      line-height: 1.4; /* lineHeight: "140%" */
    }

    .ai-table-answer svg {
      width: 8.8px; /* width: "8.8px" */
      height: 8.8px; /* height: "8.8px" */
      color: #5C3984;
      flex-shrink: 0;
      margin-top: 2px; /* mt-0.5 = 2px */
    }

    .ai-root-cause {
      margin: 12px; /* mx-3 my-3 = 12px */
      padding: 8px; /* p-2 = 8px */
      background: #EEEEFE;
      border: 0.55px solid #5C3984; /* border: "0.55px solid #5C3984" */
      border-radius: 6.6px; /* borderRadius: "6.6px" */
    }

    .ai-root-cause-header {
      display: flex;
      align-items: center;
      gap: 4px; /* gap-1 = 4px */
      margin-bottom: 4px; /* mb-1 = 4px */
    }

    .ai-root-cause-header svg {
      width: 8.8px; /* width: "8.8px" */
      height: 8.8px; /* height: "8.8px" */
      color: #5C3984;
    }

    .ai-root-cause-header span {
      font-size: 8.8px; /* fontSize: "8.8px" */
      font-weight: 600; /* font-semibold */
      color: #5C3984;
      line-height: 1.4; /* lineHeight: "140%" */
    }

    .ai-root-cause p {
      font-size: 7.7px; /* fontSize: "7.7px" */
      font-weight: 500; /* font-medium */
      color: #5C3984;
      line-height: 1.4; /* lineHeight: "140%" */
    }

    /* ============ QUALITY STANDARDS ============ */
    .quality-standards {
      padding: 4rem 0;
    }

    @media (min-width: 768px) {
      .quality-standards {
        padding: 6rem 0;
      }
    }

    .quality-standards-header {
      margin-bottom: 3rem;
    }

    @media (min-width: 768px) {
      .quality-standards-header {
        margin-bottom: 4rem;
      }
    }

    .quality-standards-header h2 {
      font-size: 1.875rem;
      font-weight: 600;
      color: hsl(var(--foreground));
      margin-bottom: 0.5rem;
    }

    @media (min-width: 768px) {
      .quality-standards-header h2 {
        font-size: 2.25rem;
      }
    }

    .quality-standards-header p {
      font-size: 1rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
      max-width: 42rem;
    }

    .standards-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .standards-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .standards-row {
        grid-template-columns: 1fr 1fr;
      }
    }

    .standards-row-3 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .standards-row-3 {
        grid-template-columns: 4fr 6fr 2fr;
      }
    }

    .standard-card {
      background: white;
      border: 1px solid hsl(var(--border));
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .standard-card-content {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .standard-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: hsl(var(--accent));
    }

    .standard-card p {
      font-size: 0.875rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
    }

    .standard-features {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .feature-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: #F4F6FF;
      border-radius: 9999px;
    }

    .feature-tag svg {
      width: 1rem;
      height: 1rem;
      color: #576A83;
    }

    .feature-tag span {
      font-size: 0.75rem;
      font-weight: 600;
      color: #576A83;
    }

    .more-standards-card {
      background: #F4F6FF;
      border: 1px solid hsl(var(--accent));
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: 200px;
    }

    .more-standards-card .number {
      font-size: 2.25rem;
      font-weight: 600;
      color: hsl(var(--accent));
      margin-bottom: 0.75rem;
    }

    .more-standards-card .label {
      font-size: 0.875rem;
      font-weight: 500;
      color: hsl(var(--foreground));
    }

    /* ============ TESTIMONIALS ============ */
    .testimonials {
      padding: 4rem 0;
    }

    @media (min-width: 768px) {
      .testimonials {
        padding: 5rem 0;
      }
    }

    .testimonials-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    @media (min-width: 768px) {
      .testimonials-inner {
        padding: 0 5rem;
      }
    }

    .testimonials-header {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    @media (min-width: 768px) {
      .testimonials-header {
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
      }
    }

    .testimonials-title-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 42rem;
    }

    .testimonials-title-wrap h2 {
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.4;
      color: hsl(var(--foreground));
    }

    .testimonials-title-wrap p {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.4;
      color: hsl(var(--muted-foreground));
    }

    .testimonials-nav {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .testimonials-nav button {
      width: 2.5rem;
      height: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: hsl(var(--secondary));
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .testimonials-nav button:hover {
      background: hsl(var(--secondary) / 0.8);
    }

    .testimonials-nav svg {
      width: 1.125rem;
      height: 1.125rem;
      color: hsl(var(--foreground));
    }

    .testimonials-carousel-wrap {
      position: relative;
    }

    .testimonials-carousel {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      padding-bottom: 1rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .testimonials-carousel::-webkit-scrollbar {
      display: none;
    }

    .testimonial-card {
      flex-shrink: 0;
      width: 320px;
      height: 288px;
      background: hsl(var(--card));
      border: 1px solid hsl(var(--border));
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .testimonial-stars {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin-bottom: 0.75rem;
    }

    .testimonial-stars svg {
      width: 1rem;
      height: 1rem;
      fill: hsl(var(--accent));
      color: hsl(var(--accent));
    }

    .testimonial-quote {
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1.4;
      color: hsl(var(--foreground));
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .testimonial-avatar {
      width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      background: hsl(var(--muted));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 500;
      color: hsl(var(--muted-foreground));
    }

    .testimonial-author p {
      font-size: 0.875rem;
      font-weight: 400;
      color: hsl(var(--muted-foreground));
    }

    .testimonials-fade {
      position: absolute;
      top: 0;
      right: 0;
      width: 120px;
      height: 100%;
      background: linear-gradient(270deg, hsl(var(--background)) 0%, transparent 100%);
      pointer-events: none;
    }

    @media (min-width: 768px) {
      .testimonials-fade {
        width: 272px;
      }
    }

    /* ============ FAQ ============ */
    .faq {
      padding: 4rem 0;
      background: hsl(var(--secondary) / 0.3);
    }

    @media (min-width: 768px) {
      .faq {
        padding: 6rem 0;
      }
    }

    .faq-header {
      margin-bottom: 3rem;
    }

    @media (min-width: 768px) {
      .faq-header {
        margin-bottom: 4rem;
      }
    }

    .faq-header h2 {
      font-size: 2rem;
      font-weight: 600;
      color: #0D1120;
      line-height: 1.4;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .faq-item {
      background: white;
      border: 1px solid #E3E3E3;
      border-radius: 1rem;
      padding: 1rem;
    }

    .faq-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .faq-item-header h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #0D1120;
      line-height: 1.4;
    }

    .faq-toggle-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: white;
      border: 1px solid #E3E3E3;
      border-radius: 0.75rem;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s;
    }

    .faq-toggle-btn:hover {
      background: hsl(var(--gray-50));
    }

    .faq-toggle-btn svg {
      width: 1rem;
      height: 1rem;
      color: #5C3984;
    }

    .faq-toggle-btn span {
      font-size: 0.875rem;
      font-weight: 500;
      color: #5C3984;
      line-height: 1.4;
    }

    .faq-answer {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: all 0.3s ease-in-out;
    }

    .faq-answer.open {
      max-height: 384px;
      opacity: 1;
      margin-top: 0.75rem;
    }

    .faq-answer p {
      font-size: 1rem;
      font-weight: 500;
      color: #797C81;
      line-height: 1.4;
    }

    /* ============ CTA BANNER ============ */
    .cta-banner {
      background: #5C3984;
      padding: 4rem 0;
    }

    @media (min-width: 768px) {
      .cta-banner {
        padding: 5rem 0;
      }
    }

    .cta-banner-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 1rem;
    }

    .cta-banner-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      max-width: 42rem;
      text-align: center;
    }

    .cta-banner h2 {
      font-size: 2rem;
      font-weight: 600;
      line-height: 1.4;
      color: white;
    }

    .cta-banner p {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.4;
      color: white;
    }

    .cta-banner .btn {
      margin-top: 2rem;
      margin-left: auto;
      margin-right: auto;
      display: block;
      background: white;
      color: #5C3984;
      border-radius: 0.75rem;
      padding: 0.5rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .cta-banner .btn:hover {
      background: rgba(255, 255, 255, 0.9);
    }

    /* ============ FOOTER ============ */
    .footer {
      background: #F7F7FD;
      padding: 1.5rem 1.5rem;
    }

    @media (min-width: 768px) {
      .footer {
        padding: 1.5rem 5rem;
      }
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 1280px;
      margin: 0 auto;
    }

    .footer-row {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    @media (min-width: 768px) {
      .footer-row {
        flex-direction: row;
      }
    }

    .footer-logo {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.25rem 0.625rem;
    }

    .footer-logo img {
      width: 2.5rem;
      height: 2.5rem;
      object-fit: contain;
    }

    .footer-logo span {
      font-weight: 600;
      font-size: 19px;
      line-height: 1.4;
      color: #3100A3;
    }

    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-nav a {
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.4;
      color: #0D1120;
      transition: opacity 0.2s;
    }

    .footer-nav a:hover {
      opacity: 0.7;
    }

    .footer-legal-row {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .footer-legal-row {
        flex-direction: row;
      }
    }

    .footer-copyright {
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.4;
      color: #797C81;
    }

    .footer-legal {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-legal a {
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.4;
      color: #797C81;
      transition: opacity 0.2s;
    }

    .footer-legal a:hover {
      opacity: 0.7;
    }

    /* Icons (inline SVG approach) */
    .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    /* ============ RTL (Arabic) ============ */
    html[dir="rtl"] body {
      direction: rtl;
    }

    /* Header RTL: DOM order is already mirrored in ERB, so keep CSS minimal */
    html[dir="rtl"] .header-logo {
      flex-direction: row-reverse; /* Logo text and icon order */
    }

    /* Desktop RTL header layout: force physical placement (CTA | NAV | LOGO) */
    @media (min-width: 768px) {
      html[dir="rtl"] .header-inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        direction: ltr; /* make column 1 = left, column 3 = right */
      }

      html[dir="rtl"] .header-cta {
        grid-column: 1;
        justify-self: start;
        direction: rtl;
      }

      html[dir="rtl"] .header-nav {
        grid-column: 2;
        justify-self: center;
        direction: rtl;
      }

      html[dir="rtl"] .header-logo {
        grid-column: 3;
        justify-self: end;
        direction: rtl;
      }
    }

    /* Mobile menu in RTL should match EN width: centered text, but full-width items */
    html[dir="rtl"] .mobile-menu-divider {
      align-items: stretch; /* match EN: don't shrink the buttons/links */
    }

    html[dir="rtl"] .hero-grid {
      direction: rtl; /* puts text on the right, image on the left */
    }

    @media (min-width: 1024px) {
      html[dir="rtl"] .hero-grid {
        grid-template-columns: 1fr 1fr; /* maintain 2 columns, but order reversed via direction: rtl */
      }
    }

    /* Mobile: center alignment for RTL */
    html[dir="rtl"] .hero-content {
      text-align: center;
    }

    html[dir="rtl"] .hero h1 {
      text-align: center;
    }

    html[dir="rtl"] .hero-badges {
      flex-direction: row-reverse; /* badges flow from right to left */
      justify-content: center; /* center on mobile */
    }

    html[dir="rtl"] .badge {
      flex-direction: row-reverse; /* text + icon in RTL */
    }

    html[dir="rtl"] .hero-features li {
      flex-direction: row-reverse; /* text + icon in RTL */
      text-align: center;
    }

    html[dir="rtl"] .hero-cta {
      text-align: center;
      align-items: center;
    }

    html[dir="rtl"] .hero-subtitle {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    /* Large screen: right alignment when image + text are side by side */
    @media (min-width: 1024px) {
      html[dir="rtl"] .hero-content {
        text-align: right;
      }

      html[dir="rtl"] .hero h1 {
        text-align: right;
      }

      html[dir="rtl"] .hero-badges {
        justify-content: flex-end; /* align to right edge in RTL (flex-start = right in RTL) */
        width: 100%;
        margin-right: 0; /* ensure no margin pushing away from edge */
      }

      html[dir="rtl"] .hero-features li {
        text-align: right;
        justify-content: flex-end; /* was flex-start in LTR */
      }

      html[dir="rtl"] .hero-cta {
        text-align: right;
        align-items: flex-start; /* align to right edge */
        width: 100%;
      }

      html[dir="rtl"] .hero-subtitle {
        text-align: right;
        margin-left: auto;
        margin-right: 0;
      }
    }

    html[dir="rtl"] .stats-grid {
      direction: rtl;
    }

    html[dir="rtl"] .features-header,
    html[dir="rtl"] .feature-card-content,
    html[dir="rtl"] .quality-standards-header,
    html[dir="rtl"] .testimonials-header,
    html[dir="rtl"] .faq-header,
    html[dir="rtl"] .cta-banner-inner,
    html[dir="rtl"] .footer-top,
    html[dir="rtl"] .footer-bottom {
      text-align: right;
    }

    html[dir="rtl"] .ai-insights-grid,
    html[dir="rtl"] .standards-grid,
    html[dir="rtl"] .testimonials-grid {
      direction: rtl;
    }

    html[dir="rtl"] .ai-feature-item,
    html[dir="rtl"] .ai-dashboard-header-actions,
    html[dir="rtl"] .ai-table-answer {
      flex-direction: row-reverse;
    }

    /* AI Insights feature list: center on mobile, align to right edge on desktop */
    html[dir="rtl"] .ai-insights-features {
      align-items: center;
      margin-left: auto;
      margin-right: auto;
    }

    html[dir="rtl"] .ai-feature-item {
      justify-content: center;
    }

    @media (min-width: 1024px) {
      html[dir="rtl"] .ai-insights-features {
        align-items: flex-end; /* requested: flex-end */
        margin-right: 0;
      }

      html[dir="rtl"] .ai-feature-item {
        justify-content: flex-end; /* requested: flex-end */
        width: 100%;
      }
    }

    html[dir="rtl"] .ai-table-header div,
    html[dir="rtl"] .ai-table-row > div {
      text-align: right;
    }

    html[dir="rtl"] .faq-item button {
      flex-direction: row-reverse;
    }

    html[dir="rtl"] .footer-nav,
    html[dir="rtl"] .footer-legal {
      flex-direction: row-reverse;
    }

    /* Ensure all card content is right-aligned in RTL */
    html[dir="rtl"] .feature-card,
    html[dir="rtl"] .testimonial-card,
    html[dir="rtl"] .testimonial-quote,
    html[dir="rtl"] .testimonial-author,
    html[dir="rtl"] .faq-item-header h3 {
      text-align: right;
    }

    /* Mirror margins: margin-left becomes margin-right in RTL */
    html[dir="rtl"] * {
      /* Use logical properties where possible, but also handle legacy margin-left */
    }

    /* Ensure any flex containers with flex-start align to flex-end in RTL */
    html[dir="rtl"] .testimonial-author {
      justify-content: flex-end;
    }

    /* Stats grid items should align right */
    html[dir="rtl"] .stats-grid > div {
      text-align: right;
    }

    /* AI insights dashboard content */
    html[dir="rtl"] .ai-dashboard-content,
    html[dir="rtl"] .ai-dashboard-header {
      text-align: right;
    }

    /* Standards cards content */
    html[dir="rtl"] .standards-card,
    html[dir="rtl"] .standards-card p {
      text-align: right;
    }

  </style>
</head>
<body>
  <!-- HEADER -->
  <header class="header">
    <div class="container-custom">
      <div class="header-inner">
        <% if rtl? %>
          <!-- Desktop CTA (RTL order: Notify Me then Language) -->
          <div class="header-cta">
            <a href="<%= new_waitlist_path %>" class="btn btn-primary"><%= t("home.header.notify_me") %></a>
            <a href="<%= switch_language_path(:en) %>" class="lang-switch"><%= t("home.header.switch_to_en") %></a>
          </div>

          <!-- Desktop Navigation (RTL visual order via dir=rtl + source order) -->
          <nav class="header-nav">
            <a href="#"><%= t("home.header.nav.home") %></a>
            <a href="mailto:info@wtexcellence.com"><%= t("home.header.nav.contact_us") %></a>
          </nav>

          <!-- Logo -->
          <a href="#" class="header-logo">
            <img src="<%= asset_path('logo.png') %>" alt="WTE Logo" onerror="this.style.display='none'">
            <span><%= t("home.header.brand") %></span>
          </a>
        <% else %>
          <!-- Logo -->
          <a href="#" class="header-logo">
            <img src="<%= asset_path('logo.png') %>" alt="WTE Logo" onerror="this.style.display='none'">
            <span><%= t("home.header.brand") %></span>
          </a>

          <!-- Desktop Navigation -->
          <nav class="header-nav">
            <a href="#"><%= t("home.header.nav.home") %></a>
            <a href="mailto:info@wtexcellence.com"><%= t("home.header.nav.contact_us") %></a>
          </nav>

          <!-- Desktop CTA -->
          <div class="header-cta">
            <a href="<%= switch_language_path(:ar) %>" class="lang-switch"><%= t("home.header.switch_to_ar") %></a>
            <a href="<%= new_waitlist_path %>" class="btn btn-primary"><%= t("home.header.notify_me") %></a>
          </div>
        <% end %>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Toggle menu">
          <svg id="menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="close-icon" style="display:none" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
