<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
      <% if @company %>
        <h2 style="color: #5C3984;">Welcome to <%= @company.name %>!</h2>
      <% elsif @user.delegated_admin? %>
        <h2 style="color: #5C3984;">Welcome as a Delegated Admin!</h2>
      <% else %>
        <h2 style="color: #5C3984;">Welcome to Way To Excellence!</h2>
      <% end %>
      
      <p>Hello <%= @user.name %>,</p>
      
      <% if @company %>
        <p>You've been invited to join <strong><%= @company.name %></strong> on our platform.</p>
        <p>Your role: <strong><%= @user.company_user&.role&.humanize || 'User' %></strong></p>
      <% elsif @user.delegated_admin? %>
        <p>You've been invited as a <strong>Delegated Admin</strong> on our platform.</p>
        <% if @user.permissions_array.any? %>
          <p>Your permissions:</p>
          <ul style="margin-left: 20px;">
            <% @user.permissions_array.each do |permission| %>
              <% permission_key = User::PERMISSIONS.key(permission) %>
              <li><%= permission_key ? t("permissions.#{permission_key}") : permission.humanize %></li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <p>You've been invited to join our platform.</p>
      <% end %>
      
      <p>To get started, please set up your password by clicking the link below:</p>
      
      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= @invitation_url %>" 
           style="background-color: #5C3984; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block;">
          Set Up Your Password
        </a>
      </div>
      
      <p style="color: #797C81; font-size: 12px;">
        This invitation link will expire in 7 days. If you didn't expect this invitation, you can safely ignore this email.
      </p>
      
      <p style="color: #797C81; font-size: 12px;">
        If the button above doesn't work, copy and paste this link into your browser:<br>
        <%= @invitation_url %>
      </p>
    </div>
  </body>
</html>

