<!-- List View (Table) -->
<div class="overflow-x-auto -mx-4 sm:mx-0">
    <table class="table-auto w-full min-w-[900px]">
        <thead>
            <tr class="border-b border-gray-200">
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500">
                    <input type="checkbox" class="rounded border-gray-300 text-[#5C3984] focus:ring-[#5C3984] w-4 h-4 sm:w-5 sm:h-5"/>
                </th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('name_description') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('type') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('in_folder') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('uploaded_by') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('last_modified') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"><%= t('linked_to') %></th>
                <th class="text-start py-3 px-3 sm:px-4 text-xs sm:text-sm font-medium text-gray-500"></th>
            </tr>
        </thead>
    <tbody>
        <% @files.each_with_index do |file, index| %>
            <% if file[:upload].present? %>
                <% folder_id = file[:upload].folder_id || (params[:id] == 'all' || params[:id] == 'legal_documents' ? params[:id] : params[:id]) %>
                <tr
                    class="border-b border-gray-100 <%= index.even? ? 'bg-gray-50 hover:bg-gray-100' : 'bg-white hover:bg-gray-50' %> transition-colors cursor-pointer" 
                    data-upload-id="<%= file[:upload].id %>"
                    data-controller="file-row file-drag"
                    data-action="click->file-row#openFile"
                    data-file-row-folder-id-value="<%= folder_id %>"
                    data-file-row-file-id-value="<%= file[:upload].id %>"
                    data-file-drag-upload-id-value="<%= file[:upload].id %>"
                    data-file-drag-file-name-value="<%= file[:name] %>">
            <% else %>
                <tr
                    class="border-b border-gray-100 <%= index.even? ? 'bg-gray-50 hover:bg-gray-100' : 'bg-white hover:bg-gray-50' %> transition-colors" 
                    data-upload-id="<%= file[:upload]&.id %>">
            <% end %>
                <!-- Checkbox -->
                <td class="py-4 px-3 sm:px-4">
                    <input type="checkbox" class="rounded border-gray-300 text-[#5C3984] focus:ring-[#5C3984] w-4 h-4 sm:w-5 sm:h-5"/>
                </td>

                <!-- Name & Description -->
                <td class="py-4 px-3 sm:px-4 min-w-[200px]">
                    <div class="flex flex-col">
                        <span class="font-semibold text-[#0D1120] text-xs sm:text-sm break-words"><%= file[:name] %></span>
                        <span class="text-xs text-gray-500 mt-1 truncate max-w-xs break-words"><%= file[:description] %></span>
                    </div>
                </td>

                <!-- Type -->
                <td class="py-4 px-3 sm:px-4 whitespace-nowrap">
                    <% 
                        type_classes = {
                          'PDF' => 'bg-red-100 text-red-800',
                          'Excel' => 'bg-green-100 text-green-800',
                          'Word' => 'bg-blue-100 text-blue-800',
                          'Image' => 'bg-purple-100 text-purple-800',
                          'Email' => 'bg-blue-100 text-blue-800',
                          'Text' => 'bg-gray-100 text-gray-800',
                          'File' => 'bg-gray-100 text-gray-800'
                        }
                        badge_class = type_classes[file[:type]] || 'bg-gray-100 text-gray-800'
                    %>
                    <span class="px-2 py-1 rounded-md text-[10px] sm:text-xs font-medium <%= badge_class %>">
                        <%= file[:type] %>
                    </span>
                </td>

                <!-- In Folder -->
                <td class="py-4 px-3 sm:px-4 min-w-[120px]">
                    <span class="text-xs sm:text-sm text-gray-700 break-words" data-folder-name="<%= file[:folder] %>"><%= file[:folder] %></span>
                </td>

                <!-- Uploaded by -->
                <td class="py-4 px-3 sm:px-4">
                    <div class="flex items-center gap-2 min-w-0">
                        <div class="rounded-full w-6 h-6 sm:w-8 sm:h-8 bg-pink-200 flex items-center justify-center overflow-hidden flex-shrink-0">
                            <% uploader = file[:upload]&.uploader %>
                            <% if uploader&.profile_image&.attached? %>
                                <%= image_tag user_profile_image_url(uploader), class: "w-full h-full object-cover max-w-full h-auto" %>
                            <% else %>
                                <% initials = uploader ? uploader.name.to_s.split(' ').map(&:first).join.upcase.presence : file[:uploaded_by].to_s.split(' ').map(&:first).join.upcase.presence %>
                                <span class="text-xs font-semibold text-pink-800"><%= initials || 'U' %></span>
                            <% end %>
                        </div>
                        <span class="text-xs sm:text-sm text-gray-700 truncate"><%= file[:uploaded_by] %></span>
                    </div>
                </td>

                <!-- Last Modified -->
                <td class="py-4 px-3 sm:px-4 whitespace-nowrap">
                    <span class="text-xs sm:text-sm text-gray-700"><%= file[:last_modified] || '-' %></span>
                </td>

                <!-- Linked To -->
                <td class="py-4 px-3 sm:px-4 min-w-[150px]">
                    <% if file[:linked_to].present? && file[:linked_to].any? %>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <% file[:linked_to].each do |link| %>
                                <a href="<%= link[:url] %>" data-turbo-frame="_top" class="text-[#5C3984] hover:text-[#4A2F6B] text-[10px] sm:text-xs font-medium px-2 py-1 rounded-md bg-blue-50 hover:bg-blue-100 transition-colors break-words">
                                    <%= link[:name] %>
                                </a>
                            <% end %>
                        </div>
                    <% else %>
                        <span class="text-xs sm:text-sm text-gray-400">-</span>
                    <% end %>
                </td>

                <!-- Three-dot menu -->
                <td class="py-4 px-3 sm:px-4">
                    <div class="relative" data-controller="dropdown" data-dropdown-fixed-value="true">
                        <button data-action="click->dropdown#toggle" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 20 20">
                                <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                            </svg>
                        </button>
                        <div data-dropdown-target="menu" class="hidden absolute end-0 mt-2 w-48 sm:w-40 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
                            <div class="py-1">
                                <% if file[:upload].present? %>
                                    <% folder_id = file[:upload].folder_id || (params[:id] == 'all' || params[:id] == 'legal_documents' ? params[:id] : params[:id]) %>
                                    <%= link_to folder_uploads_upload_path(folder_id: folder_id, id: file[:upload].id), data: { turbo_frame: "_top" }, class: "block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto" do %>
                                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                        <%= t('view') %>
                                    <% end %>
                                <% end %>
                                <% if file[:upload].present? && file[:upload].file.attached? %>
                                    <%= link_to signed_file_url(file[:upload].file, disposition: "attachment"), class: "block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto" do %>
                                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                        </svg>
                                        <%= t('download') %>
                                    <% end %>
                                <% else %>
                                    <span class="block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-400 cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                                        </svg>
                                        <%= t('download') %>
                                    </span>
                                <% end %>
                                <% if file[:upload].present? %>
                                    <button type="button" data-action="click->modal#open" data-modal-dialog-param="move_file_dialog" data-move-file-id="<%= file[:upload].id %>" data-move-file-name="<%= file[:name] %>" data-move-file-current-folder="<%= file[:upload].folder_id %>" class="w-full text-start block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                                        </svg>
                                        Move
                                    </button>
                                <% end %>
                                <% unless viewer? %>
                                  <% if file[:upload].present? && (current_user&.super_admin? || current_user&.delegated_admin? || file[:upload].uploaded_by == current_user&.id || current_user&.company_user&.has_admin_privileges?) %>
                                      <% folder_id = file[:upload].folder_id || (params[:id] == 'all' || params[:id] == 'legal_documents' ? params[:id] : params[:id]) %>
                                      <% if file[:upload].public? %>
                                          <button type="button" 
                                                  data-controller="file-visibility" 
                                                  data-action="click->file-visibility#changeVisibility" 
                                                  data-file-id="<%= file[:upload].id %>" 
                                                  data-folder-id="<%= folder_id %>"
                                                  data-visibility="private"
                                                  class="w-full text-start block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                              </svg>
                                              <%= t('document.make_private') %>
                                          </button>
                                      <% else %>
                                          <button type="button" 
                                                  data-controller="file-visibility" 
                                                  data-action="click->file-visibility#changeVisibility" 
                                                  data-file-id="<%= file[:upload].id %>" 
                                                  data-folder-id="<%= folder_id %>"
                                                  data-visibility="public"
                                                  class="w-full text-start block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                              </svg>
                                              <%= t('document.make_public') %>
                                          </button>
                                      <% end %>
                                  <% end %>
                                  <% if file[:upload].present? %>
                                      <button type="button" data-controller="file-delete" data-action="click->file-delete#openDeleteDialog" data-file-id="<%= file[:upload].id %>" data-file-name="<%= file[:name] %>" data-folder-id="<%= folder_id %>" class="w-full text-start block px-4 py-3 sm:py-2 text-xs sm:text-sm text-red-600 hover:bg-red-50 flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                          </svg>
                                          <%= t('delete') %>
                                      </button>
                                  <% end %>
                                  <% if file[:upload].present? %>
                                      <% folder_id = file[:upload].folder_id || (params[:id] == 'all' || params[:id] == 'legal_documents' ? params[:id] : params[:id]) %>
                                      <button type="button" data-action="click->modal#open" data-modal-dialog-param="move_file_dialog" data-move-file-id="<%= file[:upload].id %>" data-move-file-name="<%= file[:name] %>" data-move-file-current-folder="<%= file[:upload].folder_id %>" class="w-full text-start block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 flex items-center gap-2 min-h-[44px] sm:min-h-auto">
                                          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                                          </svg>
                                          Move
                                      </button>
                                  <% end %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
</div>

