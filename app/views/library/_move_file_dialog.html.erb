<dialog id="move_file_dialog" class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4" data-controller="modal dialog-no-backdrop-close">
    <div class="p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 sm:mb-6">
            <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words">Move File</h2>
            <button data-action="click->modal#close" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors duration-200" aria-label="<%= t('close') %>">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="move_file_form" class="space-y-4 sm:space-y-6" data-action="submit->modal#submitForm">
            <div>
                <label for="move_file_name" class="block text-sm font-medium text-gray-700 mb-2">File</label>
                <input type="text" id="move_file_name" readonly class="w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 cursor-not-allowed text-[16px] sm:text-sm">
                <input type="hidden" id="move_file_upload_id" name="upload_id">
            </div>

            <div data-controller="choices-select">
                <label for="move_file_folder_id" class="block text-sm font-medium text-gray-700 mb-2">Move to Folder</label>
                <select id="move_file_folder_id" name="folder_id" data-choices-select-target="select" class="w-full">
                    <option value="">No folder (remove from folder)</option>
                    <% @all_folders.each do |folder| %>
                        <option value="<%= folder.id %>"><%= folder.name %></option>
                    <% end %>
                </select>
                <p class="text-xs text-gray-500 mt-1 break-words">Select a folder to move the file to, or leave empty to remove from folder.</p>
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center <%= rtl? ? 'sm:justify-start sm:flex-row-reverse' : 'sm:justify-end' %> gap-2 <%= rtl? ? 'sm:space-x-reverse sm:space-x-3' : 'sm:space-x-3' %> pt-4">
                <button type="button" data-action="click->modal#closeById" data-modal-dialog-param="move_file_dialog" class="w-full sm:w-auto px-4 py-3 sm:py-2 text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200 min-h-[44px] text-[16px] sm:text-sm">
                    <%= t('cancel') %>
                </button>
                <button type="submit" class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-[#5C3984] hover:bg-[#4A2F6B] text-white rounded-lg font-medium transition-colors duration-200 min-h-[44px] text-[16px] sm:text-sm">
                    Move File
                </button>
            </div>
        </form>
    </div>
</dialog>

