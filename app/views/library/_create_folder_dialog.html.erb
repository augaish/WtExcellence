<dialog id="create_folder_dialog" class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-w-md w-full mx-4" data-controller="modal dialog-no-backdrop-close">
    <div class="p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4 sm:mb-6">
            <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('create_new_folder') %></h2>
            <button data-action="click->modal#close" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors duration-200" aria-label="<%= t('close') %>">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="create_folder_form" class="space-y-4 sm:space-y-6" data-action="submit->modal#submitForm" data-controller="folder-create">
            <input type="hidden" id="folder_parent_id" name="folder[parent_id]" value="" data-folder-create-target="parentId">
            <input type="hidden" id="company_id" name="company_id" value="<%= params[:company_id] %>">
            <div id="parent_folder_info" class="hidden bg-purple-50 border border-purple-200 rounded-lg p-3 mb-4" data-folder-create-target="parentInfo">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-purple-600 flex-shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                    </svg>
                    <span class="text-xs sm:text-sm text-purple-800 break-words">
                        <%= t('creating_subfolder_in') %>: <strong data-folder-create-target="parentName"></strong>
                    </span>
                </div>
            </div>
            <div>
                <label for="folder_name" class="block text-sm font-medium text-gray-700 mb-2"><%= t('folder_name') %></label>
                <input type="text" id="folder_name" name="folder[folder_name]" placeholder="<%= t('enter_folder_name') %>" class="w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 text-[16px] sm:text-sm" required>
            </div>

            <div>
                <label for="folder_description" class="block text-sm font-medium text-gray-700 mb-2"><%= t('folder_description') %></label>
                <textarea id="folder_description" name="folder[folder_description]" placeholder="<%= t('enter_folder_description') %>" rows="3" class="w-full px-4 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200 resize-none text-[16px] sm:text-sm"></textarea>
                <p class="text-xs text-gray-500 mt-1"><%= t('optional') %></p>
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center <%= rtl? ? 'sm:justify-start sm:flex-row-reverse' : 'sm:justify-end' %> gap-2 <%= rtl? ? 'sm:space-x-reverse sm:space-x-3' : 'sm:space-x-3' %> pt-4">
                <button type="button" data-action="click->modal#closeById" data-modal-dialog-param="create_folder_dialog" class="w-full sm:w-auto px-4 py-3 sm:py-2 text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200 min-h-[44px] text-[16px] sm:text-sm">
                    <%= t('cancel') %>
                </button>
                <button type="submit" class="w-full sm:w-auto px-6 py-3 sm:py-2 bg-[#5C3984] hover:bg-[#4A2F6B] text-white rounded-lg font-medium transition-colors duration-200 min-h-[44px] text-[16px] sm:text-sm">
                    <%= t('create_folder') %>
                </button>
            </div>
        </form>
    </div>
</dialog>
