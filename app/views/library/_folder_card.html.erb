<% 
  # Expected locals (either translation keys OR direct values):
  # Option 1: Translation keys (for static cards)
  #   - title_key: translation key for the folder title
  #   - description_key: translation key for the folder description
  # Option 2: Direct values (for dynamic folders from database)
  #   - folder: Folder object (required for delete functionality)
  #   - title: folder name string
  #   - description: folder description string
  # Common:
  #   - file_count: number of files
  #   - updated_date: optional date string (e.g., 'Oct 20, 2025')
  #   - button_text_key: translation key for button text (default: 'open_folder')
  
  _updated_date = local_assigns[:updated_date]
  _button_text_key = local_assigns[:button_text_key] || 'open_folder'
  _folder = local_assigns[:folder]
  _is_static = local_assigns[:title_key].present?
  
  # Determine which approach is being used
  _title = local_assigns[:title_key] ? t(local_assigns[:title_key]) : (local_assigns[:title] || '')
  _description = local_assigns[:description_key] ? t(local_assigns[:description_key]) : (local_assigns[:description] || '')
%>
<%
  _folder_color = _folder&.color || "#5C3984"
  _border_style = _folder ? "border-inline-start: 4px solid #{_folder_color};" : ""
%>
<div class="bg-[#FFFFFF] rounded-lg px-3 sm:px-4 pt-3 sm:pt-4 pb-3 border border-[#E3E3E3] hover:shadow-lg transition-shadow duration-200 h-full flex flex-col relative" 
     style="<%= _border_style %>" 
     <% if _folder %>
        draggable="true"
        data-controller="folder-drag folder-delete"
        data-folder-id="<%= _folder.id %>"
        data-folder-card-id="<%= _folder.id %>"
        data-folder-color="<%= _folder_color %>"
        data-folder-drag-folder-id-value="<%= _folder.id %>"
        data-folder-drag-target="folderCard"
        data-drop-target="true"
     <% end %>>
    <div class="flex-1">
        <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] mb-2 <%= _is_static ? 'pe-8' : 'pe-12' %> break-words"><%= _title %></h3>
        <p class="text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4 break-words"><%= _description %></p>

        <div class="flex items-center gap-2 <%= _updated_date.present? ? 'mb-2 sm:mb-3' : 'mb-3 sm:mb-4' %>">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span class="text-xs sm:text-sm font-medium text-[#0D1120]" data-folder-file-count><%= file_count %>
                <%= t('files') %></span>
        </div>

        <% if _updated_date.present? %>
            <div class="flex items-center gap-2 mb-3 sm:mb-4">
                <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs text-gray-500"><%= t('updated') %>
                    <%= _updated_date %></span>
            </div>
        <% end %>
    </div>

    <div class="flex items-center justify-between gap-2 sm:space-x-2 mt-auto">


        <% 
          company_id_param = local_assigns[:company_id]
          folder_id_param = local_assigns[:folder_id] || 'all'
          folder_url = if _is_static
            folder_path(folder_id_param, company_id: company_id_param)
          else
            folder_path(_folder, company_id: company_id_param)
          end
        %>
        <% if _is_static %>
            <%= link_to folder_url, data: { turbo_frame: "_top" }, class: "flex-1 flex items-center justify-center w-full bg-[#D6C4ED] hover:bg-[#CEBCE5] text-[#0D1120] px-3 sm:px-4 py-3 sm:py-2 rounded-lg font-medium transition-colors duration-200 min-h-[44px] text-xs sm:text-sm" do %>
                <span><%= t(_button_text_key) %></span>
                <svg class="w-4 h-4 ml-1 sm:ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= rtl? ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7' %>"></path>
                </svg>
            <% end %>
        <% else %>
            <%= link_to folder_url, data: { turbo_frame: "_top" }, draggable: "false", class: "flex-1 flex items-center justify-center w-full bg-[#D6C4ED] hover:bg-[#CEBCE5] text-[#0D1120] px-3 sm:px-4 py-3 sm:py-2 rounded-lg font-medium transition-colors duration-200 min-h-[44px] text-xs sm:text-sm" do %>
                <span><%= t(_button_text_key) %></span>
                <svg class="w-4 h-4 ml-1 sm:ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= rtl? ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7' %>"></path>
                </svg>
            <% end %>
        <% end %>
        <!-- Three-dot menu (only for dynamic folders, not static "All Uploaded Documents") -->
        <% unless _is_static %>
        <div class="relative flex-shrink-0" data-controller="dropdown">
            <button data-action="click->dropdown#toggle" draggable="false" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 20 20">
                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                </svg>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute end-0 bottom-full mb-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50" data-controller="folder-color">
                <div class="py-1">
                    <div class="px-4 py-2 border-b border-gray-200">
                        <label class="block text-xs font-medium text-gray-700 mb-2"><%= t('folder_color') %></label>
                        <div class="grid grid-cols-6 gap-2" data-folder-color-target="colorGrid">
                            <% 
                              # Define a set of basic colors
                              basic_colors = [
                                "#5C3984", # Purple (default)
                                "#3B82F6", # Blue
                                "#10B981", # Green
                                "#F59E0B", # Amber
                                "#EF4444", # Red
                                "#8B5CF6", # Violet
                                "#06B6D4", # Cyan
                                "#84CC16", # Lime
                                "#F97316", # Orange
                                "#EC4899", # Pink
                                "#6366F1", # Indigo
                                "#14B8A6", # Teal
                                "#FBBF24", # Yellow
                                "#DC2626", # Dark Red
                                "#059669", # Dark Green
                                "#1E40AF", # Dark Blue
                                "#7C3AED", # Dark Purple
                                "#BE185D"  # Dark Pink
                              ]
                            %>
                            <% basic_colors.each do |color| %>
                                <button type="button"
                                        data-action="click->folder-color#updateColor"
                                        data-folder-id="<%= _folder.id %>"
                                        data-color="<%= color %>"
                                        draggable="false"
                                        class="w-8 h-8 rounded border-2 transition-all duration-200 hover:scale-110 <%= _folder_color.upcase == color.upcase ? 'border-gray-800 ring-2 ring-gray-400' : 'border-gray-300 hover:border-gray-500' %>"
                                        style="background-color: <%= color %>"
                                        title="<%= color %>">
                                    <% if _folder_color.upcase == color.upcase %>
                                        <svg class="w-4 h-4 mx-auto text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                    <% end %>
                                </button>
                            <% end %>
                        </div>
                    </div>
                    <button data-action="click->modal#open" 
                            data-modal-dialog-param="create_folder_dialog" 
                            data-folder-parent-id="<%= _folder.id %>"
                            data-folder-parent-name="<%= _folder.name %>"
                            draggable="false"
                            class="w-full text-start px-4 py-3 sm:py-2 text-xs sm:text-sm text-[#5C3984] hover:bg-purple-50 transition-colors min-h-[44px] sm:min-h-auto" 
                            type="button">
                        <%= t('create_subfolder') %>
                    </button>
                    <button data-action="click->folder-delete#openDeleteDialog" data-folder-id="<%= _folder.id %>" data-folder-name="<%= _folder.name %>" data-folder-files-count="<%= _folder.file_count %>" draggable="false" class="w-full text-start px-4 py-3 sm:py-2 text-xs sm:text-sm text-red-600 hover:bg-red-50 transition-colors min-h-[44px] sm:min-h-auto" type="button">
                        <%= t('delete') %>
                    </button>
                </div>
            </div>
        </div>
    <% else %>
        <div class="w-5"></div>
    <% end %>
</div></div>
