<%= content_for :title, t('pp_records.title') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('pp_records.title'), subtitle: t('pp_records.subtitle') } do %>
      <%= link_to t('pp_records.packages.title'), dashboard_pp_packages_path, class: ui_btn_secondary %>
      <% if @record_type && PpRecord::DOA_TYPES.include?(@record_type) %>
        <%= link_to t('doa.title'), dashboard_authorities_path, class: ui_btn_primary %>
      <% elsif can_manage_pp_records? %>
        <%# The button names what the open tab holds: "Add policy" on Policies. %>
        <% add_label = @record_type ? t('pp_records.add_typed', type: t("pp_records.types.#{@record_type}")) : t('pp_records.add_record') %>
        <%= link_to add_label, new_dashboard_pp_record_path(record_type: @record_type), class: ui_btn_primary %>
      <% end %>
    <% end %>

    <%= render "dashboard/pp_records/tabs", active_type: @record_type, counts_by_type: @counts_by_type,
          total_count: @total_count, packages_count: @packages_count, on_packages: false %>

    <% if @due_for_review.any? %>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4">
        <p class="text-sm font-semibold text-amber-900 mb-1"><%= t('pp_records.review_due_title', count: @due_for_review.size) %></p>
        <p class="text-xs text-amber-800"><%= t('pp_records.review_due_hint') %></p>
      </div>
    <% end %>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-4 mb-4">
      <%= form_with url: dashboard_pp_records_path, method: :get, class: "flex flex-col sm:flex-row sm:items-end gap-3" do |f| %>
        <%= hidden_field_tag :record_type, @record_type %>
        <div class="flex-1 min-w-0">
          <%= f.label :q, t('pp_records.search'), class: "block text-xs font-medium text-[#797C81] mb-1" %>
          <%= f.text_field :q, value: @query, placeholder: t('pp_records.search_placeholder'),
                class: "w-full px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <label class="flex items-center gap-2 text-sm text-[#0D1120] sm:pb-2">
          <%= f.check_box :show_inactive, { checked: @show_inactive, class: "rounded border-[#E3E3E3] text-[#5C3984] focus:ring-[#5C3984]" }, "1", "0" %>
          <%= t('org_structure.show_inactive') %>
        </label>
        <% if can_see_versions? %>
          <label class="flex items-center gap-2 text-sm text-[#0D1120] sm:pb-2">
            <%= f.check_box :show_versions, { checked: @show_versions, class: "rounded border-[#E3E3E3] text-[#5C3984] focus:ring-[#5C3984]" }, "1", "0" %>
            <%= t('pp_records.show_versions') %>
          </label>
        <% end %>
        <button type="submit" class="<%= ui_btn_neutral %>"><%= t('apply') %></button>
      <% end %>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden">
      <% if @records.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
              <tr>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.code') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.record_title') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.type') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.version') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.owner') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.packages.package') %></span></th>
                <th class="text-start p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.review_date') %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @records.each do |record| %>
                <tr class="border-b border-[#E3E3E3] last:border-b-0 hover:bg-[#F7F7FD]">
                  <td class="p-4 text-sm font-mono text-[#797C81]"><%= record.code.presence || "—" %></td>
                  <td class="p-4">
                    <%= link_to record.display_title, dashboard_pp_record_path(record),
                          class: "text-sm font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
                    <% unless record.active? %>
                      <span class="ms-2 px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-500"><%= t('org_structure.inactive') %></span>
                    <% end %>
                  </td>
                  <td class="p-4 text-sm text-[#797C81]"><%= record.type_label %></td>
                  <td class="p-4 text-sm">
                    <span class="text-[#0D1120]">V<%= record.version_number %></span>
                    <% unless record.latest_version? %>
                      <span class="ms-1 px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-500"><%= t('pp_records.superseded') %></span>
                    <% end %>
                  </td>
                  <td class="p-4 text-sm text-[#797C81]">
                    <%= record.owner_org_unit&.display_name.presence || record.owner_user&.name.presence || "—" %>
                  </td>
                  <td class="p-4 text-sm">
                    <% if record.packaged? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-[#F6EEFF] text-[#5C3984]"><%= record.package.name %></span>
                    <% else %>
                      <span class="text-[#797C81]"><%= t('pp_records.packages.unpackaged') %></span>
                    <% end %>
                  </td>
                  <td class="p-4 text-sm">
                    <% if record.review_date.blank? %>
                      <span class="text-[#797C81]">—</span>
                    <% elsif record.review_overdue? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-red-100 text-red-700"><%= t('pp_records.overdue') %> · <%= record.review_date %></span>
                    <% elsif record.review_due_soon? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-amber-100 text-amber-800"><%= t('pp_records.due_soon') %> · <%= record.review_date %></span>
                    <% else %>
                      <span class="text-[#797C81]"><%= record.review_date %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% elsif @query.present? %>
        <%= render "dashboard/shared/empty_state", icon: 'library-icon.svg',
              title: t('pp_records.no_results'), subtitle: t('pp_records.no_results_hint') %>
      <% else %>
        <%= render "dashboard/shared/empty_state", icon: 'library-icon.svg',
              title: t('pp_records.empty_title'), subtitle: t('pp_records.empty_subtitle') %>
      <% end %>
    </div>
  </div>
</div>
