<%# The procedure's KPIs as rows, with an add row and a pencil per row. Locals: record %>
<% input = "w-full border border-[#E3E3E3] rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-[#5C3984]" %>
<% can_edit = can_manage_pp_records? && record.editable? %>
<div id="kpis" class="bg-white border border-[#E3E3E3] rounded-xl p-5" data-controller="authority-matrix"
     data-authority-matrix-reorder-authorities-url-value="<%= can_edit ? dashboard_pp_record_reorder_kpis_path(record) : '' %>">
  <h2 class="text-sm font-semibold text-[#0D1120] mb-1"><%= t('kpis.title') %></h2>
  <p class="text-xs text-[#797C81] mb-4"><%= t('kpis.hint') %></p>
  <% kpis = record.kpi_rows.to_a %>
  <% if kpis.empty? %><p class="text-sm text-[#797C81] mb-4"><%= t('kpis.none') %></p><% end %>
  <ol class="divide-y divide-[#E3E3E3] mb-4" data-authority-matrix-target="rows" data-category-id=""
      <%= 'data-action="dragover->authority-matrix#rowsDragOver drop->authority-matrix#authorityDrop"'.html_safe if can_edit %>>
    <% kpis.each_with_index do |kpi, index| %>
      <li class="py-3 flex items-start gap-3" data-authority-matrix-target="authority" data-authority-id="<%= kpi.id %>" data-controller="inline-edit"
          <%= 'draggable="true" data-action="dragstart->authority-matrix#authorityDragStart dragover->authority-matrix#authorityDragOver drop->authority-matrix#authorityDrop dragend->authority-matrix#authorityDragEnd"'.html_safe if can_edit %>>
        <% if can_edit %><span class="cursor-grab text-[#797C81] select-none" aria-hidden="true">⋮⋮</span><% end %>
        <span class="text-xs font-mono text-[#797C81] w-5" data-number><%= index + 1 %></span>
        <div class="min-w-0 flex-1" data-inline-edit-target="text">
          <p class="text-sm font-medium text-[#0D1120]"><%= kpi.name %></p>
          <p class="text-xs text-[#797C81]">
            <%= [ (kpi.target.present? ? "#{t('kpis.target')}: #{kpi.target} #{kpi.unit}" : nil), kpi.measurement_method.presence, kpi.frequency_label ].compact.join(" · ") %>
          </p>
        </div>
        <% if can_edit %>
          <%= form_with url: dashboard_pp_record_kpi_path(record, kpi), method: :patch, scope: :pp_record_kpi,
                        html: { hidden: true, class: "flex-1 grid gap-2 sm:grid-cols-3", data: { inline_edit_target: "form" } } do |f| %>
            <%= render "dashboard/pp_records/kpi_inputs", f: f, kpi: kpi, input: input %>
            <div class="sm:col-span-3 flex gap-2">
              <%= f.submit t('save'), class: ui_btn_secondary %>
              <button type="button" class="text-xs text-[#797C81] hover:underline" data-action="click->inline-edit#close"><%= t('cancel') %></button>
            </div>
          <% end %>
          <button type="button" class="text-[#5C3984] hover:text-[#4A2F6B]" data-action="click->inline-edit#open" title="<%= t('edit') %>" aria-label="<%= t('edit') %>">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L4 16z"/></svg>
          </button>
          <%= button_to t('delete'), dashboard_pp_record_kpi_path(record, kpi), method: :delete,
                form: { data: { turbo_confirm: t('are_you_sure') } }, class: "text-xs text-[#797C81] hover:text-red-600" %>
        <% end %>
      </li>
    <% end %>
  </ol>
  <% if can_edit %>
    <%= form_with url: dashboard_pp_record_kpis_path(record), method: :post, scope: :pp_record_kpi,
                  class: "grid gap-2 sm:grid-cols-3 border-t border-[#E3E3E3] pt-4" do |f| %>
      <%= render "dashboard/pp_records/kpi_inputs", f: f, kpi: PpRecordKpi.new, input: input %>
      <div class="sm:col-span-3"><%= f.submit t('kpis.add'), class: ui_btn_primary %></div>
    <% end %>
  <% end %>
</div>
