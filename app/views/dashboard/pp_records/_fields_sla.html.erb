<%# Service level agreement: what it covers, who provides it (the owning
    unit), and who the other party is - typed, so an internal agreement
    names a unit and an external one names the customer or organisation. %>
<div class="bg-white border border-[#E3E3E3] rounded-xl p-5 space-y-4" data-controller="counterparty-kind">
  <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('pp_records.section_identity') %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :title_en, t('pp_records.title_en'), class: label_class %>
      <%= f.text_field :title_en, class: input_class %>
    </div>
    <div>
      <%= f.label :title_ar, t('pp_records.title_ar'), class: label_class %>
      <%= f.text_field :title_ar, dir: "rtl", class: input_class %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :description, t('sla.scope_of_agreement'), class: label_class %>
      <%= f.text_area :description, rows: 3, class: input_class %>
    </div>
  </div>
</div>

<div class="bg-white border border-[#E3E3E3] rounded-xl p-5 space-y-4" data-controller="counterparty-kind">
  <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('sla.parties') %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render "dashboard/pp_records/ownership_fields", f: f, org_units: org_units, company_users: company_users,
          input_class: input_class, label_class: label_class, hint_class: hint_class, unit_label: t('sla.provider') %>
    <div>
      <%= f.label :counterparty_kind, t('sla.counterparty_kind'), class: label_class %>
      <%= f.select :counterparty_kind, PpRecord::COUNTERPARTY_KINDS.map { |k| [ t("sla.counterparty_kinds.#{k}"), k ] },
            { include_blank: t('pp_records.pick') }, class: input_class, data: { counterparty_kind_target: "kind", action: "change->counterparty-kind#refresh" } %>
    </div>
    <div data-counterparty-kind-target="unitBox">
      <%= f.label :counterparty_org_unit_id, t('sla.counterparty_unit'), class: label_class %>
      <%= f.select :counterparty_org_unit_id, org_units.map { |u| [ u.display_name, u.id ] }, { include_blank: t('pp_records.pick') }, class: input_class %>
    </div>
    <div data-counterparty-kind-target="nameBox">
      <%= f.label :counterparty, t('sla.counterparty'), class: label_class %>
      <%= f.text_field :counterparty, class: input_class, placeholder: t('sla.counterparty_placeholder') %>
      <p class="<%= hint_class %>"><%= t('sla.counterparty_hint') %></p>
    </div>
  </div>
  <p class="<%= hint_class %>"><%= t('sla.levels_after_save') %></p>
</div>
