<%#
  Reusable sidebar nav item.
  locals: label (String), path (String), icon (asset filename), active (Boolean)
  RTL is handled by the aside's dir attribute + logical properties.
%>
<%= link_to path,
    "aria-current": (active ? "page" : nil),
    class: "group relative flex items-center gap-3 rounded-lg px-3 h-11 text-sm font-medium transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#5C3984] focus-visible:ring-inset #{active ? 'bg-[#F1EAFB] text-[#5C3984]' : 'text-gray-600 hover:bg-gray-100 hover:text-[#0D1120]'}" do %>
  <% if active %>
    <span class="absolute inset-block-2 inset-inline-start-0 w-1 rounded-full bg-[#5C3984]"></span>
  <% end %>
  <%= nav_icon(icon) %>
  <span class="truncate"><%= label %></span>
<% end %>
