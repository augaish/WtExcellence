<aside id="sidebar"
       class="hidden sm:flex sm:flex-col w-64 bg-gray-50 border-e border-gray-200 h-full overflow-y-auto overflow-x-hidden"
       dir="<%= text_direction %>">
  <div class="flex-1 px-3 py-5 space-y-6">
    <% nav_sections.each do |section| %>
      <div>
        <p class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400"
           title="<%= section[:hint] %>"><%= section[:title] %></p>
        <nav class="space-y-1">
          <% section[:items].each do |item| %>
            <%= render "dashboard/shared/nav_item", label: item[:label], path: item[:path],
                icon: item[:icon], active: item[:active] %>
          <% end %>
        </nav>
      </div>
    <% end %>
  </div>

  <!-- Identity footer -->
  <div class="mt-auto border-t border-gray-200 px-5 py-4">
    <% if current_user&.super_admin? %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('role') %></p>
      <p class="text-sm font-semibold text-[#0D1120]"><%= t('super_admin') %></p>
    <% elsif current_user&.delegated_admin? %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('role') %></p>
      <p class="text-sm font-semibold text-[#0D1120]"><%= t('delegated_admin') %></p>
    <% elsif current_user&.company %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('company') %></p>
      <p class="text-sm font-semibold text-[#0D1120] truncate" title="<%= current_user.company.name %>"><%= current_user.company.name %></p>
    <% end %>
  </div>
</aside>
