<% path = request.path %>
<aside id="sidebar"
       class="hidden sm:flex sm:flex-col w-64 bg-gray-50 border-e border-gray-200 h-full overflow-y-auto overflow-x-hidden"
       dir="<%= text_direction %>">
  <div class="flex-1 px-3 py-5 space-y-6">

    <!-- Main -->
    <div>
      <p class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400"><%= t('main_menu') %></p>
      <nav class="space-y-1">
        <% if current_user&.super_admin? || current_user&.delegated_admin? || current_user&.company_user.present? %>
          <%= render "dashboard/shared/nav_item", label: t('overview'), path: dashboard_overview_path,
              icon: 'overview-icon.svg', active: path.include?('overview') %>
        <% end %>
        <% if module_enabled_for_current?(:standards) && !current_user&.risk_manager_only? %>
          <%= render "dashboard/shared/nav_item", label: t('standards'), path: standards_path,
              icon: 'standards-icon.svg', active: path.start_with?('/standards') %>
        <% end %>
        <% if module_enabled_for_current?(:capa) && !(current_user&.super_admin? || current_user&.delegated_admin? || current_user&.risk_manager_only?) %>
          <%= render "dashboard/shared/nav_item", label: t('capa_management'), path: dashboard_capa_management_path,
              icon: 'capa-management-icon.svg', active: path.include?('capa_management') %>
        <% end %>
        <% if module_enabled_for_current?(:library) && !current_user&.risk_manager_only? %>
          <%= render "dashboard/shared/nav_item", label: t('library'), path: library_path,
              icon: 'library-icon.svg', active: path.start_with?('/library') %>
        <% end %>
      </nav>
    </div>

    <!-- Governance -->
    <% show_risk = current_user&.can_manage_risks? && module_enabled_for_current?(:risk) %>
    <% show_vendors = current_user&.can_manage_vendors? && module_enabled_for_current?(:vendors) %>
    <% show_commitments = current_user&.can_manage_commitments? && module_enabled_for_current?(:commitments) %>
    <% if show_risk || show_vendors || show_commitments %>
      <div>
        <p class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400"><%= t('governance') %></p>
        <nav class="space-y-1">
          <% if show_risk %>
            <%= render "dashboard/shared/nav_item", label: t('risk_management'), path: dashboard_risk_management_index_path,
                icon: 'score-start-icon.svg', active: path.include?('risk_management') || path.include?('risk_workspaces') %>
          <% end %>
          <% if show_vendors %>
            <%= render "dashboard/shared/nav_item", label: t('vendor_management'), path: dashboard_vendors_path,
                icon: 'account-management-icon.svg', active: path.include?('vendors') %>
          <% end %>
          <% if show_commitments %>
            <%= render "dashboard/shared/nav_item", label: t('customer_commitments'), path: dashboard_customer_commitments_path,
                icon: 'calendar-03.png', active: path.include?('customer_commitments') %>
          <% end %>
        </nav>
      </div>
    <% end %>

    <!-- Settings -->
    <div>
      <p class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400"><%= t('settings') %></p>
      <nav class="space-y-1">
        <% if current_user&.can_manage_ai_instructions? && module_enabled_for_current?(:ai_instructions) %>
          <%= render "dashboard/shared/nav_item", label: t('ai_instructions'), path: dashboard_ai_instructions_path,
              icon: 'AI_logo.png', active: path.include?('ai_instructions') %>
        <% end %>
        <% if current_user&.can_manage_tools? && module_enabled_for_current?(:tools) %>
          <%= render "dashboard/shared/nav_item", label: t('tool_setup'), path: tools_path,
              icon: 'tool-setup-icon.svg', active: path.include?('tools') %>
        <% end %>
        <% if current_user&.super_admin? || current_user&.delegated_admin? %>
          <%= render "dashboard/shared/nav_item", label: t('credit_changes'), path: dashboard_credit_changes_path,
              icon: 'account-management-icon.svg', active: path.include?('credit_changes') %>
        <% end %>
        <% if current_user&.super_admin? || current_user&.delegated_admin? || current_user&.company_user&.company_admin? %>
          <%= render "dashboard/shared/nav_item", label: t('account_management'), path: dashboard_account_management_path,
              icon: 'account-management-icon.svg', active: path.include?('account_management') %>
        <% end %>
        <% if current_user&.company_user.present? && !current_user&.company_contributor? %>
          <%= render "dashboard/shared/nav_item", label: t('ai_usage'), path: dashboard_ai_insights_path,
              icon: 'overview-icon.svg', active: path.start_with?('/dashboard/ai_insights') %>
        <% end %>
        <%= render "dashboard/shared/nav_item", label: t('general_settings'), path: dashboard_general_settings_path,
            icon: 'general-settings-icon.svg', active: path.include?('general_settings') %>
      </nav>
    </div>
  </div>

  <!-- Identity footer -->
  <div class="mt-auto border-t border-gray-200 px-5 py-4">
    <% if current_user&.super_admin? %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('role') %></p>
      <p class="text-sm font-semibold text-[#0D1120]"><%= t('super_admin') %></p>
    <% elsif current_user&.delegated_admin? %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('role') %></p>
      <p class="text-sm font-semibold text-[#0D1120]"><%= t('delegated_admin') %></p>
    <% elsif current_user&.company %>
      <p class="text-[11px] text-gray-400 uppercase tracking-wider mb-0.5"><%= t('company') %></p>
      <p class="text-sm font-semibold text-[#0D1120] truncate" title="<%= current_user.company.name %>"><%= current_user.company.name %></p>
    <% end %>
  </div>
</aside>
