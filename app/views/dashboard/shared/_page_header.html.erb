<%# Consistent page header. Render with `layout:` and a block for action buttons. Locals: title, subtitle (optional). %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold text-[#0D1120] truncate"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-1 text-sm text-[#797C81]"><%= subtitle %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0">
    <%= yield %>
  </div>
</div>
