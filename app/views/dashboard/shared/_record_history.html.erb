<%# The record's own trail, folded: who did what to it and when. Locals: record %>
<% entries = record.activity_trail(limit: 30) %>
<details class="bg-white border border-[#E3E3E3] rounded-xl">
  <summary class="cursor-pointer p-5 text-sm font-semibold text-[#0D1120] list-none flex items-center justify-between">
    <%= t('activity.history') %>
    <span class="text-xs font-normal text-[#797C81]"><%= entries.size %></span>
  </summary>
  <% if entries.any? %>
    <ol class="divide-y divide-[#E3E3E3] border-t border-[#E3E3E3]">
      <% entries.each do |entry| %>
        <li class="px-5 py-3">
          <p class="text-sm text-[#0D1120]"><%= activity_entry_label(entry) %></p>
          <p class="text-xs text-[#797C81]"><%= entry.actor_user&.name || t('governance_activity.unknown_actor') %> · <%= l(entry.created_at, format: :long) %></p>
          <% sentences = activity_change_sentences(entry) %>
          <% if sentences.any? %>
            <ul class="mt-1 space-y-0.5 text-xs text-[#0D1120]"><% sentences.each do |sentence| %><li><%= sentence %></li><% end %></ul>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="px-5 pb-5 text-sm text-[#797C81]"><%= t('governance_activity.none') %></p>
  <% end %>
</details>
