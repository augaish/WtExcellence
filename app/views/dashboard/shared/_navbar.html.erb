<nav
    class="bg-white border-b border-[#E3E3E3] h-auto min-h-[56px] sm:h-16 flex items-center justify-between px-4 sm:px-6"
    data-rtl="<%= rtl? ? 'true' : 'false' %>">
    <!-- Left section (logo / title) -->
    <div class="flex items-center <%= rtl? ? 'flex-row-reverse space-x-reverse' : '' %> space-x-3">

        <%= link_to dashboard_overview_path, class: "flex items-center gap-2" do %>
            <%= image_tag asset_path('logo.png'), class: "w-8 h-8 max-w-full h-auto rounded-full flex-shrink-0" %>
            <span class="font-bold text-[#5C3984] text-base sm:text-lg leading-tight hidden sm:inline"><%= t('way_to_excellence') %></span>
        <% end %>

        <%# The company's own logo sits beside the WTE mark, never replacing it. %>
        <% if current_user&.company&.brand_logo&.attached? %>
            <span class="h-6 w-px bg-[#E3E3E3] flex-shrink-0" aria-hidden="true"></span>
            <%= image_tag dashboard_branding_logo_path,
                class: "h-8 w-auto max-w-[140px] object-contain flex-shrink-0",
                alt: current_user.company.name %>
        <% end %>
        <!-- Sidebar Toggle Button (Desktop) -->
        <button id="sidebarToggle" class="hidden sm:flex p-2 min-h-[44px] min-w-[44px] text-gray-600 hover:text-purple-900 hover:bg-purple-100 bg-[#F7F7FD] rounded-lg transition-colors duration-200 flex-shrink-0 items-center justify-center" onclick="toggleSidebar()" aria-label="<%= t('toggle_sidebar', default: 'Toggle sidebar') %>">
            <%= image_tag asset_path('sidebar-toogle-icon.svg'), class: "w-5 h-5 max-w-full h-auto" %>
        </button>
    </div>

    <!-- Mobile Hamburger Menu Button (visible on mobile only) -->
    <button id="mobileMenuToggle" class="sm:hidden p-2 min-h-[44px] min-w-[44px] text-gray-600 hover:text-purple-900 hover:bg-purple-100 bg-[#F7F7FD] rounded-lg transition-colors duration-200 flex items-center justify-center" onclick="toggleMobileMenu()" aria-label="<%= t('menu', default: 'Menu') %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>

    <!-- Desktop Right section (hidden on mobile) -->
    <div
        class="hidden sm:flex items-center <%= rtl? ? 'flex-row-reverse space-x-reverse' : '' %> space-x-4">
        <% unless current_user&.super_admin? || current_user&.delegated_admin? %>
        <!-- Current User Credits -->
        <div class="flex items-center <%= rtl? ? 'flex-row-reverse space-x-reverse' : '' %> space-x-2 bg-[#F7F7FD] px-3 sm:px-4 py-2 rounded-lg min-h-[44px]">
            <span class="text-[#5C3984] font-medium"><%= t('credits') %></span>
            <span class="text-[#0D1120] font-semibold" data-credit-balance><%= current_user_credit_balance %></span>
        </div>
        <% end %>

        <!-- Language Selector -->
        <div class="relative">
            <button class="flex items-center flex-row rtl:flex-row-reverse gap-2 bg-[#F7F7FD] hover:bg-purple-200 px-3 sm:px-4 py-2 sm:py-2.5 min-h-[44px] rounded-lg transition-colors duration-200 text-[15px] sm:text-sm" onclick="toggleLanguageDropdown()" aria-haspopup="true" aria-expanded="false">
                <!-- Language Icon - first in LTR, last in RTL -->
                <div class="text-[#5C3984] flex-shrink-0 order-1 rtl:order-3">
                    <%= image_tag asset_path('language-icon.svg'), class: "w-6 h-6 max-w-full h-auto text-[#5C3984]" %>
                </div>
                <!-- Language Text - middle in both -->
                <span class="text-[#5C3984] font-medium order-2"><%= t('language') %></span>
                <!-- Dropdown Arrow - last in LTR, first in RTL -->
                <div class="text-[#5C3984] flex-shrink-0 order-3 rtl:order-1">
                    <%= image_tag asset_path('down-arrow-icon.svg'), class: "w-3 h-2 max-w-full h-auto" %>
                </div>
            </button>

            <!-- Dropdown Menu -->
            <div id="languageDropdown" class="hidden absolute end-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
                <div class="py-1">
                    <% I18n.available_locales.each do |locale| %>
                        <% is_active = current_locale == locale %>
                        <% locale_name = locale == :en ? t('english') : t('arabic') %>
                        <%= link_to switch_language_path(locale), 
                            class: "flex items-center gap-2 px-4 py-2 min-h-[44px] text-sm #{is_active ? 'bg-purple-100 text-purple-900 font-semibold' : 'text-gray-700 hover:bg-purple-100 hover:text-purple-900'}",
                            data: { turbo: false } do %>
                            <!-- Flag/Emoji - first in LTR, last in RTL -->
                            <span class="flex-shrink-0 order-1 rtl:order-3">
                                <%= locale == :en ? '🇺🇸' : '🇸🇦' %>
                            </span>
                            <!-- Locale Name - middle in both -->
                            <span class="flex-1 order-2"><%= locale_name %></span>
                            <!-- Active Indicator - last in LTR, first in RTL -->
                            <% if is_active %>
                                <span class="text-purple-600 flex-shrink-0 order-3 rtl:order-1">✓</span>
                            <% end %>
                        <% end %>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Profile Button -->
        <div class="relative">
            <button class="flex items-center <%= rtl? ? 'flex-row-reverse space-x-reverse' : '' %> space-x-2 bg-[#F7F7FD] hover:bg-purple-200 px-3 sm:px-4 py-2 sm:py-2.5 min-h-[44px] rounded-lg transition-colors duration-200 text-[15px] sm:text-sm" onclick="toggleProfileDropdown()" aria-haspopup="true" aria-expanded="false">
                <div class="w-6 h-6 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0 overflow-hidden" data-navbar-profile-container>
                    <% if current_user.profile_image.attached? %>
                        <%= image_tag user_profile_image_url(current_user), class: "w-full h-full max-w-full h-auto object-contain", data: { navbar_profile_image: true } %>
                    <% else %>
                        <% initials = current_user.name.split(' ').map(&:first).join('').upcase[0..1] %>
                        <span class="text-white font-semibold text-xs" data-navbar-profile-initials><%= initials %></span>
                    <% end %>
                </div>
                <span class="text-[#5C3984] font-medium max-w-[120px] sm:max-w-none truncate" data-navbar-profile-name><%= current_user.name %></span>
                <div class="text-[#5C3984] flex-shrink-0">
                    <%= image_tag asset_path('down-arrow-icon.svg'), class: "w-3 h-2 max-w-full h-auto" %>
                </div>
            </button>


            <!-- Dropdown Menu -->
            <div id="profileDropdown" class="hidden absolute end-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
                <div class="py-1">
                    <%= link_to t('help.title'), help_path, class: "w-full text-start flex items-center px-4 py-2 min-h-[44px] text-sm text-gray-700 hover:bg-purple-100 hover:text-purple-900" %>
                    <%= button_to t('logout'), destroy_user_session_path, method: :delete, data: { turbo: false }, class: "w-full text-start flex items-center px-4 py-2 min-h-[44px] text-sm text-gray-700 hover:bg-purple-100 hover:text-purple-900" %>
                </div>
            </div>
        </div>

        <!-- Notification Bell Button + Dropdown -->
        <div class="relative">
            <button class="relative flex items-center justify-center bg-[#F7F7FD] hover:bg-purple-200 w-11 h-11 min-w-[44px] min-h-[44px] rounded-lg transition-colors duration-200" onclick="toggleNotificationDropdown()" aria-label="<%= t('notifications', default: 'Notifications') %>" aria-haspopup="true" aria-expanded="false">
                <div class="text-[#5C3984]">
                    <%= image_tag asset_path('bell-icon.svg'), class: "w-4 h-5 max-w-full h-auto" %>
                </div>
                <% if @unread_notifications_count.to_i.positive? %>
                <span class="absolute top-1.5 end-1.5 flex h-2.5 w-2.5 rtl:start-1.5 rtl:end-auto">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-purple-600"></span>
                </span>
                <% end %>
            </button>

            <!-- Notification Dropdown (Facebook-style) -->
            <div id="notificationDropdown" class="hidden absolute end-0 mt-2 w-[380px] max-w-[calc(100vw-2rem)] max-h-[min(80vh,480px)] bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden flex flex-col">
                <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 bg-[#F7F7FD]">
                    <h3 class="font-semibold text-[#0D1120]"><%= t('notifications', default: 'Notifications') %></h3>
                    <% if @unread_notifications_count.to_i.positive? %>
                    <%= button_to dashboard_notifications_mark_all_read_path, method: :patch, data: { turbo: false }, form: { class: "inline-block" }, class: "text-sm text-[#5C3984] hover:text-purple-900 font-medium bg-transparent border-none cursor-pointer p-0" do %>
                        <%= t('mark_all_read', default: 'Mark all as read') %>
                    <% end %>
                    <% end %>
                </div>
                <div class="overflow-y-auto flex-1 py-1 divide-y divide-gray-100">
                    <% if @recent_notifications.present? %>
                        <% @recent_notifications.each do |notification| %>
                            <%= render "dashboard/notifications/notification_row", notification: notification, rtl: rtl? %>
                        <% end %>
                    <% else %>
                        <p class="px-4 py-6 text-sm text-gray-500 text-center"><%= t('no_notifications', default: 'No notifications yet') %></p>
                    <% end %>
                </div>
                <div class="border-t border-gray-200 px-4 py-2 bg-gray-50">
                    <%= link_to dashboard_notifications_path, class: "block text-center text-sm font-medium text-[#5C3984] hover:text-purple-900 py-2" do %>
                      <%= t('view_all_notifications', default: 'View all notifications') %>
                    <% end %>
                </div>
            </div>
        </div>

    </div>

    <!-- Mobile Menu Overlay (visible on mobile only when opened) -->
    <div id="mobileMenuOverlay" class="hidden fixed inset-0 backdrop-blur-md bg-white/30 z-40" onclick="toggleMobileMenu()"></div>

    <!-- Mobile Menu Panel (slides in from right/left based on direction) -->
    <div id="mobileMenuPanel" class="fixed top-0 <%= rtl? ? 'left-0' : 'right-0' %> h-full w-80 max-w-[85vw] bg-white shadow-2xl z-50 transform <%= rtl? ? '-translate-x-full' : 'translate-x-full' %> transition-transform duration-300 ease-in-out overflow-y-auto" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
        <div class="flex flex-col h-full">
            <!-- Mobile Menu Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-200">
                <h2 class="text-lg font-bold text-[#0D1120]"><%= t('menu', default: 'Menu') %></h2>
                <button onclick="toggleMobileMenu()" class="p-2 text-gray-600 hover:text-purple-900 hover:bg-purple-100 rounded-lg transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="<%= t('close', default: 'Close') %>">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu Content -->
            <div class="flex-1 overflow-y-auto p-4">
                <%# Rendered from the same definition as the desktop sidebar (NavigationHelper#nav_sections) %>
                <% nav_sections.each do |section| %>
                    <div class="mb-6">
                        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2"><%= section[:title] %></h3>
                        <nav class="space-y-1">
                            <% section[:items].each do |item| %>
                                <% item_class = "flex items-center gap-3 py-3 px-3 rounded-lg hover:bg-purple-100 text-gray-700 font-medium min-h-[44px] #{'bg-purple-100 text-purple-900' if item[:active]}" %>
                                <%= link_to item[:path], class: item_class, onclick: "toggleMobileMenu();" do %>
                                    <%= image_tag asset_path(item[:icon]), class: "w-5 h-5 flex-shrink-0", alt: "" %>
                                    <span><%= item[:label] %></span>
                                <% end %>
                            <% end %>
                        </nav>
                    </div>
                <% end %>

                <!-- Divider -->
                <div class="border-t border-gray-200 my-4"></div>

                <% unless current_user&.super_admin? || current_user&.delegated_admin? %>
                <!-- Credits Display -->
                <div class="flex items-center justify-between gap-3 py-3 px-4 bg-[#F7F7FD] rounded-lg mb-4">
                    <span class="text-[#5C3984] font-medium"><%= t('credits') %></span>
                    <span class="text-[#0D1120] font-semibold text-lg" data-credit-balance><%= current_user_credit_balance %></span>
                </div>
                <% end %>

                <!-- User Profile Section -->
                <div class="py-3 px-4 bg-[#F7F7FD] rounded-lg mb-4">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0">
                            <% if current_user.profile_image.attached? %>
                                <%= image_tag user_profile_image_url(current_user), class: "w-full h-full object-contain" %>
                            <% else %>
                                <% initials = current_user.name.split(' ').map(&:first).join('').upcase[0..1] %>
                                <span class="text-white font-semibold text-base"><%= initials %></span>
                            <% end %>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-[#0D1120] truncate"><%= current_user.name %></p>
                            <p class="text-sm text-gray-600 truncate"><%= current_user.email %></p>
                        </div>
                    </div>
                    <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "w-full flex items-center justify-center gap-2 py-3 px-4 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition-colors min-h-[44px]" do %>
                        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        <span><%= t('logout') %></span>
                    <% end %>
                </div>

                <!-- Company/Role Info -->
                <div class="py-3 px-4 bg-gray-50 rounded-lg mb-4">
                    <% if current_user&.super_admin? %>
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1"><%= t('role') %></p>
                        <p class="text-sm font-medium text-[#0D1120]"><%= t('super_admin') %></p>
                    <% elsif current_user&.delegated_admin? %>
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1"><%= t('role') %></p>
                        <p class="text-sm font-medium text-[#0D1120]">Delegated Admin</p>
                    <% elsif current_user&.company %>
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-1"><%= t('company') %></p>
                        <p class="text-sm font-medium text-[#0D1120] break-words"><%= current_user.company.name %></p>
                    <% end %>
                </div>

                <!-- Language Selector -->
                <div class="mb-4">
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2 px-4"><%= t('language') %></h3>
                    <div class="space-y-1">
                        <% I18n.available_locales.each do |locale| %>
                            <% is_active = current_locale == locale %>
                            <% locale_name = locale == :en ? t('english') : t('arabic') %>
                            <% lang_link_class = "flex items-center gap-3 py-3 px-4 rounded-lg min-h-[44px] #{is_active ? 'bg-purple-100 text-purple-900 font-semibold' : 'text-gray-700 hover:bg-purple-50'}" %>
                            <%= link_to switch_language_path(locale), 
                                class: lang_link_class,
                                onclick: "closeMobileMenuBeforeNavigate();",
                                data: { turbo: false } do %>
                                <span class="text-2xl flex-shrink-0"><%= locale == :en ? '🇺🇸' : '🇸🇦' %></span>
                                <span class="flex-1"><%= locale_name %></span>
                                <% if is_active %>
                                    <svg class="w-5 h-5 text-purple-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                <% end %>
                            <% end %>
                        <% end %>
                    </div>
                </div>

                <!-- Notifications -->
                <%= link_to dashboard_notifications_path, class: "w-full flex items-center gap-3 py-3 px-4 rounded-lg hover:bg-purple-100 text-gray-700 font-medium border border-gray-200 min-h-[44px]", onclick: "toggleMobileMenu();" do %>
                    <%= image_tag asset_path('bell-icon.svg'), class: "w-5 h-5 flex-shrink-0" %>
                    <span><%= t('notifications', default: 'Notifications') %></span>
                <% end %>
            </div>
        </div>
    </div>
</nav>

<script>
    function toggleMobileMenu() {
        const overlay = document.getElementById('mobileMenuOverlay');
        const panel = document.getElementById('mobileMenuPanel');
        const navbar = document.querySelector('nav[data-rtl]');
        const isRtl = navbar && navbar.getAttribute('data-rtl') === 'true';
        
        if (overlay.classList.contains('hidden')) {
            // Open menu
            overlay.classList.remove('hidden');
            panel.classList.remove(isRtl ? '-translate-x-full' : 'translate-x-full');
            panel.classList.add('translate-x-0');
            document.body.style.overflow = 'hidden'; // Prevent body scroll
        } else {
            // Close menu
            overlay.classList.add('hidden');
            panel.classList.add(isRtl ? '-translate-x-full' : 'translate-x-full');
            panel.classList.remove('translate-x-0');
            document.body.style.overflow = ''; // Restore body scroll
        }
    }

    function closeMobileMenuBeforeNavigate() {
        const overlay = document.getElementById('mobileMenuOverlay');
        const panel = document.getElementById('mobileMenuPanel');
        const navbar = document.querySelector('nav[data-rtl]');
        const isRtl = navbar && navbar.getAttribute('data-rtl') === 'true';
        
        if (!overlay.classList.contains('hidden')) {
            // Close menu immediately before navigation
            overlay.classList.add('hidden');
            panel.classList.add(isRtl ? '-translate-x-full' : 'translate-x-full');
            panel.classList.remove('translate-x-0');
            document.body.style.overflow = '';
        }
    }
</script>
