<%= content_for :title, @package.name %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: {
          title: @package.name, subtitle: @package.window_label || t('pp_records.packages.no_window') } do %>
      <%= link_to t('back'), dashboard_pp_packages_path, class: ui_btn_neutral %>
      <% if can_manage_pp_records? %>
        <%= link_to t('edit'), edit_dashboard_pp_package_path(@package), class: ui_btn_primary %>
      <% end %>
    <% end %>

    <!-- Progress against the package's own window -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-[#0D1120]"><%= t('pp_records.packages.progress') %></span>
        <span class="text-sm font-semibold text-[#5C3984]"><%= @package.completion_percentage %>%</span>
      </div>
      <div class="h-2 bg-[#F0F0F5] rounded-full overflow-hidden">
        <div class="h-full bg-[#5C3984] rounded-full" style="width: <%= @package.completion_percentage %>%"></div>
      </div>
      <p class="mt-2 text-xs text-[#797C81]">
        <%= t('pp_records.packages.progress_hint', completed: @package.completed_count, total: @package.records_count) %>
      </p>
      <% if @package.notes.present? %>
        <p class="mt-3 pt-3 border-t border-[#E3E3E3] text-sm text-[#0D1120] whitespace-pre-line"><%= @package.notes %></p>
      <% end %>
    </div>

    <!-- One sub-tab per record type -->
    <div class="border-b border-[#E3E3E3] mb-4 overflow-x-auto">
      <nav class="flex items-center gap-1 min-w-max">
        <% PpRecord::TYPES.each do |type| %>
          <% is_active = (@record_type == type) %>
          <%= link_to dashboard_pp_package_path(@package, record_type: type),
                class: "px-3 py-2.5 text-sm font-medium border-b-2 -mb-px whitespace-nowrap focus-visible:outline-2 focus-visible:outline-[#5C3984] #{is_active ? 'border-[#5C3984] text-[#5C3984]' : 'border-transparent text-[#797C81] hover:text-[#0D1120] hover:border-[#E3E3E3]'}" do %>
            <%= t("pp_records.types_plural.#{type}") %>
            <span class="ms-1 text-xs text-[#797C81]">(<%= @counts_by_type[type].to_i %>)</span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-[#E3E3E3] bg-[#F7F7FD]">
        <p class="text-xs font-semibold text-[#797C81]"><%= t('pp_records.packages.compose_hint') %></p>
      </div>

      <% if @records.any? %>
        <ul class="divide-y divide-[#E3E3E3]">
          <% @records.each do |record| %>
            <% in_this_package = record.package_id == @package.id %>
            <% in_other_package = record.packaged? && !in_this_package %>
            <li class="flex items-center gap-3 px-4 py-3 <%= in_this_package ? 'bg-[#F6EEFF]/40' : '' %>">
              <div class="flex-shrink-0 w-5 flex items-center justify-center">
                <% if in_this_package && can_manage_pp_records? %>
                  <%# Ticked: unticking removes it from this package. %>
                  <%= button_to remove_record_dashboard_pp_package_path(@package, record_id: record.id, record_type: @record_type),
                        method: :delete, form: { class: "inline" },
                        class: "w-4 h-4 rounded border border-[#5C3984] bg-[#5C3984] text-white flex items-center justify-center text-[10px] leading-none focus-visible:outline-2 focus-visible:outline-[#5C3984]",
                        aria: { label: t('pp_records.packages.remove_from_package') } do %>✓<% end %>
                <% elsif in_other_package %>
                  <%# Deliberately NOT a checkbox: moving a committed record is an explicit action. %>
                  <span class="w-4 h-4 rounded border border-[#E3E3E3] bg-gray-100" aria-hidden="true"></span>
                <% elsif can_manage_pp_records? %>
                  <%= button_to assign_record_dashboard_pp_package_path(@package, record_id: record.id, record_type: @record_type),
                        method: :post, form: { class: "inline" },
                        class: "w-4 h-4 rounded border border-[#E3E3E3] bg-white hover:border-[#5C3984] focus-visible:outline-2 focus-visible:outline-[#5C3984]",
                        aria: { label: t('pp_records.packages.add_to_package') } do %><span class="sr-only"><%= t('pp_records.packages.add_to_package') %></span><% end %>
                <% else %>
                  <span class="w-4 h-4 rounded border border-[#E3E3E3] bg-white" aria-hidden="true"></span>
                <% end %>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <%= link_to record.display_title, dashboard_pp_record_path(record),
                        class: "text-sm font-medium text-[#0D1120] hover:text-[#5C3984] hover:underline truncate focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
                  <% if record.code.present? %>
                    <span class="text-xs font-mono text-[#797C81]"><%= record.code %></span>
                  <% end %>
                  <% if in_other_package %>
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-amber-100 text-amber-800">
                      <%= t('pp_records.packages.already_in', package: record.package.name) %>
                    </span>
                  <% end %>
                </div>
                <% if record.owner_org_unit %>
                  <p class="mt-0.5 text-xs text-[#797C81] truncate"><%= record.owner_org_unit.display_name %></p>
                <% end %>
              </div>

              <% if in_other_package && can_manage_pp_records? %>
                <%= button_to t('pp_records.packages.reassign'),
                      assign_record_dashboard_pp_package_path(@package, record_id: record.id, record_type: @record_type, reassign: true),
                      method: :post,
                      class: "flex-shrink-0 px-2.5 py-1 text-xs font-medium text-amber-800 border border-amber-300 rounded-lg hover:bg-amber-50 focus-visible:outline-2 focus-visible:outline-amber-600",
                      form: { class: "inline", data: { turbo_confirm: t('pp_records.packages.confirm_reassign', title: record.display_title, from: record.package.name, to: @package.name) } } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "dashboard/shared/empty_state", icon: 'library-icon.svg',
              title: t('pp_records.packages.no_records_of_type'), subtitle: t('pp_records.packages.no_records_of_type_hint') %>
      <% end %>
    </div>
  </div>
</div>
