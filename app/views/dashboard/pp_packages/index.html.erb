<%= content_for :title, t('pp_records.packages.title') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('pp_records.title'), subtitle: t('pp_records.packages.subtitle') } do %>
      <% if can_manage_pp_records? %>
        <%= link_to t('pp_records.packages.add'), new_dashboard_pp_package_path, class: ui_btn_primary %>
      <% end %>
    <% end %>

    <%= render "dashboard/pp_records/tabs",
          active_type: nil,
          counts_by_type: current_company.pp_records.active.group(:record_type).count,
          total_count: current_company.pp_records.active.count,
          packages_count: @packages.size, on_packages: true %>

    <% if @packages.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @packages.each do |package| %>
          <div class="bg-white border border-[#E3E3E3] rounded-xl p-5 flex flex-col">
            <div class="flex-1 min-w-0">
              <%= link_to package.name, dashboard_pp_package_path(package),
                    class: "text-sm font-semibold text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984] break-words" %>
              <% if package.window_label %>
                <p class="mt-1 text-xs text-[#797C81]"><%= package.window_label %></p>
              <% end %>
              <p class="mt-3 text-xs text-[#797C81]">
                <%= t('pp_records.packages.records_count', count: package.records_count) %>
              </p>
              <div class="mt-2">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="text-[#797C81]"><%= t('pp_records.packages.progress') %></span>
                  <span class="font-semibold text-[#0D1120]"><%= package.completion_percentage %>%</span>
                </div>
                <div class="h-1.5 bg-[#F0F0F5] rounded-full overflow-hidden">
                  <div class="h-full bg-[#5C3984] rounded-full" style="width: <%= package.completion_percentage %>%"></div>
                </div>
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-[#E3E3E3] flex items-center gap-2">
              <%= link_to t('pp_records.packages.open'), dashboard_pp_package_path(package),
                    class: "text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
              <% if can_manage_pp_records? %>
                <span class="text-[#E3E3E3]">|</span>
                <%= link_to t('edit'), edit_dashboard_pp_package_path(package),
                      class: "text-xs font-medium text-[#797C81] hover:text-[#0D1120] focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border border-[#E3E3E3] rounded-xl">
        <%= render "dashboard/shared/empty_state", icon: 'library-icon.svg',
              title: t('pp_records.packages.empty_title'), subtitle: t('pp_records.packages.empty_subtitle') %>
      </div>
    <% end %>
  </div>
</div>
