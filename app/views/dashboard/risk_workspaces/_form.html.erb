<%= form_with model: @risk_workspace, url: (@risk_workspace.new_record? ? dashboard_risk_workspaces_path : dashboard_risk_workspace_path(@risk_workspace)), method: (@risk_workspace.new_record? ? :post : :patch), class: "space-y-6" do |f| %>

  <% if @risk_workspace.errors.any? %>
    <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800 mb-2">
            <%= pluralize(@risk_workspace.errors.count, "error") %> prohibited this workspace from being saved:
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @risk_workspace.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
    <div>
      <%= f.label :name, t('name'), class: ui_label %>
      <%= f.text_field :name, class: ui_input %>
    </div>

    <div>
      <%= f.label :framework, t('framework'), class: ui_label %>
      <%= f.text_field :framework, placeholder: "ISO 27001, SOC 2, Finance...", class: ui_input %>
    </div>

    <div>
      <%= f.label :department_scope, t('department_scope'), class: ui_label %>
      <%= f.text_field :department_scope, class: ui_input %>
    </div>

    <div>
      <%= f.label :description, t('description'), class: ui_label %>
      <%= f.text_area :description, rows: 3, class: ui_input %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t('cancel'), dashboard_risk_workspaces_path, class: ui_btn_neutral %>
    <%= f.submit (@risk_workspace.new_record? ? t('create_workspace') : t('save_changes')), class: ui_btn_primary %>
  </div>
<% end %>
