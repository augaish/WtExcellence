<%= form_with model: @risk_workspace, url: (@risk_workspace.new_record? ? dashboard_risk_workspaces_path : dashboard_risk_workspace_path(@risk_workspace)), method: (@risk_workspace.new_record? ? :post : :patch), class: "space-y-6" do |f| %>

  <% if @risk_workspace.errors.any? %>
    <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800 mb-2">
            <%= pluralize(@risk_workspace.errors.count, "error") %> prohibited this workspace from being saved:
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @risk_workspace.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
    <div>
      <%= f.label :name, t('name'), class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :name, class: "w-full px-4 py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2" %>
    </div>

    <div>
      <%= f.label :framework, t('framework'), class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :framework, placeholder: "ISO 27001, SOC 2, Finance...", class: "w-full px-4 py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2" %>
    </div>

    <div>
      <%= f.label :department_scope, t('department_scope'), class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :department_scope, class: "w-full px-4 py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2" %>
    </div>

    <div>
      <%= f.label :description, t('description'), class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :description, rows: 3, class: "w-full px-4 py-3 border border-gray-300 focus:ring-[#5C3984] focus:border-transparent rounded-lg focus:outline-none focus:ring-2" %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t('cancel'), dashboard_risk_workspaces_path, class: "px-4 py-2 text-sm text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50" %>
    <%= f.submit (@risk_workspace.new_record? ? t('create_workspace') : t('save_changes')), class: "px-4 py-2 text-sm text-white bg-[#5C3984] hover:bg-[#4A2F6B] rounded-lg transition-colors" %>
  </div>
<% end %>
