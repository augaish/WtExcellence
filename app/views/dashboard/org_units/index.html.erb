<%= content_for :title, t('org_structure.title') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('org_structure.title'), subtitle: t('org_structure.subtitle') } do %>
      <%= link_to t('org_structure.chart.chart_view'), dashboard_org_units_chart_path, class: ui_btn_neutral %>
      <% if can_manage_org_structure? %>
        <%= link_to t('org_structure.settings'), settings_dashboard_org_units_path, class: ui_btn_neutral %>
        <%= link_to t('org_structure.import_title'), import_dashboard_org_units_path, class: ui_btn_secondary %>
        <%= link_to t('org_structure.add_unit'), new_dashboard_org_unit_path, class: ui_btn_primary %>
      <% end %>
    <% end %>

    <!-- Filters -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl p-4 mb-4">
      <%= form_with url: dashboard_org_units_path, method: :get, data: { turbo_frame: "_top" }, class: "flex flex-col sm:flex-row sm:items-end gap-3" do |f| %>
        <div class="flex-1 min-w-0">
          <%= f.label :q, t('org_structure.search'), class: "block text-xs font-medium text-[#797C81] mb-1" %>
          <%= f.text_field :q, value: @query, placeholder: t('org_structure.search_placeholder'),
                class: "w-full px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <label class="flex items-center gap-2 text-sm text-[#0D1120] sm:pb-2">
          <%= f.check_box :show_inactive, { checked: @show_inactive, class: "rounded border-[#E3E3E3] text-[#5C3984] focus:ring-[#5C3984]" }, "1", "0" %>
          <%= t('org_structure.show_inactive') %>
        </label>
        <button type="submit" class="<%= ui_btn_neutral %>"><%= t('apply') %></button>
      <% end %>
    </div>

    <!-- Legend -->
    <% if @groups.any? %>
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs text-[#797C81]">
        <span class="font-medium"><%= t('org_structure.groups') %>:</span>
        <% @groups.each do |group| %>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= group.color %>"></span>
            <%= group.display_name %>
          </span>
        <% end %>
      </div>
    <% end %>

    <!-- Tree -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden" data-controller="org-tree">
      <div class="flex items-center justify-between px-4 py-3 border-b border-[#E3E3E3] bg-[#F7F7FD]">
        <span class="text-xs font-semibold text-[#797C81]"><%= t('org_structure.units_count', count: @total_count) %></span>
        <div class="flex items-center gap-2">
          <button type="button" data-action="click->org-tree#expandAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('expand_all') %></button>
          <span class="text-[#E3E3E3]">|</span>
          <button type="button" data-action="click->org-tree#collapseAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('collapse_all') %></button>
        </div>
      </div>

      <% if @roots.any? %>
        <% @roots.each do |unit| %>
          <%= render "dashboard/org_units/unit_row", unit: unit, units_by_parent: @units_by_parent, depth: 0, can_manage: can_manage_org_structure? %>
        <% end %>
      <% elsif @query.present? %>
        <%= render "dashboard/shared/empty_state", icon: 'account-management-icon.svg',
              title: t('org_structure.no_results'), subtitle: t('org_structure.no_results_hint') %>
      <% else %>
        <%= render "dashboard/shared/empty_state", icon: 'account-management-icon.svg',
              title: t('org_structure.empty_title'), subtitle: t('org_structure.empty_subtitle') %>
      <% end %>
    </div>
  </div>
</div>
