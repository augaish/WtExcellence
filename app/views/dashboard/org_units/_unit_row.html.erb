<%# One node in the org tree. Locals: unit, units_by_parent, depth, can_manage %>
<% children = units_by_parent[unit.id] || [] %>
<div class="border-b border-[#E3E3E3] last:border-b-0">
  <div class="flex items-center gap-3 px-4 py-3 hover:bg-[#F7F7FD]"
       style="padding-inline-start: <%= 16 + depth * 24 %>px">
    <% if children.any? %>
      <button type="button"
              class="flex-shrink-0 w-5 h-5 flex items-center justify-center rounded text-[#797C81] hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]"
              data-action="click->org-tree#toggle"
              data-org-tree-target="toggle"
              data-node-id="<%= unit.id %>"
              aria-expanded="true"
              aria-label="<%= t('org_structure.toggle_children') %>">
        <span class="text-xs" data-org-tree-target="chevron">▾</span>
      </button>
    <% else %>
      <span class="flex-shrink-0 w-5 h-5"></span>
    <% end %>

    <span class="flex-shrink-0 w-2.5 h-2.5 rounded-full border border-white shadow-sm"
          style="background-color: <%= unit.org_group&.color || '#C9C9D1' %>"
          title="<%= unit.org_group&.display_name.presence || t('org_structure.no_group') %>"></span>

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm font-medium text-[#0D1120] truncate"><%= unit.display_name %></span>
        <% if unit.code.present? %>
          <span class="text-xs text-[#797C81] font-mono"><%= unit.code %></span>
        <% end %>
        <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-[#F6EEFF] text-[#5C3984]">
          <%= unit.level_name %>
        </span>
        <% unless unit.active? %>
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-500"><%= t('org_structure.inactive') %></span>
        <% end %>
      </div>
      <% if unit.head_user || unit.cost_center.present? || unit.mandate_list.any? %>
        <p class="mt-0.5 text-xs text-[#797C81] truncate">
          <% parts = [] %>
          <% parts << "#{t('org_structure.head')}: #{unit.head_user.name}" if unit.head_user %>
          <% parts << "#{t('org_structure.cost_center')}: #{unit.cost_center}" if unit.cost_center.present? %>
          <% parts << t('org_structure.mandates_count', count: unit.mandate_list.size) if unit.mandate_list.any? %>
          <%= parts.join(" · ") %>
        </p>
      <% end %>
    </div>

    <% if can_manage %>
      <div class="flex items-center gap-1 flex-shrink-0">
        <% if unit.level < OrgLevelDefinition::MAX_LEVEL %>
          <%= link_to t('org_structure.add_child'), new_dashboard_org_unit_path(parent_id: unit.id),
                class: "px-2 py-1 text-xs font-medium text-[#5C3984] rounded hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
        <% end %>
        <%= link_to t('edit'), edit_dashboard_org_unit_path(unit),
              class: "px-2 py-1 text-xs font-medium text-[#5C3984] rounded hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
        <%= button_to (unit.active? ? t('org_structure.deactivate') : t('org_structure.activate')),
              toggle_active_dashboard_org_unit_path(unit), method: :patch,
              class: "px-2 py-1 text-xs font-medium text-[#797C81] rounded hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-[#5C3984]",
              form: { class: "inline" } %>
        <% unless children.any? %>
          <%= button_to t('delete'), dashboard_org_unit_path(unit), method: :delete,
                class: "px-2 py-1 text-xs font-medium text-red-600 rounded hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600",
                form: { class: "inline", data: { turbo_confirm: t('org_structure.confirm_delete', name: unit.display_name) } } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if children.any? %>
    <div data-org-tree-target="children" data-parent-id="<%= unit.id %>">
      <% children.each do |child| %>
        <%= render "dashboard/org_units/unit_row", unit: child, units_by_parent: units_by_parent, depth: depth + 1, can_manage: can_manage %>
      <% end %>
    </div>
  <% end %>
</div>
