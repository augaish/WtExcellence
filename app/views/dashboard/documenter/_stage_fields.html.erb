<%# Stage-specific fields. A plain progression stage still gets the checkbox and
    bulk move (handled by the parent) — it simply shows nothing extra here.
    Locals: record, stage_key, phase, is_approval, is_branch, org_units, target %>

<% if is_branch %>
  <%# s2_confirmation: the intersections answer routes the record. %>
  <%= form_with url: dashboard_documenter_intersections_path(record), method: :patch,
        data: { turbo: false, controller: "conditional-field" }, class: "space-y-2" do %>
    <%= hidden_field_tag :phase, phase %>
    <label class="block text-xs font-medium text-[#797C81]"><%= t('documenter.has_intersections') %></label>
    <select name="has_intersections"
            data-conditional-field-target="trigger"
            data-action="change->conditional-field#toggle"
            class="w-full px-2 py-1.5 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
      <option value="false" <%= "selected" unless record.has_intersections? %>><%= t('documenter.no_label') %></option>
      <option value="true" <%= "selected" if record.has_intersections? %>><%= t('documenter.yes_label') %></option>
    </select>

    <div data-conditional-field-target="dependent" <%= "hidden" unless record.has_intersections? %>>
      <label class="block text-xs font-medium text-[#797C81] mb-1"><%= t('documenter.intersecting_units') %></label>
      <select name="org_unit_ids[]" multiple size="3"
              class="w-full px-2 py-1.5 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
        <% org_units.each do |unit| %>
          <option value="<%= unit.id %>"><%= unit.display_name %></option>
        <% end %>
      </select>
      <p class="mt-1 text-[11px] text-[#797C81]"><%= t('documenter.intersecting_units_hint') %></p>
    </div>

    <button type="submit" class="px-2.5 py-1 text-xs font-medium text-[#5C3984] border border-[#5C3984] rounded-lg hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]">
      <%= t('save') %>
    </button>
  <% end %>

<% elsif is_approval %>
  <%# Approval chain: one row per org unit, with a per-unit late flag. %>
  <% approvals = record.stage_approvals.select { |a| a.stage_key == stage_key } %>
  <div class="space-y-2">
    <% if approvals.any? %>
      <table class="w-full text-xs">
        <thead>
          <tr class="text-[#797C81]">
            <th class="text-start pb-1"><%= t('documenter.unit') %></th>
            <th class="text-start pb-1"><%= t('documenter.requested') %></th>
            <th class="text-start pb-1"><%= t('documenter.received') %></th>
            <th class="text-start pb-1"><%= t('documenter.late') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% approvals.each do |approval| %>
            <tr class="border-t border-[#E3E3E3]">
              <td class="py-1 pe-2 text-[#0D1120]"><%= approval.org_unit.display_name %></td>
              <td class="py-1 pe-2 text-[#797C81]"><%= approval.requested_at&.strftime("%Y-%m-%d") %></td>
              <td class="py-1 pe-2 text-[#797C81]"><%= approval.received_at&.strftime("%Y-%m-%d") || "—" %></td>
              <td class="py-1 pe-2">
                <% if approval.late?(current_company, target) %>
                  <span class="px-1.5 py-0.5 rounded-full bg-red-100 text-red-700 font-medium"><%= t('documenter.yes_label') %></span>
                <% else %>
                  <span class="text-[#797C81]"><%= t('documenter.no_label') %></span>
                <% end %>
              </td>
              <td class="py-1 text-end whitespace-nowrap">
                <% unless approval.received? %>
                  <%= button_to t('documenter.mark_received'),
                        dashboard_documenter_receive_approval_path(approval_id: approval.id, phase: phase),
                        method: :patch, form: { class: "inline", data: { turbo: false } },
                        class: "px-2 py-0.5 text-[11px] font-medium text-[#5C3984] rounded hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
                <% end %>
                <% if can_manage_documenter? %>
                  <%= button_to "×", dashboard_documenter_remove_approval_path(approval_id: approval.id, phase: phase),
                        method: :delete, form: { class: "inline", data: { turbo: false } },
                        class: "px-1.5 py-0.5 text-[11px] font-medium text-red-600 rounded hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600",
                        aria: { label: t('remove') } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-xs text-[#797C81]"><%= t('documenter.no_approvals_yet') %></p>
    <% end %>

    <%= form_with url: dashboard_documenter_add_approval_path(record), method: :post,
          data: { turbo: false }, class: "flex items-center gap-1" do %>
      <%= hidden_field_tag :phase, phase %>
      <%= hidden_field_tag :stage_key, stage_key %>
      <select name="org_unit_id"
              class="flex-1 min-w-0 px-2 py-1 border border-[#E3E3E3] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
        <option value=""><%= t('documenter.add_unit') %></option>
        <% org_units.each do |unit| %>
          <option value="<%= unit.id %>"><%= unit.display_name %></option>
        <% end %>
      </select>
      <button type="submit" class="px-2 py-1 text-xs font-medium text-[#5C3984] border border-[#5C3984] rounded-lg hover:bg-[#F6EEFF] focus-visible:outline-2 focus-visible:outline-[#5C3984]">+</button>
    <% end %>
  </div>

<% else %>
  <span class="text-xs text-[#797C81]">—</span>
<% end %>

<%# Returning a record is available at every stage, gated separately. %>
<% if can_return_records? && PpStage.index(stage_key).to_i.positive? %>
  <details class="mt-2">
    <summary class="text-[11px] text-[#797C81] cursor-pointer hover:text-[#0D1120]"><%= t('documenter.return_record') %></summary>
    <%= form_with url: dashboard_documenter_return_path, method: :post, data: { turbo: false }, class: "mt-1 space-y-1" do %>
      <%= hidden_field_tag :phase, phase %>
      <%= hidden_field_tag :record_id, record.id %>
      <select name="stage_key" class="w-full px-2 py-1 border border-[#E3E3E3] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
        <% record.route.take_while { |k| k != stage_key }.each do |earlier| %>
          <option value="<%= earlier %>"><%= PpStage.label(earlier) %></option>
        <% end %>
      </select>
      <input type="text" name="reason" required placeholder="<%= t('documenter.reason_placeholder') %>"
             class="w-full px-2 py-1 border border-[#E3E3E3] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
      <button type="submit" class="px-2 py-1 text-[11px] font-medium text-amber-800 border border-amber-300 rounded-lg hover:bg-amber-50 focus-visible:outline-2 focus-visible:outline-amber-600">
        <%= t('documenter.return_action') %>
      </button>
    <% end %>
  </details>
<% end %>
