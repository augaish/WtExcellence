<%# The procedure's steps, one row each, filled here, each with the operational
    authorities it exercises behind a scales icon.
    Locals: record, steps, org_units, can_edit, input, label, executive_authorities, authorities_by_step %>
<% th = "text-start p-2 text-xs font-semibold text-[#797C81]" %>
<div class="bg-white border border-[#E3E3E3] rounded-xl p-5 space-y-4">
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('process_steps.title') %></h2>
    <% if record.computed_total_in("hours") %>
      <p class="text-xs text-[#797C81]"><%= t('process_steps.total_from_steps') %>: <span class="font-semibold text-[#0D1120]"><%= record.computed_total_in("hours") %> <%= t('process_steps.units.hours') %></span></p>
    <% end %>
  </div>

  <% if steps.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
          <tr>
            <th class="<%= th %>">#</th>
            <th class="<%= th %>"><%= t('process_steps.activity') %></th>
            <th class="<%= th %>"><%= t('process_steps.description') %></th>
            <th class="<%= th %>"><%= t('process_steps.responsible') %></th>
            <th class="<%= th %>"><%= t('process_steps.duration') %></th>
            <th class="<%= th %>"><%= t('process_steps.system') %></th>
            <th class="p-2"></th>
          </tr>
        </thead>
        <tbody>
          <% steps.each do |step| %>
            <% step_authorities = authorities_by_step.fetch(step.id, []) %>
            <tr class="border-b border-[#E3E3E3] align-top">
              <% if can_edit %>
                <%= form_with url: dashboard_pp_record_record_step_path(record, step), method: :patch, id: "step_#{step.id}" do %><% end %>
                <td class="p-2"><%= number_field_tag "pp_process_step[position]", step.position, min: 1, form: "step_#{step.id}", class: "#{input} w-16", "aria-label": "#" %></td>
                <td class="p-2"><%= text_field_tag "pp_process_step[activity]", step.activity, form: "step_#{step.id}", class: input, "aria-label": t('process_steps.activity') %></td>
                <td class="p-2"><%= text_field_tag "pp_process_step[description]", step.description, form: "step_#{step.id}", class: input, "aria-label": t('process_steps.description') %></td>
                <td class="p-2 space-y-1">
                  <%= text_field_tag "pp_process_step[responsible_title]", step.responsible_title, form: "step_#{step.id}", placeholder: t('process_steps.responsible_title'), class: input, "aria-label": t('process_steps.responsible') %>
                  <%= select_tag "pp_process_step[responsible_org_unit_id]", options_from_collection_for_select(org_units, :id, :display_name, step.responsible_org_unit_id), include_blank: t('process_architecture.no_owner'), form: "step_#{step.id}", class: input %>
                </td>
                <td class="p-2">
                  <div class="flex gap-1">
                    <%= number_field_tag "pp_process_step[duration_value]", step.duration_value, step: :any, min: 0, form: "step_#{step.id}", class: "#{input} w-20", "aria-label": t('process_steps.duration') %>
                    <%= select_tag "pp_process_step[duration_unit]", options_for_select(PpProcessStep::UNITS.map { |u| [ t("process_steps.units.#{u}"), u ] }, step.duration_unit), include_blank: t('process_architecture.unit'), form: "step_#{step.id}", class: "#{input} w-24" %>
                  </div>
                </td>
                <td class="p-2"><%= text_field_tag "pp_process_step[system_used]", step.system_used, form: "step_#{step.id}", class: input, "aria-label": t('process_steps.system') %></td>
                <td class="p-2 whitespace-nowrap">
                  <%= submit_tag t('save'), form: "step_#{step.id}", class: "text-xs font-medium text-[#5C3984] hover:underline" %>
                  <%= button_to t('delete'), dashboard_pp_record_record_step_path(record, step), method: :delete, class: "text-xs text-red-600 hover:underline", form: { class: "inline" } %>
                  <%= render "dashboard/documenter/authority_toggle", step: step, count: step_authorities.size, conforming: step_authorities.all?(&:conforms_to_executive?) %>
                </td>
              <% else %>
                <td class="p-2 text-[#797C81]"><%= step.position %></td>
                <td class="p-2 text-[#0D1120]"><%= step.activity %></td>
                <td class="p-2 text-[#0D1120]"><%= step.description %></td>
                <td class="p-2 text-[#0D1120]"><%= step.responsible_label %></td>
                <td class="p-2 text-[#0D1120]"><%= step.duration_value %> <%= t("process_steps.units.#{step.duration_unit}") if step.duration_unit.present? %></td>
                <td class="p-2 text-[#0D1120]"><%= step.system_used %></td>
                <td class="p-2 whitespace-nowrap">
                  <%= render "dashboard/documenter/authority_toggle", step: step, count: step_authorities.size, conforming: step_authorities.all?(&:conforms_to_executive?) %>
                </td>
              <% end %>
            </tr>
            <tr class="border-b border-[#E3E3E3] last:border-b-0" id="step_authorities_<%= step.id %>" hidden>
              <td colspan="7" class="p-2">
                <%= render "dashboard/documenter/step_authorities", record: record, step: step, authorities: step_authorities,
                      executive_authorities: executive_authorities, org_units: org_units, can_edit: can_edit, input: input %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-[#797C81]"><%= t('documenter.steps_empty') %></p>
  <% end %>

  <% if can_edit %>
    <%= form_with url: dashboard_pp_record_record_steps_path(record), method: :post, class: "pt-3 border-t border-[#E3E3E3] grid grid-cols-1 sm:grid-cols-6 gap-2 items-end" do %>
      <div class="sm:col-span-2">
        <%= label_tag "new_step_activity", t('process_steps.activity'), class: label %>
        <%= text_field_tag "pp_process_step[activity]", retained(:pp_process_step, :activity), id: "new_step_activity", required: true, class: input %>
      </div>
      <div class="sm:col-span-2">
        <%= label_tag "new_step_description", t('process_steps.description'), class: label %>
        <%= text_field_tag "pp_process_step[description]", retained(:pp_process_step, :description), id: "new_step_description", class: input %>
      </div>
      <div>
        <%= label_tag "new_step_responsible", t('process_steps.responsible_title'), class: label %>
        <%= text_field_tag "pp_process_step[responsible_title]", retained(:pp_process_step, :responsible_title), id: "new_step_responsible", class: input %>
      </div>
      <div>
        <%= submit_tag t('process_steps.add'), class: ui_btn_primary %>
      </div>
    <% end %>
  <% end %>
</div>
