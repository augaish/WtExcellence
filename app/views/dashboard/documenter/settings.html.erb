<%= content_for :title, t('settings') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('settings'), subtitle: t('documenter.settings_subtitle') } do %>
      <%= link_to t('back'), dashboard_documenter_path, class: ui_btn_neutral %>
    <% end %>

    <%= render "dashboard/general_settings/tabs", current: :documenter %>

    <%= form_with url: dashboard_update_documenter_settings_path, method: :patch, class: "space-y-6" do %>
      <!-- Working calendar -->
      <div class="bg-white border border-[#E3E3E3] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('documenter.working_calendar') %></h2>
        <p class="mt-1 mb-4 text-xs text-[#797C81]"><%= t('documenter.working_calendar_hint') %></p>
        <div class="flex flex-wrap gap-3">
          <% Date::DAYNAMES.each_with_index do |day, index| %>
            <label class="flex items-center gap-2 text-sm text-[#0D1120]">
              <%= check_box_tag "weekend_days[]", index, @weekend_days.include?(index),
                    id: "weekend_#{index}", class: "rounded border-[#E3E3E3] text-[#5C3984] focus:ring-[#5C3984]" %>
              <%= t("date.day_names")[index] %>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Stage targets -->
      <div class="bg-white border border-[#E3E3E3] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('documenter.stage_targets') %></h2>
        <p class="mt-1 mb-4 text-xs text-[#797C81]"><%= t('documenter.stage_targets_hint') %></p>

        <% PpStage::PHASES.each do |phase| %>
          <div class="mb-4 last:mb-0">
            <p class="text-xs font-semibold text-[#797C81] uppercase tracking-wide mb-2"><%= PpStage.phase_label(phase) %></p>
            <div class="space-y-2">
              <% PpStage.in_phase(phase).each do |stage| %>
                <div class="grid grid-cols-[1fr_100px] gap-3 items-center">
                  <label for="target_<%= stage[:key] %>" class="text-sm text-[#0D1120]"><%= PpStage.label(stage[:key]) %></label>
                  <input type="number" min="0" id="target_<%= stage[:key] %>"
                         name="targets[<%= stage[:key] %>]" value="<%= @targets[stage[:key]] %>"
                         class="w-full px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm text-center focus:outline-none focus:ring-2 focus:ring-[#5C3984]">
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex justify-end">
        <%= submit_tag t('save'), class: ui_btn_primary %>
      </div>
    <% end %>

    <!-- Holidays -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl p-5 mt-6">
      <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('documenter.holidays') %></h2>
      <p class="mt-1 mb-4 text-xs text-[#797C81]"><%= t('documenter.holidays_hint') %></p>

      <% if @holidays.any? %>
        <ul class="divide-y divide-[#E3E3E3] mb-4">
          <% @holidays.each do |holiday| %>
            <li class="flex items-center justify-between py-2 gap-3">
              <span class="text-sm text-[#0D1120] truncate">
                <%= holiday.name.presence || t('documenter.holiday') %>
                <span class="ms-2 text-xs text-[#797C81]"><%= holiday.start_date %> → <%= holiday.end_date %></span>
              </span>
              <%= button_to t('remove'), dashboard_documenter_holiday_path(holiday_id: holiday.id), method: :delete,
                    class: "flex-shrink-0 px-2 py-1 text-xs font-medium text-red-600 rounded hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600",
                    form: { class: "inline" } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-[#797C81] mb-4"><%= t('documenter.no_holidays') %></p>
      <% end %>

      <%= form_with url: dashboard_documenter_holidays_path, method: :post,
            class: "grid grid-cols-1 sm:grid-cols-[1fr_auto_auto_auto] gap-2 items-end border-t border-[#E3E3E3] pt-4" do %>
        <div>
          <label class="block text-xs font-medium text-[#797C81] mb-1"><%= t('documenter.holiday_name') %></label>
          <%= text_field_tag :name, nil, class: "w-full px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-[#797C81] mb-1"><%= t('pp_records.packages.start_date') %></label>
          <%= date_field_tag :start_date, nil, required: true, class: "px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-[#797C81] mb-1"><%= t('pp_records.packages.end_date') %></label>
          <%= date_field_tag :end_date, nil, required: true, class: "px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <%= submit_tag t('documenter.add_holiday'), class: ui_btn_primary %>
      <% end %>
    </div>
  </div>
</div>
