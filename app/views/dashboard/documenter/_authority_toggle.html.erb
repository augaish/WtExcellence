<%# The scales: opens the step's operational authorities. Red when one of them
    does not conform to the executive matrix. Locals: step, count, conforming %>
<button type="button" class="inline-flex items-center gap-1 text-xs font-medium <%= conforming ? 'text-[#5C3984]' : 'text-red-600' %> hover:underline"
        data-controller="reveal" data-action="click->reveal#toggle" data-reveal-id-value="step_authorities_<%= step.id %>"
        aria-controls="step_authorities_<%= step.id %>" aria-expanded="false"
        title="<%= t('process_authorities.title') %>">
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v18M5 7h14M5 7l-3 7a3 3 0 0 0 6 0L5 7zm14 0l-3 7a3 3 0 0 0 6 0l-3-7zM8 21h8"/></svg>
  <span><%= count %></span>
  <span class="sr-only"><%= t('process_authorities.title') %></span>
</button>
