<%# Layout switcher + customize controls (admins only). %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
  <!-- Layout slot tabs -->
  <div class="inline-flex items-center rounded-xl border border-[#E3E3E3] bg-white p-1" role="tablist" aria-label="<%= t('dashboard_layouts', default: 'Dashboard layouts') %>">
    <% @layout_slots.each do |s| %>
      <%= button_to dashboard_activate_overview_layout_path, params: { slot: s[:slot] }, method: :post,
            form_class: "contents",
            class: "px-3 h-9 rounded-lg text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#5C3984] " +
                    (s[:active] ? "bg-[#5C3984] text-white" : "text-[#5C3984] hover:bg-[#F6EEFF]"),
            role: "tab", "aria-selected": s[:active].to_s do %>
        <%= s[:name] %>
      <% end %>
    <% end %>
  </div>

  <!-- Customize controls -->
  <div class="flex items-center gap-2">
    <button type="button"
            data-overview-customize-target="editBtn"
            data-action="overview-customize#enter"
            class="<%= ui_btn_secondary %>">
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 13.5V16h2.5l7.4-7.4-2.5-2.5L4 13.5zM15.7 6.3a.7.7 0 000-1L14.7 4.3a.7.7 0 00-1 0l-1 1 2.5 2.5 1-1z" stroke-linejoin="round"/>
      </svg>
      <%= t("customize", default: "Customize") %>
    </button>

    <div data-overview-customize-target="editActions" class="hidden items-center gap-2">
      <button type="button"
              data-action="overview-customize#cancel"
              class="<%= ui_btn_neutral %>">
        <%= t("cancel", default: "Cancel") %>
      </button>
      <button type="button"
              data-action="overview-customize#save"
              data-overview-customize-target="saveBtn"
              class="<%= ui_btn_primary %>">
        <%= t("save_layout", default: "Save layout") %>
      </button>
    </div>
  </div>
</div>

<p data-overview-customize-target="hint" class="hidden text-xs text-[#797C81] mb-3">
  <%= t("customize_hint", default: "Drag the handles to reorder. Use Hide/Show to control which widgets appear. Save to store this arrangement.") %>
</p>
