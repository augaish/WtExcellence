<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
  <%= render "dashboard/overview/kpi_tile", label: t('total_capas_logged'), value: @total_capas,
      accent: "#7C3AED", icon: :capa,
      hint: (@capas_created_in_period.to_i.positive? ? "+#{@capas_created_in_period} #{t('in_period')}" : nil) %>

  <%= render "dashboard/overview/kpi_tile", label: t('open_capas'), value: @open_capas,
      accent: "#1D5CE5", icon: :folder,
      hint: "#{@open_capas_in_period} #{t('created_in_period')}" %>

  <%= render "dashboard/overview/kpi_tile", label: t('high_priority_capa'), value: @high_priority_capas,
      accent: "#D97706", icon: :flag %>

  <%= render "dashboard/overview/kpi_tile", label: t('overdue_capa'), value: @overdue_capas,
      accent: "#C73636", icon: :clock, value_color: "#C73636" %>
</div>
