<% unless @risk_by_workspace.nil? %>
  <div class="bg-white border border-[#E3E3E3] rounded-xl p-5 mb-6">
    <h3 class="text-sm font-semibold text-[#0D1120] mb-4"><%= t('widget_risks_by_workspace', default: 'Risks by workspace') %></h3>
    <% data = @risk_by_workspace.reject { |_, v| v.to_i.zero? } %>
    <% if data.any? %>
      <%= column_chart data, height: "240px", legend: false, colors: [ "#5C3984" ] %>
    <% else %>
      <p class="text-sm text-[#797C81]"><%= t('no_risks_yet', default: 'No risks logged yet') %></p>
    <% end %>
  </div>
<% end %>
