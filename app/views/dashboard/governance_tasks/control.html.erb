<%= content_for :title, @risk.title %>
<% input = "w-full border border-[#E3E3E3] rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-[#5C3984]" %>

<div class="p-6 max-w-3xl mx-auto space-y-6">
  <%= render layout: "dashboard/shared/page_header", locals: { title: @risk.title, subtitle: t('governance_tasks.control_subtitle') } do %>
    <%= link_to t('back'), dashboard_overview_path, class: ui_btn_neutral %>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-5">
    <h2 class="text-sm font-semibold text-[#0D1120] mb-4"><%= t('governance_tasks.the_control') %></h2>
    <dl class="grid grid-cols-1 gap-4 text-sm">
      <% if @risk.treatment_plan.present? %><div><dt class="text-xs font-medium text-[#797C81]"><%= t('risk_depth.treatment_plan') %></dt><dd class="mt-0.5 text-[#0D1120] whitespace-pre-line"><%= @risk.treatment_plan %></dd></div><% end %>
      <% if @risk.control_rationale.present? %><div><dt class="text-xs font-medium text-[#797C81]"><%= t('risk_depth.control_rationale') %></dt><dd class="mt-0.5 text-[#0D1120] whitespace-pre-line"><%= @risk.control_rationale %></dd></div><% end %>
      <div><dt class="text-xs font-medium text-[#797C81]"><%= t('governance_tasks.risk_owner') %></dt><dd class="mt-0.5 text-[#0D1120]"><%= @risk.owner&.user&.name || t('unassigned') %></dd></div>
      <% if @risk.next_review_on %><div><dt class="text-xs font-medium text-[#797C81]"><%= t('risk_depth.next_review_on') %></dt><dd class="mt-0.5 text-[#0D1120]"><%= l(@risk.next_review_on, format: :document) %></dd></div><% end %>
    </dl>
  </div>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-5">
    <h2 class="text-sm font-semibold text-[#0D1120] mb-1"><%= t('governance_tasks.your_report') %></h2>
    <% if @risk.control_evidence_submitted_at %>
      <p class="text-xs text-[#797C81] mb-2"><%= t('governance_tasks.submitted_on', date: l(@risk.control_evidence_submitted_at, format: :long)) %></p>
      <p class="text-sm text-[#0D1120] whitespace-pre-line mb-4"><%= @risk.control_evidence_note %></p>
    <% end %>
    <p class="text-xs text-[#797C81] mb-3"><%= t('governance_tasks.control_hint') %></p>
    <%= form_with url: dashboard_submit_control_task_path(@risk), method: :post, class: "space-y-3" do %>
      <%= text_area_tag :control_evidence_note, @risk.control_evidence_note, rows: 4, class: input, placeholder: t('governance_tasks.note_placeholder') %>
      <%= submit_tag (@risk.control_evidence_submitted_at ? t('governance_tasks.resubmit_control') : t('governance_tasks.submit_control')), class: ui_btn_primary %>
    <% end %>
  </div>
</div>
