<%# Lightweight modal — only the "Assign To" field %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" />

<div data-controller="capas--assign-assignees" 
     data-action="assign-assignees-modal:open@window->capas--assign-assignees#open">
       <dialog id="assignActionAssigneesModal"
          class="rounded-3xl backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white"
          style="box-shadow: 0px 16px 32px -4px rgba(12,12,13,0.10), 0px 4px 4px -4px rgba(12,12,13,0.05); width: 480px; max-width: 92vw; padding: 0; overflow: visible;"
          data-capas--assign-assignees-target="dialog">
     <div class="flex flex-col gap-5 p-6">
  
      <%# Header %>
      <div class="flex items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5 min-w-0 flex-1">
          <h2 class="text-lg font-semibold text-[#0D1120]">
            <%= t("capa_management_ui.assign_assignees_modal.title") %>
          </h2>
          <p class="text-xs text-[#797C81]">
            <%= t("capa_management_ui.assign_assignees_modal.subtitle") %>
          </p>
        </div>
        <button type="button"
                class="text-[#5C3984] text-sm px-3 py-2 min-h-[44px] flex-shrink-0"
                data-action="click->capas--assign-assignees#close">
          <%= t("close") %>
        </button>
      </div>
  
      <%# Hidden fields %>
      <input type="hidden" data-capas--assign-assignees-target="actionIdInput">
  
      <%# Selected Users List (Chips) %>
      <div id="assignAssigneesChips" class="flex flex-col gap-2 max-h-60 overflow-y-auto px-1 custom-scrollbar" data-capas--assign-assignees-target="chipList"></div>

      <%# Choices Select %>
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t("capa_management_ui.assign_assignees_modal.select_label", default: "Select Assignees") %></label>
        <select multiple
                data-capas--assign-assignees-target="select"
                data-placeholder="<%= t("capa_management_ui.assign_assignees_modal.search_placeholder") %>"
                data-search-placeholder="<%= t("capa_management_ui.assign_assignees_modal.search_placeholder") %>"
                class="w-full">
          <% @company_users&.each do |cu| %>
            <% 
               avatar_url = cu.user.profile_image.attached? ? user_profile_image_url(cu.user) : nil
               props = { avatar: avatar_url, role: cu.role, name: cu.user.name, initial: (cu.user.name.first || '?').upcase }
            %>
            <option value="<%= cu.id %>" data-custom-properties='<%= props.to_json %>'>
              <%= cu.user.name %> (<%= cu.role %>)
            </option>
          <% end %>
        </select>
      </div>

      <%# Footer buttons %>
      <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 sm:gap-3 pt-4 border-t border-[#F0F0F0]">
        <button type="button"
                data-action="click->capas--assign-assignees#close"
                class="w-full sm:w-auto px-4 py-3 sm:py-2 text-[#5C3984] text-sm min-h-[44px] sm:min-h-auto">
          <%= t("cancel") %>
        </button>
        <button type="button"
                data-capas--assign-assignees-target="saveButton"
                data-saving-text="<%= t("saving") %>"
                data-action="click->capas--assign-assignees#submit"
                class="w-full sm:w-auto px-5 py-3 sm:py-2 bg-[#5C3984] hover:opacity-80 text-white rounded-xl text-sm font-medium min-h-[44px] sm:min-h-auto disabled:opacity-50 transition-opacity">
          <%= t("save_changes") %>
        </button>
      </div>
    </div>
  </dialog>
</div>

<style>
  #assignActionAssigneesModal:not([open]) { display: none !important; }

  /* Custom overrides for Choices.js to match design */
  .choices__inner {
    border-radius: 0.75rem !important; /* rounded-xl */
    background-color: white !important;
    border-color: #E3E3E3 !important;
    min-height: 44px !important;
    padding: 4px 8px !important;
    display: flex;
    align-items: center;
  }
  .choices__list--multiple .choices__item {
    background-color: #F7F7FD !important;
    border: 1px solid #E3E3E3 !important;
    color: #0D1120 !important;
    border-radius: 0.5rem !important; /* rounded-lg */
    font-size: 0.875rem !important; /* text-sm */
  }
  .choices__list--multiple .choices__item.is-highlighted {
    background-color: #E0E0FC !important;
  }
  .choices__input {
    background-color: transparent !important;
    font-size: 0.875rem !important; /* text-sm */
    margin-bottom: 0 !important;
  }
  .choices[data-type*="select-multiple"] .choices__button {
    border-left: 1px solid #E3E3E3 !important;
    margin: 0 0 0 8px !important; 
    padding-left: 8px !important;
  }
  /* Fix dropdown z-index in modal */
  .choices__list--dropdown {
    z-index: 1000 !important;
    border: 1px solid #E3E3E3 !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
    padding: 6px !important;
    background-color: white !important;
    margin-top: 8px !important;
  }
  .choices__list--dropdown .choices__list {
    max-height: 300px !important;
    overflow-y: auto !important;
  }
  /* Style dropdown options */
  .choices__list--dropdown .choices__item {
    padding: 10px 12px !important;
    font-size: 0.875rem !important;
    color: #0D1120 !important;
    background-color: transparent !important;
    border-radius: 8px !important;
    margin-bottom: 2px !important;
    transition: background-color 0.1s ease !important;
  }
  
  /* Hover and Highlight states - Specificity matches Choices.js defaults to override them */
  .choices__list--dropdown .choices__item--selectable.is-highlighted,
  .choices__list--dropdown .choices__item--selectable:hover {
    background-color: #F3E8FF !important; /* Light purple */
    color: #5C3984 !important; /* Darker Text Purple */
  }
  
  .choices__list--dropdown .choices__item.is-selected {
    display: none !important;
  }
  
  .choices__list--multiple .choices__item {
    display: none !important;
  }
</style>

<script>
  window.openAssignAssigneesModal = function(capaId, actionId, assigneeIds) {
    const event = new CustomEvent('assign-assignees-modal:open', {
      detail: {
        capaId: capaId,
        actionId: actionId,
        assigneeIds: assigneeIds
      }
    });
    window.dispatchEvent(event);
  };
  
  window.closeAssignAssigneesModal = function() {
    // This is kept for compatibility if called from elsewhere, but the controller handles closing via data-action
    const dialog = document.getElementById('assignActionAssigneesModal');
    if (dialog) dialog.close();
  };
</script>
