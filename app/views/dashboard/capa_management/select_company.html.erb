<div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xl sm:text-2xl font-semibold text-[#0D1120] mb-4 sm:mb-6 break-words"><%= t("capa_management_ui.select_company.title") %></h1>
    <p class="text-xs sm:text-sm text-[#797C81] mb-6 sm:mb-8 break-words"><%= t("capa_management_ui.select_company.subtitle") %></p>
    
    <div class="space-y-3 sm:space-y-4">
      <% @companies.each do |company| %>
        <%= form_with url: set_company_dashboard_capa_management_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :company_id, value: company.id %>
          <button type="submit" class="w-full p-3 sm:p-4 border border-[#E3E3E3] rounded-lg hover:bg-[#F7F7FD] transition-colors text-left min-h-[44px]">
            <div class="font-medium text-sm sm:text-base text-[#0D1120] break-words"><%= company.name %></div>
            <div class="text-xs sm:text-sm text-[#797C81] mt-1 break-words">
              <%= t("capa_management_ui.select_company.users_count", count: company.company_users.count) %> • 
              <%= t("capa_management_ui.select_company.standards_count", count: company.company_standards.active.count) %>
            </div>
          </button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

