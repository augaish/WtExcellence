<dialog id="questionnaireGenerationModal" class="backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white rounded-lg shadow-xl border border-[#E3E3E3] p-0 max-h-[90vh] overflow-hidden flex flex-col mx-4" style="width: 90vw; max-width: 800px; display: none;" data-controller="capas--questionnaire-generation dialog-no-backdrop-close" data-capa-id="<%= @capa.id %>" data-question-label="<%= t('capa_management_ui.modals.questionnaire.question_label', number: '%{number}') %>" data-answer-label="<%= t('capa_management_ui.modals.questionnaire.answer_label') %>" data-draft-notice="<%= t('capa_management_ui.modals.questionnaire.draft_notice') %>" data-accepted-label="<%= t('capa_management_ui.modals.questionnaire.accepted_label') %>" data-accepted-heading="<%= t('capa_management_ui.modals.questionnaire.accepted_heading', number: '%{number}') %>" data-regenerate-label="<%= t('capa_management_ui.modals.questionnaire.regenerate') %>" data-complete-label="<%= t('capa_management_ui.modals.questionnaire.complete') %>" data-failed-label="<%= t('capa_management_ui.modals.questionnaire.failed_keep') %>">
  <!-- Header -->
  <div class="p-4 sm:p-6 border-b border-[#E3E3E3] flex-shrink-0">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <h2 class="text-lg sm:text-xl md:text-2xl font-semibold text-[#0D1120] mb-2 break-words">
          <%= t("capa_management_ui.modals.questionnaire.title") %>
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 break-words">
          <%= t("capa_management_ui.modals.questionnaire.subtitle") %>
        </p>
      </div>
      <button data-action="click->capas--questionnaire-generation#closeModal" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center flex-shrink-0 text-gray-400 hover:text-gray-600 transition-colors duration-200" aria-label="<%= t('close') %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <!-- Progress Indicator -->
    <div class="mt-3 sm:mt-4">
      <div class="flex items-center justify-between text-xs sm:text-sm text-gray-600 mb-2">
        <span data-capas--questionnaire-generation-target="progressText" class="break-words"><%= t("capa_management_ui.modals.questionnaire.progress", current: 1, total: 5) %></span>
        <span data-capas--questionnaire-generation-target="progressPercent" class="whitespace-nowrap">0%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-[#5C3984] h-2 rounded-full transition-all duration-300" data-capas--questionnaire-generation-target="progressBar" style="width: 0%"></div>
      </div>
    </div>
  </div>

  <!-- Chat Messages Area (Scrollable) -->
  <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-3 sm:space-y-4" data-capas--questionnaire-generation-target="messagesContainer">
    <!-- Messages will be dynamically added here -->
  </div>

  <!-- Footer with Action Buttons -->
  <div class="p-4 sm:p-6 border-t border-[#E3E3E3] flex-shrink-0" data-capas--questionnaire-generation-target="actionButtons" style="display: none;">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-2 sm:gap-3">
      <%# Shown only after a failed generation. Accepted answers are already
          saved, so retrying costs nothing but another attempt at this question. %>
      <button type="button"
              class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 flex items-center justify-center gap-2 min-h-[44px] sm:min-h-auto"
              style="display: none;"
              data-action="click->capas--questionnaire-generation#retryPair"
              data-capas--questionnaire-generation-target="retryButton">
        <span><%= t("capa_management_ui.modals.questionnaire.retry") %></span>
      </button>
      <button type="button" 
              class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 min-h-[44px] sm:min-h-auto"
              data-action="click->capas--questionnaire-generation#regeneratePair"
              data-capas--questionnaire-generation-target="regenerateButton">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span><%= t("capa_management_ui.modals.questionnaire.regenerate") %></span>
      </button>
      <button type="button" 
              class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#3F9011] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 min-h-[44px] sm:min-h-auto"
              data-action="click->capas--questionnaire-generation#acceptPair"
              data-capas--questionnaire-generation-target="acceptButton">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span><%= t("capa_management_ui.modals.questionnaire.accept") %></span>
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div class="p-4 sm:p-6 border-t border-[#E3E3E3] flex-shrink-0" data-capas--questionnaire-generation-target="loadingState" style="display: none;">
    <div class="flex items-center justify-center gap-2 text-gray-600">
      <svg class="w-5 h-5 animate-spin flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span class="text-xs sm:text-sm"><%= t("capa_management_ui.modals.questionnaire.generating") %></span>
    </div>
  </div>

  <!-- Completion State -->
  <div class="p-4 sm:p-6 border-t border-[#E3E3E3] flex-shrink-0 text-center" data-capas--questionnaire-generation-target="completionState" style="display: none;">
    <div class="mb-3 sm:mb-4">
      <svg class="w-12 h-12 sm:w-16 sm:h-16 text-[#3F9011] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] mb-2 break-words"><%= t("capa_management_ui.modals.questionnaire.complete_title") %></h3>
    <p class="text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4 break-words px-4"><%= t("capa_management_ui.modals.questionnaire.complete_message") %></p>
    <button type="button" 
            class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] rounded-lg text-sm font-medium text-white hover:opacity-80 min-h-[44px] sm:min-h-auto"
            data-action="click->capas--questionnaire-generation#closeModal">
      <%= t("close") %>
    </button>
  </div>
</dialog>

