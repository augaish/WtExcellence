<dialog id="editActionModal" class="rounded-3xl backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white" style="box-shadow: 0px 16px 32px -4px rgba(12, 12, 13, 0.1), 0px 4px 4px -4px rgba(12, 12, 13, 0.05); width: 674px; max-width: 90vw; max-height: 90vh; padding: 0; overflow: hidden;" data-controller="dialog-no-backdrop-close">
  <div class="flex flex-col h-full max-h-[90vh]">
    <!-- Header -->
    <div class="px-6 py-5 border-b border-[#F0F0F0] flex-shrink-0">
      <div class="flex items-center justify-between gap-3">
        <div class="flex flex-col gap-1 min-w-0 flex-1">
          <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t("capa_management_ui.modals.edit_action.title") %></h2>
          <p class="text-xs sm:text-sm font-medium text-[#797C81] break-words"><%= t("capa_management_ui.modals.edit_action.subtitle") %></p>
        </div>
        <button type="button" class="text-[#797C81] hover:text-[#0D1120] p-1 flex-shrink-0 transition-colors" onclick="document.getElementById('editActionModal').close()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Body -->
    <div class="flex-grow overflow-y-auto px-6 py-5 custom-scrollbar">
      <form id="editCapaForm" method="dialog" class="flex flex-col gap-5" data-controller="capas--edit-form" data-action="submit->capas--edit-form#submitForm" data-capas--edit-form-delete-icon-path-value="<%= asset_path('delete-clause-icon.svg') %>">
        <input type="hidden" name="id" data-field="capaId">

        <!-- Title -->
        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-[#0D1120]"><%= t("capa_management_ui.modals.edit_action.title_label") %></label>
          <input type="text" name="capa[title]" required aria-label="<%= t('capa_management_ui.modals.edit_action.title_label') %>" class="min-h-[44px] px-4 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-all" placeholder="<%= t('capa_management_ui.modals.edit_action.title_placeholder') %>" data-field="title">
        </div>

        <!-- Description -->
        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-[#0D1120]"><%= t("capa_management_ui.modals.edit_action.description_label") %></label>
          <textarea name="capa[description]" required aria-label="<%= t('capa_management_ui.modals.edit_action.description_label') %>" rows="3" class="px-4 py-3 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-all" placeholder="<%= t('capa_management_ui.modals.edit_action.description_placeholder') %>" data-field="description"></textarea>
        </div>

        <!-- Source & Standard -->
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex flex-col gap-2 flex-1" data-controller="choices-select">
            <label class="text-sm font-semibold text-[#0D1120]"><%= t("capa_management_ui.modals.edit_action.source_label") %></label>
            <select name="capa[source]" required aria-label="<%= t('capa_management_ui.modals.edit_action.source_label') %>" data-choices-select-target="select" class="w-full" data-field="source">
              <option value="internal_audit"><%= t("capa_sources.internal_audit") %></option>
              <option value="external_audit"><%= t("capa_sources.external_audit") %></option>
              <option value="customer_complaint"><%= t("capa_sources.customer_complaint") %></option>
            </select>
          </div>
          <div class="flex flex-col gap-2 flex-1" data-controller="choices-select" data-choices-select-search-value="true">
            <label class="text-sm font-semibold text-[#0D1120]"><%= t("capa_management_ui.modals.edit_action.related_standard_label") %></label>
            <select name="capa[standard_id]" aria-label="<%= t('capa_management_ui.modals.edit_action.related_standard_label') %>" data-choices-select-target="select" class="w-full" data-field="standardId">
              <option value=""><%= t("capa_management_ui.modals.edit_action.select_standard_placeholder") %></option>
              <% @standards&.each do |standard| %>
                <option value="<%= standard.id %>"><%= standard.display_name %></option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Priority & Due Date -->
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex flex-col gap-2 flex-1" data-controller="choices-select">
            <label class="text-sm font-semibold text-[#0D1120]"><%= t("capa_management_ui.modals.edit_action.priority_label") %></label>
            <select name="capa[priority]" aria-label="<%= t('capa_management_ui.modals.edit_action.priority_label') %>" data-choices-select-target="select" class="w-full" data-field="priority">
              <option value="high"><%= t("priority_levels.high") %></option>
              <option value="medium"><%= t("priority_levels.medium") %></option>
              <option value="low"><%= t("priority_levels.low") %></option>
            </select>
          </div>
          <div class="flex flex-col gap-2 flex-1">
            <label class="text-sm font-semibold text-[#0D1120]"><%= t("due_date_optional") %></label>
            <input type="date" name="capa[due_date]" aria-label="<%= t('due_date_optional') %>" class="min-h-[44px] px-4 py-2 border border-[#E3E3E3] rounded-lg text-sm w-full focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-all" data-field="dueDate">
          </div>
        </div>

        <!-- Status -->
        <div class="flex flex-col gap-2" data-controller="choices-select">
          <label class="text-sm font-semibold text-[#0D1120]"><%= t("status") %></label>
          <select name="capa[status]" required aria-label="<%= t('status') %>" data-choices-select-target="select" class="w-full" data-field="status" data-capas--edit-form-target="statusSelect">
            <option value="open"><%= t("capa_management_ui.statuses.open") %></option>
            <option value="assigned"><%= t("capa_management_ui.statuses.assigned") %></option>
            <option value="in_progress"><%= t("capa_management_ui.statuses.in_progress") %></option>
            <% if can_close_capa?(@capa) %>
              <option value="closed"><%= t("capa_management_ui.statuses.closed") %></option>
            <% end %>
          </select>
        </div>

        <!-- Assignees -->
        <div class="flex flex-col gap-3">
          <label class="text-sm font-semibold text-[#0D1120]"><%= t("assign_to") %></label>
          <div id="editAssignedUsers" data-capas--edit-form-target="assignedUsers" class="flex flex-col gap-2">
            <!-- Assigned users will render here as chips -->
          </div>
          <div class="flex flex-col gap-2">
            <select multiple name="capa[company_user_ids][]" aria-label="<%= t('assign_to') %>" data-capas--edit-form-target="userSelect" class="w-full">
              <% @company_users&.each do |company_user| %>
                <% 
                   props = { 
                     name: company_user.user&.name || "Deleted User", 
                     role: company_user.role, 
                     profileImageUrl: (company_user.user&.profile_image&.attached? ? user_profile_image_url(company_user.user) : "") 
                   } 
                %>
                <option value="<%= company_user.id %>" data-custom-properties='<%= props.to_json %>'>
                  <%= company_user.user&.name || "Deleted User" %> (<%= company_user.role %>)
                </option>
              <% end %>
            </select>
          </div>
        </div>
        
        <!-- Bottom spacing element for Better Dropdown visibility -->
        <div class="h-64"></div>
      </form>
    </div>

    <!-- Footer -->
    <div class="px-6 py-5 border-t border-[#F0F0F0] flex-shrink-0 bg-[#F9FAFC] rounded-b-3xl">
      <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
        <button type="button" class="w-full sm:w-auto px-5 py-2 text-[#797C81] text-sm font-medium hover:text-[#0D1120] transition-colors" onclick="document.getElementById('editActionModal').close()"><%= t("cancel") %></button>
        <button type="submit" form="editCapaForm" class="w-full sm:w-auto px-6 py-2.5 bg-[#5C3984] text-white rounded-xl text-sm font-semibold hover:bg-[#4A2F6B] transition-all shadow-sm hover:shadow-md"><%= t("save_changes") %></button>
      </div>
    </div>
  </div>
</dialog>



<script>
  window.openEditCapaModal = function(ds) {
    const modal = document.getElementById('editActionModal');
    if (!modal) return;
    
    const form = modal.querySelector('form[data-controller*="capas--edit-form"]');
    if (!form) return;
    
    // Get the Stimulus controller instance
    let controller = null;
    if (window.Stimulus) {
      controller = window.Stimulus.getControllerForElementAndIdentifier(form, 'capas--edit-form');
    } else if (window.application) {
      controller = window.application.getControllerForElementAndIdentifier(form, 'capas--edit-form');
    }
    
    if (!controller) {
      console.error('Edit form controller not found');
      return;
    }
    
    // Create a fake event object with the dataset to pass to the controller's open method
    const fakeEvent = {
      currentTarget: {
        dataset: ds
      }
    };
    
    // Call the controller's open method
    controller.open(fakeEvent);
  };
</script>