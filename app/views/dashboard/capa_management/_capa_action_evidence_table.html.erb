<% capa_action = local_assigns[:capa_action] %>
<% capa = local_assigns[:capa] %>
<div class="border border-[#E3E3E3] rounded-xl overflow-x-auto">
  <table class="w-full min-w-[600px]">
    <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
      <tr>
        <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.evidence_tab.table_headers.file_name") %></span></th>
        <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.evidence_tab.table_headers.type") %></span></th>
        <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.evidence_tab.table_headers.uploaded_by") %></span></th>
        <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.evidence_tab.table_headers.date") %></span></th>
        <th class="text-right p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.evidence_tab.table_headers.actions") %></span></th>
      </tr>
    </thead>
    <tbody id="capa-action-documents-tbody">
      <% if capa_action.evidence_attachments.any? %>
        <% capa_action.evidence_attachments.includes(:upload, :attached_by_user).order(created_at: :desc).each do |evidence_attachment| %>
          <% upload = evidence_attachment.upload %>
          <tr data-upload-id="<%= upload.id %>">
            <td class="p-3 sm:p-4 min-w-[160px]"><span class="text-xs sm:text-sm text-[#0D1120] break-words"><%= upload.display_name %></span></td>
            <td class="p-3 sm:p-4 whitespace-nowrap"><span class="text-xs sm:text-sm text-[#797C81]"><%= upload.mime_type&.split('/')&.last&.upcase || t("capa_management_ui.evidence_tab.mime_type_na") %></span></td>
            <td class="p-3 sm:p-4 min-w-[120px]"><span class="text-xs sm:text-sm text-[#797C81] break-words"><%= evidence_attachment.attached_by_user&.name || (upload.uploaded_by.present? ? t("capa_management_ui.evidence_tab.uploaded_by_fallback.user") : t("capa_management_ui.evidence_tab.uploaded_by_fallback.system")) %></span></td>
            <td class="p-3 sm:p-4 whitespace-nowrap"><span class="text-xs sm:text-sm text-[#797C81]"><%= upload.created_at.strftime('%b %d, %Y') %></span></td>
            <td class="p-3 sm:p-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <a href="<%= signed_file_url(upload.file, disposition: "attachment") %>" target="_blank" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-[#5C3984] hover:text-[#4A2F6B]">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
                <% if can_link_documents_to_capa_action?(capa_action) && !viewer? %>
                  <button type="button" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-red-600 hover:text-red-700 unlink-capa-action-document" data-capa-id="<%= capa.id %>" data-capa-action-id="<%= capa_action.id %>" data-upload-id="<%= upload.id %>" title="<%= t('capa_management_ui.evidence_tab.unlink_document.button_title') %>">
                    <%= image_tag asset_path('unlink-icon.svg'), class: "w-5 h-5 max-w-full h-auto" %>
                  </button>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="p-6 sm:p-8 text-center text-xs sm:text-sm text-[#797C81]"><%= t("capa_action_show.empty_documents") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
(function() {
  function initUnlink() {
    document.querySelectorAll('.unlink-capa-action-document').forEach(function(btn) {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function() {
        var capaId = this.dataset.capaId, actionId = this.dataset.capaActionId, uploadId = this.dataset.uploadId;
        if (!capaId || !actionId || !uploadId) return;
        var row = this.closest('tr');
        window.__pendingUnlinkDocumentAction = { capaId: capaId, actionId: actionId, uploadId: uploadId, row: row, btn: this };
        var dialog = document.getElementById('unlink-document-action-confirm-dialog');
        if (dialog) dialog.showModal();
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initUnlink);
  else initUnlink();
  document.addEventListener('turbo:load', initUnlink);
})();
</script>
