    async function bulkDeleteCapas() {
      const controller = getSelectAllController();
      if (!controller) return;

      const selectedIds = controller.getSelectedCapaIds();
      if (selectedIds.length === 0) {
        alert(listTranslations.selectDelete);
        return;
      }

      if (!(await customConfirm(
        withCount(listTranslations.confirmDeleteMultiple, selectedIds.length),
        { intent: 'delete', confirmText: confirmationTranslations.deleteButton, title: confirmationTranslations.deleteTitle }
      ))) {
        return;
      }

      fetch('/dashboard/capa_management/bulk_delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        credentials: 'same-origin',
        body: JSON.stringify({ capa_ids: selectedIds })
