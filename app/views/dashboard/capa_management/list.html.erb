  <!-- CAPAs Table -->
  <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden">
    <div class="overflow-x-auto -mx-4 sm:mx-0">
      <table class="w-full min-w-[1100px]" data-controller="capas--select-all" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
        <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
          <tr>
            <th class="text-left rtl:text-right p-3 sm:p-4 w-12">
              <input type="checkbox" class="w-5 h-5 sm:w-4 sm:h-4 rounded border-gray-300 text-[#5C3984] focus:ring-[#5C3984] flex-shrink-0" data-capas--select-all-target="master" data-action="change->capas--select-all#toggleAll">
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.title_description") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.source") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.related_standard") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.assignees") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.priority") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.due_date") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.status") %></span>
            </th>
            <th class="text-left rtl:text-right p-3 sm:p-4 w-12">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.list_table.headers.actions") %></span>
            </th>
          </tr>
        </thead>
        <tbody>
          <% if @capas.any? %>
            <% @capas.each do |capa| %>
              <%= render partial: "dashboard/capa_management/capa_list_row", locals: { capa: capa } %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="p-6 sm:p-8 text-center rtl:text-right">
                <% 
                  # Check if any filters are applied
                  has_filters = (params[:status].present? && params[:status] != 'all') || 
                                params[:priority].present? || 
                                params[:assignee_id].present? || 
                                params[:due_date_from].present? ||
                                params[:due_date_to].present? || 
                                params[:search].present?
                %>
                <% if has_filters %>
                  <div class="flex flex-col items-center gap-3 sm:gap-4 rtl:text-right">
                    <p class="text-xs sm:text-sm text-[#797C81] break-words px-4"><%= t("capa_management_ui.list_table.empty.no_capas_filtered") %></p>
                    <%= link_to dashboard_capa_management_list_path, 
                                class: "px-4 py-3 sm:py-2 bg-[#5C3984] hover:bg-[#4A2F6B] text-white rounded-xl text-xs sm:text-sm font-medium transition-colors duration-200 min-h-[44px]" do %>
                      <%= t("capa_management_ui.list_filters.clear_filters") %>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-xs sm:text-sm text-[#797C81] break-words px-4">
                    <%= t("capa_management_ui.list_table.empty.no_capas") %><% if can_create_capa? && !viewer? %> <%= link_to t("capa_management_ui.tabs.add_non_conformity"), "#", class: "text-[#5C3984] underline min-h-[44px] sm:min-h-auto inline-flex items-center", onclick: "document.getElementById('newActionModal').showModal(); return false;" %> <% end %>
                  </p>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render partial: "new_action_modal" %>
<%= render partial: "edit_action_modal" %>
<%= render partial: "general_confirmation_modal" %>
<%= render partial: "delete_confirmation_modal" %>
<%= render partial: "archive_confirmation_modal" %>
</div>
