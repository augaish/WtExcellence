<%= render partial: "tabs" %>

<div>
<div class="bg-[#F9FAFC] min-h-screen p-4 sm:p-6">
  <!-- Filters Section -->
  <div class="mb-4">
    <div class="flex flex-col gap-3">
      <!-- Status Filters -->
      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <div class="inline-flex items-center gap-2 sm:gap-3 bg-white border border-[#E3E3E3] rounded-xl px-4 sm:px-6 py-2 min-w-max">
          <% current_status = params[:status] || 'all' %>
          <% all_link_params = { priority: params[:priority], assignee_id: params[:assignee_id], due_date_to: params[:due_date_to], search: params[:search] }.compact %>
          <%= link_to dashboard_capa_management_list_path(all_link_params), 
                      class: ui_filter_pill(current_status == 'all') do %>
            <%= t("all") %>
          <% end %>
          <% status_link_params = { priority: params[:priority], assignee_id: params[:assignee_id], due_date_to: params[:due_date_to], search: params[:search] }.compact %>
          <%= link_to dashboard_capa_management_list_path(status_link_params.merge(status: 'open')), 
                      class: ui_filter_pill(current_status == 'open') do %>
            <%= t("capa_management_ui.statuses.open") %>
          <% end %>
          <%= link_to dashboard_capa_management_list_path(status_link_params.merge(status: 'assigned')), 
                      class: ui_filter_pill(current_status == 'assigned') do %>
            <%= t("capa_management_ui.statuses.assigned") %>
          <% end %>
          <%= link_to dashboard_capa_management_list_path(status_link_params.merge(status: 'in_progress')), 
                      class: ui_filter_pill(current_status == 'in_progress') do %>
            <%= t("capa_management_ui.statuses.in_progress") %>
          <% end %>
          <%= link_to dashboard_capa_management_list_path(status_link_params.merge(status: 'closed')), 
                      class: ui_filter_pill(current_status == 'closed') do %>
            <%= t("capa_management_ui.statuses.closed") %>
          <% end %>
          <%= link_to dashboard_capa_management_list_path(status_link_params.merge(status: 'overdue')), 
                      class: ui_filter_pill(current_status == 'overdue') do %>
            <%= t("capa_management_ui.status_labels.overdue") %>
          <% end %>
        </div>
      </div>

      <!-- Additional Filters (Right) -->
      <div class="bg-white border border-[#E3E3E3] rounded-xl px-4 sm:px-6 py-3 sm:py-4">
        <form method="get" action="<%= dashboard_capa_management_list_path %>" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-2" id="filterForm">
          <% if params[:status].present? %>
            <input type="hidden" name="status" value="<%= params[:status] %>">
          <% end %>
          <% if params[:search].present? %>
            <input type="hidden" name="search" value="<%= params[:search] %>">
          <% end %>
          
          <!-- Due Date Filter -->
          <div class="relative flex-1 sm:flex-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 cursor-pointer text-[#5C3984]" onclick="(function(){var i=document.getElementById('dueDateFilter'); if(i){ if(i.showPicker){ i.showPicker(); } else { i.focus(); i.click(); } }})()"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
            <input type="date" 
                   name="due_date_to" 
                   value="<%= params[:due_date_to] %>" 
                   id="dueDateFilter"
                   placeholder="<%= t('capa_management_ui.list_filters.due_date') %>"
                   class="w-full sm:min-w-[160px] pl-9 pr-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-xl text-[16px] sm:text-sm text-[#5C3984] font-medium cursor-pointer bg-white min-h-[44px]"
                   onchange="document.getElementById('filterForm').submit()">
          </div>

          <!-- Assigned To Filter -->
          <% if current_user.company_admin? or current_user.company_quality_manager? %>
            <div class="relative flex-1 sm:min-w-[240px] sm:flex-none choices-filter" data-controller="capas--filter">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none w-4 h-4 z-10 text-[#5C3984]"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd"/></svg>
              <select name="assignee_id" 
                      id="assigneeFilter"
                      data-capas--filter-target="select"
                      data-action="change->capas--filter#submit"
                      data-placeholder="<%= t('capa_management_ui.list_filters.assigned_to_label') %>"
                      class="w-full sm:min-w-[240px] py-3 sm:py-2 border border-[#E3E3E3] rounded-xl text-[16px] sm:text-sm text-[#5C3984] font-medium appearance-none bg-white cursor-pointer min-h-[44px]">
                <option value=""><%= t('capa_management_ui.list_filters.assigned_to_label') %></option>
                <% @company_users.each do |company_user| %>
                  <option value="<%= company_user.id %>" <%= 'selected' if params[:assignee_id] == company_user.id.to_s %>><%= company_user.user.name %></option>
                <% end %>
              </select>
              <%= image_tag asset_path('down-arrow-icon.svg'), class: "absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none max-w-full h-auto z-10" %>
            </div>
          <% end %>

          <!-- Priority Filter (with background) -->
          <div class="relative flex-1 sm:flex-none" data-controller="choices-select">
            <select name="priority" 
                    id="priorityFilter"
                    data-choices-select-target="select"
                    data-action="change->filterForm#submit"
                    class="w-full sm:min-w-[160px] pl-4 pr-9 py-3 sm:py-2 border border-[#E3E3E3] rounded-xl text-[16px] sm:text-sm text-[#5C3984] font-medium appearance-none bg-white cursor-pointer min-h-[44px]"
                    onchange="document.getElementById('filterForm').submit()">
              <option value=""><%= t('capa_management_ui.list_filters.priority_placeholder') %></option>
              <option value="high" <%= 'selected' if params[:priority] == 'high' %>><%= t('priority_levels.high') %></option>
              <option value="medium" <%= 'selected' if params[:priority] == 'medium' %>><%= t('priority_levels.medium') %></option>
              <option value="low" <%= 'selected' if params[:priority] == 'low' %>><%= t('priority_levels.low') %></option>
            </select>
          </div>
          
          <% link_params = {} %>
          <% link_params[:status] = params[:status] if params[:status].present? %>
          <% link_params[:search] = params[:search] if params[:search].present? %>
          <%= link_to dashboard_capa_management_list_path(link_params), 
                      class: "w-full sm:w-auto px-4 py-3 sm:py-2 border-0 rounded-xl text-xs sm:text-sm text-[#797C81] font-medium bg-transparent hover:opacity-70 whitespace-nowrap min-h-[44px] sm:min-h-auto flex items-center justify-center" do %>
            <%= t("capa_management_ui.list_filters.clear_filters") %>
          <% end %>
        </form>
      </div>
    </div>
  </div>

  <style>
    /* Hide native right-side icon for date input */
    #dueDateFilter::-webkit-calendar-picker-indicator { display: none; }
    #dueDateFilter { -webkit-appearance: none; -moz-appearance: none; appearance: none; }
  </style>

  <script>
    // Store current page URL in sessionStorage
    function storeCurrentPage() {
      const currentUrl = window.location.pathname + window.location.search;
      sessionStorage.setItem('capa_management_last_page', currentUrl);
    }

    // Store page on load and Turbo navigation
    function initializePageStorage() {
      storeCurrentPage();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializePageStorage);
    } else {
      initializePageStorage();
    }
    document.addEventListener('turbo:load', initializePageStorage);
    document.addEventListener('turbo:render', initializePageStorage);

    window.listTranslations = {
      emptyWithCta: '<%= j(viewer? || !can_create_capa? ? t("capa_management_ui.list_table.empty.no_capas") : t("capa_management_ui.list_page.empty.with_cta_html", create_link: link_to(t("capa_management_ui.list_page.empty.create_first"), "#", class: "text-[#5C3984] underline", onclick: "document.getElementById(\'newActionModal\').showModal(); return false;"))) %>',
      selectArchive: '<%= j t("capa_management_ui.list_page.alerts.select_archive") %>',
      selectDelete: '<%= j t("capa_management_ui.list_page.alerts.select_delete") %>',
      confirmArchiveSingle: '<%= j t("capa_management_ui.list_page.confirmations.archive_single") %>',
      confirmArchiveMultiple: '<%= j t("capa_management_ui.list_page.confirmations.archive_multiple", count: "%{count}") %>',
      confirmDeleteSingle: '<%= j t("capa_management_ui.list_page.confirmations.delete_single") %>',
      confirmDeleteMultiple: '<%= j t("capa_management_ui.list_page.confirmations.delete_multiple", count: "%{count}") %>',
      errorArchiveSingle: '<%= j t("capa_management_ui.list_page.errors.archive_single") %>',
      errorArchiveMultiple: '<%= j t("capa_management_ui.list_page.errors.archive_multiple") %>',
      errorDeleteSingle: '<%= j t("capa_management_ui.list_page.errors.delete_single") %>',
      errorDeleteMultiple: '<%= j t("capa_management_ui.list_page.errors.delete_multiple") %>'
    };
 
    window.confirmationTranslations = {
      defaultTitle: '<%= j t("capa_management_ui.confirmations.default_title") %>',
      confirmButton: '<%= j t("capa_management_ui.confirmations.confirm_button") %>',
      deleteTitle: '<%= j t("capa_management_ui.confirmations.delete_title") %>',
      deleteButton: '<%= j t("capa_management_ui.confirmations.delete_button") %>',
      unlinkTitle: '<%= j t("capa_management_ui.confirmations.unlink_title") %>',
      unlinkButton: '<%= j t("capa_management_ui.confirmations.unlink_button") %>',
      removeTitle: '<%= j t("capa_management_ui.confirmations.remove_title") %>',
      removeButton: '<%= j t("capa_management_ui.confirmations.remove_button") %>'
    };

    var emptyStateRowHtml = `
      <tr>
        <td colspan="9" class="p-8 text-center text-[#797C81]">
          ${listTranslations.emptyWithCta}
        </td>
      </tr>
    `;

    function withCount(template, count) {
      return template.replace('%{count}', count);
    }

    function setupCapaRowClickHandlers() {
      // Remove existing listeners to avoid duplicates
      const table = document.querySelector('table[data-controller="capas--select-all"]');
      if (!table) return;

      // Use event delegation on the table
      table.addEventListener('click', function(event) {
        const row = event.target.closest('tr[data-capa-id]');
        if (!row) return;

        // Don't navigate if clicking on interactive elements
        if (event.target.closest('input[type="checkbox"]') || 
            event.target.closest('details') ||
            event.target.closest('button') ||
            event.target.closest('a') ||
            event.target.closest('td[onclick]')) {
          return;
        }

        const capaId = row.getAttribute('data-capa-id');
        if (capaId) {
          // Store current page before navigating
          storeCurrentPage();
          const baseUrl = '<%= dashboard_capa_management_show_path(id: 999) %>'.replace('999', capaId);
          window.location.href = baseUrl + '#evidence';
        }
      });
    }

    // Setup on initial page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCapaRowClickHandlers);
    } else {
      setupCapaRowClickHandlers();
    }

    // Setup on Turbo navigation
    document.addEventListener('turbo:load', setupCapaRowClickHandlers);

    // Custom confirm function for archiving that returns a Promise
    window.customArchiveConfirm = async function(message, options = {}) {
      const modal = document.getElementById('archiveCapaModal');
      if (!modal) {
        // Fallback to browser confirm if modal not found
        return confirm(message);
      }

      try {
        const archiveController = window.Stimulus.getControllerForElementAndIdentifier(
          modal,
          'capas--archive-confirmation'
        );

        if (!archiveController) {
          return confirm(message);
        }

        return await archiveController.confirm(message, options);
      } catch (error) {
        console.warn('Custom archive confirm failed, falling back to browser:', error);
        return confirm(message);
      }
    };

    // Custom confirm function that returns a Promise (like confirm() but async)
    window.customConfirm = async function(message, options = {}) {
      const modal = document.getElementById('generalConfirmationModal');
      if (!modal) {
        // Fallback to browser confirm if modal not found
        return confirm(message);
      }

      try {
        const generalController = window.Stimulus.getControllerForElementAndIdentifier(
          modal,
          'capas--general-confirmation'
        );

        if (!generalController) {
          return confirm(message);
        }

        const intent = options.intent;
        let buttonStyle = options.buttonStyle;
        if (!buttonStyle) {
          if (intent === 'delete' || intent === 'remove') {
            buttonStyle = 'danger';
          } else if (intent === 'unlink') {
            buttonStyle = 'primary';
          } else {
            buttonStyle = 'primary';
          }
        }

        let confirmText = options.confirmText;
        if (!confirmText) {
          if (intent === 'delete') {
            confirmText = confirmationTranslations.deleteButton;
          } else if (intent === 'unlink') {
            confirmText = confirmationTranslations.unlinkButton;
          } else if (intent === 'remove') {
            confirmText = confirmationTranslations.removeButton;
          } else {
            confirmText = confirmationTranslations.confirmButton;
          }
        }

        let title = options.title;
        if (!title) {
          if (intent === 'delete') {
            title = confirmationTranslations.deleteTitle;
          } else if (intent === 'unlink') {
            title = confirmationTranslations.unlinkTitle;
          } else if (intent === 'remove') {
            title = confirmationTranslations.removeTitle;
          } else {
            title = confirmationTranslations.defaultTitle;
          }
        }

        return await generalController.confirm(message, {
          title: title,
          confirmText: confirmText,
          buttonStyle: buttonStyle,
          ...options
        });
      } catch (error) {
        console.warn('Custom confirm failed, falling back to browser:', error);
        return confirm(message);
      }
    };

    async function archiveCapa(capaId) {
      if (!(await customArchiveConfirm(listTranslations.confirmArchiveSingle))) {
        return;
      }

      fetch(`/dashboard/capa_management/${capaId}/archive`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        credentials: 'same-origin'
      })
      .then(response => response.json().then(data => ({ response, data })))
      .then(({ response, data }) => {
        if (data.notification_html) {
          const event = new CustomEvent('toast:show', {
            detail: { notificationHtml: data.notification_html },
            bubbles: true
          });
          document.dispatchEvent(event);
        }
        if (data.error) {
          // Dispatch error toast
          const bgColor = 'bg-[#FFFFFF] border-[#E3E3E3] border-l-4 border-l-red-500';
          const icon = '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';
          const notificationHtml = `
            <div
              data-toast-target="notification"
              class="${bgColor} rounded-lg shadow-lg p-4 flex items-start gap-3 transform opacity-0 translate-x-full transition ease-out duration-300"
            >
              ${icon}
              <div class="flex-1 text-sm text-[#0D1120] font-medium">
                ${data.error}
              </div>
              <button
                data-action="click->toast#close"
                class="text-gray-400 hover:text-gray-600 transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
            </div>
          `;
          const event = new CustomEvent('toast:show', {
            detail: { notificationHtml: notificationHtml },
            bubbles: true
          });
          document.dispatchEvent(event);
        }
        if (response.ok && !data.error) {
          const row = document.querySelector(`tr[data-capa-id="${capaId}"]`);
          if (row) {
            row.remove();
            const table = document.querySelector('table[data-controller="capas--select-all"]');
            if (table) {
              const tbody = table.querySelector('tbody');
              if (tbody && tbody.children.length === 0) {
                const temp = document.createElement('tbody');
                temp.innerHTML = emptyStateRowHtml.trim();
                const emptyRow = temp.firstElementChild;
                if (emptyRow) tbody.appendChild(emptyRow);
              }
            }
          }
        }
      })
      .catch(error => {
        console.error('Error:', error);
        const bgColor = 'bg-[#FFFFFF] border-[#E3E3E3] border-l-4 border-l-red-500';
        const icon = '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';
        const notificationHtml = `
          <div
            data-toast-target="notification"
            class="${bgColor} rounded-lg shadow-lg p-4 flex items-start gap-3 transform opacity-0 translate-x-full transition ease-out duration-300"
          >
            ${icon}
              <div class="flex-1 text-sm text-[#0D1120] font-medium">
                ${listTranslations.errorArchiveSingle}
              </div>
            <button
              data-action="click->toast#close"
              class="text-gray-400 hover:text-gray-600 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        `;
        const event = new CustomEvent('toast:show', {
          detail: { notificationHtml: notificationHtml },
          bubbles: true
        });
        document.dispatchEvent(event);
      });
    }

    async function deleteCapa(capaId) {
      if (!(await customConfirm(
        listTranslations.confirmDeleteSingle,
        { intent: 'delete', confirmText: confirmationTranslations.deleteButton, title: confirmationTranslations.deleteTitle }
      ))) {
        return;
      }

      try {
        const response = await fetch(`/dashboard/capa_management/${capaId}`, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
            'Accept': 'application/json'
          },
          credentials: 'same-origin'
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          if (error.notification_html) {
            const event = new CustomEvent('toast:show', {
              detail: { notificationHtml: error.notification_html },
              bubbles: true
            });
            document.dispatchEvent(event);
          }
          return;
        }

        const data = await response.json();
        if (data.notification_html) {
          // Dispatch toast notification
          const event = new CustomEvent('toast:show', {
            detail: { notificationHtml: data.notification_html },
            bubbles: true
          });
          document.dispatchEvent(event);
        }

        // Remove CAPA row from table
        const row = document.querySelector(`tr[data-capa-id="${capaId}"]`);
        if (row) {
          row.remove();
          
          // Check if table is now empty and show empty state
          const table = document.querySelector('table[data-controller="capas--select-all"]');
          if (table) {
            const tbody = table.querySelector('tbody');
            if (tbody && tbody.children.length === 0) {
              const temp = document.createElement('tbody');
              temp.innerHTML = emptyStateRowHtml.trim();
              const emptyRow = temp.firstElementChild;
              if (emptyRow) {
                tbody.appendChild(emptyRow);
              }
            }
          }
        }
      } catch (error) {
        console.error('Error:', error);
        const bgColor = 'bg-[#FFFFFF] border-[#E3E3E3] border-l-4 border-l-red-500';
        const icon = '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';
        const notificationHtml = `
          <div
            data-toast-target="notification"
            class="${bgColor} rounded-lg shadow-lg p-4 flex items-start gap-3 transform opacity-0 translate-x-full transition ease-out duration-300"
          >
            ${icon}
              <div class="flex-1 text-sm text-[#0D1120] font-medium">
                ${listTranslations.errorDeleteSingle}
              </div>
            <button
              data-action="click->toast#close"
              class="text-gray-400 hover:text-gray-600 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        `;
        const event = new CustomEvent('toast:show', {
          detail: { notificationHtml: notificationHtml },
          bubbles: true
        });
        document.dispatchEvent(event);
      }
    }

    function getSelectAllController() {
      const table = document.querySelector('table[data-controller="capas--select-all"]');
      if (!table) return null;
      return window.Stimulus.getControllerForElementAndIdentifier(table, 'capas--select-all');
    }

    async function bulkArchiveCapas() {
      const controller = getSelectAllController();
      if (!controller) return;

      const selectedIds = controller.getSelectedCapaIds();
      if (selectedIds.length === 0) {
        alert(listTranslations.selectArchive);
        return;
      }

      if (!(await customArchiveConfirm(withCount(listTranslations.confirmArchiveMultiple, selectedIds.length)))) {
        return;
      }

      fetch('/dashboard/capa_management/bulk_archive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        credentials: 'same-origin',
        body: JSON.stringify({ capa_ids: selectedIds })
      })
      .then(response => response.json())
      .then(data => {
        if (data.notification_html) {
