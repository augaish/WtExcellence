<div class="overflow-x-auto -mx-3 sm:mx-0">
  <div class="inline-block min-w-full align-middle">
    <div class="overflow-hidden rounded-lg border border-[#E3E3E3]">
      <table class="w-full min-w-[400px]">
        <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
          <tr>
            <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.overview_charts.assignee_name") %></span></th>
            <th class="text-left p-3 sm:p-4"><span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.overview_charts.nr_assigned") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% if @top_assigned_users&.any? %>
            <% @top_assigned_users.each do |item| %>
              <% company_user = item[:company_user] %>
              <% next unless company_user&.user %>
              <tr class="border-b border-[#E3E3E3]">
                <td class="p-3 sm:p-4 min-w-[180px]">
                  <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                    <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium overflow-hidden flex-shrink-0" title="<%= company_user.user.name %>">
                      <% if company_user.user.profile_image.attached? %>
                        <%= image_tag user_profile_image_url(company_user.user), class: "w-full h-full object-cover max-w-full h-auto" %>
                      <% else %>
                        <%= company_user.user.name[0].upcase %>
                      <% end %>
                    </div>
                    <span class="text-xs sm:text-sm text-[#0D1120] font-medium truncate"><%= company_user.user.name %></span>
                    <span class="text-[10px] sm:text-xs text-[#576A83] bg-[#F7F7FD] px-2 sm:px-3 py-1 rounded-full whitespace-nowrap"><%= company_user.role %></span>
                  </div>
                </td>
                <td class="p-3 sm:p-4 text-center whitespace-nowrap">
                  <span class="text-xs sm:text-sm text-[#0D1120] font-medium"><%= item[:count] %></span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="2" class="p-4 text-center text-xs sm:text-sm text-[#797C81]"><%= t("capa_management_ui.overview_charts.no_assignments") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

