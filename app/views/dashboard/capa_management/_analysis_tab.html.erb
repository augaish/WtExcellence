<!-- Questionnaire Section -->
<% regenerate_questionnaire_cost = CreditService.get_cost("GENERATE_CAPA_QUESTIONNAIRE") %>
<% regenerate_root_cause_cost = CreditService.get_cost("REGENERATE_ROOT_CAUSE") %>
<% contributor = current_user&.company_user&.company_contributor? %>

<div class="mb-6 sm:mb-8" data-controller="capas--questionnaire">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 mb-4">
    <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] break-words"><%= t("capa_management_ui.analysis_tab.questionnaire_title") %></h3>
    <% if @capa.questionnaire.present? %>
      <div class="flex items-center gap-2 flex-wrap">
        <% unless viewer? %>
          <!-- View Mode Buttons -->
          <div class="flex items-center gap-2 flex-wrap" data-capas--questionnaire-target="viewModeButtons">
            <button type="button" 
                    class="px-3 py-2 sm:py-1.5 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                    data-action="click->capas--questionnaire#toggleEditMode"
                    data-capas--questionnaire-target="editButton"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.edit") %></span>
            </button>
            <button type="button" 
                    class="px-3 py-2 sm:py-1.5 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                    data-questionnaire-generate-button
                    data-capa-id="<%= @capa.id %>"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#FFFFFF] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.regenerate") %></span>
              <% if regenerate_questionnaire_cost.to_i > 0 %>
                <span class="ml-1 px-1.5 py-0.5 bg-white/20 rounded text-[10px] sm:text-xs font-normal"><%= t("capa_management_ui.analysis_tab.credits_suffix", credits: regenerate_questionnaire_cost) %></span>
              <% end %>
            </button>
          </div>
          <!-- Edit Mode Buttons -->
          <div class="hidden flex items-center gap-2 flex-wrap" data-capas--questionnaire-target="editModeButtons">
            <button type="button" 
                    class="px-3 py-2 sm:py-1.5 bg-[#3F9011] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                    data-action="click->capas--questionnaire#saveQuestionnaire"
                    data-capas--questionnaire-target="saveButton"
                    data-capa-id="<%= @capa.id %>"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.save") %></span>
            </button>
            <button type="button" 
                    class="px-3 py-2 sm:py-1.5 bg-[#797C81] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                    data-action="click->capas--questionnaire#cancelEdit"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.cancel") %></span>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <% if @capa.questionnaire.present? %>
    <div class="border border-[#E3E3E3] rounded-xl overflow-hidden" data-capas--questionnaire-target="questionnaireContainer">
      <div class="hidden sm:block bg-[#F7F7FD] border-b border-[#E3E3E3] px-4 sm:px-6 py-3">
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <div>
            <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
          </div>
        </div>
      </div>
      
      <div class="divide-y divide-[#E3E3E3]" data-capas--questionnaire-target="questionnaireContent">
        <!-- Question 1 -->
        <div class="px-4 sm:px-6 py-3 sm:py-4" data-capas--questionnaire-target="questionRow" data-question-index="1">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <!-- Mobile Label -->
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
              <!-- View Mode -->
              <p class="text-xs sm:text-sm font-medium text-[#0D1120] flex-1 break-words" data-capas--questionnaire-target="questionView"><%= @capa.questionnaire.question_1 %></p>
              <!-- Edit Mode -->
              <textarea class="hidden w-full text-xs sm:text-sm font-medium text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="questionEdit" 
                        data-question-field="question_1"
                        rows="2"><%= @capa.questionnaire.question_1 %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <!-- Mobile Label -->
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
              <!-- View Mode -->
              <div class="flex items-start gap-2 flex-1 min-w-0" data-capas--questionnaire-target="answerView">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <p class="text-xs sm:text-sm text-[#0D1120] break-words"><%= @capa.questionnaire.answer_1 %></p>
              </div>
              <!-- Edit Mode -->
              <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="answerEdit" 
                        data-answer-field="answer_1"
                        rows="2"><%= @capa.questionnaire.answer_1 %></textarea>
              <!-- Delete Button (Edit Mode Only) -->
              <button type="button" 
                      class="hidden text-[#DC2626] hover:text-[#B91C1C] flex-shrink-0 mt-1 p-2 min-w-[44px] min-h-[44px] sm:min-w-auto sm:min-h-auto"
                      data-capas--questionnaire-target="deleteButton"
                      data-action="click->capas--questionnaire#removeQuestion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <!-- Question 2 -->
        <div class="px-4 sm:px-6 py-3 sm:py-4" data-capas--questionnaire-target="questionRow" data-question-index="2">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
              <p class="text-xs sm:text-sm font-medium text-[#0D1120] flex-1 break-words" data-capas--questionnaire-target="questionView"><%= @capa.questionnaire.question_2 %></p>
              <textarea class="hidden w-full text-xs sm:text-sm font-medium text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="questionEdit" 
                        data-question-field="question_2"
                        rows="2"><%= @capa.questionnaire.question_2 %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
              <div class="flex items-start gap-2 flex-1 min-w-0" data-capas--questionnaire-target="answerView">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <p class="text-xs sm:text-sm text-[#0D1120] break-words"><%= @capa.questionnaire.answer_2 %></p>
              </div>
              <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="answerEdit" 
                        data-answer-field="answer_2"
                        rows="2"><%= @capa.questionnaire.answer_2 %></textarea>
              <button type="button" 
                      class="hidden text-[#DC2626] hover:text-[#B91C1C] flex-shrink-0 mt-1 p-2 min-w-[44px] min-h-[44px] sm:min-w-auto sm:min-h-auto"
                      data-capas--questionnaire-target="deleteButton"
                      data-action="click->capas--questionnaire#removeQuestion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <!-- Question 3 -->
        <div class="px-4 sm:px-6 py-3 sm:py-4" data-capas--questionnaire-target="questionRow" data-question-index="3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
              <p class="text-xs sm:text-sm font-medium text-[#0D1120] flex-1 break-words" data-capas--questionnaire-target="questionView"><%= @capa.questionnaire.question_3 %></p>
              <textarea class="hidden w-full text-xs sm:text-sm font-medium text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="questionEdit" 
                        data-question-field="question_3"
                        rows="2"><%= @capa.questionnaire.question_3 %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
              <div class="flex items-start gap-2 flex-1 min-w-0" data-capas--questionnaire-target="answerView">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <p class="text-xs sm:text-sm text-[#0D1120] break-words"><%= @capa.questionnaire.answer_3 %></p>
              </div>
              <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="answerEdit" 
                        data-answer-field="answer_3"
                        rows="2"><%= @capa.questionnaire.answer_3 %></textarea>
              <button type="button" 
                      class="hidden text-[#DC2626] hover:text-[#B91C1C] flex-shrink-0 mt-1 p-2 min-w-[44px] min-h-[44px] sm:min-w-auto sm:min-h-auto"
                      data-capas--questionnaire-target="deleteButton"
                      data-action="click->capas--questionnaire#removeQuestion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <!-- Question 4 -->
        <div class="px-4 sm:px-6 py-3 sm:py-4" data-capas--questionnaire-target="questionRow" data-question-index="4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
              <p class="text-xs sm:text-sm font-medium text-[#0D1120] flex-1 break-words" data-capas--questionnaire-target="questionView"><%= @capa.questionnaire.question_4 %></p>
              <textarea class="hidden w-full text-xs sm:text-sm font-medium text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="questionEdit" 
                        data-question-field="question_4"
                        rows="2"><%= @capa.questionnaire.question_4 %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
              <div class="flex items-start gap-2 flex-1 min-w-0" data-capas--questionnaire-target="answerView">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <p class="text-xs sm:text-sm text-[#0D1120] break-words"><%= @capa.questionnaire.answer_4 %></p>
              </div>
              <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="answerEdit" 
                        data-answer-field="answer_4"
                        rows="2"><%= @capa.questionnaire.answer_4 %></textarea>
              <button type="button" 
                      class="hidden text-[#DC2626] hover:text-[#B91C1C] flex-shrink-0 mt-1 p-2 min-w-[44px] min-h-[44px] sm:min-w-auto sm:min-h-auto"
                      data-capas--questionnaire-target="deleteButton"
                      data-action="click->capas--questionnaire#removeQuestion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <!-- Question 5 -->
        <div class="px-4 sm:px-6 py-3 sm:py-4" data-capas--questionnaire-target="questionRow" data-question-index="5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.question_header") %></span>
              <p class="text-xs sm:text-sm font-medium text-[#0D1120] flex-1 break-words" data-capas--questionnaire-target="questionView"><%= @capa.questionnaire.question_5 %></p>
              <textarea class="hidden w-full text-xs sm:text-sm font-medium text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="questionEdit" 
                        data-question-field="question_5"
                        rows="2"><%= @capa.questionnaire.question_5 %></textarea>
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-2">
              <span class="sm:hidden text-[10px] font-semibold text-[#797C81] uppercase"><%= t("capa_management_ui.analysis_tab.answer_header") %></span>
              <div class="flex items-start gap-2 flex-1 min-w-0" data-capas--questionnaire-target="answerView">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <p class="text-xs sm:text-sm text-[#0D1120] break-words"><%= @capa.questionnaire.answer_5 %></p>
              </div>
              <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                        data-capas--questionnaire-target="answerEdit" 
                        data-answer-field="answer_5"
                        rows="2"><%= @capa.questionnaire.answer_5 %></textarea>
              <button type="button" 
                      class="hidden text-[#DC2626] hover:text-[#B91C1C] flex-shrink-0 mt-1 p-2 min-w-[44px] min-h-[44px] sm:min-w-auto sm:min-h-auto"
                      data-capas--questionnaire-target="deleteButton"
                      data-action="click->capas--questionnaire#removeQuestion">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <!-- Add Question Button (Edit Mode Only) -->
        <% unless viewer? %>
          <div class="px-4 sm:px-6 py-3 sm:py-4 hidden" data-capas--questionnaire-target="addQuestionContainer">
              <button type="button" 
                    class="w-full px-4 py-3 sm:py-2 border-2 border-dashed border-[#E3E3E3] rounded-lg text-xs sm:text-sm font-medium text-[#797C81] hover:border-[#5C3984] hover:text-[#5C3984] flex items-center justify-center gap-2 min-h-[44px] disabled:opacity-50 disabled:cursor-not-allowed"
                    data-action="click->capas--questionnaire#addQuestion"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
                <span><%= t("capa_management_ui.analysis_tab.add_question") %></span>
            </button>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Root Cause Summary Section -->
    <div class="mb-6 sm:mb-8 mt-6 sm:mt-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 mb-4">
        <div class="flex items-center gap-2">
          <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] break-words"><%= t("capa_management_ui.analysis_tab.root_cause_title") %></h3>
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <% unless viewer? %>
            <div class="flex items-center gap-2 flex-wrap" data-capas--questionnaire-target="rootCauseViewButtons">
              <button type="button"
                      class="px-3 py-2 sm:py-1.5 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                      data-action="click->capas--questionnaire#toggleRootCauseEdit"
                      <%= "disabled" if contributor %>>
                <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                <span><%= t("capa_management_ui.analysis_tab.edit") %></span>
              </button>
              <button type="button"
                      class="px-3 py-2 sm:py-1.5 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                      data-action="click->capas--questionnaire#regenerateRootCause"
                      data-capa-id="<%= @capa.id %>"
                      data-capas--questionnaire-target="rootCauseRegenerateButton"
                      <%= "disabled" if contributor %>>
                <svg class="hidden w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                     data-capas--questionnaire-target="rootCauseRegenerateSpinner">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#FFFFFF] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                <span data-capas--questionnaire-target="rootCauseRegenerateText"><%= t("capa_management_ui.analysis_tab.regenerate") %></span>
                <% if regenerate_root_cause_cost.to_i > 0 %>
                  <span class="ml-1 px-1.5 py-0.5 bg-white/20 rounded text-[10px] sm:text-xs font-normal"><%= t("capa_management_ui.analysis_tab.credits_suffix", credits: regenerate_root_cause_cost) %></span>
                <% end %>
              </button>
            </div>
            <div class="hidden flex items-center gap-2 flex-wrap" data-capas--questionnaire-target="rootCauseEditButtons">
              <button type="button" 
                      class="px-3 py-2 sm:py-1.5 bg-[#3F9011] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                      data-action="click->capas--questionnaire#saveRootCause"
                      data-capa-id="<%= @capa.id %>"
                      data-capas--questionnaire-target="rootCauseSaveButton"
                      <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.save") %></span>
            </button>
            <button type="button" 
                    class="px-3 py-2 sm:py-1.5 bg-[#797C81] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px] sm:min-h-auto"
                    data-action="click->capas--questionnaire#cancelRootCauseEdit"
                    <%= "disabled" if contributor %>>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span><%= t("capa_management_ui.analysis_tab.cancel") %></span>
            </button>
          </div>
          <% end %>
        </div>
      </div>
      
      <div class="bg-[#F7F7FD] border border-[#E3E3E3] rounded-xl p-3 sm:p-4" data-capas--questionnaire-target="rootCauseContainer">
        <!-- View Mode -->
        <p class="text-xs sm:text-sm text-[#0D1120] break-words" data-capas--questionnaire-target="rootCauseView">
          <%= @capa.questionnaire.root_cause %>
        </p>
        <!-- Edit Mode -->
        <textarea class="hidden w-full text-xs sm:text-sm text-[#0D1120] border border-[#E3E3E3] rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-[#5C3984]" 
                  data-capas--questionnaire-target="rootCauseEdit"
                  rows="4"><%= @capa.questionnaire.root_cause %></textarea>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="border border-[#E3E3E3] rounded-xl p-6 sm:p-8 text-center">
      <p class="text-xs sm:text-sm text-[#797C81] mb-4 break-words px-4"><%= t("capa_management_ui.analysis_tab.empty_questionnaire") %></p>
      <div class="flex flex-col items-center gap-3">
        <button type="button" 
                class="px-4 py-3 sm:py-2 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px]"
                data-questionnaire-generate-button
                data-capa-id="<%= @capa.id %>"
                <%= "disabled" if contributor %>>
          <span><%= t("capa_management_ui.analysis_tab.generate_questionnaire") %></span>
        </button>
        <button type="button" 
                class="px-4 py-3 sm:py-2 bg-[#5C3984] rounded-lg text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px]"
                data-action="click->capas--questionnaire#writeQuestionnaire"
                data-capas--questionnaire-target="writeButton"
                data-capa-id="<%= @capa.id %>"
                <%= "disabled" if contributor %>>
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span data-capas--questionnaire-target="writeButtonText"><%= t("capa_management_ui.analysis_tab.write_questionnaire") %></span>
          <svg data-capas--questionnaire-target="writeLoadingSpinner" class="hidden w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Root Cause Summary Section (empty state) -->
    <div class="mb-6 sm:mb-8 mt-6 sm:mt-8">
      <div class="flex items-center gap-2 mb-4">
        <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] break-words"><%= t("capa_management_ui.analysis_tab.root_cause_title") %></h3>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#5C3984] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      
      <div class="bg-[#F7F7FD] border border-[#E3E3E3] rounded-xl p-3 sm:p-4">
        <p class="text-xs sm:text-sm text-[#797C81] break-words"><%= t("capa_management_ui.analysis_tab.root_cause_pending") %></p>
      </div>
    </div>
  <% end %>
</div>

<%= render 'dashboard/capa_management/questionnaire_generation_modal' %>

<!-- Corrective & Preventive Actions Section -->
<div data-controller="capas--capa-action"
     data-create-title="<%= t('capa_management_ui.actions.create_title') %>"
     data-create-subtitle="<%= t('capa_management_ui.actions.create_subtitle') %>"
     data-create-submit="<%= t('capa_management_ui.actions.create_submit') %>"
     data-create-loading="<%= t('capa_management_ui.actions.create_loading') %>"
     data-edit-title="<%= t('capa_management_ui.actions.edit_title') %>"
     data-edit-subtitle="<%= t('capa_management_ui.actions.edit_subtitle') %>"
     data-edit-submit="<%= t('capa_management_ui.actions.edit_submit') %>"
     data-edit-loading="<%= t('capa_management_ui.actions.edit_loading') %>"
     data-delete-confirm="<%= t('capa_management_ui.actions.delete_confirm') %>"
     data-delete-loading="<%= t('capa_management_ui.actions.delete_loading') %>"
     data-delete-error="<%= t('capa_management_ui.actions.delete_error') %>"
     data-delete-button="<%= t('capa_management_ui.actions.delete_button') %>"
     data-network-error="<%= t('capa_management_ui.actions.network_error') %>"
     data-generate-loading="<%= t('capa_management_ui.actions.generate_loading') %>"
     data-generate-error="<%= t('capa_management_ui.actions.generate_error') %>">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 mb-4">
    <h3 class="text-base sm:text-lg font-semibold text-[#0D1120] break-words"><%= t("capa_management_ui.analysis_tab.corrective_preventive_title") %></h3>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">

      <button type="button" 
              class="px-3 sm:px-4 py-3 sm:py-2 bg-[#5C3984] rounded-xl text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 min-h-[44px]"
              data-action="click->capas--capa-action#openCreateModal"
              <%= "disabled" if contributor %>>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span><%= t("capa_management_ui.analysis_tab.assign_actions") %></span>
      </button>

      <% generate_actions_cost = CreditService.get_cost("GENERATE_CAPA_ACTIONS") %>
      <% can_generate_actions = @capa.questionnaire&.root_cause.present? %>
      <% generate_actions_help = t("capa_management_requirements.generate_actions.button_requirement", default: "Complete the questionnaire and root cause before generating actions.") %>
      <% unless viewer? %>
        <button type="button" 
                id="generateActionsButton"
                class="px-3 sm:px-4 py-3 sm:py-2 bg-[#5C3984] rounded-xl text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 min-h-[44px]"
                data-action="click->capas--capa-action#generateActions"
                data-capa-id="<%= @capa.id %>"
                data-root-cause-ready="<%= can_generate_actions %>"
                data-root-cause-message="<%= j generate_actions_help %>"
                <%# A contributor is barred for a different reason, which the
                    readiness update must never override. %>
                data-role-disabled="<%= contributor ? 'true' : 'false' %>"
                <%= "disabled" if contributor || !can_generate_actions %>>
          <svg data-generate-actions-spinner class="hidden w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#FFFFFF] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
          <span data-generate-actions-text><%= t("capa_management_ui.analysis_tab.generate_actions") %></span>
          <% if generate_actions_cost.to_i > 0 %>
            <span class="ml-1 px-1.5 py-0.5 bg-white/20 rounded text-[10px] sm:text-xs font-normal"><%= t("capa_management_ui.analysis_tab.credits_suffix", credits: generate_actions_cost) %></span>
          <% end %>
        </button>
      <% end %>
      <% unless can_generate_actions %>
        <p class="text-xs text-[#797C81] max-w-full sm:max-w-xs break-words"><%= generate_actions_help %></p>
      <% end %>
      
    </div>
  </div>

  <% if @proposed_actions.present? %>
    <%= render "dashboard/capa_management/proposed_actions", capa: @capa, proposals: @proposed_actions, company_users: @company_users %>
  <% end %>

  <!-- Actions Table (contributor/auditor see only actions assigned to them) -->
  <% if @capa_actions_visible.any? %>
    <div class="border border-[#E3E3E3] rounded-xl overflow-x-auto -mx-4 sm:mx-0">
      <table class="w-full min-w-[900px]">
        <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
          <tr>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("title") %></span>
            </th>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("capa_actions.headers.action_type", default: t("capa_actions.types.corrective")) %></span>
            </th>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("assignees") %></span>
            </th>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("status") %></span>
            </th>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("due_date") %></span>
            </th>
            <th class="text-left p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"><%= t("notes", default: "Notes") %></span>
            </th>
            <th class="text-right p-3 sm:p-4">
              <span class="text-[10px] sm:text-xs font-semibold text-[#797C81]"></span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E3E3E3]">
          <% @capa_actions_visible.each do |action| %>
            <% 
              # Action type styling
              action_type_styles = {
                'corrective' => { bg: 'bg-[#E0F9DE]', text: 'text-[#3F9011]', label: 'Corrective' },
                'preventive' => { bg: 'bg-[#FEF0FF]', text: 'text-[#B130AC]', label: 'Preventive' }
              }
              action_type_style = action_type_styles[action.action_type] || { bg: 'bg-gray-100', text: 'text-gray-600', label: action.action_type&.humanize || '-' }
              
              # Status styling
              status_styles = {
                'started' => { bg: 'bg-[#E0F9DE]', text: 'text-[#3F9011]', label: 'Started' },
                'in_progress' => { bg: 'bg-[#E9F0FF]', text: 'text-[#1751A7]', label: 'In Progress' },
                'done' => { bg: 'bg-[#E0F9DE]', text: 'text-[#3F9011]', label: 'Done' }
              }
              status_style = status_styles[action.status] || { bg: 'bg-gray-100', text: 'text-gray-600', label: action.status&.humanize || '-' }
              
              # Format due date
              due_date_formatted = action.due_date ? action.due_date.strftime("%b %d, %Y") : '-'
              
              # Get assignees
              assignees = action.company_users.includes(:user).to_a
              assignee_ids = assignees.map(&:id).join(',')
            %>
            <tr class="hover:bg-[#F7F7FD] cursor-pointer"
                data-action-id="<%= action.id %>"
                onclick="window.location.href='<%= dashboard_capa_action_show_path(@capa.id, action.id) %>'" >
              <td class="p-3 sm:p-4 min-w-[160px]">
                <p class="text-xs sm:text-sm font-medium text-[#0D1120] break-words"><%= action.title %></p>
              </td>
              <td class="p-3 sm:p-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium <%= action_type_style[:bg] %> <%= action_type_style[:text] %>">
                  <%= action_type_style[:label] %>
                </span>
              </td>
              <td class="p-3 sm:p-4 min-w-[140px]">
                <% if assignees.any? %>
                  <div class="flex items-center min-w-0">
                    <% if assignees.length <= 3 %>
                      <div class="flex items-center flex-shrink-0" style="isolation: isolate;">
                        <% assignees.each_with_index do |cu, idx| %>
                          <% initial = cu.user.name&.first&.upcase || '?' %>
                          <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium border-2 border-white" 
                               style="<%= idx > 0 ? "margin-left: -8px; z-index: #{assignees.length - idx};" : "z-index: #{assignees.length};" %>">
                            <%= cu.user.profile_image.attached? ? image_tag(user_profile_image_url(cu.user), class: "w-full h-full object-cover rounded-full") : initial %>
                          </div>
                        <% end %>
                      </div>
                      <% if assignees.length > 0 %>
                        <span class="text-[10px] sm:text-xs text-[#0D1120] ml-2 truncate"><%= assignees.map { |cu| cu.user.name }.join(', ') %></span>
                      <% end %>
                    <% else %>
                      <div class="flex items-center flex-shrink-0" style="isolation: isolate;">
                        <% assignees.first(3).each_with_index do |cu, idx| %>
                          <% initial = cu.user.name&.first&.upcase || '?' %>
                          <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium border-2 border-white" 
                               style="<%= idx > 0 ? "margin-left: -8px; z-index: #{4 - idx};" : "z-index: 4;" %>">
                            <%= cu.user.profile_image.attached? ? image_tag(user_profile_image_url(cu.user), class: "w-full h-full object-cover rounded-full") : initial %>
                          </div>
                        <% end %>
                      </div>
                      <span class="text-[10px] sm:text-xs text-[#797C81] ml-2"><%= t("capa_management_ui.analysis_tab.more_assignees", count: assignees.length - 3) %></span>
                    <% end %>
                  </div>
                <% else %>
                  <% if can_assign_to_capa_action?(action) %>
                    <button type="button"
                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-dashed border-[#5C3984] text-[10px] sm:text-xs font-medium text-[#5C3984] hover:bg-[#F9F5FF] transition-colors"
                            onclick="event.stopPropagation(); openAssignAssigneesModal('<%= @capa.id %>', '<%= action.id %>', '<%= assignee_ids %>')"
                            data-action-id="<%= action.id %>">
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                      </svg>
                      <%= t("capa_management_ui.analysis_tab.assign_button") %>
                    </button>
                  <% else %>
                    <span class="text-[10px] sm:text-xs text-[#797C81]"><%= t("capa_management_ui.analysis_tab.no_assignees") %></span>
                  <% end %>
                <% end %>
              </td>
              <td class="p-3 sm:p-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium <%= status_style[:bg] %> <%= status_style[:text] %>">
                  <%= status_style[:label] %>
                </span>
              </td>
              <td class="p-3 sm:p-4 whitespace-nowrap">
                <span class="text-xs sm:text-sm text-[#0D1120]"><%= due_date_formatted %></span>
              </td>
              <td class="p-3 sm:p-4 min-w-[120px]">
                <span class="text-xs sm:text-sm text-[#0D1120] break-words"><%= action.notes.presence || t("capa_management_ui.analysis_tab.notes_placeholder") %></span>
              </td>
              <td class="p-3 sm:p-4 text-right" onclick="event.stopPropagation();">
                <% unless contributor %>
                <details class="relative" data-controller="capas--dropdown">
                  <summary class="list-none text-[#797C81] hover:text-[#0D1120] cursor-pointer p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                    </svg>
                  </summary>
                  <div class="absolute right-0 mt-2 w-48 sm:w-40 bg-white border border-[#E3E3E3] rounded-lg shadow-lg z-[9999] py-1" data-capas--dropdown-target="menu">
                    <div class="py-1">
                      <%= link_to dashboard_capa_action_show_path(@capa.id, action.id), class: "block w-full text-left px-4 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7FD] min-h-[44px] sm:min-h-auto" do %>
                        <%= t("capa_management_ui.analysis_tab.view_action", default: "View") %>
                      <% end %>
                      <% unless viewer? %>
                        <button type="button" 
                                class="block w-full text-left px-4 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7FD] min-h-[44px] sm:min-h-auto"
                                onclick="openEditCapaActionModal(this.dataset, event)"
                                data-action-id="<%= action.id %>"
                                data-action-title="<%= action.title %>"
                                data-action-type="<%= action.action_type %>"
                                data-action-status="<%= action.status %>"
                                data-action-due-date="<%= action.due_date&.strftime('%Y-%m-%d') %>"
                                data-action-notes="<%= action.notes %>"
                                data-action-assignee-ids="<%= assignee_ids %>">
                          <%= t("capa_management_ui.analysis_tab.edit") %>
                        </button>
                        <button type="button" 
                                class="block w-full text-left px-4 py-3 sm:py-2 text-xs sm:text-sm text-[#DC2626] hover:bg-[#F7F7FD] min-h-[44px] sm:min-h-auto"
                                onclick="deleteCapaAction(this.dataset.actionId, this.dataset.capaId, event)"
                                data-action-id="<%= action.id %>"
                                data-capa-id="<%= @capa.id %>">
                          <%= t("capa_management_ui.analysis_tab.delete") %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                </details>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="border border-[#E3E3E3] rounded-xl p-6 sm:p-8 text-center">
      <p class="text-xs sm:text-sm text-[#797C81] mb-4 break-words px-4"><%= t("capa_management_ui.analysis_tab.actions_empty") %></p>
      <button type="button" 
              class="px-4 py-3 sm:py-2 bg-[#5C3984] rounded-xl text-xs sm:text-sm font-medium text-white hover:opacity-80 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 mx-auto min-h-[44px]"
              data-action="click->capas--capa-action#openCreateModal"
              <%= "disabled" if contributor %>>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span><%= t("capa_management_ui.analysis_tab.assign_actions") %></span>
      </button>
    </div>
  <% end %>
</div>

<%= render 'dashboard/capa_management/capa_action_modal' %>
<%= render 'dashboard/capa_management/assign_action_assignees_modal' %>

<script>
  // Set delete icon path as a constant (rendered server-side)
  const DELETE_ICON_PATH = '<%= asset_path('delete-clause-icon.svg') %>';
  
  window.openEditCapaActionModal = function(dataset, event) {
    const modal = document.getElementById('capaActionModal')
    if (!modal) {
      console.error('Modal not found')
      return
    }
    
    // Get the button element that triggered this (needed for dropdown closing and passing to controller)
    const button = event?.target || document.querySelector(`[data-action-id="${dataset.actionId}"]`)
    
    // Close dropdown menu if open
    if (button) {
      const dropdown = button.closest('[data-controller*="dropdown"]')
      if (dropdown && dropdown.tagName === 'DETAILS') {
        dropdown.open = false
      }
    }
    
    // Get the Stimulus controller instance
    const controllerElement = modal.querySelector('[data-controller~="capas--capa-action"]')
    if (!controllerElement) {
      console.error('CAPA action controller not found')
      return
    }
    
    let controller = null
    if (window.Stimulus) {
      controller = window.Stimulus.getControllerForElementAndIdentifier(controllerElement, 'capas--capa-action')
    } else if (window.application) {
      controller = window.application.getControllerForElementAndIdentifier(controllerElement, 'capas--capa-action')
    }
    
    if (!controller) {
      console.error('CAPA action controller instance not found')
      return
    }
    
    // Create a fake event object with the actual button element
    // The button element is needed for el.closest() to work in openEditModal
    // The button already has all the data attributes from the HTML, so we can use it directly
    const fakeEvent = {
      currentTarget: button || {
        dataset: dataset
      }
    }
    
    // Call the controller's openEditModal method
    controller.openEditModal(fakeEvent)
  }
  
  window.deleteCapaAction = async function(actionId, capaId, event) {
    // Close dropdown menu if open
    const button = event?.target || document.querySelector(`[data-action-id="${actionId}"]`)
    if (button) {
      const dropdown = button.closest('[data-controller*="dropdown"]')
      if (dropdown && dropdown.tagName === 'DETAILS') {
        dropdown.open = false
      }
    }

    // Use customConfirm if available, otherwise fallback to confirm
    const confirmed = window.customConfirm 
      ? await window.customConfirm('<%= j t("capa_management_ui.analysis_tab.delete_action_confirm") %>')
      : confirm('<%= j t("capa_management_ui.analysis_tab.delete_action_confirm") %>')
    
    if (!confirmed) {
      return
    }

    const deleteButton = button || document.querySelector(`[data-action-id="${actionId}"]`)
    if (!deleteButton) return

    try {
      deleteButton.disabled = true
      deleteButton.textContent = 'Deleting...'

      const response = await fetch(`/dashboard/capa_management/${capaId}/capa_actions/${actionId}`, {
        method: 'DELETE',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })

      if (!response.ok) {
        const err = await response.json().catch(() => ({}))
        alert(err.error || '<%= j t("capa_management_ui.analysis_tab.delete_action_failed") %>')
        return
      }

      window.location.reload()
    } catch (error) {
      console.error('Delete error:', error)
      alert('<%= j t("capa_management_ui.analysis_tab.delete_action_network") %>')
    } finally {
      if (deleteButton) {
        deleteButton.disabled = false
        deleteButton.textContent = '<%= j t("capa_management_ui.analysis_tab.delete") %>'
      }
    }
  }

  // Global function to open questionnaire generation modal
  window.openQuestionnaireGenerationModal = function(capaId) {
    
    const modal = document.getElementById('questionnaireGenerationModal');
    if (!modal) {
      console.error('Questionnaire generation modal not found');
      alert('Modal not found. Please refresh the page.');
      return;
    }

    // Get the Stimulus application
    const application = window.Stimulus;
    if (!application) {
      console.error('Stimulus application not found');
      // Fallback: just show the modal and let the controller handle it
      modal.showModal();
      modal.dispatchEvent(new CustomEvent('questionnaire:open', { detail: { capaId: String(capaId) } }));
      return;
    }

    // Get the controller instance from the modal
    let controller = null;
    try {
      controller = application.getControllerForElementAndIdentifier(modal, 'capas--questionnaire-generation');
    } catch (error) {
      console.error('Error getting controller:', error);
    }
    
    if (!controller) {
      // Fallback: show modal and dispatch event for controller to handle
      modal.showModal();
      modal.dispatchEvent(new CustomEvent('questionnaire:open', { detail: { capaId: String(capaId) } }));
      return;
    }

    
    if (capaId) {
      controller.capaIdValue = String(capaId);
    }

    controller.initializeAndStart().catch(error => {
      console.error('Error initializing questionnaire generation:', error);
      alert('Error initializing questionnaire generation. Please check the console for details.');
    });
  };

  // Set up event listeners for questionnaire generation buttons using event delegation
  // This handles both existing and dynamically added buttons
  (function() {
    let initialized = false;
    function setupListener() {
      if (initialized) return;
      initialized = true;
      
      // Use event delegation to handle clicks on questionnaire generation buttons
      document.addEventListener('click', function(event) {
        const button = event.target.closest('[data-questionnaire-generate-button]');
        if (button) {
          event.preventDefault();
          event.stopPropagation();
          const capaId = button.getAttribute('data-capa-id');
          if (capaId) {
            window.openQuestionnaireGenerationModal(capaId);
          }
        }
      }, true); // Use capture phase to catch early
    }
    
    // Set up immediately if DOM is ready, otherwise wait for DOMContentLoaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupListener);
    } else {
      setupListener();
    }
  })();
</script>
