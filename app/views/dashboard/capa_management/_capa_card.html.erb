<%# Expected locals: capa, status_label:, status_text_color:, status_bg_color: %>
<%# Fallbacks if colors are not provided %>
<% status_text_color ||= 'text-[#797C81]' %>
<% status_bg_color ||= 'bg-gray-100' %>

<%# Derive a friendly CAPA code (e.g., CAPA-1-2024-01-15) %>
<% capa_code = capa.friendly_code %>

<%# Priority dot color %>
<% priority_color = case capa.priority
when 'high' then 'bg-[#EA4034]'
when 'medium' then 'bg-[#EC71DD]'
when 'low' then 'bg-[#64A3EB]'
else 'bg-gray-400'
end %>

<%# Calculate progress from CAPA actions only for 'in_progress' status %>
<% progress_percent = 0 %>
<% show_progress = false %>
<% total_actions = capa.capa_actions.count %>
<% done_actions = capa.capa_actions.where(status: 'done').count %>
<% if capa.status == 'in_progress' %>
  <% show_progress = true %>
  <% progress_percent = total_actions > 0 ? (done_actions.to_f / total_actions * 100).round : 0 %>
<% end %>

<%# Check if CAPA is overdue (accept as local or calculate) %>
<% is_overdue = local_assigns[:is_overdue] %>
<% if is_overdue.nil? %>
  <% is_overdue = capa.due_date.present? && capa.due_date < Date.today && capa.status != 'closed' %>
<% end %>

<%# Determine progress bar and text colors based on overdue status %>
<% if show_progress %>
  <% if is_overdue %>
    <% progress_bar_color = 'bg-[#EA4034]' %>
    <% progress_text_color = 'text-[#EA4034]' %>
  <% else %>
    <% progress_bar_color = 'bg-[#79BE52]' %>
    <% progress_text_color = 'text-[#79BE52]' %>
  <% end %>
<% end %>
<div class="border border-[#E3E3E3] rounded-xl p-3 sm:p-4 hover:shadow-sm <%= draggable ? 'cursor-move select-none' : '' %>"
     draggable="<%= draggable ? true : nil %>"
     data-action="<%= draggable ? 'mousedown->capas--board#prepareDrag dragstart->capas--board#dragStart dragend->capas--board#dragEnd' : nil %>"
     style="<%= draggable ? '-webkit-user-drag: element;' : nil %>"
     data-capa-id="<%= capa.id %>" data-capa-status="<%= capa.status %>" data-total-actions="<%= total_actions %>" data-done-actions="<%= done_actions %>" data-capa-due-date="<%= capa.due_date&.strftime('%Y-%m-%d') %>">
  <div class="flex items-start justify-between">
    <div class="flex-1 min-w-0">
      <div class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium text-[#5D6B80] bg-[#F2F4F8]">
        <%= capa_code %>
      </div>
      <div class="text-xs sm:text-sm font-semibold text-[#0D1120] mt-2 break-words leading-snug"><%= capa.title %></div>
      <div class="text-[10px] sm:text-xs text-[#797C81] mt-1 break-words"><%= capa.description %></div>
    </div>
  </div>

  <% if show_progress %>
    <div class="mt-2 sm:mt-3">
      <div class="flex items-center justify-between text-[10px] sm:text-xs <%= progress_text_color %> font-medium">
        <span><%= t("capa_management_ui.board.progress_label") %></span>
        <span><%= progress_percent %>%</span>
      </div>
      <div class="w-full h-1.5 bg-[#E9F0FF] rounded-full mt-1">
        <div class="h-1.5 <%= progress_bar_color %> rounded-full" style="width: <%= progress_percent %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="mt-2 sm:mt-3 flex items-center justify-between min-w-0">
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <div class="flex items-center -space-x-1 flex-shrink-0" data-role="assignee-chips">
        <% assignees = capa.company_users.includes(:user).limit(3).to_a %>
        <% total_assignees = capa.company_users.count %>
        <% assignees.each do |company_user| %>
          <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium overflow-hidden" title="<%= company_user.user.name %>">
            <% if company_user.user.profile_image.attached? %>
              <%= image_tag user_profile_image_url(company_user.user), class: "w-full h-full object-cover max-w-full h-auto" %>
            <% else %>
              <%= company_user.user.name[0].upcase %>
            <% end %>
          </div>
        <% end %>
        <% if total_assignees > 3 %>
          <div class="w-6 h-6 rounded-full bg-[#F0F0F0] flex items-center justify-center text-[10px] text-[#797C81] font-medium">+<%= total_assignees - 3 %></div>
        <% end %>
      </div>
      <% names = assignees.map { |cu| cu.user.name } %>
      <% display_names = if total_assignees > 3
        names.join(', ') + " " + t("capa_management_ui.board.more_assignees", count: total_assignees - 3)
      else
        names.join(', ')
      end %>
      <span class="text-[10px] sm:text-xs text-[#0D1120] break-words truncate min-w-0" data-role="assignee-names">
        <%= display_names.presence || '-' %>
      </span>
    </div>
  </div>

  <div class="mt-2 sm:mt-3 flex flex-wrap items-center gap-1.5 text-[10px] sm:text-xs text-[#797C81]">
    <div class="flex items-center gap-1 px-2 py-1 rounded-full bg-[#F7F7F7] flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 flex-shrink-0 text-[#5C3984]" <%= 'draggable="false"'.html_safe if draggable %>><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
      <span class="whitespace-nowrap"><%= capa.due_date ? capa.due_date.strftime('%b %d, %Y') : '-' %></span>
    </div>
    <div class="flex items-center gap-1 px-2 py-1 rounded-full bg-[#F7F7F7] flex-shrink-0">
      <span class="w-2 h-2 rounded-full <%= priority_color %> flex-shrink-0"></span>
      <span class="text-[#0D1120] font-medium whitespace-nowrap">
        <%= capa.priority.present? ? t("priority_levels.#{capa.priority}") : "-" %>
      </span>
    </div>
    <div class="px-2 py-0.5 rounded-full <%= status_bg_color %> <%= status_text_color %> font-medium whitespace-nowrap flex-shrink-0" data-role="status-badge">
      <%= status_label || capa.status.to_s.humanize %>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between gap-2 w-full">
    <%= link_to "#{dashboard_capa_management_show_path(capa)}#evidence", class: 'inline-flex items-center justify-center px-3 py-2 gap-2 flex-1 h-9 bg-white border border-[#E3E3E3] rounded-xl text-xs font-medium text-[#0D1120] min-w-0', draggable: (draggable ? 'false' : nil), data: { turbo: false }, onclick: "sessionStorage.setItem('capa_management_last_page', window.location.pathname + window.location.search); return true;" do %>
      <span class="truncate"><%= t("capa_management_ui.board.actions.view") %></span>
      <svg class="w-3.5 h-3.5 fill-[#5C3984] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 3a1 1 0 00-1-1h-6a1 1 0 100 2h3.586L4.293 17.293a1 1 0 101.414 1.414L19 5.414V9a1 1 0 102 0V3z" />
      </svg>
    <% end %>
    <details class="relative flex-shrink-0" data-controller="capas--dropdown" <%= draggable ? 'draggable="false"' : '' %>>
      <summary class="list-none p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg text-[#797C81] hover:text-[#0D1120] hover:bg-[#F7F7F7] cursor-pointer" <%= draggable ? 'draggable="false"' : '' %>>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-40 sm:w-36 bg-white border border-[#E3E3E3] rounded-xl shadow z-[9999] py-1" data-capas--dropdown-target="menu">
        <% unless viewer? %>
          <button type="button" class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7F7] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="openEditCapaModal(this.dataset)"
                  data-capa-id="<%= capa.id %>"
                  data-capa-title="<%= capa.title %>"
                  data-capa-description="<%= capa.description %>"
                  data-capa-source="<%= capa.source %>"
                  data-capa-standard-id="<%= capa.standard_id %>"
                  data-capa-priority="<%= capa.priority %>"
                  data-capa-due-date="<%= capa.due_date&.strftime('%Y-%m-%d') %>"
                  data-capa-status="<%= capa.status %>"
                  data-capa-assignee-ids="<%= capa.company_users.pluck(:id).join(',') %>"
                  data-capa-assignee-names="<%= capa.company_users.includes(:user).map { |cu| cu.user.name }.to_json %>"
                  data-capa-assignee-roles="<%= capa.company_users.includes(:user).map { |cu| cu.role }.to_json %>"
                  data-capa-assignee-profile-image-urls="<%= capa.company_users.includes(user: [ :profile_image_attachment ]).map { |cu| cu.user&.profile_image&.attached? ? user_profile_image_url(cu.user) : '' }.to_json %>">
            <%= t("capa_management_ui.list_table.actions.edit") %>
          </button>
          <button type="button" 
                  class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7F7] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="archiveCapa('<%= capa.id %>')">
            <%= t("capa_management_ui.list_table.actions.archive") %>
          </button>
          <button type="button" 
                  class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#EA4034] hover:bg-[#FFF1F0] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="deleteCapa('<%= capa.id %>')">
            <%= t("capa_management_ui.list_table.actions.delete") %>
          </button>
        <% end %>
      </div>
    </details>
  </div>
</div>


