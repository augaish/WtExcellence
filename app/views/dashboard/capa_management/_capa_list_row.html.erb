<%
  assignees = capa.company_users.includes(:user).limit(3).to_a
  total_assignees = capa.company_users.count
  
  priority_color = case capa.priority
                   when 'high' then 'bg-[#EA4034]'
                   when 'medium' then 'bg-[#EC71DD]'
                   when 'low' then 'bg-[#64A3EB]'
                   else 'bg-gray-400'
                   end
  
  # Check if CAPA is overdue (has due_date and it's before today)
  is_overdue = capa.due_date.present? && capa.due_date < Date.today && capa.status != 'closed'
  
  status_colors = {
    'open' => { bg: 'bg-[#FEF0FF]', text: 'text-[#B130AC]', label: t('capa_management_ui.statuses.open') },
    'assigned' => { bg: 'bg-[#E9F5F8]', text: 'text-[#1B94AD]', label: t('capa_management_ui.statuses.assigned') },
    'in_progress' => { bg: 'bg-[#E9F0FF]', text: 'text-[#1751A7]', label: t('capa_management_ui.statuses.in_progress') },
    'closed' => { bg: 'bg-[#E0F9DE]', text: 'text-[#3F9011]', label: t('capa_management_ui.statuses.closed') }
  }
  
  # Special cases for in_progress status
  if capa.status == 'in_progress'
    if is_overdue
      status_style = { bg: 'bg-[#FFF1F0]', text: 'text-[#B13030]', label: t('capa_management_ui.status_labels.overdue') }
    else
      status_style = { bg: 'bg-[#F5FFD8]', text: 'text-[#789C16]', label: t('capa_management_ui.status_labels.in_time') }
    end
  else
    status_style = status_colors[capa.status] || { bg: 'bg-gray-100', text: 'text-gray-600', label: capa.status&.humanize || '-' }
  end

  source_label = capa.source ? t("capa_sources.#{capa.source}", default: capa.source&.titleize&.gsub('_', ' ')) : '-'
%>
<tr class="border-b border-[#E3E3E3] hover:bg-[#F7F7FD] cursor-pointer" 
    data-capa-id="<%= capa.id %>"
    dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <td class="p-3 sm:p-4" onclick="event.stopPropagation();">
    <input type="checkbox" class="w-5 h-5 sm:w-4 sm:h-4 rounded border-gray-300 text-[#5C3984] focus:ring-[#5C3984] flex-shrink-0" data-capas--select-all-target="item" data-action="change->capas--select-all#syncMaster" data-capa-id="<%= capa.id %>">
  </td>
  <td class="p-3 sm:p-4 rtl:text-right min-w-[180px]">
    <div class="flex flex-col">
      <span class="text-xs sm:text-sm font-semibold text-[#0D1120] break-words">
        <%= truncate(capa.title, length: 30) %>
      </span>
      <span class="text-[10px] sm:text-xs text-[#797C81] mt-1 break-words">
        <%= truncate(capa.description, length: 40) %>
      </span>
    </div>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right min-w-[120px]">
    <span class="text-xs sm:text-sm text-[#0D1120] break-words">
      <%= source_label.presence || '-' %>
    </span>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right min-w-[140px]">
    <span class="text-xs sm:text-sm text-[#0D1120] break-words">
      <%= capa.standard ? capa.standard.display_name : '-' %>
    </span>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right min-w-[160px]">
    <div class="flex items-center gap-2 rtl:flex-row-reverse min-w-0">
      <% if total_assignees > 0 %>
        <% if total_assignees <= 2 %>
          <!-- Show names when 2 or fewer -->
          <% assignees.each_with_index do |company_user, index| %>
            <span class="text-xs sm:text-sm text-[#0D1120] truncate">
              <%= company_user.user.name %>
            </span>
            <% unless index == assignees.count - 1 %>
              <span class="text-xs sm:text-sm text-[#797C81]">,</span>
            <% end %>
          <% end %>
        <% else %>
          <!-- Show avatars when more than 2 -->
          <div class="flex items-center gap-1 flex-shrink-0">
            <% assignees.each do |company_user| %>
              <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium overflow-hidden" title="<%= company_user.user.name %>">
                <% if company_user.user.profile_image.attached? %>
                  <%= image_tag user_profile_image_url(company_user.user), class: "w-full h-full object-cover max-w-full h-auto" %>
                <% else %>
                  <%= company_user.user.name[0].upcase %>
                <% end %>
              </div>
            <% end %>
          </div>
          <% if total_assignees > 3 %>
            <span class="text-[10px] sm:text-xs text-[#797C81] font-medium whitespace-nowrap">+<%= total_assignees - 3 %> more</span>
          <% end %>
        <% end %>
      <% else %>
        <span class="text-xs sm:text-sm text-[#797C81]">-</span>
      <% end %>
    </div>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right whitespace-nowrap">
    <div class="flex items-center gap-2 rtl:flex-row-reverse">
      <div class="w-3 h-3 rounded-full <%= priority_color %> flex-shrink-0"></div>
      <span class="text-xs sm:text-sm text-[#0D1120] font-medium">
        <%= capa.priority ? t("priority_levels.#{capa.priority}", default: capa.priority.capitalize) : '-' %>
      </span>
    </div>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right whitespace-nowrap">
    <span class="text-xs sm:text-sm text-[#0D1120]">
      <%= capa.due_date ? capa.due_date.strftime('%Y-%m-%d') : '-' %>
    </span>
  </td>
  <td class="p-3 sm:p-4 rtl:text-right whitespace-nowrap">
    <span class="text-[10px] sm:text-xs px-3 sm:px-4 py-1 rounded-full font-medium <%= status_style[:bg] %> <%= status_style[:text] %>">
      <%= status_style[:label] %>
    </span>
  </td>
  <td class="p-3 sm:p-4" onclick="event.stopPropagation();">
    <details class="relative" data-controller="capas--dropdown">
      <summary class="list-none text-[#797C81] hover:text-[#0D1120] cursor-pointer p-2 min-w-[44px] min-h-[44px] flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
        </svg>
      </summary>
      <div class="absolute right-0 rtl:right-auto rtl:left-0 mt-2 w-40 sm:w-36 bg-white border border-[#E3E3E3] rounded-xl shadow z-[9999] py-1" data-capas--dropdown-target="menu">
        <% unless viewer? %>
          <button type="button" class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7F7] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="openEditCapaModal(this.dataset)"
                  data-capa-id="<%= capa.id %>"
                  data-capa-title="<%= capa.title %>"
                  data-capa-description="<%= capa.description %>"
                  data-capa-source="<%= capa.source %>"
                  data-capa-standard-id="<%= capa.standard_id %>"
                  data-capa-priority="<%= capa.priority %>"
                  data-capa-due-date="<%= capa.due_date&.strftime('%Y-%m-%d') %>"
                  data-capa-status="<%= capa.status %>"
                  data-capa-assignee-ids="<%= capa.company_users.pluck(:id).join(',') %>"
                  data-capa-assignee-names="<%= capa.company_users.includes(:user).map { |cu| cu.user.name }.to_json %>"
                  data-capa-assignee-roles="<%= capa.company_users.includes(:user).map { |cu| cu.role }.to_json %>"
                  data-capa-assignee-profile-image-urls="<%= capa.company_users.includes(user: [ :profile_image_attachment ]).map { |cu| cu.user&.profile_image&.attached? ? user_profile_image_url(cu.user) : '' }.to_json %>">
            <%= t('capa_management_ui.list_table.actions.edit') %>
          </button>
          <button type="button" 
                  class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#0D1120] hover:bg-[#F7F7F7] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="archiveCapa('<%= capa.id %>')">
            <%= t('capa_management_ui.list_table.actions.archive') %>
          </button>
          <button type="button" 
                  class="block w-full text-left px-3 py-3 sm:py-2 text-xs sm:text-sm text-[#EA4034] hover:bg-[#FFF1F0] rounded-lg min-h-[44px] sm:min-h-auto"
                  onclick="deleteCapa('<%= capa.id %>')">
            <%= t('capa_management_ui.list_table.actions.delete') %>
          </button>
        <% end %>
      </div>
    </details>
  </td>
</tr>

