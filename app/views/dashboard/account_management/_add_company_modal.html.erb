<dialog id="addCompanyModal" 
        class="rounded-3xl backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white" 
        style="box-shadow: 0px 16px 32px -4px rgba(12, 12, 13, 0.1), 0px 4px 4px -4px rgba(12, 12, 13, 0.05); width: 600px; max-width: 90vw; padding: 20px;"
        data-controller="dialog-no-backdrop-close"
        data-action="click->account-management#modalClick">
  <div class="flex flex-col gap-4 sm:gap-5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-col gap-2 min-w-0 flex-1">
        <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('add_new_company') %></h2>
        <p class="text-xs sm:text-sm font-medium text-[#797C81] break-words"><%= t('create_company_description') %></p>
      </div>
      <button type="button" 
              class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center flex-shrink-0 text-[#797C81] hover:text-[#0D1120] transition-colors"
              data-action="click->account-management#closeAddCompanyModal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: dashboard_create_company_path, method: :post, local: true, 
                  data: { action: "submit->account-management#submitCompanyForm" },
                  class: "flex flex-col gap-4 sm:gap-5" do |f| %>
      
      <!-- Company Name -->
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('company_name') %>*</label>
        <input type="text" 
               name="company[name]" 
               required 
               maxlength="200"
               class="min-h-[44px] px-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-lg text-[16px] sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent" 
               placeholder="<%= t('enter_company_name_placeholder') %>">
      </div>

      <!-- License Seats -->
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('license_seats') %>*</label>
        <input type="number" 
               name="company[license_seats]" 
               required 
               min="0"
               value="0"
               class="min-h-[44px] px-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-lg text-[16px] sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent" 
               placeholder="<%= t('enter_license_seats_placeholder') %>">
      </div>

      <!-- Credits -->
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('initial_credits') %>*</label>
        <input type="number" 
               name="company[credits]" 
               required 
               min="0"
               value="1000"
               class="min-h-[44px] px-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-lg text-[16px] sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent" 
               placeholder="<%= t('enter_initial_credits_placeholder') %>">
      </div>

      <!-- Error Messages -->
      <div id="companyErrors" class="hidden text-xs sm:text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg p-3 break-words"></div>

      <!-- Form Actions -->
      <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-2 sm:gap-4 pt-2">
        <button type="button" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 text-[#5C3984] text-sm font-medium hover:underline min-h-[44px] text-[16px] sm:text-sm"
                data-action="click->account-management#closeAddCompanyModal">
          <%= t('cancel') %>
        </button>
        <button type="submit" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] text-white rounded-lg text-sm font-medium hover:bg-[#4A2F6B] transition-colors min-h-[44px] text-[16px] sm:text-sm">
          <%= t('add_company') %>
        </button>
      </div>
    <% end %>
  </div>
</dialog>

