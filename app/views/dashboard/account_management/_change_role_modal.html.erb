<dialog id="changeRoleModal" 
        class="rounded-3xl backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white" 
        style="box-shadow: 0px 16px 32px -4px rgba(12, 12, 13, 0.1), 0px 4px 4px -4px rgba(12, 12, 13, 0.05); width: 500px; max-width: 90vw; padding: 20px;"
        data-controller="dialog-no-backdrop-close"
        data-action="click->account-management#modalClick">
  <div class="flex flex-col gap-4 sm:gap-5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-col gap-2 min-w-0 flex-1">
        <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('change_role') %></h2>
        <p class="text-xs sm:text-sm font-medium text-[#797C81] break-words" id="changeRoleUserName"></p>
      </div>
      <button type="button" 
              class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center flex-shrink-0 text-[#797C81] hover:text-[#0D1120] transition-colors"
              data-action="click->account-management#closeChangeRoleModal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="changeRoleForm" class="flex flex-col gap-4 sm:gap-5 choices-overflow-visible">
      <input type="hidden" id="changeRoleUserId" name="user_id" value="">
      <input type="hidden" id="changeRoleHasCompanyUser" name="has_company_user" value="">
      
      <!-- Current Roles Display -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <!-- Global Role -->
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-[#0D1120]">
            <%= t('current_global_role') %>
          </label>
          <div class="px-3 py-2 bg-gray-100 border border-gray-200 rounded-lg text-xs sm:text-sm text-[#0D1120] break-words" id="changeRoleCurrentGlobalRole">
          </div>
        </div>

        <!-- Company Role (if user has company) -->
        <div class="flex flex-col gap-2" id="changeRoleCompanyRoleSection" style="display: none;">
          <label class="text-sm font-medium text-[#0D1120]">
            <%= t('current_company_role') %>
          </label>
          <div class="px-3 py-2 bg-gray-100 border border-gray-200 rounded-lg text-xs sm:text-sm text-[#0D1120] break-words" id="changeRoleCurrentCompanyRole">
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-2 choices-overflow-visible" 
           data-controller="choices-select" 
           data-choices-select-search-value="false"
           id="changeRoleGlobalRoleWrapper">
        <label for="newGlobalRole" class="text-sm font-medium text-[#0D1120]">
          <%= t('new_global_role') %>
        </label>
        <select id="newGlobalRole" 
                name="global_role"
                data-choices-select-target="select"
                class="w-full">
          <option value=""><%= t('no_global_role') %></option>
          <option value="delegated_admin"><%= t('delegated_admin') %></option>
          <option value="super_admin"><%= t('super_admin') %></option>
          <option value="viewer"><%= t('viewer') %></option>
        </select>
      </div>

      <div class="flex flex-col gap-2 choices-overflow-visible" 
           id="changeRoleNewCompanyRoleSection" 
           style="display: none;" 
           data-controller="choices-select"
           data-choices-select-search-value="false">
        <label for="newCompanyRole" class="text-sm font-medium text-[#0D1120]">
          <%= t('new_company_role') %> <span class="text-red-600">*</span>
        </label>
        <select id="newCompanyRole" 
                name="company_role"
                data-choices-select-target="select"
                class="w-full">
          <option value="company_admin"><%= t('company_admin') %></option>
          <option value="company_quality_manager"><%= t('company_quality_manager') %></option>
          <option value="company_auditor"><%= t('company_auditor') %></option>
          <option value="company_contributor"><%= t('company_contributor') %></option>
          <option value="company_viewer"><%= t('company_viewer') %></option>
        </select>
      </div>

      <p class="text-xs text-gray-500 break-words"><%= t('role_change_warning') %></p>

      <!-- Error Messages -->
      <div id="changeRoleErrors" class="hidden text-xs sm:text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg p-3 break-words"></div>

      <!-- Success Message -->
      <div id="changeRoleSuccess" class="hidden text-xs sm:text-sm text-green-600 bg-green-50 border border-green-200 rounded-lg p-3 break-words"></div>

      <!-- Form Actions -->
      <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-2 sm:gap-4 pt-2">
        <button type="button" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 text-[#5C3984] text-sm font-medium hover:underline min-h-[44px] text-[16px] sm:text-sm"
                data-action="click->account-management#closeChangeRoleModal">
          <%= t('cancel') %>
        </button>
        <button type="submit" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] text-white rounded-lg text-sm font-medium hover:bg-[#4A2F6B] transition-colors min-h-[44px] text-[16px] sm:text-sm">
          <%= t('change_role') %>
        </button>
      </div>
    </form>
  </div>
</dialog>
