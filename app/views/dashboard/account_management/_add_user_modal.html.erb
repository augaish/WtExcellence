<dialog id="addUserModal" 
        class="rounded-3xl backdrop:bg-black/30 backdrop:backdrop-blur-sm bg-white" 
        style="box-shadow: 0px 16px 32px -4px rgba(12, 12, 13, 0.1), 0px 4px 4px -4px rgba(12, 12, 13, 0.05); width: 600px; max-width: 90vw; padding: 20px;"
        data-controller="dialog-no-backdrop-close"
        data-action="click->account-management#modalClick">
  <div class="flex flex-col gap-4 sm:gap-5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-col gap-2 min-w-0 flex-1">
        <h2 class="text-lg sm:text-xl font-semibold text-[#0D1120] break-words"><%= t('add_new_user') %></h2>
        <p class="text-xs sm:text-sm font-medium text-[#797C81] break-words"><%= t('invite_user_description') %></p>
      </div>
      <button type="button" 
              class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center flex-shrink-0 text-[#797C81] hover:text-[#0D1120] transition-colors"
              data-action="click->account-management#closeAddUserModal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <%= form_with url: dashboard_create_invitation_path, method: :post, local: true, 
                  data: { action: "submit->account-management#submitInvitationForm" },
                  class: "flex flex-col gap-4 sm:gap-5" do |f| %>
      
      <!-- Full Name -->
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('full_name') %>*</label>
        <input type="text" 
               name="name" 
               required 
               class="min-h-[44px] px-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-lg text-[16px] sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent" 
               placeholder="<%= t('enter_full_name_placeholder') %>">
      </div>

      <!-- Email Address -->
      <div class="flex flex-col gap-2">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('email_address') %>*</label>
        <input type="email" 
               name="email" 
               required 
               class="min-h-[44px] px-4 py-3 sm:py-2 border border-[#E3E3E3] rounded-lg text-[16px] sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent" 
               placeholder="<%= t('enter_email_address_placeholder') %>">
      </div>

      <!-- Company (only for Super Admin or Delegated Admin with permission) -->
      <% if current_user&.can_manage_companies? %>
        <div class="flex flex-col gap-2" id="companyField" data-controller="choices-select">
          <label class="text-sm font-medium text-[#0D1120]"><%= t('company') %>*</label>
          <select name="company_id" 
                  id="companySelect"
                  required 
                  data-choices-select-target="select"
                  class="w-full focus:outline-none">
            <option value=""><%= t('select_company') %></option>
            <% (@invitation_companies || @companies)&.each do |company| %>
              <option value="<%= company.id %>"><%= company.name %></option>
            <% end %>
          </select>
        </div>
      <% else %>
        <!-- Hidden field for company admin's company -->
        <input type="hidden" name="company_id" id="companySelect" value="<%= current_user.company_user&.company_id %>">
      <% end %>

      <!-- Role (Company Role) -->
      <div class="flex flex-col gap-2" id="companyRoleField" 
           data-controller="choices-select"
           data-choices-select-search-value="false">
        <label class="text-sm font-medium text-[#0D1120]"><%= t('role') %>*</label>
        <select name="company_role" 
                id="companyRoleSelect"
                required 
                data-choices-select-target="select"
                class="w-full">
          <option value=""><%= t('select_role') %></option>
          <% @company_roles&.each do |display_name, value| %>
            <option value="<%= value %>"><%= display_name %></option>
          <% end %>
        </select>
      </div>

      <!-- Global Role (only for Super Admin) -->
      <% if current_user&.super_admin? %>
        <div class="flex flex-col gap-2" 
             data-controller="choices-select"
             data-choices-select-search-value="false">
          <label class="text-sm font-medium text-[#0D1120]"><%= t('global_role_optional') %></label>
          <select name="role" 
                  id="globalRoleSelect"
                  data-choices-select-target="select"
                  data-action="change->account-management#togglePermissionsSection"
                  class="w-full">
            <option value=""><%= t('no_global_role') %></option>
            <option value="delegated_admin"><%= t('delegated_admin') %></option>
            <option value="super_admin"><%= t('super_admin') %></option>
          </select>
        </div>

        <!-- Permissions Section (only shown for Delegated Admin) -->
        <div id="permissionsSection" class="hidden flex flex-col gap-2">
          <label class="text-sm font-medium text-[#0D1120]"><%= t('permissions_label') %></label>
          <p class="text-xs text-gray-500 mb-2 break-words"><%= t('select_permissions_description') %></p>
          <div class="space-y-2 border border-[#E3E3E3] rounded-lg p-3 sm:p-4 bg-gray-50">
            <% User::PERMISSIONS.each do |key, value| %>
              <label class="flex items-center gap-2 cursor-pointer min-h-[44px] sm:min-h-auto">
                <input type="checkbox" 
                       name="permissions[]" 
                       value="<%= value %>"
                       class="h-5 w-5 sm:h-4 sm:w-4 text-[#5C3984] focus:ring-[#5C3984] border-gray-300 rounded flex-shrink-0">
                <span class="text-sm text-[#0D1120] break-words"><%= t("permissions.#{key}") %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Error Messages -->
      <div id="invitationErrors" class="hidden text-xs sm:text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg p-3 break-words"></div>

      <!-- Form Actions -->
      <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-2 sm:gap-4 pt-2">
        <button type="button" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 text-[#5C3984] text-sm font-medium hover:underline min-h-[44px] text-[16px] sm:text-sm"
                data-action="click->account-management#closeAddUserModal">
          <%= t('cancel') %>
        </button>
        <button type="submit" 
                class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-[#5C3984] text-white rounded-lg text-sm font-medium hover:bg-[#4A2F6B] transition-colors min-h-[44px] text-[16px] sm:text-sm">
          <%= t('add_account') %>
        </button>
      </div>
    <% end %>
  </div>
</dialog>

