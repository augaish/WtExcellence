<!-- Filters Section -->
<div class="mb-4 sm:mb-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 flex-wrap">
  <%= form_with url: dashboard_account_management_companies_path, method: :get, local: true, class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 flex-wrap w-full sm:w-auto" do |f| %>
    <!-- Sort -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 flex-1 sm:flex-none min-w-0" 
         data-controller="choices-select"
         data-choices-select-search-value="false">
      <label class="text-xs sm:text-sm font-medium text-[#797C81] whitespace-nowrap"><%= t('sort') %>:</label>
      <%= f.select :sort, 
          options_for_select([
            [t('sort_name_asc'), 'name_asc'],
            [t('sort_name_desc'), 'name_desc'],
            [t('sort_newest_first'), 'created_desc'],
            [t('sort_oldest_first'), 'created_asc']
          ], params[:sort]),
          {},
          { data: { choices_select_target: "select" }, class: "px-3 py-3 sm:py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] text-[16px] sm:text-sm min-h-[44px]" } %>
    </div>

    <%= f.hidden_field :search, value: params[:search] %>
    <%= f.submit t('apply_filters'), class: "px-4 py-3 sm:py-2 bg-[#5C3984] text-white rounded-lg hover:bg-[#4A2F6B] transition-colors font-medium min-h-[44px] text-[16px] sm:text-sm" %>
    
    <% if params[:sort].present? || params[:search].present? %>
      <%= link_to dashboard_account_management_companies_path(search: params[:search]), class: "px-4 py-3 sm:py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium min-h-[44px] text-[16px] sm:text-sm text-center" do %>
        <%= t('clear_filters') %>
      <% end %>
    <% end %>
  <% end %>
</div>

<!-- Companies Table -->
<div class="overflow-x-auto -mx-4 sm:mx-0">
  <table class="min-w-full divide-y divide-gray-200 min-w-[900px]">
    <thead class="bg-gray-50">
      <tr>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('company_name') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('license_seats') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('users') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('assigned_standards') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('status_label') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('created_at') %>
        </th>
        <th scope="col" class="px-3 sm:px-6 py-3 text-start text-[10px] sm:text-xs font-medium text-gray-500 uppercase tracking-wider">
          <%= t('actions') %>
        </th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if @companies.any? %>
        <% @companies.each do |company| %>
          <tr class="hover:bg-gray-50">
            <td class="px-3 sm:px-6 py-4 min-w-0 max-w-[200px]">
              <div class="min-w-0 truncate break-words" data-controller="truncate-tooltip" data-truncate-tooltip-text-value="<%= company.name %>">
                <%= link_to dashboard_account_management_company_path(company),
                            class: "text-xs sm:text-sm font-medium text-gray-900 hover:text-[#5C3984] truncate break-words block" do %>
                  <%= company.name %>
                <% end %>
              </div>
            </td>
            <td class="px-3 sm:px-6 py-4">
              <% if current_user&.can_modify_license_seats? %>
                <div class="flex items-center gap-2 flex-wrap">
                  <div class="text-xs sm:text-sm text-gray-900" id="license-seats-display-<%= company.id %>">
                    <%= company.license_seats %>
                  </div>
                  <button type="button"
                          class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-[#5C3984] hover:text-[#4A2F6B]"
                          data-action="click->account-management#editLicenseSeats"
                          data-company-id="<%= company.id %>"
                          data-company-name="<%= company.name %>"
                          data-current-seats="<%= company.license_seats %>"
                          title="<%= t('edit') %> <%= t('license_seats') %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                  <input type="number"
                         id="license-seats-input-<%= company.id %>"
                         value="<%= company.license_seats %>"
                         min="<%= company.company_users.count %>"
                         step="1"
                         class="hidden w-20 px-2 py-2 text-xs sm:text-sm border border-[#5C3984] rounded-md focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent min-h-[44px]"
                         data-company-id="<%= company.id %>"
                         data-current-users="<%= company.company_users.count %>">
                  <button type="button"
                          id="license-seats-save-<%= company.id %>"
                          class="hidden px-3 py-2 text-xs bg-[#5C3984] text-white rounded hover:bg-[#4A2F6B] min-h-[44px]"
                          data-action="click->account-management#saveLicenseSeats"
                          data-company-id="<%= company.id %>">
                    <%= t('save') %>
                  </button>
                  <button type="button"
                          id="license-seats-cancel-<%= company.id %>"
                          class="hidden px-3 py-2 text-xs bg-gray-200 text-gray-700 rounded hover:bg-gray-300 min-h-[44px]"
                          data-action="click->account-management#cancelLicenseSeatsEdit"
                          data-company-id="<%= company.id %>">
                    <%= t('cancel') %>
                  </button>
                </div>
              <% else %>
                <div class="text-xs sm:text-sm text-gray-900"><%= company.license_seats %></div>
              <% end %>
            </td>
            <td class="px-3 sm:px-6 py-4 whitespace-nowrap">
              <div class="text-xs sm:text-sm text-gray-900"><%= company.company_users.count %></div>
            </td>
            <td class="px-3 sm:px-6 py-4 whitespace-nowrap">
              <div class="text-xs sm:text-sm text-gray-900"><%= company.company_standards.count %></div>
            </td>
            <td class="px-3 sm:px-6 py-4 whitespace-nowrap">
              <% 
                company_status = company.status || "pending"
                status_badge_class = company_status == "active" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800"
                status_text = company_status == "active" ? t('active') : t('pending')
              %>
              <span class="px-2 inline-flex text-[10px] sm:text-xs leading-5 font-semibold rounded-full <%= status_badge_class %> status-badge-<%= company.id %> whitespace-nowrap">
                <%= status_text %>
              </span>
            </td>
            <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-xs sm:text-sm text-gray-900">
              <%= company.created_at.strftime("%Y-%m-%d") %>
            </td>
            <td class="px-3 sm:px-6 py-4 text-xs sm:text-sm font-medium">
              <div class="flex items-center gap-2 flex-wrap">
                <% if current_user&.can_manage_companies? %>
                  <% if company.status == "pending" %>
                    <%= link_to t('activate'),
                                dashboard_update_company_status_path(company, status: "active"),
                                method: :patch,
                                data: { 
                                  action: "click->account-management#updateCompanyStatus",
                                  company_status_button: company.id
                                },
                                class: "text-xs text-[#5C3984] hover:text-[#4A2F6B] font-medium whitespace-nowrap" %>
                  <% else %>
                    <%= link_to t('deactivate'),
                                dashboard_update_company_status_path(company, status: "pending"),
                                method: :patch,
                                data: { 
                                  action: "click->account-management#updateCompanyStatus",
                                  company_status_button: company.id
                                },
                                class: "text-xs text-red-600 hover:text-red-700 font-medium whitespace-nowrap" %>
                  <% end %>
                <% end %>
                <div class="relative" data-controller="dropdown">
                  <button type="button" 
                          class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-gray-400 hover:text-gray-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-[#5C3984] rounded-lg"
                          data-action="click->dropdown#toggle">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                    </svg>
                  </button>
                  <div class="hidden absolute end-0 mt-2 w-48 sm:w-40 bg-white rounded-md shadow-lg z-10 border border-gray-200" data-dropdown-target="menu">
                    <div class="py-1">
                      <%= link_to dashboard_account_management_company_path(company),
                                  class: "block px-4 py-3 sm:py-2 text-xs sm:text-sm text-gray-700 hover:bg-gray-100 min-h-[44px] sm:min-h-auto" do %>
                        <%= t('open_company_profile') %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="8" class="px-4 sm:px-6 py-4 text-center text-xs sm:text-sm text-gray-500">
            <%= t('no_companies_found') %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<% if @pagy.pages > 1 %>
  <div class="mt-4 sm:mt-6 px-4">
    <%== pagy_nav(@pagy) if defined?(pagy_nav) %>
  </div>
<% end %>


