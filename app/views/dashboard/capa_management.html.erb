<script>
  // Store current page URL in sessionStorage
  function storeCurrentPage() {
    const currentUrl = window.location.pathname + window.location.search;
    sessionStorage.setItem('capa_management_last_page', currentUrl);
  }

  // Store page on load and Turbo navigation
  function initializePageStorage() {
    storeCurrentPage();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePageStorage);
  } else {
    initializePageStorage();
  }
  document.addEventListener('turbo:load', initializePageStorage);
  document.addEventListener('turbo:render', initializePageStorage);
</script>

