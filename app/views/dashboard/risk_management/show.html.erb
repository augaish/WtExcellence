<%= content_for :title, @risk.title %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-[#0D1120]"><%= @risk.title %></h1>
      <div class="flex gap-2">
        <%= link_to "Edit", dashboard_edit_risk_path(@risk), class: "px-4 py-2 text-sm text-white bg-[#5C3984] hover:bg-[#4A2F6B] rounded-lg transition-colors" %>
        <%= button_to "Delete", dashboard_destroy_risk_path(@risk), method: :delete, form: { data: { turbo_confirm: "Delete this risk?" } }, class: "px-4 py-2 text-sm text-red-700 border border-red-300 rounded-lg hover:bg-red-50" %>
      </div>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
      <div>
        <span class="text-xs font-semibold text-[#797C81]"><%= t('description') %></span>
        <p class="text-sm text-[#0D1120] mt-1"><%= @risk.description.presence || "-" %></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('category') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.category.presence || "-" %></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('owner') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.owner&.user&.name || "Unassigned" %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('inherent_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.inherent_score %> (<%= @risk.inherent_level %>) &mdash; Likelihood <%= @risk.likelihood %> &times; Impact <%= @risk.impact %></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_methodology.current_exposure') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <%= @risk.current_score %>
            <% if @risk.above_appetite? %>
              <span class="ms-2 inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-[#FDEBEB] text-[#8A1C1C]">
                <%= t('risk_methodology.above_appetite', appetite: @risk.company.risk_appetite_score) %>
              </span>
            <% end %>
          </p>
        </div>

        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_methodology.target_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <% if @risk.target_score.present? %>
              <%= @risk.target_score %>
              &mdash; <%= t('risk_methodology.target_note') %>
              <% if @risk.target_met? %>
                <span class="ms-2 inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <%= t('risk_methodology.target_met') %>
                </span>
              <% end %>
            <% else %>
              &mdash;
            <% end %>
          </p>
        </div>

        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('residual_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <% if @risk.residual_score.present? %>
              <%= @risk.residual_score %> (<%= @risk.residual_level %>) &mdash; Likelihood <%= @risk.residual_likelihood %> &times; Impact <%= @risk.residual_impact %>
            <% else %>
              Not assessed
            <% end %>
          </p>
        </div>
      </div>

      <div>
        <span class="text-xs font-semibold text-[#797C81]"><%= t('status') %></span>
        <p class="text-sm text-[#0D1120] mt-1"><%= t("risk_status.#{@risk.status}") %></p>
      </div>
    </div>

    <%= render "dashboard/shared/governance_capas", origin: @risk,
          create_path: dashboard_create_risk_capa_path(@risk) %>

    <%= render "dashboard/shared/activity_trail", record: @risk %>

    <div class="mt-6">
      <%= link_to "Back to Risk Register", dashboard_risk_management_index_path, class: "text-sm text-blue-500 hover:text-blue-700" %>
    </div>
  </div>
</div>
