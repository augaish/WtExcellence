<%= content_for :title, @risk.title %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-[#0D1120]"><%= @risk.title %></h1>
      <% if current_user&.can_manage_governance? %>
      <div class="flex gap-2">
        <%= link_to t('edit'), dashboard_edit_risk_path(@risk), class: "px-4 py-2 text-sm text-white bg-[#5C3984] hover:bg-[#4A2F6B] rounded-lg transition-colors" %>
        <%= button_to t('delete'), dashboard_destroy_risk_path(@risk), method: :delete, form: { data: { turbo_confirm: t('delete_risk_confirm') } }, class: "px-4 py-2 text-sm text-red-700 border border-red-300 rounded-lg hover:bg-red-50" %>
      </div>
      <% end %>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
      <div>
        <span class="text-xs font-semibold text-[#797C81]"><%= t('description') %></span>
        <p class="text-sm text-[#0D1120] mt-1"><%= @risk.description.presence || "-" %></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('category') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.category.presence || "-" %></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('owner') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.owner&.user&.name || "Unassigned" %></p>
        </div>
      </div>

      <% if @risk.statement %>
        <div class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] p-4">
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_depth.statement_title') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.statement %></p>
        </div>
      <% end %>

      <%= render "dashboard/risk_management/acceptance", risk: @risk %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('inherent_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.inherent_score %> (<%= t("risk_level_#{@risk.inherent_level.to_s.downcase}", default: @risk.inherent_level) %>) &mdash; <%= t('likelihood_times_impact', likelihood: @risk.likelihood, impact: @risk.impact) %></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_methodology.current_exposure') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <%= @risk.current_score %>
            <% if @risk.above_appetite? %>
              <span class="ms-2 inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-[#FDEBEB] text-[#8A1C1C]">
                <%= t('risk_methodology.above_appetite', appetite: @risk.company.risk_appetite_score) %>
              </span>
            <% end %>
          </p>
        </div>

        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_methodology.target_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <% if @risk.target_score.present? %>
              <%= @risk.target_score %>
              &mdash; <%= t('risk_methodology.target_note') %>
              <% if @risk.target_met? %>
                <span class="ms-2 inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <%= t('risk_methodology.target_met') %>
                </span>
              <% end %>
            <% else %>
              &mdash;
            <% end %>
          </p>
        </div>

        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('residual_score') %></span>
          <p class="text-sm text-[#0D1120] mt-1">
            <% if @risk.residual_score.present? %>
              <%= @risk.residual_score %> (<%= t("risk_level_#{@risk.residual_level.to_s.downcase}", default: @risk.residual_level) %>) &mdash; <%= t('likelihood_times_impact', likelihood: @risk.residual_likelihood, impact: @risk.residual_impact) %>
            <% else %>
              Not assessed
            <% end %>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 pt-4 border-t border-[#E3E3E3]">
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_depth.treatment') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.treatment_label || "—" %></p>
          <% if @risk.treatment_plan.present? %><p class="text-xs text-[#797C81] mt-1 whitespace-pre-line"><%= @risk.treatment_plan %></p><% end %>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_depth.control_owner') %></span>
          <p class="text-sm text-[#0D1120] mt-1"><%= @risk.control_owner&.user&.name || "—" %></p>
        </div>
        <div class="col-span-2">
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_depth.control_rationale') %></span>
          <p class="text-sm text-[#0D1120] mt-1 whitespace-pre-line"><%= @risk.control_rationale.presence || t('risk_depth.residual_unverified') %></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-[#797C81]"><%= t('risk_depth.next_review_on') %></span>
          <p class="text-sm mt-1 <%= @risk.review_overdue? ? 'text-red-700 font-medium' : 'text-[#0D1120]' %>">
            <%= @risk.next_review_on ? l(@risk.next_review_on, format: :document) : "—" %>
            <% if @risk.review_overdue? %><span class="ms-1 px-2 py-0.5 rounded-full bg-red-100 text-red-700 text-[11px]"><%= t('vendor_assessment.review_overdue') %></span><% end %>
          </p>
        </div>
      </div>

      <div>
        <span class="text-xs font-semibold text-[#797C81]"><%= t('status') %></span>
        <p class="text-sm text-[#0D1120] mt-1"><%= t("risk_status.#{@risk.status}") %></p>
      </div>
    </div>

    <%= render "dashboard/shared/governance_capas", origin: @risk,
          create_path: dashboard_create_risk_capa_path(@risk) %>

    <%= render "dashboard/shared/activity_trail", record: @risk %>

    <div class="mt-6">
      <% if @risk.closed? %>
        <div class="mt-4 rounded-xl border border-[#E3E3E3] bg-[#F7F7FD] p-4">
          <p class="text-xs font-semibold text-[#797C81] uppercase tracking-wide"><%= t('risk.closure_title') %></p>
          <p class="mt-1 text-sm text-[#0D1120] whitespace-pre-line"><%= @risk.closure_reason.presence || "—" %></p>
          <p class="mt-2 text-xs text-[#797C81]">
            <%= t('risk.closed_by_on', name: @risk.closed_by&.name || "—", date: (@risk.closed_at ? l(@risk.closed_at.to_date, format: :document) : "—")) %>
          </p>
        </div>
      <% end %>
      <%= link_to t('back_to_risk_register'), dashboard_risk_management_index_path, class: "text-sm text-blue-500 hover:text-blue-700" %>
    </div>
  </div>
</div>
