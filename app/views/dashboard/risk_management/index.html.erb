<%= content_for :title, t('risk_management') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('risk_management'), subtitle: t('risk_management_subtitle') } do %>
      <%= link_to t('manage_workspaces'), dashboard_risk_workspaces_path, class: ui_btn_secondary %>
      <%= link_to t('log_new_risk'), dashboard_new_risk_path, class: ui_btn_primary %>
    <% end %>

    <!-- Risk Matrix Heatmap -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 mb-8 overflow-x-auto">
      <h2 class="text-lg font-semibold text-[#0D1120] mb-4"><%= t('risk_matrix') %></h2>
      <table class="border-collapse">
        <tbody>
          <% (5).downto(1) do |impact| %>
            <tr>
              <td class="text-xs font-medium text-[#797C81] pr-2 align-middle">Impact <%= impact %></td>
              <% (1..5).each do |likelihood| %>
                <% score = likelihood * impact %>
                <% cell_risks = @heatmap[[likelihood, impact]] || [] %>
                <% color = case score
                           when 1..4 then "bg-green-100 text-green-800"
                           when 5..10 then "bg-yellow-100 text-yellow-800"
                           when 11..15 then "bg-orange-100 text-orange-800"
                           else "bg-red-100 text-red-800"
                           end %>
                <td class="w-20 h-16 border border-white">
                  <div class="w-full h-full flex flex-col items-center justify-center rounded <%= color %>">
                    <span class="text-xs font-semibold"><%= score %></span>
                    <% if cell_risks.any? %>
                      <span class="text-[10px]"><%= cell_risks.size %> risk<%= "s" if cell_risks.size != 1 %></span>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
          <tr>
            <td></td>
            <% (1..5).each do |likelihood| %>
              <td class="text-xs font-medium text-[#797C81] text-center pt-1">L<%= likelihood %></td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Risk Register (grouped by workspace) -->
    <% if @risks.empty? %>
      <div class="bg-white border border-[#E3E3E3] rounded-xl p-8 text-center text-sm text-[#797C81]">
        No risks logged yet
      </div>
    <% else %>
      <% @risks_by_workspace.each do |workspace, risks| %>
        <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden mb-6">
          <div class="p-4 border-b border-[#E3E3E3] flex items-center justify-between">
            <h2 class="text-lg font-semibold text-[#0D1120]">
              <%= workspace ? workspace.name : t('uncategorized') %>
            </h2>
            <% if workspace %>
              <%= link_to t('view_workspace'), dashboard_risk_workspace_path(workspace), class: "text-sm text-[#5C3984] hover:underline" %>
            <% end %>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
                <tr>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('title') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('category') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('owner') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('inherent_score') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('residual_score') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('status') %></span></th>
                  <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('action') %></span></th>
                </tr>
              </thead>
              <tbody>
                <% risks.each do |risk| %>
                  <tr class="border-b border-[#E3E3E3] hover:bg-[#F7F7FD]">
                    <td class="p-4 text-sm font-medium text-[#0D1120]"><%= risk.title %></td>
                    <td class="p-4 text-sm text-[#797C81]"><%= risk.category.presence || "-" %></td>
                    <td class="p-4 text-sm text-[#797C81]"><%= risk.owner&.user&.name || "Unassigned" %></td>
                    <td class="p-4">
                      <span class="px-2 py-1 text-xs font-medium rounded-full <%= risk.inherent_level == 'low' ? 'bg-green-100 text-green-800' : risk.inherent_level == 'medium' ? 'bg-yellow-100 text-yellow-800' : risk.inherent_level == 'high' ? 'bg-orange-100 text-orange-800' : 'bg-red-100 text-red-800' %>">
                        <%= risk.inherent_score %> (<%= risk.inherent_level %>)
                      </span>
                    </td>
                    <td class="p-4 text-sm text-[#797C81]">
                      <% if risk.residual_score.present? %>
                        <%= risk.residual_score %> (<%= risk.residual_level %>)
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td class="p-4 text-sm text-[#797C81]"><%= risk.status.titleize %></td>
                    <td class="p-4">
                      <%= link_to "View", dashboard_risk_management_path(risk), class: "text-blue-500 hover:text-blue-700 text-sm" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
