<%= form_with model: @risk, url: (@risk.new_record? ? dashboard_risk_management_index_path : dashboard_update_risk_path(@risk)), method: (@risk.new_record? ? :post : :patch), class: "space-y-6", data: { turbo: false } do |f| %>
  <% if f.object.new_record? %><%= hidden_field_tag :submission_token, SecureRandom.hex(16) %><% end %>

  <% if @risk.errors.any? %>
    <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800 mb-2">
            <%= t('form_errors.heading', count: @risk.errors.count) %>
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @risk.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
    <div>
      <%= f.label :title, t('title'), class: ui_label %>
      <%= f.text_field :title, class: ui_input %>
    </div>

    <div>
      <%= f.label :description, t('description'), class: ui_label %>
      <%= f.text_area :description, rows: 3, class: ui_input %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category, t('category'), class: ui_label %>
        <%= f.text_field :category, class: ui_input %>
      </div>
      <div>
        <%= f.label :owner_id, t('owner'), class: ui_label %>
        <%= f.collection_select :owner_id, current_company&.company_users&.includes(:user) || [], :id, ->(cu) { cu.user.name }, { include_blank: t('unassigned') }, class: ui_input %>
      </div>
    </div>

    <%# Cause → event → impact: a risk stated so two readers understand the same thing. %>
    <div class="rounded-lg border border-[#E3E3E3] bg-[#F7F7FD] p-4 space-y-3">
      <p class="text-xs font-semibold text-[#797C81] uppercase tracking-wide"><%= t('risk_depth.statement_title') %></p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <%= f.label :cause, t('risk_depth.cause'), class: ui_label %>
          <%= f.text_area :cause, rows: 2, class: ui_input, placeholder: t('risk_depth.cause_placeholder') %>
        </div>
        <div>
          <%= f.label :event, t('risk_depth.event'), class: ui_label %>
          <%= f.text_area :event, rows: 2, class: ui_input, placeholder: t('risk_depth.event_placeholder') %>
        </div>
        <div>
          <%= f.label :impact_statement, t('risk_depth.impact'), class: ui_label %>
          <%= f.text_area :impact_statement, rows: 2, class: ui_input, placeholder: t('risk_depth.impact_placeholder') %>
        </div>
      </div>
    </div>

    <div>
      <%= f.label :risk_workspace_id, t('risk_workspace'), class: ui_label %>
      <%= f.collection_select :risk_workspace_id, @risk_workspaces || [], :id, :name, { include_blank: t('uncategorized') }, class: ui_input %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :likelihood, t('likelihood_1_5'), class: ui_label %>
        <%= f.select :likelihood, (1..5), {}, class: ui_input %>
      </div>
      <div>
        <%= f.label :impact, t('impact_1_5'), class: ui_label %>
        <%= f.select :impact, (1..5), {}, class: ui_input %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :residual_likelihood, t('residual_likelihood_label'), class: ui_label %>
        <%= f.select :residual_likelihood, (1..5), { include_blank: true }, class: ui_input %>
      </div>
      <div>
        <%= f.label :residual_impact, t('residual_impact_label'), class: ui_label %>
        <%= f.select :residual_impact, (1..5), { include_blank: true }, class: ui_input %>
      </div>

      <%# A target is where the company intends the exposure to end up. It is
          recorded separately from the residual assessment so it can never be
          mistaken for exposure already reduced. %>
      <div>
        <%= f.label :target_likelihood, t('risk_methodology.target_likelihood'), class: ui_label %>
        <%= f.select :target_likelihood, (1..5), { include_blank: true }, class: ui_input %>
      </div>

      <div>
        <%= f.label :target_impact, t('risk_methodology.target_impact'), class: ui_label %>
        <%= f.select :target_impact, (1..5), { include_blank: true }, class: ui_input %>
      </div>
    </div>

    <%# What is done about it, who owns the controls, and why the residual score holds. %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :treatment_strategy, t('risk_depth.treatment'), class: ui_label %>
        <%= f.select :treatment_strategy, Risk::TREATMENT_STRATEGIES.map { |s| [ t("risk_depth.treatments.#{s}"), s ] }, { include_blank: t('pp_records.pick') }, class: ui_input %>
      </div>
      <div>
        <%= f.label :control_owner_id, t('risk_depth.control_owner'), class: ui_label %>
        <%= f.collection_select :control_owner_id, current_company&.company_users&.includes(:user) || [], :id, ->(cu) { cu.user.name }, { include_blank: t('unassigned') }, class: ui_input %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :treatment_plan, t('risk_depth.treatment_plan'), class: ui_label %>
        <%= f.text_area :treatment_plan, rows: 2, class: ui_input %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :control_rationale, t('risk_depth.control_rationale'), class: ui_label %>
        <%= f.text_area :control_rationale, rows: 2, class: ui_input, placeholder: t('risk_depth.control_rationale_placeholder') %>
        <p class="mt-1 text-xs text-[#797C81]"><%= t('risk_depth.control_rationale_hint') %></p>
      </div>
      <div>
        <%= f.label :next_review_on, t('risk_depth.next_review_on'), class: ui_label %>
        <%= f.date_field :next_review_on, class: ui_input %>
      </div>
    </div>

    <div>
      <%= f.label :status, t('status'), class: ui_label %>
      <%= f.select :status, Risk.statuses.keys.map { |s| [ t("risk_status.#{s}"), s ] }, {}, class: ui_input %>
    </div>

    <%# Closing a risk is a governance decision and must say why. %>
    <div>
      <%= f.label :closure_reason, t('risk.closure_reason'), class: ui_label %>
      <%= f.text_area :closure_reason, rows: 3, class: ui_input,
          placeholder: t('risk.closure_reason_placeholder') %>
      <p class="mt-1 text-xs text-[#797C81]"><%= t('risk.closure_reason_hint') %></p>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t('cancel'), dashboard_risk_management_index_path, class: ui_btn_neutral %>
    <%= f.submit (@risk.new_record? ? t('log_risk') : t('save_changes')), class: ui_btn_primary %>
  </div>
<% end %>
