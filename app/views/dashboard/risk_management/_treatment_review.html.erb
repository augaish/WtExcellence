<%# Where the owner's treatment stands, and the reviewer's accept / return. %>
<% can_review = current_user.can_manage_governance? && risk.treatment_submitted? && risk.owner&.user != current_user %>
<div class="bg-white border border-[#E3E3E3] rounded-xl p-5" id="treatment-review">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-[#0D1120]"><%= t('risk_treatment.review_title') %></h2>
    <%= render "dashboard/risk_management/treatment_state", risk: risk %>
  </div>
  <p class="text-xs text-[#797C81] mt-1">
    <% if risk.treatment_submitted? && risk.treatment_submitted_at %>
      <%= t('risk_treatment.submitted_by', name: risk.owner&.user&.name.to_s, date: l(risk.treatment_submitted_at, format: :long)) %>
    <% elsif (risk.treatment_accepted? || risk.treatment_returned?) && risk.treatment_reviewed_at %>
      <%= t("risk_treatment.reviewed_#{risk.treatment_accepted? ? 'accepted' : 'returned'}", name: risk.treatment_reviewed_by&.name.to_s, date: l(risk.treatment_reviewed_at, format: :long)) %>
    <% elsif risk.owner %>
      <%= t('risk_treatment.with_owner', name: risk.owner.user.name) %>
    <% else %>
      <%= t('risk_treatment.no_owner') %>
    <% end %>
  </p>
  <% if risk.treatment_returned? && risk.treatment_return_reason.present? %>
    <p class="mt-2 text-sm text-amber-900 whitespace-pre-line"><%= risk.treatment_return_reason %></p>
  <% end %>
  <% if risk.owner&.user == current_user && risk.treatment_with_owner? %>
    <%= link_to t('risk_treatment.open_task'), dashboard_treatment_task_path(risk), class: "#{ui_btn_primary} mt-3" %>
  <% end %>
  <% if can_review %>
    <div class="mt-4 flex flex-col sm:flex-row gap-3">
      <%= button_to t('risk_treatment.accept'), dashboard_accept_risk_treatment_path(risk), method: :post, class: ui_btn_primary, form_class: "shrink-0" %>
      <%= form_with url: dashboard_return_risk_treatment_path(risk), method: :post, class: "flex-1 flex flex-col sm:flex-row gap-2" do %>
        <%= text_field_tag :reason, nil, required: true, placeholder: t('risk_treatment.reason_placeholder'), class: "flex-1 border border-[#E3E3E3] rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        <%= submit_tag t('risk_treatment.return'), class: ui_btn_neutral %>
      <% end %>
    </div>
  <% end %>
</div>
