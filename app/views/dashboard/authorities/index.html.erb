<% input = "w-full border border-[#E3E3E3] rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-[#5C3984]" %>
<% can_manage = can_manage_authorities? %>

<div class="p-6 space-y-6">
  <%= render layout: "dashboard/shared/page_header",
      locals: { title: t('doa.title'), subtitle: @matrix&.display_title } do %>
    <% if @matrix && can_manage %>
      <%= button_to t('doa.versions.open_next'), dashboard_open_next_authority_version_path(matrix_id: @matrix.id),
          method: :post, class: ui_btn_secondary %>
    <% end %>
  <% end %>

  <% if @matrix.nil? %>
    <%= render "dashboard/shared/empty_state", icon: "account-management-icon.svg",
        title: t('doa.matrix'), subtitle: t('doa.no_matrix') %>
  <% else %>
    <% if @matrices.size > 1 %>
      <%= form_with url: dashboard_authorities_path, method: :get, class: "flex items-end gap-3" do %>
        <div>
          <label class="block text-xs font-medium text-[#797C81] mb-1"><%= t('doa.select_matrix') %></label>
          <%= select_tag :matrix_id, options_from_collection_for_select(@matrices, :id, :display_title, @matrix.id),
              class: input, onchange: "this.form.requestSubmit()" %>
        </div>
      <% end %>
    <% end %>

    <%= render "dashboard/authorities/changes", diff: @diff if @diff %>

    <!-- Findings -->
    <section class="bg-white border border-[#E3E3E3] rounded-lg p-5">
      <h2 class="text-base font-semibold text-[#0D1120] mb-3"><%= t('doa.findings.title') %></h2>
      <% if @authorities.empty? %>
        <p class="text-sm text-[#797C81]"><%= t('doa.findings.nothing_yet') %></p>
      <% elsif @report.any? %>
        <ul class="space-y-2 text-sm">
          <% @report.by_authority.each do |authority, findings| %>
            <li class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-3">
              <p class="font-medium text-[#0D1120]"><%= authority.display_name %></p>
              <ul class="mt-1 space-y-0.5 text-[#797C81]">
                <% findings.each do |finding| %>
                  <li><%= finding.message %><% if finding.band&.bounded? %> <span class="text-xs">(<%= finding.band.display_label %>)</span><% end %></li>
                <% end %>
              </ul>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-[#797C81]"><%= t('doa.findings.none') %></p>
      <% end %>
    </section>

    <%# ---- The matrix: category -> authority -> bands -> six level boxes ---- %>
    <% grouped = @authorities.group_by(&:authority_category) %>
    <% sections = @categories.map { |c| [ c, grouped.fetch(c, []) ] } %>
    <% sections << [ nil, grouped[nil] ] if grouped[nil].present? %>

    <% sections.each do |category, authorities| %>
      <section class="bg-white border border-[#E3E3E3] rounded-lg">
        <div class="flex items-center justify-between gap-3 p-5 border-b border-[#E3E3E3]">
          <h2 class="text-base font-semibold text-[#0D1120]"><%= category&.display_name || t('doa.uncategorised') %></h2>
          <% if can_manage && category %>
            <details class="relative">
              <summary class="cursor-pointer text-xs text-[#5C3984] hover:underline"><%= t('edit') %></summary>
              <div class="mt-2 flex flex-wrap gap-2 items-center">
                <%= form_with url: dashboard_update_authority_category_path(category, matrix_id: @matrix.id), method: :patch,
                              scope: :authority_category, class: "flex gap-2" do |f| %>
                  <%= f.text_field :name_en, value: category.name_en, placeholder: "EN", class: "#{input} w-40" %>
                  <%= f.text_field :name_ar, value: category.name_ar, placeholder: "AR", class: "#{input} w-40" %>
                  <%= f.submit t('save_changes'), class: ui_btn_secondary %>
                <% end %>
                <%= button_to t('delete'), dashboard_destroy_authority_category_path(category, matrix_id: @matrix.id),
                    method: :delete, form: { data: { turbo_confirm: t('doa.category_delete_confirm') } },
                    class: "text-xs text-[#797C81] hover:text-[#0D1120]" %>
              </div>
            </details>
          <% end %>
        </div>

        <% if authorities.empty? %>
          <p class="px-5 py-4 text-sm text-[#797C81]"><%= t('doa.category_empty') %></p>
        <% end %>

        <div class="divide-y divide-[#E3E3E3]">
          <% authorities.each do |authority| %>
            <div class="p-5 space-y-4">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-[#0D1120]">
                    <span class="text-[#797C81] font-mono me-1"><%= authority.number %></span><%= authority.display_name %>
                  </p>
                  <p class="text-xs text-[#797C81] mt-0.5"><%= t('doa.basis') %>: <%= authority.basis_label.presence || t('doa.no_basis') %></p>
                </div>
                <% if can_manage %>
                  <div class="flex items-center gap-3 flex-shrink-0">
                    <details>
                      <summary class="cursor-pointer text-xs text-[#5C3984] hover:underline"><%= t('edit') %></summary>
                      <%= form_with url: dashboard_update_authority_path(authority, matrix_id: @matrix.id), method: :patch,
                                    scope: :authority, class: "mt-2 grid gap-2 md:grid-cols-4" do |f| %>
                        <%= f.text_field :name_en, value: authority.name_en, placeholder: "EN", class: input %>
                        <%= f.text_field :name_ar, value: authority.name_ar, placeholder: "AR", class: input %>
                        <%= f.collection_select :basis_record_id, @matrix.company.pp_records.of_type("policy").ordered, :id, :display_title,
                            { include_blank: t('doa.basis'), selected: authority.basis_record_id }, class: input %>
                        <%= f.submit t('save_changes'), class: ui_btn_secondary %>
                      <% end %>
                    </details>
                    <%= button_to t('delete'), dashboard_destroy_authority_path(authority, matrix_id: @matrix.id),
                        method: :delete, form: { data: { turbo_confirm: t('are_you_sure') } },
                        class: "text-xs text-[#797C81] hover:text-[#0D1120]" %>
                  </div>
                <% end %>
              </div>

              <%# Bands: each carries its six boxes. An unbounded single band is
                  simply "all amounts". %>
              <% authority.bands.each do |band| %>
                <div class="rounded-lg border border-[#E3E3E3] bg-[#F7F7FD] p-3 space-y-2">
                  <div class="flex items-center justify-between gap-3">
                    <p class="text-xs font-medium text-[#0D1120]"><%= t('doa.band') %>: <%= band.display_label %></p>
                    <% if can_manage %>
                      <details>
                        <summary class="cursor-pointer text-[11px] text-[#5C3984] hover:underline"><%= t('doa.edit_band') %></summary>
                        <div class="mt-1 flex flex-wrap gap-2 items-center">
                          <%= form_with url: dashboard_update_authority_band_path(band, matrix_id: @matrix.id), method: :patch,
                                        scope: :authority_band, class: "flex gap-2" do |f| %>
                            <%= f.number_field :min_amount, value: band.min_amount, step: :any, placeholder: t('doa.min_amount'), class: "#{input} w-32" %>
                            <%= f.number_field :max_amount, value: band.max_amount, step: :any, placeholder: t('doa.max_amount'), class: "#{input} w-32" %>
                            <%= f.submit t('save_changes'), class: ui_btn_secondary %>
                          <% end %>
                          <% unless authority.bands.one? %>
                            <%= button_to t('delete'), dashboard_destroy_authority_band_path(band, matrix_id: @matrix.id),
                                method: :delete, form: { data: { turbo_confirm: t('are_you_sure') } },
                                class: "text-[11px] text-[#797C81] hover:text-[#0D1120]" %>
                          <% end %>
                        </div>
                      </details>
                    <% end %>
                  </div>
                  <div class="grid gap-2 sm:grid-cols-3 lg:grid-cols-6">
                    <% AuthorityLevel::KEYS.each do |level| %>
                      <%= render "dashboard/authorities/holder_box", band: band, level: level, matrix: @matrix,
                          org_units: @org_units, company_users: @company_users, can_manage: can_manage %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if can_manage %>
                <%= form_with url: dashboard_create_authority_band_path(authority_id: authority.id, matrix_id: @matrix.id),
                              method: :post, scope: :authority_band, class: "flex flex-wrap items-center gap-2" do |f| %>
                  <span class="text-xs text-[#797C81]"><%= t('doa.add_band') %>:</span>
                  <%= f.number_field :min_amount, step: :any, min: 0, placeholder: t('doa.min_amount'), class: "#{input} w-32" %>
                  <%= f.number_field :max_amount, step: :any, min: 0, placeholder: t('doa.max_amount'), class: "#{input} w-32" %>
                  <%= f.submit t('doa.add_band'), class: ui_btn_neutral %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if can_manage %>
          <div class="p-5 border-t border-[#E3E3E3]">
            <%= form_with url: dashboard_create_authority_path(matrix_id: @matrix.id), method: :post,
                          scope: :authority, class: "grid gap-3 md:grid-cols-4" do |f| %>
              <%= f.hidden_field :authority_category_id, value: category&.id %>
              <%= f.text_field :name_en, placeholder: t('doa.authority') + " (EN)", class: input %>
              <%= f.text_field :name_ar, placeholder: t('doa.authority') + " (AR)", class: input %>
              <%= f.collection_select :basis_record_id, @matrix.company.pp_records.of_type("policy").ordered, :id, :display_title,
                  { include_blank: t('doa.basis') }, class: input %>
              <%= f.submit t('doa.add_authority'), class: ui_btn_primary %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if can_manage %>
      <section class="bg-white border border-[#E3E3E3] rounded-lg p-5">
        <h2 class="text-base font-semibold text-[#0D1120] mb-3"><%= t('doa.add_category') %></h2>
        <%= form_with url: dashboard_create_authority_category_path(matrix_id: @matrix.id), method: :post,
                      scope: :authority_category, class: "flex flex-wrap gap-3" do |f| %>
          <%= f.text_field :name_en, placeholder: t('doa.category') + " (EN)", class: "#{input} sm:w-64" %>
          <%= f.text_field :name_ar, placeholder: t('doa.category') + " (AR)", class: "#{input} sm:w-64" %>
          <%= f.submit t('doa.add_category'), class: ui_btn_secondary %>
        <% end %>
      </section>

      <%= render "dashboard/authorities/suggestions", suggestions: @suggested_categories, matrix: @matrix %>
    <% end %>

    <%= render "dashboard/authorities/delegations", delegations: @delegations, matrix: @matrix,
        authorities: @authorities, org_units: @org_units, input: input, can_manage: can_manage %>
    <%= render "dashboard/authorities/consultation", consultations: @consultations, matrix: @matrix,
        authorities: @authorities, org_units: @org_units, input: input, can_manage: can_manage %>
  <% end %>
</div>
