<%# A person or a structure, so a holder's kind is seen before it is read. Locals: kind (:person | :unit) %>
<% if kind == :person %>
  <svg class="w-3.5 h-3.5 text-[#5C3984]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><title><%= t('doa.picker.people') %></title><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
<% else %>
  <svg class="w-3.5 h-3.5 text-[#5C3984]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><title><%= t('doa.picker.units') %></title><rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="15" width="6" height="5" rx="1"/><rect x="15" y="15" width="6" height="5" rx="1"/><path d="M12 8v4M6 15v-3h12v3"/></svg>
<% end %>
