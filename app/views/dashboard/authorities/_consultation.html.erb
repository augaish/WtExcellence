<%# The consultation cycle run in a spreadsheet today: a challenge, a proposal,
    an expected impact and a ruling, with the trail from one to the other kept. %>
<section class="bg-white border border-[#E3E3E3] rounded-lg">
  <div class="p-5 border-b border-[#E3E3E3]">
    <h2 class="text-base font-semibold text-[#0D1120]"><%= t('doa.consultation.title') %></h2>
  </div>

  <% if consultations.any? %>
    <div class="divide-y divide-[#E3E3E3]">
      <% consultations.each do |item| %>
        <div class="p-5 space-y-2">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-medium text-[#0D1120]"><%= item.authority&.display_name || t('doa.matrix') %></p>
              <p class="text-xs text-[#797C81]"><%= item.org_unit&.display_name %></p>
            </div>
            <span class="text-xs px-2 py-1 rounded-full bg-[#F6EEFF] text-[#0D1120]"><%= item.status_label %></span>
          </div>

          <dl class="grid gap-2 md:grid-cols-3 text-sm">
            <% { challenge: item.challenge, proposal: item.proposal, expected_impact: item.expected_impact }.each do |key, value| %>
              <% next if value.blank? %>
              <div>
                <dt class="text-xs text-[#797C81]"><%= t("doa.consultation.#{key}") %></dt>
                <dd class="text-[#0D1120]"><%= value %></dd>
              </div>
            <% end %>
          </dl>

          <% if item.ruling.present? %>
            <div class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-2 text-sm">
              <span class="text-xs text-[#797C81]"><%= t('doa.consultation.ruling') %>:</span>
              <%= item.ruling %>
            </div>
          <% end %>

          <% if can_manage && !item.ruled? %>
            <%= form_with url: dashboard_rule_authority_consultation_path(item, matrix_id: matrix.id),
                          method: :patch, scope: :authority_consultation, class: "grid gap-2 md:grid-cols-3" do |f| %>
              <%= f.select :status,
                  (AuthorityConsultation::STATUSES - [ "open" ]).map { |s| [ t("doa.consultation.statuses.#{s}"), s ] },
                  {}, class: input %>
              <%= f.text_field :ruling, placeholder: t('doa.consultation.ruling'), class: input %>
              <%= f.submit t('doa.consultation.rule'), class: ui_btn_secondary %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="px-5 py-6 text-sm text-[#797C81]"><%= t('doa.consultation.none') %></p>
  <% end %>

  <%= form_with url: dashboard_create_authority_consultation_path(matrix_id: matrix.id), method: :post,
                scope: :authority_consultation, class: "p-5 border-t border-[#E3E3E3] grid gap-3 md:grid-cols-5" do |f| %>
    <%= f.collection_select :authority_id, authorities, :id, :display_name,
        { include_blank: t('doa.authority') }, class: input %>
    <%= f.collection_select :org_unit_id, org_units, :id, :display_name,
        { include_blank: t('doa.holder') }, class: input %>
    <%= f.text_field :challenge, placeholder: t('doa.consultation.challenge'), class: input %>
    <%= f.text_field :proposal, placeholder: t('doa.consultation.proposal'), class: input %>
    <%= f.submit t('doa.consultation.raise'), class: ui_btn_primary %>
  <% end %>
</section>
