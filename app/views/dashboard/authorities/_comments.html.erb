<%# Reviewer comments on one authority and the owner's answer to each.
    Locals: authority, matrix, comments, can_edit, input %>
<div class="mt-2 space-y-2">
  <% comments.each do |comment| %>
    <div class="rounded-lg border border-[#E3E3E3] bg-[#F7F7FD] px-3 py-2 space-y-1">
      <p class="text-xs text-[#797C81]"><%= comment.user.name %> · <%= l(comment.created_at, format: :short) %></p>
      <p class="text-[#0D1120] whitespace-pre-line"><%= comment.body %></p>
      <% if comment.answered? %>
        <p class="text-xs">
          <span class="font-medium <%= comment.decision == 'accepted' ? 'text-green-700' : 'text-red-700' %>"><%= t("doa.comments.decisions.#{comment.decision}") %></span>
          <span class="text-[#797C81]">· <%= comment.replied_by&.name %></span>
        </p>
        <p class="text-[#0D1120] whitespace-pre-line"><%= comment.reply %></p>
      <% elsif can_edit %>
        <%= form_with url: dashboard_answer_authority_review_comment_path(comment, matrix_id: matrix.id), method: :patch,
                      class: "flex flex-wrap gap-2 items-start pt-1" do %>
          <%= text_area_tag :reply, nil, rows: 1, placeholder: t('doa.comments.reply_placeholder'), class: "#{input} flex-1 min-w-[12rem]" %>
          <%= button_tag t('doa.comments.accept'), name: "decision", value: "accepted", class: ui_btn_secondary %>
          <%= button_tag t('doa.comments.reject'), name: "decision", value: "rejected", class: ui_btn_danger %>
        <% end %>
      <% else %>
        <p class="text-xs text-[#797C81]"><%= t('doa.comments.waiting') %></p>
      <% end %>
    </div>
  <% end %>

  <% if can_comment_on_matrix? && matrix.latest_version? %>
    <%= form_with url: dashboard_create_authority_review_comment_path(authority_id: authority.id, matrix_id: matrix.id), method: :post,
                  class: "flex flex-wrap gap-2 items-start" do %>
      <%= text_area_tag :body, nil, rows: 1, placeholder: t('doa.comments.placeholder'), class: "#{input} flex-1 min-w-[12rem]" %>
      <%= submit_tag t('doa.comments.add'), class: ui_btn_secondary %>
    <% end %>
  <% end %>
</div>
