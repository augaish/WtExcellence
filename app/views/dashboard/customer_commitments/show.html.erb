<%= content_for :title, @commitment.title %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <%= link_to t('back_to_commitments'), dashboard_customer_commitments_path, class: "text-sm text-[#5C3984] hover:underline mb-2 inline-block" %>
        <h1 class="text-2xl font-bold text-[#0D1120]"><%= @commitment.title %></h1>
      </div>
      <% if current_user&.can_manage_governance? %>
      <div class="flex items-center gap-3">
        <%= link_to t('edit'), edit_dashboard_customer_commitment_path(@commitment), class: ui_btn_secondary %>
        <%= link_to t('delete'), dashboard_customer_commitment_path(@commitment), data: { turbo_method: :delete, turbo_confirm: t('are_you_sure') }, class: ui_btn_danger %>
      </div>
      <% end %>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
      <div>
        <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('customer') %></p>
        <p class="text-sm text-[#0D1120]"><%= @commitment.customer_name %></p>
      </div>
      <% if @commitment.description.present? %>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('description') %></p>
          <p class="text-sm text-[#0D1120]"><%= @commitment.description %></p>
        </div>
      <% end %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('due_date') %></p>
          <p class="text-sm <%= @commitment.past_due? ? 'text-red-600 font-medium' : 'text-[#0D1120]' %>">
            <%= @commitment.due_date ? l(@commitment.due_date, format: :document) : "-" %>
          </p>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('owner') %></p>
          <p class="text-sm text-[#0D1120]"><%= @commitment.owner&.user&.name || t('unassigned') %></p>
        </div>
      </div>
      <%# Workflow state and timing are shown side by side: "In progress" and
          "4 days overdue" say different things, and the detail page used to
          show only the first. %>
      <div>
        <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('status') %></p>
        <span class="inline-flex mt-1 px-2 py-1 text-xs font-medium rounded-full <%= @commitment.fulfilled? ? 'bg-green-100 text-green-800' : 'bg-[#F7F7FD] text-[#0D1120]' %>">
          <%= t("commitment_status.#{@commitment.status}") %>
        </span>
      </div>
      <div>
        <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_timing.title') %></p>
        <span class="inline-flex mt-1 px-2 py-1 text-xs font-medium rounded-full <%= commitment_timing_classes(@commitment) %>">
          <%= commitment_timing_label(@commitment) %>
        </span>
      </div>
      <div class="grid grid-cols-2 gap-4 pt-4 border-t border-[#E3E3E3]">
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_depth.agreement_reference') %></p>
          <p class="text-sm text-[#0D1120]"><%= @commitment.agreement_reference.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_depth.vendor') %></p>
          <p class="text-sm text-[#0D1120]"><% if @commitment.vendor %><%= link_to @commitment.vendor.name, dashboard_vendor_path(@commitment.vendor), class: "text-[#5C3984] hover:underline" %><% else %>—<% end %></p>
        </div>
        <div class="col-span-2">
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_depth.acceptance_criteria') %></p>
          <p class="text-sm text-[#0D1120] whitespace-pre-line"><%= @commitment.acceptance_criteria.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_depth.recurrence') %></p>
          <p class="text-sm text-[#0D1120]"><%= @commitment.recurrence_label %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_depth.delivered_on') %></p>
          <p class="text-sm text-[#0D1120]"><%= @commitment.delivered_on ? l(@commitment.delivered_on, format: :document) : "—" %></p>
        </div>
      </div>

      <%= render "dashboard/customer_commitments/acceptance", commitment: @commitment %>

      <% if @commitment.fulfillment_note.present? %>
        <div class="md:col-span-2">
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('commitment_timing.fulfillment_note') %></p>
          <p class="mt-1 text-sm text-[#0D1120]"><%= @commitment.fulfillment_note %></p>
        </div>
      <% end %>
    </div>

    <%= render "dashboard/shared/governance_capas", origin: @commitment,
          create_path: create_capa_dashboard_customer_commitment_path(@commitment) %>

    <%= render "dashboard/shared/activity_trail", record: @commitment %>
  </div>
</div>
