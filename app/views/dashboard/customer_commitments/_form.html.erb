<%= form_with model: @commitment, url: (@commitment.new_record? ? dashboard_customer_commitments_path : dashboard_customer_commitment_path(@commitment)), method: (@commitment.new_record? ? :post : :patch), class: "space-y-6" do |f| %>

  <% if @commitment.errors.any? %>
    <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800 mb-2">
            <%= pluralize(@commitment.errors.count, "error") %> prohibited this commitment from being saved:
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @commitment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
    <div>
      <%= f.label :title, t('title'), class: ui_label %>
      <%= f.text_field :title, class: ui_input %>
    </div>

    <div>
      <%= f.label :customer_name, t('customer'), class: ui_label %>
      <%= f.text_field :customer_name, class: ui_input %>
    </div>

    <div>
      <%= f.label :description, t('description'), class: ui_label %>
      <%= f.text_area :description, rows: 3, class: ui_input %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :due_date, t('due_date'), class: ui_label %>
        <%= f.date_field :due_date, class: ui_input %>
      </div>
      <div>
        <%= f.label :owner_id, t('owner'), class: ui_label %>
        <%= f.collection_select :owner_id, current_company&.company_users&.includes(:user) || [], :id, ->(cu) { cu.user.name }, { include_blank: t('unassigned') }, class: ui_input %>
      </div>
    </div>

    <div>
      <%= f.label :status, t('status'), class: ui_label %>
      <%# Overdue is not offered: timing is derived from the due date, so it can
          be reported but never chosen. %>
      <%= f.select :status, CustomerCommitment.statuses.keys.map { |s| [ s.titleize, s ] }, {}, class: ui_input %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :fulfillment_note, t('commitment_timing.fulfillment_note'), class: ui_label %>
      <%= f.text_area :fulfillment_note, rows: 3, class: ui_input,
          placeholder: t('commitment_timing.fulfillment_note_placeholder') %>
      <p class="mt-1 text-xs text-[#797C81]"><%= t('commitment_timing.fulfillment_note_hint') %></p>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t('cancel'), dashboard_customer_commitments_path, class: ui_btn_neutral %>
    <%= f.submit (@commitment.new_record? ? t('log_commitment') : t('save_changes')), class: ui_btn_primary %>
  </div>
<% end %>
