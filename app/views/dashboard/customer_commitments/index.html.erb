<%= content_for :title, t('customer_commitments') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('customer_commitments'), subtitle: t('customer_commitments_subtitle') } do %>
      <%= link_to t('new_commitment'), new_dashboard_customer_commitment_path, class: ui_btn_primary %>
    <% end %>

    <%= render "dashboard/shared/register_filters", filter: @filter, path: dashboard_customer_commitments_path %>
    <p class="text-xs text-[#797C81] mb-3"><%= t('registers.showing', count: @filter.results.count, total: @total_count) %></p>

    <% if @past_due_count > 0 %>
      <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6 text-sm text-red-800">
        <%= t('past_due_warning', count: @past_due_count) %>
      </div>
    <% end %>

    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
            <tr>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('title') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('customer') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('due_date') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('owner') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('status') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('actions') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% if @commitments.any? %>
              <% @commitments.each do |commitment| %>
                <tr class="border-b border-[#E3E3E3] hover:bg-[#F7F7FD]">
                  <td class="p-4 text-sm font-medium text-[#0D1120]"><%= commitment.title %></td>
                  <td class="p-4 text-sm text-[#797C81]"><%= commitment.customer_name %></td>
                  <td class="p-4 text-sm <%= commitment.past_due? ? 'text-red-600 font-medium' : 'text-[#797C81]' %>">
                    <%= commitment.due_date ? l(commitment.due_date, format: :document) : "-" %>
                  </td>
                  <td class="p-4 text-sm text-[#797C81]"><%= commitment.owner&.user&.name || t('unassigned') %></td>
                  <td class="p-4">
                    <span class="px-2 py-1 text-xs font-medium rounded-full <%= commitment.status == 'fulfilled' ? 'bg-green-100 text-green-800' : commitment.past_due? ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>">
                      <%= t("commitment_status.#{commitment.status}") %>
                    </span>
                  </td>
                  <td class="p-4">
                    <%= link_to t('view'), dashboard_customer_commitment_path(commitment), class: "text-blue-500 hover:text-blue-700 text-sm" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6"><%= render "dashboard/shared/empty_state", icon: 'calendar-03.png', title: t('no_commitments_yet'), subtitle: t('customer_commitments_subtitle') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
