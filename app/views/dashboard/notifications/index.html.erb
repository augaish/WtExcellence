<%= content_for :title, t('notifications', default: 'Notifications') %>

<div class="min-h-screen bg-gray-50" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 mb-4 sm:mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-[#0D1120]"><%= t('notifications', default: 'Notifications') %></h1>
      <% if @has_unread_notifications %>
      <%= button_to dashboard_notifications_mark_all_read_path, method: :patch, data: { turbo: false }, class: "text-sm font-medium text-[#5C3984] hover:text-purple-900 px-3 py-2 rounded-lg hover:bg-purple-50 transition-colors min-h-[44px] sm:min-h-auto" do %>
        <%= t('mark_all_read', default: 'Mark all as read') %>
      <% end %>
      <% end %>
    </div>

    <!-- Notifications list card -->
    <div class="bg-white border border-[#E3E3E3] rounded-xl shadow-sm overflow-hidden">
      <div class="divide-y divide-gray-100">
        <% if @notifications.any? %>
          <% @notifications.each do |notification| %>
            <%= render "dashboard/notifications/notification_row", notification: notification, rtl: rtl? %>
          <% end %>
        <% else %>
          <p class="px-4 sm:px-6 py-12 text-sm text-gray-500 text-center"><%= t('no_notifications', default: 'No notifications yet') %></p>
        <% end %>
      </div>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-4 px-4 sm:px-6 pb-4">
        <%== pagy_nav(@pagy) if defined?(pagy_nav) %>
      </div>
    <% end %>
  </div>
</div>
