<% palette = @company.brand_palette %>

<div class="p-6 space-y-6">
  <%= render "dashboard/shared/page_header", title: t('branding.title'), subtitle: t('branding.subtitle') %>

  <%= form_with model: @company, url: dashboard_update_branding_path, method: :patch,
                html: { multipart: true }, class: "max-w-2xl space-y-6",
                data: { controller: "brand-preview" } do |f| %>

    <div class="bg-white border border-[#E3E3E3] rounded-lg p-6 space-y-5">
      <h2 class="text-base font-semibold text-[#0D1120]"><%= t('branding.logo') %></h2>

      <div class="flex items-center gap-4">
        <div class="w-32 h-16 border border-[#E3E3E3] rounded-lg flex items-center justify-center bg-[#F7F7FD] overflow-hidden">
          <%# Shows the saved logo, or the file just chosen, before anything is saved. %>
          <img src="<%= @company.brand_logo.attached? ? dashboard_branding_logo_path : '' %>" alt="<%= @company.name %>"
               class="max-h-full max-w-full object-contain <%= 'hidden' unless @company.brand_logo.attached? %>"
               data-brand-preview-target="logo">
          <span class="text-xs text-[#797C81] <%= 'hidden' if @company.brand_logo.attached? %>" data-brand-preview-target="noLogo"><%= t('branding.no_logo') %></span>
        </div>

        <div class="flex-1">
          <%= f.file_field :brand_logo, accept: "image/png,image/jpeg,image/svg+xml",
              data: { action: "change->brand-preview#logoChanged" },
              class: "block w-full text-sm text-[#0D1120] file:me-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[#F6EEFF] file:text-[#5C3984]" %>
          <p class="mt-2 text-xs text-[#797C81]"><%= t('branding.logo_hint') %></p>

          <% if @company.brand_logo.attached? %>
            <label class="mt-3 flex items-center gap-2 text-sm text-[#0D1120]">
              <%= check_box_tag :remove_brand_logo, "1", false, class: "rounded border-[#E3E3E3]" %>
              <%= t('branding.remove_logo') %>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-lg p-6 space-y-5">
      <h2 class="text-base font-semibold text-[#0D1120]"><%= t('branding.colors') %></h2>

      <% if palette.primary_rejected? %>
        <div class="rounded-lg border border-[#E3E3E3] bg-[#F7F7FD] p-4 text-sm text-[#0D1120]">
          <%= t('branding.primary_rejected') %>
        </div>
      <% end %>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :brand_primary_color, t('branding.primary_color'),
              class: "block text-sm font-medium text-[#0D1120] mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :brand_primary_color, value: palette.primary,
                data: { brand_preview_target: "primaryPicker", action: "input->brand-preview#primaryChanged" },
                class: "h-10 w-14 rounded border border-[#E3E3E3] p-1" %>
            <%= f.text_field :brand_primary_color, placeholder: BrandPalette::DEFAULT_PRIMARY,
                data: { brand_preview_target: "primaryText", action: "input->brand-preview#primaryTyped" },
                class: "flex-1 border border-[#E3E3E3] rounded-md px-3 py-2 text-sm" %>
          </div>
          <p class="mt-2 text-xs text-[#797C81]"><%= t('branding.primary_hint') %></p>
        </div>

        <div>
          <%= f.label :brand_accent_color, t('branding.accent_color'),
              class: "block text-sm font-medium text-[#0D1120] mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :brand_accent_color, value: palette.accent,
                data: { brand_preview_target: "accentPicker", action: "input->brand-preview#accentChanged" },
                class: "h-10 w-14 rounded border border-[#E3E3E3] p-1" %>
            <%= f.text_field :brand_accent_color, placeholder: BrandPalette::DEFAULT_ACCENT,
                data: { brand_preview_target: "accentText", action: "input->brand-preview#accentTyped" },
                class: "flex-1 border border-[#E3E3E3] rounded-md px-3 py-2 text-sm" %>
          </div>
          <p class="mt-2 text-xs text-[#797C81]"><%= t('branding.accent_hint') %></p>
        </div>
      </div>

      <div class="rounded-lg p-4" style="background-color: <%= palette.accent %>;" data-brand-preview-target="accentBox">
        <p class="text-xs font-medium text-[#797C81] mb-2"><%= t('branding.preview') %></p>
        <div class="flex items-center gap-3 mb-3">
          <%= image_tag asset_path('logo.png'), class: "h-8 w-8 rounded-full", alt: "Way to Excellence" %>
          <span class="h-6 w-px bg-[#E3E3E3]" aria-hidden="true"></span>
          <img src="<%= @company.brand_logo.attached? ? dashboard_branding_logo_path : '' %>" alt=""
               class="h-8 w-auto max-w-[140px] object-contain <%= 'hidden' unless @company.brand_logo.attached? %>"
               data-brand-preview-target="logo">
        </div>
        <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-white"
              style="background-color: <%= palette.primary %>;" data-brand-preview-target="primaryBox">
          <%= t('branding.preview_button') %>
        </span>
      </div>
    </div>

    <div class="flex justify-end">
      <%= f.submit t('save_changes'), class: ui_btn_primary %>
    </div>
  <% end %>
</div>
