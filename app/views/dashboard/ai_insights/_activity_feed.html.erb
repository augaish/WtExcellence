<% activities = local_assigns.fetch(:activities, @ai_activities) %>
<% if activities&.any? %>
  <div class="relative">
    <!-- Timeline Line -->
    <div class="absolute left-[20px] sm:left-[28px] w-0 border-[2px] border-[#5C3984]" style="height: 100%; z-index: 0;"></div>

    <!-- Activity List -->
    <ul class="list-none space-y-4 sm:space-y-6 pl-4 sm:pl-6" style="list-style: none;">
      <% activities.each do |activity| %>
        <li class="relative" style="list-style: none;">
          <div class="flex items-start">
            <!-- Timeline Marker - Circle as bullet point -->
            <div class="flex-shrink-0">
              <div class="w-3 h-3 rounded-full bg-[#5C3984]"></div>
            </div>
            
            <!-- Content -->
            <div class="flex flex-col items-start flex-1 min-w-0 pl-4 sm:pl-7 py-2 sm:py-4 z-[1]">
              <!-- Main content row -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-3 flex-wrap w-full">
                <!-- Date tag (always show if present) -->
                <% if activity.created_at.present? %>
                  <div class="flex items-center flex-shrink-0 px-2 sm:px-3 py-1 sm:py-2 gap-2 bg-[#FFFFFF] border border-[#E3E3E3] rounded-[30px]" title="<%= activity.formatted_datetime %>">
                    <span class="text-xs sm:text-sm font-medium text-[#797C81]"><%= activity.formatted_date %></span>
                  </div>
                <% end %>
                
                <!-- Activity Description -->
                <p class="text-xs sm:text-sm font-medium break-words flex-1 min-w-0 text-[#0D1120]">
                  <%= format_ai_activity_description(activity) %>
                  <span class="text-[#797C81]"> <%= t('by') %></span>
                </p>
                
                <!-- Credits Used Badge -->
                <% credits_used = ai_activity_credits_used(activity) %>
                <% if credits_used > 0 %>
                  <div class="flex items-center flex-shrink-0 px-2 py-1 bg-[#F3F4F6] rounded text-[10px] sm:text-xs font-medium text-[#5C3984] whitespace-nowrap">
                    <%= credits_used %> <%= t('credits') %>
                  </div>
                <% end %>
                
                <!-- User Avatar and Name -->
                <% if activity.actor_user %>
                  <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                    <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium">
                      <%= activity.actor_user.name[0].upcase %>
                    </div>
                    <span class="text-xs sm:text-sm font-medium text-[#0D1120] truncate max-w-[120px] sm:max-w-none"><%= activity.actor_user.name %></span>
                  </div>
                <% else %>
                  <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                    <div class="w-6 h-6 rounded-full bg-[#E3E3E3] flex items-center justify-center text-xs text-[#0D1120] font-medium">
                      <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    </div>
                    <span class="text-xs sm:text-sm font-medium text-[#0D1120] truncate max-w-[120px] sm:max-w-none"><%= t('deleted_user', default: 'Deleted user') %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <!-- Empty State -->
  <div class="flex items-center justify-center py-8 sm:py-12">
    <p class="text-xs sm:text-sm text-[#797C81] break-words px-4"><%= t('no_activity_logged_yet') %></p>
  </div>
<% end %>


