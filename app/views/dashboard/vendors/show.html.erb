<%= content_for :title, @vendor.name %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <%= link_to t('back_to_vendors'), dashboard_vendors_path, class: "text-sm text-[#5C3984] hover:underline mb-2 inline-block" %>
        <h1 class="text-2xl font-bold text-[#0D1120]"><%= @vendor.name %></h1>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to t('edit'), edit_dashboard_vendor_path(@vendor), class: ui_btn_secondary %>
        <%= link_to t('delete'), dashboard_vendor_path(@vendor), data: { turbo_method: :delete, turbo_confirm: t('are_you_sure') }, class: ui_btn_danger %>
      </div>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('category') %></p>
          <p class="text-sm text-[#0D1120]"><%= @vendor.category.presence || "-" %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('contact_email') %></p>
          <p class="text-sm text-[#0D1120]"><%= @vendor.contact_email.presence || "-" %></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('risk_level') %></p>
          <% level_color = { "unassessed" => "bg-gray-100 text-gray-700", "low" => "bg-green-100 text-green-800", "medium" => "bg-yellow-100 text-yellow-800", "high" => "bg-orange-100 text-orange-800", "critical" => "bg-red-100 text-red-800" }[@vendor.risk_level] %>
          <span class="inline-flex mt-1 px-2 py-1 text-xs font-medium rounded-full <%= level_color %>">
            <%= @vendor.risk_level.titleize %>
          </span>
        </div>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('owner') %></p>
          <p class="text-sm text-[#0D1120]"><%= @vendor.owner&.user&.name || t('unassigned') %></p>
        </div>
      </div>
      <% if @vendor.notes.present? %>
        <div>
          <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('notes') %></p>
          <p class="text-sm text-[#0D1120]"><%= @vendor.notes %></p>
        </div>
      <% end %>
    </div>

    <%= render "dashboard/shared/governance_capas", origin: @vendor,
          create_path: create_capa_dashboard_vendor_path(@vendor) %>

    <%= render "dashboard/shared/activity_trail", record: @vendor %>
  </div>
</div>
