<%= form_with model: @vendor, url: (@vendor.new_record? ? dashboard_vendors_path : dashboard_vendor_path(@vendor)), method: (@vendor.new_record? ? :post : :patch), class: "space-y-6", data: { turbo: false } do |f| %>
  <% if f.object.new_record? %><%= hidden_field_tag :submission_token, SecureRandom.hex(16) %><% end %>

  <% if @vendor.errors.any? %>
    <div class="bg-red-50 border-l-4 border-l-red-500 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800 mb-2">
            <%= t('form_errors.heading', count: @vendor.errors.count) %>
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @vendor.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-[#E3E3E3] rounded-xl p-6 space-y-4">
    <div>
      <%= f.label :name, t('vendor_name'), class: ui_label %>
      <%= f.text_field :name, class: ui_input %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category, t('category'), class: ui_label %>
        <%= f.text_field :category, placeholder: "Cloud hosting, Payroll, Legal...", class: ui_input %>
      </div>
      <div>
        <%= f.label :contact_email, t('contact_email'), class: ui_label %>
        <%= f.email_field :contact_email, class: ui_input %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :criticality, t('vendor_assessment.criticality'), class: ui_label %>
        <%= f.select :criticality, Vendor::CRITICALITIES.map { |c| [ t("vendor_assessment.criticalities.#{c}"), c ] }, { include_blank: t('pp_records.pick') }, class: ui_input %>
        <p class="mt-1 text-xs text-[#797C81]"><%= t('vendor_assessment.criticality_hint') %></p>
      </div>
      <div>
        <%= f.label :owner_id, t('owner'), class: ui_label %>
        <%= f.collection_select :owner_id, current_company&.company_users&.includes(:user) || [], :id, ->(cu) { cu.user.name }, { include_blank: t('unassigned') }, class: ui_input %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :service_description, t('vendor_assessment.service_description'), class: ui_label %>
        <%= f.text_area :service_description, rows: 2, class: ui_input %>
      </div>
      <div>
        <%= f.label :contract_end_on, t('vendor_assessment.contract_end_on'), class: ui_label %>
        <%= f.date_field :contract_end_on, class: ui_input %>
      </div>
      <div>
        <%= f.label :next_review_on, t('vendor_assessment.next_review_on'), class: ui_label %>
        <%= f.date_field :next_review_on, class: ui_input %>
      </div>
    </div>

    <%# The rating normally comes from a signed-off assessment. Setting it here
        is an override and must say why. %>
    <div class="rounded-lg border border-[#E3E3E3] bg-[#F7F7FD] p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :risk_level, t('vendor_assessment.manual_rating'), class: ui_label %>
        <%= f.select :risk_level, Vendor.risk_levels.keys.map { |l| [ t("risk_level_#{l}", default: l.titleize), l ] }, {}, class: ui_input %>
        <p class="mt-1 text-xs text-[#797C81]"><%= t('vendor_assessment.manual_rating_hint') %></p>
      </div>
      <div>
        <%= f.label :rating_override_reason, t('vendor_assessment.override_reason'), class: ui_label %>
        <%= f.text_field :rating_override_reason, class: ui_input, placeholder: t('vendor_assessment.override_reason_placeholder') %>
      </div>
    </div>

    <div>
      <%= f.label :notes, t('notes'), class: ui_label %>
      <%= f.text_area :notes, rows: 3, class: ui_input %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t('cancel'), dashboard_vendors_path, class: ui_btn_neutral %>
    <%= f.submit (@vendor.new_record? ? t('add_vendor') : t('save_changes')), class: ui_btn_primary %>
  </div>
<% end %>
