<%= content_for :title, t('vendor_management') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('vendor_management'), subtitle: t('vendor_management_subtitle') } do %>
      <%= link_to t('new_vendor'), new_dashboard_vendor_path, class: ui_btn_primary if current_user&.can_manage_governance? %>
    <% end %>

    <%= render "dashboard/shared/register_filters", filter: @filter, path: dashboard_vendors_path %>
    <p class="text-xs text-[#797C81] mb-3"><%= t('registers.showing', count: @filter.results.count, total: @total_count) %></p>

    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden">
      <% if @vendors.any? %>
        <%= render "dashboard/shared/mobile_cards", items: @vendors.map { |v|
              { title: v.name, path: dashboard_vendor_path(v),
                facts: [ [ t('category'), v.category ], [ t('vendor_assessment.criticality'), v.criticality_label ], [ t('vendor_assessment.approval'), v.approval_label ], [ t('vendor_assessment.next_review_on'), (v.next_review_on ? l(v.next_review_on, format: :document) : nil) ] ],
                status: [ t("risk_level_#{v.risk_level}", default: v.risk_level), { "unassessed" => "bg-gray-100 text-gray-700", "low" => "bg-green-100 text-green-800", "medium" => "bg-yellow-100 text-yellow-800", "high" => "bg-orange-100 text-orange-800", "critical" => "bg-red-100 text-red-800" }[v.risk_level] ] } } %>
      <% end %>
      <div class="overflow-x-auto <%= 'hidden sm:block' if @vendors.any? %>">
        <table class="w-full">
          <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
            <tr>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('vendor_name') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('category') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('vendor_assessment.criticality') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('risk_level') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('vendor_assessment.approval') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('vendor_assessment.next_review_on') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('owner') %></span></th>
              <th class="text-left p-4"><span class="text-xs font-semibold text-[#797C81]"><%= t('actions') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% if @vendors.any? %>
              <% @vendors.each do |vendor| %>
                <tr class="border-b border-[#E3E3E3] hover:bg-[#F7F7FD]">
                  <td class="p-4 text-sm font-medium text-[#0D1120]"><%= vendor.name %></td>
                  <td class="p-4 text-sm text-[#797C81]"><%= vendor.category.presence || "-" %></td>
                  <td class="p-4 text-sm text-[#797C81]"><%= vendor.criticality_label || "—" %></td>
                  <td class="p-4">
                    <% level_color = { "unassessed" => "bg-gray-100 text-gray-700", "low" => "bg-green-100 text-green-800", "medium" => "bg-yellow-100 text-yellow-800", "high" => "bg-orange-100 text-orange-800", "critical" => "bg-red-100 text-red-800" }[vendor.risk_level] %>
                    <span class="px-2 py-1 text-xs font-medium rounded-full <%= level_color %>">
                      <%= t("risk_level_#{vendor.risk_level}", default: vendor.risk_level.titleize) %>
                    </span>
                    <span class="block mt-1 text-[11px] text-[#797C81]"><%= vendor.unassessed? ? "" : t("vendor_assessment.sources.#{vendor.rating_source}") %></span>
                  </td>
                  <td class="p-4 text-sm text-[#0D1120]"><%= vendor.approval_label %></td>
                  <td class="p-4 text-sm <%= vendor.review_overdue? ? 'text-red-700 font-medium' : 'text-[#797C81]' %>"><%= vendor.next_review_on ? l(vendor.next_review_on, format: :document) : "—" %></td>
                  <td class="p-4 text-sm text-[#797C81]"><%= vendor.owner&.user&.name || t('unassigned') %></td>
                  <td class="p-4">
                    <%= link_to t('view'), dashboard_vendor_path(vendor), class: "text-blue-500 hover:text-blue-700 text-sm" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="8"><%= render "dashboard/shared/empty_state", icon: 'account-management-icon.svg', title: t('no_vendors_yet'), subtitle: t('vendor_management_subtitle') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
