<% input = "w-full border border-[#E3E3E3] rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-[#5C3984]" %>
<% th = "px-4 py-3 text-start text-xs font-medium text-[#797C81] uppercase tracking-wider" %>
<% td = "px-4 py-3 text-sm text-[#0D1120] align-top" %>

<div class="p-6 space-y-6">
  <%= render "dashboard/shared/page_header",
      title: @process.display_name,
      subtitle: [ @process.code, @process.objective ].compact_blank.join(" · ") %>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to t('back'), dashboard_pp_processes_path, class: ui_btn_neutral %>
    <% diagram = @process.diagrams.first %>
    <% if @steps.any? %>
      <% if diagram %>
        <%= button_to t('architect.sync.generate'), generate_from_steps_dashboard_pp_diagram_path(diagram),
            method: :post, class: ui_btn_secondary, title: t('architect.sync.generate_hint') %>
        <%= link_to t('architect.diagram'), dashboard_pp_diagram_path(diagram), class: ui_btn_neutral %>
      <% else %>
        <%= link_to t('architect.sync.generate'), new_dashboard_pp_diagram_path(owner_type: "PpProcess", owner_id: @process.id),
            class: ui_btn_secondary, title: t('architect.sync.generate_hint') %>
      <% end %>
    <% end %>
  </div>

  <!-- خطوات الإجراء -->
  <section class="bg-white border border-[#E3E3E3] rounded-lg">
    <div class="flex items-center justify-between p-5 border-b border-[#E3E3E3]">
      <h2 class="text-base font-semibold text-[#0D1120]"><%= t('process_steps.title') %></h2>
      <% if @process.computed_total_minutes %>
        <span class="text-sm text-[#797C81]">
          <%= t('process_steps.total_from_steps') %>:
          <span class="font-semibold text-[#0D1120]"><%= @process.computed_total_in("hours") %> <%= t('process_steps.units.hours') %></span>
        </span>
      <% end %>
    </div>

    <% if @process.total_time_disagrees_with_steps? %>
      <p class="mx-5 mt-4 rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-3 text-sm text-[#0D1120]">
        <%= t('process_steps.total_disagrees') %>
      </p>
    <% end %>

    <% if @steps.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-[#E3E3E3]">
          <thead class="bg-[#F7F7FD]">
            <tr>
              <th class="<%= th %>"><%= t('process_steps.number') %></th>
              <th class="<%= th %>"><%= t('process_steps.activity') %></th>
              <th class="<%= th %>"><%= t('process_steps.description') %></th>
              <th class="<%= th %>"><%= t('process_steps.responsible') %></th>
              <th class="<%= th %>"><%= t('process_steps.duration') %></th>
              <th class="<%= th %>"><%= t('process_steps.system') %></th>
              <th class="<%= th %>"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E3E3E3]">
            <% @steps.each do |step| %>
              <tr>
                <td class="<%= td %>"><%= step.position %></td>
                <td class="<%= td %>"><%= step.activity %></td>
                <td class="<%= td %>"><%= step.description %></td>
                <td class="<%= td %>"><%= step.responsible_label %></td>
                <td class="<%= td %>">
                  <% if step.duration_value.present? %>
                    <%= step.duration_value %> <%= t("process_steps.units.#{step.duration_unit}") %>
                  <% end %>
                </td>
                <td class="<%= td %>"><%= step.system_used %></td>
                <td class="<%= td %> text-end">
                  <div class="flex items-center justify-end gap-3">
                    <details class="text-start">
                      <summary class="cursor-pointer text-sm text-[#5C3984] hover:underline"><%= t('edit') %></summary>
                      <%# Corrections in place: one duration or one performer, with the
                          links, history and total untouched. %>
                      <%= form_with url: dashboard_pp_process_step_path(@process, step), method: :patch,
                                    scope: :pp_process_step, class: "mt-2 grid gap-2 w-72" do |f| %>
                        <%= f.number_field :position, value: step.position, min: 1, class: input, title: t('process_steps.number') %>
                        <%= f.text_field :activity, value: step.activity, placeholder: t('process_steps.activity'), class: input %>
                        <%= f.text_field :description, value: step.description, placeholder: t('process_steps.description'), class: input %>
                        <%= f.text_field :responsible_title, value: step.responsible_title, placeholder: t('process_steps.responsible'), class: input %>
                        <div class="flex gap-2">
                          <%= f.number_field :duration_value, value: step.duration_value, step: :any, min: 0, class: input %>
                          <%= f.select :duration_unit, PpProcessStep::UNITS.map { |u| [ t("process_steps.units.#{u}"), u ] },
                              { include_blank: true, selected: step.duration_unit }, class: input %>
                        </div>
                        <%= f.text_field :system_used, value: step.system_used, placeholder: t('process_steps.system'), class: input %>
                        <%= f.submit t('save_changes'), class: ui_btn_secondary %>
                      <% end %>
                    </details>
                    <%= button_to t('delete'), dashboard_pp_process_step_path(@process, step),
                        method: :delete, form: { data: { turbo_confirm: t('are_you_sure') } },
                        class: "text-sm text-[#797C81] hover:text-[#0D1120]" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-6 text-sm text-[#797C81]"><%= t('process_steps.none') %></p>
    <% end %>

    <%= form_with url: dashboard_pp_process_steps_path(@process), method: :post,
                  scope: :pp_process_step, class: "p-5 border-t border-[#E3E3E3] grid gap-3 md:grid-cols-6" do |f| %>
      <%= f.text_field :activity, value: retained(:pp_process_step, :activity), placeholder: t('process_steps.activity'), class: input %>
      <%= f.text_field :description, value: retained(:pp_process_step, :description), placeholder: t('process_steps.description'), class: input %>
      <%= f.text_field :responsible_title, value: retained(:pp_process_step, :responsible_title), placeholder: t('process_steps.responsible'), class: input %>
      <%= f.number_field :duration_value, value: retained(:pp_process_step, :duration_value), step: :any, min: 0, placeholder: t('process_steps.duration'), class: input %>
      <%= f.select :duration_unit,
          PpProcessStep::UNITS.map { |unit| [ t("process_steps.units.#{unit}"), unit ] },
          { include_blank: true }, class: input %>
      <div class="flex gap-2">
        <%= f.text_field :system_used, placeholder: t('process_steps.system'), class: input %>
        <%= f.submit t('process_steps.add'), class: ui_btn_primary %>
      </div>
    <% end %>
  </section>

  <!-- مصفوفة الصلاحيات الإجرائية -->
  <section class="bg-white border border-[#E3E3E3] rounded-lg">
    <div class="p-5 border-b border-[#E3E3E3]">
      <h2 class="text-base font-semibold text-[#0D1120]"><%= t('process_authorities.title') %></h2>
    </div>

    <%# Conformance with the executive matrix, computed rather than compared by
        eye across two spreadsheets. %>
    <div class="px-5 pt-5">
      <h3 class="text-sm font-semibold text-[#0D1120] mb-2"><%= t('doa.conformance.title') %></h3>
      <% if @conformance.any? %>
        <ul class="space-y-2">
          <% @conformance.findings.each do |finding| %>
            <li class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-2 text-sm text-[#0D1120]">
              <span class="font-medium"><%= finding.operational.decision.presence || finding.operational.item %></span>
              — <%= finding.message %>
            </li>
          <% end %>
        </ul>
      <% elsif @conformance.linked_rows.any? %>
        <p class="text-sm text-[#797C81]"><%= t('doa.conformance.none') %></p>
      <% end %>
    </div>

    <% if @authorities.any? %>
      <div class="divide-y divide-[#E3E3E3]">
        <% @authorities.each do |authority| %>
          <div class="p-5 space-y-3">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-semibold text-[#0D1120]"><%= authority.decision.presence || authority.item %></p>
                <% if authority.item.present? && authority.decision.present? %>
                  <p class="text-xs text-[#797C81] mt-0.5"><%= authority.item %></p>
                <% end %>
              </div>
              <%= button_to t('delete'), dashboard_pp_process_authority_path(@process, authority),
                  method: :delete, form: { data: { turbo_confirm: t('are_you_sure') } },
                  class: "text-sm text-[#797C81] hover:text-[#0D1120]" %>
            </div>

            <%# The rules that make this a matrix rather than a table. %>
            <% unless authority.single_authorizer? %>
              <p class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-2 text-sm text-[#0D1120]">
                <%= authority.authorizers.empty? ? t('process_authorities.no_authorizer') : t('process_authorities.many_authorizers') %>
              </p>
            <% end %>
            <% if authority.segregation_breaches.any? %>
              <p class="rounded-lg bg-[#F7F7FD] border border-[#E3E3E3] px-4 py-2 text-sm text-[#0D1120]">
                <%= t('process_authorities.segregation_breach') %>
              </p>
            <% end %>

            <div class="flex flex-wrap gap-2">
              <% authority.assignments.each do |assignment| %>
                <span class="inline-flex items-center gap-2 rounded-full bg-[#F6EEFF] px-3 py-1 text-xs text-[#0D1120]">
                  <span class="font-semibold"><%= assignment.level_label %></span>
                  <span><%= assignment.holder_label %></span>
                  <% if assignment.condition.present? %>
                    <span class="text-[#797C81]">(<%= assignment.condition %>)</span>
                  <% end %>
                  <%= button_to "×", dashboard_pp_process_authority_assignment_path(@process, authority, assignment),
                      method: :delete, class: "text-[#797C81] hover:text-[#0D1120]" %>
                </span>
              <% end %>
            </div>

            <%= form_with url: dashboard_pp_process_authority_assignments_path(@process, authority), method: :post,
                          scope: :pp_authority_assignment, class: "grid gap-3 md:grid-cols-4" do |f| %>
              <%= f.select :level,
                  AuthorityLevel::KEYS.map { |key| [ AuthorityLevel.label(key), key ] },
                  {}, class: input %>
              <%= f.text_field :holder_title, placeholder: t('process_authorities.holder'), class: input %>
              <%= f.text_field :condition, placeholder: t('process_authorities.condition'), class: input %>
              <%= f.submit t('process_authorities.add_assignment'), class: ui_btn_secondary %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="px-5 py-6 text-sm text-[#797C81]"><%= t('process_authorities.none') %></p>
    <% end %>

    <%= form_with url: dashboard_pp_process_authorities_path(@process), method: :post,
                  scope: :pp_process_authority, class: "p-5 border-t border-[#E3E3E3] grid gap-3 md:grid-cols-3" do |f| %>
      <%= f.text_field :item, placeholder: t('process_authorities.item'), class: input %>
      <%= f.text_field :decision, placeholder: t('process_authorities.decision'), class: input %>
      <%= f.collection_select :authority_id, @executive_authorities, :id, :display_name,
          { include_blank: t('doa.conformance.link') }, class: input %>
      <%= f.submit t('process_authorities.add'), class: ui_btn_primary %>
    <% end %>
  </section>
</div>
