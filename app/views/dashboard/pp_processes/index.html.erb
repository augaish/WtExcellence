<%= content_for :title, t('process_architecture.title') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <%= render layout: "dashboard/shared/page_header", locals: { title: t('process_architecture.title'), subtitle: t('process_architecture.subtitle') } do %>
      <%# Two pictures of the same tree. %>
      <% view_base = "px-3 py-2 text-sm font-medium rounded-lg border focus-visible:outline-2 focus-visible:outline-[#5C3984]" %>
      <%= link_to t('process_architecture.list_view'), dashboard_pp_processes_path(view: "list"),
            class: "#{view_base} #{@view == 'list' ? 'bg-[#5C3984] text-white border-[#5C3984]' : 'bg-white text-[#0D1120] border-[#E3E3E3] hover:bg-[#F7F7FD]'}",
            "aria-current": (@view == "list" ? "page" : nil) %>
      <%= link_to t('process_architecture.model_view'), dashboard_pp_processes_path(view: "model"),
            class: "#{view_base} #{@view == 'model' ? 'bg-[#5C3984] text-white border-[#5C3984]' : 'bg-white text-[#0D1120] border-[#E3E3E3] hover:bg-[#F7F7FD]'}",
            "aria-current": (@view == "model" ? "page" : nil) %>
      <% if can_manage_processes? %>
        <%= link_to t('process_architecture.settings'), settings_dashboard_pp_processes_path, class: ui_btn_neutral %>
        <%= link_to t('process_architecture.import_title'), import_dashboard_pp_processes_path, class: ui_btn_secondary %>
      <% end %>
    <% end %>

    <%# Level 0 is fixed; Level 1 and Level 2 grow from their "+" sign. %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
      <div class="bg-white border border-[#E3E3E3] rounded-xl p-4">
        <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t('process_architecture.levels.l0') %></p>
        <p class="mt-1 text-sm font-semibold text-[#0D1120]">
          <%= PpProcess::CATEGORIES.map { |band| @company.process_band_name(band) }.join(" · ") %>
        </p>
      </div>
      <% (1..PpProcess::MAX_LEVEL).each do |lvl| %>
        <div class="bg-white border border-[#E3E3E3] rounded-xl p-4 flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-medium text-[#797C81] uppercase tracking-wide"><%= t("process_architecture.levels.l#{lvl}") %></p>
            <p class="mt-1 text-xl font-semibold text-[#0D1120]"><%= @level_counts[lvl].to_i %></p>
          </div>
          <% if can_manage_processes? %>
            <%= link_to new_dashboard_pp_process_path(level: lvl),
                  class: "flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-full bg-[#F6EEFF] text-[#5C3984] text-xl leading-none hover:bg-[#5C3984] hover:text-white focus-visible:outline-2 focus-visible:outline-[#5C3984]",
                  "aria-label": t("process_architecture.add_level", level: lvl), title: t("process_architecture.add_level", level: lvl) do %>+<% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @view == "model" %>
      <%= render "dashboard/pp_processes/model", by_band: @by_band, by_parent: @by_parent, company: @company, can_manage: can_manage_processes? %>
    <% else %>

    <div class="bg-white border border-[#E3E3E3] rounded-xl p-4 mb-4">
      <%= form_with url: dashboard_pp_processes_path, method: :get, class: "flex flex-col sm:flex-row sm:items-end gap-3" do |f| %>
        <div class="flex-1 min-w-0">
          <%= f.label :q, t('process_architecture.search'), class: "block text-xs font-medium text-[#797C81] mb-1" %>
          <%= f.text_field :q, value: @query, placeholder: t('process_architecture.search_placeholder'),
                class: "w-full px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <div>
          <%= f.label :category, t('process_architecture.category'), class: "block text-xs font-medium text-[#797C81] mb-1" %>
          <%= f.select :category, PpProcess::CATEGORIES.map { |c| [ t("process_architecture.categories.#{c}"), c ] },
                { include_blank: t('process_architecture.all_categories'), selected: @category },
                class: "px-3 py-2 border border-[#E3E3E3] rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#5C3984]" %>
        </div>
        <label class="flex items-center gap-2 text-sm text-[#0D1120] sm:pb-2">
          <%= f.check_box :show_inactive, { checked: @show_inactive, class: "rounded border-[#E3E3E3] text-[#5C3984] focus:ring-[#5C3984]" }, "1", "0" %>
          <%= t('org_structure.show_inactive') %>
        </label>
        <button type="submit" class="<%= ui_btn_neutral %>"><%= t('apply') %></button>
      <% end %>
    </div>

    <div class="bg-white border border-[#E3E3E3] rounded-xl overflow-hidden" data-controller="org-tree">
      <div class="flex items-center justify-between px-4 py-3 border-b border-[#E3E3E3] bg-[#F7F7FD]">
        <span class="text-xs font-semibold text-[#797C81]"><%= t('process_architecture.count', count: @total_count) %></span>
        <div class="flex items-center gap-2">
          <button type="button" data-action="click->org-tree#expandAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('expand_all') %></button>
          <span class="text-[#E3E3E3]">|</span>
          <button type="button" data-action="click->org-tree#collapseAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('collapse_all') %></button>
        </div>
      </div>

      <% if @roots.any? %>
        <% @roots.each do |process| %>
          <%= render "dashboard/pp_processes/process_row", process: process, by_parent: @by_parent, depth: 0, can_manage: can_manage_processes? %>
        <% end %>
      <% elsif @query.present? || @category.present? %>
        <%= render "dashboard/shared/empty_state", icon: 'standards-icon.svg',
              title: t('process_architecture.no_results'), subtitle: t('process_architecture.no_results_hint') %>
      <% else %>
        <%= render "dashboard/shared/empty_state", icon: 'standards-icon.svg',
              title: t('process_architecture.empty_title'), subtitle: t('process_architecture.empty_subtitle') %>
      <% end %>
    </div>
    <% end %>
  </div>
</div>
