<%# The architecture as a picture: one band per Level 0 category, Level 1
    processes as boxes inside it, Level 2 shown when a box is expanded, and the
    company's objective standing to the side as the point of it all.
    Locals: by_band, by_parent, company, can_manage %>
<% band_styles = {
     "management" => { band: "bg-[#DDF1EF]", box: "bg-[#A8D08D] text-[#0D1120]" },
     "core"       => { band: "bg-[#E4404E]", box: "bg-[#FFD966] text-[#0D1120]" },
     "support"    => { band: "bg-[#8FB8BF]", box: "bg-[#D9EEF0] text-[#0D1120]" }
   } %>
<div class="bg-white border border-[#E3E3E3] rounded-xl p-4 sm:p-6" data-controller="org-tree">
  <div class="flex items-center justify-end gap-2 mb-4">
    <button type="button" data-action="click->org-tree#expandAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('process_architecture.show_level2') %></button>
    <span class="text-[#E3E3E3]">|</span>
    <button type="button" data-action="click->org-tree#collapseAll" class="text-xs font-medium text-[#5C3984] hover:underline focus-visible:outline-2 focus-visible:outline-[#5C3984]"><%= t('process_architecture.hide_level2') %></button>
  </div>

  <div class="flex flex-col lg:flex-row lg:items-stretch gap-4">
    <div class="flex-1 min-w-0 space-y-3">
      <% PpProcess::CATEGORIES.each do |band| %>
        <% style = band_styles[band] %>
        <% processes = by_band[band] || [] %>
        <section class="rounded-xl <%= style[:band] %> p-3 sm:p-4" aria-labelledby="band-<%= band %>">
          <div class="flex items-center justify-between gap-3 mb-3">
            <h2 id="band-<%= band %>" class="text-sm font-semibold <%= band == 'core' ? 'text-white' : 'text-[#0D1120]' %>">
              <%= PpProcess::BAND_NUMBERS[band] %>. <%= company.process_band_name(band) %>
            </h2>
            <% if can_manage %>
              <%= link_to "+", new_dashboard_pp_process_path(level: 1, category: band),
                    class: "w-7 h-7 flex items-center justify-center rounded-full bg-white/80 text-[#5C3984] text-lg leading-none hover:bg-white focus-visible:outline-2 focus-visible:outline-[#5C3984]",
                    "aria-label": t('process_architecture.add_to_band', band: company.process_band_name(band)) %>
            <% end %>
          </div>

          <% if processes.any? %>
            <div class="flex flex-wrap gap-3">
              <% processes.each do |process| %>
                <% children = by_parent[process.id] || [] %>
                <div class="w-full sm:w-[calc(50%-0.375rem)] xl:w-[calc(25%-0.5625rem)] rounded-lg <%= style[:box] %> shadow-sm">
                  <div class="flex items-start gap-2 p-3">
                    <% if children.any? %>
                      <button type="button"
                              class="flex-shrink-0 w-5 h-5 mt-0.5 flex items-center justify-center rounded text-[#0D1120]/70 hover:bg-white/60 focus-visible:outline-2 focus-visible:outline-[#5C3984]"
                              data-action="click->org-tree#toggle" data-org-tree-target="toggle"
                              data-node-id="<%= process.id %>" aria-expanded="true"
                              aria-label="<%= t('process_architecture.toggle_children') %>">
                        <span class="text-xs" data-org-tree-target="chevron">▾</span>
                      </button>
                    <% else %>
                      <span class="flex-shrink-0 w-5 h-5"></span>
                    <% end %>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-semibold leading-snug">
                        <span class="font-mono text-xs opacity-70"><%= process.architecture_number %></span>
                        <%= link_to process.display_name, edit_dashboard_pp_process_path(process), class: "hover:underline" if can_manage %>
                        <%= process.display_name unless can_manage %>
                      </p>
                    </div>
                    <% if can_manage %>
                      <%= link_to "+", new_dashboard_pp_process_path(parent_id: process.id),
                            class: "flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-white/70 text-[#5C3984] leading-none hover:bg-white focus-visible:outline-2 focus-visible:outline-[#5C3984]",
                            "aria-label": t('process_architecture.add_child') %>
                    <% end %>
                  </div>
                  <% if children.any? %>
                    <ul class="px-3 pb-3 space-y-1 text-xs" data-org-tree-target="children" data-parent-id="<%= process.id %>">
                      <% children.each do |child| %>
                        <li class="flex items-baseline gap-2 bg-white/70 rounded px-2 py-1">
                          <span class="font-mono opacity-70"><%= child.architecture_number %></span>
                          <% if can_manage %>
                            <%= link_to child.display_name, edit_dashboard_pp_process_path(child), class: "hover:underline" %>
                          <% else %>
                            <span><%= child.display_name %></span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-xs <%= band == 'core' ? 'text-white/90' : 'text-[#0D1120]/70' %>"><%= t('process_architecture.band_empty') %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <%# The objective the whole map serves. %>
    <div class="flex items-center justify-center lg:w-56 flex-shrink-0">
      <div class="w-48 h-48 rounded-full bg-[#7CC5C0] border-2 border-[#0D1120]/70 flex items-center justify-center text-center p-6 text-sm font-medium text-[#0D1120]">
        <%= company.process_objective.presence || t('process_architecture.objective_placeholder') %>
      </div>
    </div>
  </div>
</div>
