<%= content_for :title, t('ai_instructions') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-2">
      <div>
        <h1 class="text-3xl font-bold text-[#0D1120] mb-2"><%= t('ai_instructions') %></h1>
        <p class="text-[#797C81]"><%= t('ai_instructions_subtitle') %></p>
      </div>
      <%= link_to t('new_ai_instruction'), new_dashboard_ai_instruction_path, class: "px-4 py-2 text-sm text-white bg-[#5C3984] hover:bg-[#4A2F6B] rounded-lg transition-colors" %>
    </div>

    <div class="bg-[#F6EEFF] border border-[#E3D5F5] rounded-lg p-4 mb-6 text-sm text-[#5C3984]">
      <%= t('ai_instructions_help') %>
    </div>

    <% if @ai_instructions.any? %>
      <div class="space-y-4">
        <% @ai_instructions.each do |instruction| %>
          <div class="bg-white border border-[#E3E3E3] rounded-xl p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h2 class="text-lg font-semibold text-[#0D1120] truncate"><%= instruction.title %></h2>
                  <% if instruction.active? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= t('active') %></span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600"><%= t('inactive') %></span>
                  <% end %>
                </div>
                <% preview = instruction.content_for(I18n.locale).to_s %>
                <p class="text-sm text-gray-600 line-clamp-2"><%= truncate(preview, length: 200) %></p>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0 text-sm">
                <%= button_to (instruction.active? ? t('deactivate') : t('activate')), toggle_dashboard_ai_instruction_path(instruction), method: :patch, class: "text-[#5C3984] hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
                <%= link_to t('edit'), edit_dashboard_ai_instruction_path(instruction), class: "text-[#5C3984] hover:underline" %>
                <%= button_to t('delete'), dashboard_ai_instruction_path(instruction), method: :delete, form: { data: { turbo_confirm: t('are_you_sure') } }, class: "text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border border-[#E3E3E3] rounded-xl p-8 text-center text-sm text-[#797C81]">
        <%= t('no_ai_instructions_yet') %>
      </div>
    <% end %>
  </div>
</div>
