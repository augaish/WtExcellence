<%# Shared frame for the public pages. Locals: title, block %>
<div class="min-h-screen bg-gray-50" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <div class="max-w-3xl mx-auto px-6 py-10">
    <nav class="flex items-center justify-between mb-8 text-sm">
      <a href="<%= root_path %>" class="flex items-center gap-2 text-[#0D1120]">
        <%= image_tag asset_path('logo.png'), alt: "Way to Excellence", class: "h-8 w-8 rounded-full", width: 32, height: 32 %>
        <span class="font-semibold">Way to Excellence</span>
      </a>
      <% if rtl? %><a href="<%= switch_language_path(:en) %>" lang="en" class="text-[#797C81] hover:text-[#0D1120]">English</a><% else %><a href="<%= switch_language_path(:ar) %>" lang="ar" class="text-[#797C81] hover:text-[#0D1120]">العربية</a><% end %>
    </nav>
    <main class="bg-white border border-[#E3E3E3] rounded-xl p-8 prose prose-sm max-w-none text-[#0D1120]">
      <h1 class="text-2xl font-bold mb-2"><%= title %></h1>
      <p class="text-xs text-[#797C81] mb-6"><%= rtl? ? "آخر تحديث" : "Last updated" %>: <%= l(Date.new(2026, 9, 10), format: :document) %></p>
      <%= yield %>
    </main>
    <p class="mt-6 text-xs text-[#797C81]">
      <a href="<%= page_path(:privacy) %>" class="hover:underline"><%= rtl? ? "الخصوصية" : "Privacy" %></a> ·
      <a href="<%= page_path(:terms) %>" class="hover:underline"><%= rtl? ? "الشروط" : "Terms" %></a> ·
      <a href="<%= page_path(:security) %>" class="hover:underline"><%= rtl? ? "الأمن" : "Security" %></a> ·
      <a href="<%= page_path(:about) %>" class="hover:underline"><%= rtl? ? "من نحن" : "About" %></a> ·
      <a href="mailto:info@wtexcellence.com" class="hover:underline">info@wtexcellence.com</a>
    </p>
  </div>
</div>
