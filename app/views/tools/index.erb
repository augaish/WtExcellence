<div data-controller="tools--select-all"
     data-tools--select-all-confirm-title-value="<%= t('delete_tools_title') %>"
     data-tools--select-all-confirm-message-value="<%= t('bulk_delete_tools_confirm', n: '%{n}') %>"
     data-tools--select-all-confirm-text-value="<%= t('delete') %>"
     data-tools--select-all-no-selection-message-value="<%= t('bulk_delete_tools_no_selection') %>"
     data-tools--select-all-bulk-delete-path-value="<%= bulk_destroy_tools_path %>">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between bg-white px-4 sm:px-6 py-4 sm:py-6 border-b border-[#E3E3E3] gap-3">
        <h1 class="text-lg sm:text-2xl font-semibold text-[#0D1120] break-words"><%= t('tool_setup_management') %></h1>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
            <% unless viewer? %>
              <div class="hidden items-center gap-2" data-tools--select-all-target="bulkActions">
                <button type="button"
                        data-action="click->tools--select-all#bulkDelete"
                        class="inline-flex items-center justify-center gap-2 bg-[#EA4034] hover:bg-[#D32F2F] text-white px-4 py-3 sm:py-2.5 rounded-lg font-medium transition-colors duration-200 whitespace-nowrap min-h-[44px] text-[16px] sm:text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a2 2 0 012-2h2a2 2 0 012 2v3" />
                    </svg>
                    <span><%= t('delete_selected_tools') %></span>
                    <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-semibold bg-white/20 rounded-full" data-tools--select-all-target="selectedCount">0</span>
                </button>
              </div>
            <% end %>
            <%= form_with url: tools_path, method: :get, data: { turbo_frame: "tools-table", turbo_action: "replace", controller: "tools" }, class: "relative w-full sm:w-auto" do |form| %>
                <%= form.hidden_field :standard_id, value: params[:standard_id] %>
                <%= form.hidden_field :sort, value: params[:sort] %>
                <%= form.text_field :search, placeholder: t('search_tools'), value: params[:search], class: "w-full sm:w-64 px-4 py-3 sm:py-2.5 pl-10 pr-4 text-[16px] sm:text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C3984] focus:border-transparent transition-colors duration-200", data: { action: "input->tools#searchTools" } %>
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            <% end %>
            <% unless viewer? %>
              <%= link_to new_tool_path, class: "flex items-center justify-center bg-[#5C3984] hover:bg-[#4A2F6B] text-white px-6 py-3 sm:py-2.5 rounded-lg font-medium transition-colors duration-200 whitespace-nowrap min-h-[44px] text-[16px] sm:text-sm" do %>
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                  <%= t('add_new_tool') %>
              <% end %>
            <% end %>
        </div>
    </div>

    <div id="tools-filters" class="px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white border-b border-[#E3E3E3]">
        <h4 class="text-sm sm:text-base font-medium text-[#0D1120]">
            <% if params[:search].present? || (params[:standard_id].present? && params[:standard_id] != "all") || (params[:sort].present? && params[:sort] != "last_edited") %>
                <%= t('filtered_tools') %> (<%= @tools.count %>)
            <% else %>
                <%= t('created_tools') %> (<%= @tools.count %>)
            <% end %>
        </h4>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <%= form_with url: tools_path, method: :get, data: { turbo_frame: "tools-table", turbo_action: "replace", controller: "tools" }, class: "relative flex items-center gap-3" do |form| %>
                <%= form.hidden_field :search, value: params[:search] %>
                <%= form.hidden_field :standard_id, value: params[:standard_id] %>
                <div class="relative" data-controller="choices-select">
                    <%= form.select :sort, 
                        options_for_select([
                            [t('last_edited_sort'), "last_edited"],
                            [t('creation_date'), "creation_date"]
                        ], params[:sort] || "last_edited"),
                        {},
                        { 
                            class: "w-full",
                            data: { 
                                action: "change->tools#submitForm",
                                "choices-select-target": "select"
                            }
                        } %>
                </div>
            <% end %>
            <%= form_with url: tools_path, method: :get, data: { turbo_frame: "tools-table", turbo_action: "replace", controller: "tools" }, class: "relative flex items-center gap-3" do |form| %>
                <%= form.hidden_field :search, value: params[:search] %>
                <%= form.hidden_field :sort, value: params[:sort] %>
                <div class="relative" data-controller="choices-select" data-choices-select-search-value="true">
                    <%= form.select :standard_id, 
                        options_for_select([[t('all_standards'), "all"]] + @standards.map { |s| [s.display_name, s.id] }, params[:standard_id] || "all"),
                        {},
                        { 
                            class: "w-full",
                            data: { 
                                action: "change->tools#submitForm",
                                "choices-select-target": "select"
                            }
                        } %>
                </div>
            <% end %>
            <% if params[:search].present? || (params[:standard_id].present? && params[:standard_id] != "all") || (params[:sort].present? && params[:sort] != "last_edited") %>
                <%= link_to tools_path, 
                    data: { turbo_frame: "tools-table", turbo_action: "replace" },
                    class: "flex items-center gap-2 px-4 py-3 sm:py-2.5 text-[16px] sm:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:text-[#5C3984] transition-colors duration-200" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <%= t('clear_filters') %>
                <% end %>
            <% end %>
        </div>
    </div>


    <turbo-frame id="tools-table">
        <div class="bg-white border border-[#E3E3E3] rounded-xl w-full max-w-[95%] mx-auto mt-4 overflow-x-auto">
            <div class="">
                <table class="w-full min-w-[720px]">
                    <thead class="bg-[#F7F7FD] border-b border-[#E3E3E3]">
                        <tr>
                            <th class="text-left p-4 w-12">
                                <% unless viewer? %>
                                  <input type="checkbox"
                                         class="rounded border-gray-300 text-[#5C3984] focus:ring-[#5C3984] cursor-pointer"
                                         data-tools--select-all-target="master"
                                         data-action="change->tools--select-all#toggleAll"
                                         aria-label="<%= t('select_all') %>">
                                <% end %>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('tool_name') %></span>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('description') %></span>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('linked_standard') %></span>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('top_level_clauses') %></span>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('last_edited') %></span>
                            </th>
                            <th class="text-left p-4">
                                <span class="text-xs font-semibold text-[#797C81]"><%= t('actions') %></span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <%= render partial: "tools_table_rows" %>
                    </tbody>
                </table>
            </div>
        </div>
    </turbo-frame>
</div>



<%= render "shared/general_confirmation_modal" %>